!IFDEF DEBUG
!IFDEF OPT_MOST
!ERROR You MUST NOT define DEBUG= and OPT_MOST= together.
!ENDIF
CFLAGS_OPT = /Od
!ELSE
!IFDEF OPT_MOST
CFLAGS_OPT = /Ox /Ob2 /Oi /Ot /Oy
!ELSE
CFLAGS_OPT = /O2
!ENDIF
!ENDIF

CFLAGS = /nologo $(CFLAGS_OPT) /Imlkem /Imlkem/src /Imlkem/src/fips202 /Imlkem/src/fips202/native /Imlkem/src/sys /Imlkem/src/native

!IFDEF DEBUG
CFLAGS = $(CFLAGS) /Zi
!ENDIF

!IFDEF ASSEMBLY
CFLAGS = $(CFLAGS) /D MLK_CONFIG_USE_NATIVE_BACKEND_ARITH /D MLK_CONFIG_USE_NATIVE_BACKEND_FIPS202
!IFDEF ARM64
AS = armasm64.exe
ASFLAGS = -machine ARM64 -nologo
!IFDEF DEBUG
ASFLAGS = $(ASFLAGS) -g
!ENDIF
!ELSE
AS = ml64.exe
ASFLAGS = /nologo /c
!IFDEF DEBUG
ASFLAGS = $(ASFLAGS) /Zi
!ENDIF
!ENDIF
!ELSE
CFLAGS = $(CFLAGS) /D MLD_CONFIG_NO_ASM
!ENDIF

ALLOC_CFLAGS = \
    $(CFLAGS) \
    /D MLK_CONFIG_FILE="\"../test/configs/test_alloc_config.h\""

OBJ_FILES = .\mlkem\*.obj \
            .\mlkem\fips202\*.obj

