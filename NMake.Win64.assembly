    $(AS) $(ASFLAGS) /D FUNC_NAME=$(<B:mlkem_=mlk_)_asm /Fo$(MLKEM1024_BUILD_DIR)\alloc\mlkem\x86_64\$(<B).obj $<

# compilation of C files for MLKEM1024 (assembly part, FIPS 202)
{mlkem\src\fips202\native\x86_64\src}.c{$(MLKEM1024_BUILD_DIR)\alloc\mlkem\fips202\x86_64}.obj:
