#
# ML-KEM 512
#

!IFDEF ARM64

#
# Comment from author: armasm64.exe has bugs:
# a) ALIGN 16 in code sections does NOT emit
#    correct 'HINT #0x0' (NOPs) but zeros
# b) 'RELOC 2' for PDATA sections meaning
#    IMAGE_REL_ARM64_ADDR32NB still emit ADDR64
#    instead
#
# The bottom line is: you may also use clang-cl
# to compile Aarch64 assembly stuff on MS Windows.
# You have to add:
# --target=aarch64-pc-windows-msvc
# in this case.
# Claude Code provided the fix_pdata.py script,
# which performs well here, though.
#
# clang-cl works for ARM64 but obviously not for
# AMD64 assembly (ml64.exe is used in this case)
# because we had to convert the SysV AMD64 ABI
# to MS AMD64 ABI by hand...
#

# compilation of C files for MLKEM512 (assembly part)
{mlkem\src\native\aarch64\src}.c{$(MLKEM512_BUILD_DIR)\mlkem\aarch64}.obj:
