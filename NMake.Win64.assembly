    $(AS) $(ASFLAGS) -predefine "FUNC_NAME SETS \"mlk_$(<B)_asm\"" -o $(MLKEM1024_BUILD_DIR)\alloc\mlkem\fips202\aarch64\$(<B).obj $<
    @python fix_pdata.py $(MLKEM1024_BUILD_DIR)\alloc\mlkem\fips202\aarch64\$(<B).obj

!ELSE

