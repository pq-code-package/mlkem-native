import conform  # noqa: E402

Failed = conform.Failed


def positive_int(value):
    try:
        number = int(value)
    except ValueError as e:
        raise argparse.ArgumentTypeError("must be an integer") from e
    if number < 1:
        raise argparse.ArgumentTypeError("must be at least 1")
    return number


def hms(start):
    secs = round(time.time() - start)
    return f"{secs // 3600}:{secs // 60 % 60:02}:{secs % 60:02}"


def progress(what):
    """Report a step that may take a while."""
    print(what, flush=True)


def die(msg):
    print(f"hol-trace: {msg}", file=sys.stderr)
    sys.exit(1)


# Every HOL Light shell provides the replay HOL Light and s2n-bignum;
# recording needs the hol_trace-cross shell.
SHELL_OF = {
    "HOLTRACE_RECORD_HOL": "hol_trace-cross",
    "HOLTRACE_S2N_BIGNUM": "hol_trace-cross",
}


def env(name):
    value = os.environ.get(name)
    if not value:
        shell = SHELL_OF.get(name, "hol_light")
        die(f"{name} is not set; run inside `nix develop .#{shell}`")
    return value


def holtrace_hol(name):
    """The HOL Light build with HOLTrace installed that $name points to.
    Ordinary proofs use stock HOL Light; never use that for HOLTrace."""
    path = env(name)
    if not os.path.exists(os.path.join(path, "INSTALLED-HOLTrace")):
        die(f"{name}={path} is not a HOL Light build with HOLTrace installed")
    return path


def rel(path):
    return os.path.relpath(path, ROOT)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def run(cmd, log, stdout=None, **kwargs):
    """Run cmd with stderr (and stdout, unless given) to the log file.
    Return (exit code, seconds, peak RSS in KB) of this command alone."""
    log.flush()
    start = time.time()
    p = subprocess.Popen(cmd, stdout=stdout or log, stderr=log, **kwargs)
    _, status, usage = os.wait4(p.pid, 0)
    p.returncode = os.waitstatus_to_exitcode(status)
    rss = usage.ru_maxrss // (1024 if sys.platform == "darwin" else 1)
    return p.returncode, time.time() - start, rss


# ----- proofs, theorems, sources


def native_arch():
    """The host's architecture, as `tests hol_light` determines it."""
    machine = platform.machine().lower()
    if machine in ("arm64", "aarch64"):
        return "aarch64"
    if machine == "x86_64":
        return "x86_64"
    die(f"unsupported host architecture {machine}; use --arch")


def functions(arch):
    p = subprocess.run(
        [os.path.join(PROOF_DIR, arch, "list_proofs.sh")],
        capture_output=True,
        text=True,
        check=True,
        cwd=ROOT,
    )
    return [f for f in p.stdout.split() if f]


def proof_ml(arch, func):
    return os.path.join(PROOF_DIR, arch, "proofs", func + ".ml")


def theorems(arch, func):
    """The proof's main theorems, as defined by ARCH/list_thms.sh (which
    lint uses to check that every proof establishes them)."""
    p = subprocess.run(
        [os.path.join(PROOF_DIR, arch, "list_thms.sh"), func],
        capture_output=True,
        text=True,
        check=True,
        cwd=ROOT,
    )
    return p.stdout.split()


def strip_comments(src):
    """Remove (nested) OCaml comments; keep string literals and HOL Light
    term quotations (`...`) intact."""
    out, depth, i = [], 0, 0
    while i < len(src):
        # The character literals '"' and '\"' start no string.
        quote = re.match(r"'\\?\"'", src[i : i + 4])
        if quote:
            if not depth:
                out.append(quote.group())
            i += len(quote.group())
        elif src.startswith("(*", i):
            depth, i = depth + 1, i + 2
        elif depth and src.startswith("*)", i):
            depth, i = depth - 1, i + 2
        elif not depth and src[i] == "`":
            j = src.find("`", i + 1)
            j = len(src) if j < 0 else j
            out.append(src[i : j + 1])
            i = j + 1
        elif src[i] == '"':
            j = i + 1
            while j < len(src) and src[j] != '"':
                j += 2 if src[j] == "\\" else 1
            if not depth:
                out.append(src[i : j + 1])
            i = j + 1
        else:
            if not depth:
                out.append(src[i])
            i += 1
    return "".join(out)


def sources(arch, func):
    """mlkem-native files the proof loads (transitively), and its .S file."""
    files, todo = set(), [proof_ml(arch, func)]
    while todo:
        path = todo.pop()
        if path in files:
            continue
        files.add(path)
        for dep in re.findall(
            r'(?:needs|loadt|loads)\s+"mlkem_native/([^"]+)"',
            strip_comments(open(path).read()),
        ):
            todo.append(os.path.join(PROOF_DIR, dep))
    files.add(os.path.join(PROOF_DIR, arch, "mlkem", func + ".S"))
    return {rel(f): sha256(f) for f in sorted(files)}


def tool_id(path):
    """A Nix package name and version without its platform-specific hash."""
    normalized = os.path.normpath(path)
    m = re.match(r"^/nix/store/[a-z0-9]{32}-([^/]+)", normalized)
    return m.group(1) if m else os.path.basename(normalized)


def recording_tools():
    return {name: tool_id(env(name)) for name in RECORD_TOOLS}


RECORD_TOOLS = ["HOLTRACE_RECORD_HOL", "HOLTRACE_S2N_BIGNUM"]


def paths(arch, func):
    d = os.path.join(TRACES, arch)
    return {
        "trace": os.path.join(d, func + ".50"),
        "raw": os.path.join(d, func + ".raw.50"),
        "manifest": os.path.join(d, func + ".manifest.json"),
        "gen_log": os.path.join(d, func + ".gen.log"),
    }


def replay_paths(arch, func, backend):
    stem = os.path.join(TRACES, arch, func + "." + backend)
    return {"result": stem + ".result", "log": stem + ".replay.log"}


# ----- gen


def build_objects(selected):
    for arch in ARCHS:
        funcs = [f for a, f in selected if a == arch]
        if not funcs:
            continue
        progress(f"assembling {len(funcs)} {arch} object files")
        p = subprocess.run(
            ["make", "-C", os.path.join(PROOF_DIR, arch)]
            + [f"mlkem/{f}.o" for f in funcs],
            capture_output=True,
            text=True,
        )
        if p.returncode != 0:
            print(p.stdout[-3000:] + p.stderr[-3000:], file=sys.stderr)
            die(
                f"cannot assemble the {arch} code. On another host architecture "
                "use `nix develop .#hol_light-cross`."
            )


def prepare_tree(work):
    """Copy of proofs/hol_light rewritten for hashtt, with an imports root."""
    src = os.path.join(work, "src")
    ignore = shutil.ignore_patterns("*.native", "*.correct")
    for d in ["common"] + ARCHS:
        shutil.copytree(os.path.join(PROOF_DIR, d), os.path.join(src, d), ignore=ignore)
    subprocess.run(
        ["holtrace-hashtt-rewrite", src],
        check=True,
        stdout=subprocess.DEVNULL,
        cwd=ROOT,
    )
    imports = os.path.join(work, "imports")
    os.makedirs(imports)
    os.symlink(env("HOLTRACE_S2N_BIGNUM"), os.path.join(imports, "s2n_bignum"))
    os.symlink(src, os.path.join(imports, "mlkem_native"))
    return src, imports


def remove_results(arch, func):
    for backend in BACKENDS:
        for path in replay_paths(arch, func, backend).values():
            if os.path.exists(path):
                os.remove(path)


def gen_one(arch, func, work, src, imports, prune, source_snapshot):
    start = time.time()

    def phase(what):
        """Print the step that starts now; recording can take hours."""
        print(f"  {func}: {what} ({hms(start)} elapsed)", flush=True)

    p = paths(arch, func)
    os.makedirs(os.path.dirname(p["trace"]), exist_ok=True)
    for k in ["trace", "raw", "manifest"]:
        if os.path.exists(p[k]):
            os.remove(p[k])
    remove_results(arch, func)
    names = theorems(arch, func)
    if not names:
        raise Failed("no theorems found")
    tmp = os.path.join(work, arch, func)
    os.makedirs(tmp)
    wrapper = os.path.join(tmp, "trace.ml")
    with open(wrapper, "w") as f:
        f.write(f'loadt "{src}/{arch}/proofs/{func}.ml";;\n')
        f.write("holtrace_namethm [\n")
        f.writelines(f'  ("{n}", {n});\n' for n in names)
        f.write("];;\nholtrace_stop ();;\n")
    native = os.path.join(tmp, "trace.native")
    raw = p["raw"]
    record_hol = holtrace_hol("HOLTRACE_RECORD_HOL")
    stats = {}
    with open(p["gen_log"], "w") as log:
        e = dict(os.environ, S2N_BIGNUM_DIR=env("HOLTRACE_S2N_BIGNUM"))
        e["IMPORTS_DIR"] = imports
        phase("compiling the proof")
        rc, _, _ = run(
            [BUILD_PROOF, wrapper, os.path.join(record_hol, "hol.sh"), native],
            log,
            env=e,
            cwd=ROOT,
        )
        if rc != 0:
            raise Failed(f"building the proof failed, see {rel(p['gen_log'])}")
        e = dict(os.environ, HOLTRACE_SAVE=raw)
        phase("recording the trace")
        rc, secs, rss = run([native], log, cwd=src, env=e)
        # Again: the proof code that just ran could have written them.
        remove_results(arch, func)
        stats["record"] = {"seconds": round(secs), "max_rss_kb": rss}
    # Same success criterion as the Makefile's .correct rule.
    text = open(p["gen_log"], errors="replace").read()
    if (
        rc != 0
        or re.search(r"error:|exception:", text, re.I)
        or "Running time:" not in text
    ):
        raise Failed(f"proof failed, see {rel(p['gen_log'])}")
    if prune:
        phase(f"pruning the {os.path.getsize(raw) / 2**30:.1f} GiB trace")
        with open(p["gen_log"], "a") as log:
            log.write("\n# holtrace-prune\n")
            with open(raw, "rb") as fin, open(p["trace"], "wb") as fout:
                rc, secs, rss = run(
                    ["holtrace-prune"] + names, log, stdin=fin, stdout=fout
                )
        if rc != 0:
            raise Failed(f"holtrace-prune failed, see {rel(p['gen_log'])}")
        stats["prune"] = {
            "seconds": round(secs),
            "max_rss_kb": rss,
            "unpruned_bytes": os.path.getsize(raw),
        }
        os.remove(raw)
    else:
        shutil.move(raw, p["trace"])
    if sources(arch, func) != source_snapshot:
        raise Failed("proof sources changed while the trace was being recorded")
    phase(f"hashing the {os.path.getsize(p['trace']) / 2**30:.1f} GiB trace")
    manifest = {
        "function": f"{arch}/{func}",
        "sources": source_snapshot,
        "recording_tools": recording_tools(),
        "pruned": prune,
        "theorems": names,
        "trace_bytes": os.path.getsize(p["trace"]),
        "trace_sha256": sha256(p["trace"]),
        "stats": stats,
    }
    with open(p["manifest"], "w") as f:
        json.dump(manifest, f, indent=2)
        f.write("\n")
    gb = max(s["max_rss_kb"] for s in stats.values()) / 2**20
    secs = sum(s["seconds"] for s in stats.values())
    return f"{manifest['trace_bytes'] / 2**20:.0f} MB trace, {secs} s, {gb:.1f} GB peak"


def cmd_gen(selected, args):
    for name in ["HOLTRACE_RECORD_HOL", "HOLTRACE_S2N_BIGNUM"]:
        env(name)
    source_snapshots = {(a, f): sources(a, f) for a, f in selected}
    build_objects(selected)
    work = tempfile.mkdtemp(prefix="hol-trace-gen-")
    try:
        progress("copying the proofs and rewriting them for hashtt")
        src, imports = prepare_tree(work)
        return run_all(
            "gen",
            selected,
            args.jobs,
            lambda a, f: gen_one(
                a,
                f,
                work,
                src,
                imports,
                args.prune,
                source_snapshots[a, f],
            ),
        )
    finally:
        shutil.rmtree(work, ignore_errors=True)


# ----- check


def stale(arch, func, manifest):
    p = paths(arch, func)
    if manifest.get("function") != f"{arch}/{func}":
        return "manifest names another function"
    if manifest.get("sources") != sources(arch, func):
        return "proof sources changed"
    if manifest.get("theorems") != theorems(arch, func):
        return "source theorem list changed"
    if manifest.get("recording_tools") != recording_tools():
        return "HOL Light, s2n-bignum or HOLTrace changed"
    if manifest.get("trace_bytes") != os.path.getsize(p["trace"]):
        return "trace size differs from manifest"
    if manifest.get("trace_sha256") != sha256(p["trace"]):
        return "trace hash differs from manifest"
    return None


# ----- replay
#
# Each backend reads HOLTRACE_TRACE and HOLTRACE_NAMES and writes the
# replayed theory to HOLTRACE_RESULT. It loads no proof code.


def fresh_imports(work):
    """An environment whose imports root lives in work. The checkout's
    .imports is untracked, so proof code run by `gen` could repoint it."""
    imports = os.path.join(work, "imports")
    if not os.path.isdir(imports):
        os.makedirs(imports)
        os.symlink(env("S2N_BIGNUM_DIR"), os.path.join(imports, "s2n_bignum"))
        os.symlink(PROOF_DIR, os.path.join(imports, "mlkem_native"))
    return dict(os.environ, IMPORTS_DIR=imports)


def hol_light_replay(work):
    restore = os.path.join(work, "restore.native")
    hol = os.path.join(holtrace_hol("HOLTRACE_REPLAY_HOL"), "hol.sh")
    progress("compiling restore.ml against the replay HOL Light")
    p = subprocess.run(
        [BUILD_PROOF, os.path.join(HERE, "restore.ml"), hol, restore],
        capture_output=True,
        text=True,
        cwd=ROOT,
        env=fresh_imports(work),
    )
    if p.returncode != 0:
        print(p.stdout[-3000:] + p.stderr[-3000:], file=sys.stderr)
        die("building restore.ml failed")
    return [restore]


BACKENDS = {
    "hol-light": hol_light_replay,
}


def replay_one(arch, func, work, backend, command):
    p = paths(arch, func)
    out = replay_paths(arch, func, backend)
    # First, so that a failed replay never leaves an old result behind.
    if os.path.exists(out["result"]):
        os.remove(out["result"])
    for k in ["trace", "manifest"]:
        if not os.path.exists(p[k]):
            raise Failed(f"no trace; run `hol-trace gen --arch {arch} -p {func}`")
    reason = stale(arch, func, json.load(open(p["manifest"])))
    if reason:
        raise Failed(
            f"trace is stale ({reason}); run `hol-trace gen --arch {arch} -p {func}`"
        )
    names = os.path.join(work, f"{arch}-{func}.names")
    with open(names, "w") as f:
        f.writelines(t + "\n" for t in theorems(arch, func))
    e = dict(
        os.environ,
        HOLTRACE_TRACE=p["trace"],
        HOLTRACE_NAMES=names,
        HOLTRACE_RESULT=out["result"],
    )
    e.pop("HOLTRACE_SAVE", None)
    with open(out["log"], "w") as log:
        rc, secs, rss = run(command, log, env=e)
        log.write(
            f"\n# replay: {secs:.0f} s, {rss / 2**20:.1f} GiB peak RSS, "
            f"exit status {rc}\n"
        )
    if rc != 0:
        if os.path.exists(out["result"]):
            os.remove(out["result"])
        raise Failed(f"replay exited with status {rc}; see {rel(out['log'])}")
    if not os.path.exists(out["result"]):
        raise Failed(f"replay wrote no result; see {rel(out['log'])}")
    return f"replay {secs:.0f} s, {rss / 2**20:.1f} GiB peak RSS"


def cmd_replay(selected, args):
    work = tempfile.mkdtemp(prefix="hol-trace-replay-")
    try:
        command = BACKENDS[args.backend](work)
        return run_all(
            f"replay ({args.backend})",
            selected,
            args.jobs,
            lambda a, f: replay_one(a, f, work, args.backend, command),
        )
    finally:
        shutil.rmtree(work, ignore_errors=True)


# ----- compare


def layer_paths(arch):
    """The generated layers that a proof of arch is checked against: the
    files that `hol-trace outline` writes, not whatever is in accepted/."""
    return [path for path, _, _, _ in layer_steps(arch)]


def check_layers_fresh(paths):
    """Fail if a layer was generated from other pins or sources."""
    current = layer_pins()
    for path in paths:
        if not os.path.exists(path):
            raise Failed(f"{rel(path)} is missing; {REGENERATE}")
        for key, value in conform.read_metadata(path):
            if key == "pin":
                name, _, version = value.partition(" ")
                if current.get(name) != version:
                    raise Failed(f"{rel(path)} is stale ({name}); {REGENERATE}")
            elif key == "source":
                f, _, digest = value.partition(" ")
                if sha256(os.path.join(ROOT, f)) != digest:
                    raise Failed(f"{rel(path)} is stale ({f}); {REGENERATE}")


REGENERATE = (
    "run `scripts/autogen --hol-trace-defs` (or `hol-trace outline --base "
    "--specs`) in `nix develop .#hol_light`"
)


def compare_one(arch, func, backend, accept, accept_hashed):
    result = replay_paths(arch, func, backend)["result"]
    if not os.path.exists(result):
        raise Failed(
            f"no replay result; run `hol-trace replay --backend {backend} "
            f"--arch {arch} -p {func}`"
        )
    layers = layer_paths(arch)
    check_layers_fresh(layers)
    own = os.path.join(ACCEPTED, "proofs", arch, func)
    report = conform.conform(
        result,
        func,
        theorems(arch, func),
        layers,
        own + ".defs",
        own + ".thms",
        accept or accept_hashed,
        accept_hashed,
    )
    for line in report[1:]:
        print(f"  {func}: {line}", flush=True)
    return report[0]


# ----- layers
#
# accepted/base and accepted/spec hold every definition that a load step
# adds: HOL Light, then the s2n-bignum files that the proofs load (with
# the HOL Light libraries those load), then each mlkem-native file that
# the proofs load and that is not a proof. Each layer file records the
# pins or source it was generated from, so that conform can tell when
# it is stale.


# The upstream sources that the layers are generated from, as every HOL
# Light shell exports them (see flake.nix).
PIN_SOURCES = {"hol_light": "HOL_LIGHT_SRC", "s2n_bignum": "S2N_BIGNUM_SRC"}


def layer_pins():
    """The upstream commit of each pinned source: GitHub's archive URL
    .../archive/REV.tar.gz becomes .../commit/REV."""
    return {
        name: re.sub(r"/archive/([0-9a-f]+)\.tar\.gz$", r"/commit/\1", env(var))
        for name, var in PIN_SOURCES.items()
    }


def loads(path):
    """Files loaded by an OCaml file, in source order."""
    text = strip_comments(open(path).read())
    return re.findall(r'\b(?:needs|loadt|loads)\s+"([^"]+)"', text)


def layer_steps(arch):
    """The load steps for arch: [(layer file, header comment, OCaml
    lines, source file or None)], in the order the proofs load them."""
    proofs = [proof_ml(arch, f) for f in functions(arch)]
    s2n, support = [], []

    def visit(path):
        for target in loads(path):
            if target.startswith("s2n_bignum/") and target not in s2n:
                s2n.append(target)
            if target.startswith("mlkem_native/"):
                dep = os.path.join(PROOF_DIR, target[len("mlkem_native/") :])
                if dep not in support:
                    visit(dep)  # dependencies first
                    support.append(dep)

    for path in proofs:
        visit(path)
    support = [p for p in support if p not in proofs]

    base = os.path.join(ACCEPTED, "base")
    steps = [
        (
            os.path.join(base, "hol_light.defs"),
            "The axioms and definitions of HOL Light.",
            [],
            None,
        ),
        (
            os.path.join(base, f"s2n_bignum_{S2N_ARCH[arch]}.defs"),
            "Definitions added by loading "
            + ", ".join(s2n)
            + ", and the HOL Light libraries that these load.",
            [f'needs "{t}";;' for t in s2n],
            None,
        ),
    ]
    for path in support:
        sub = os.path.relpath(path, PROOF_DIR)  # common/x.ml or ARCH/proofs/x.ml
        name = os.path.basename(path)[:-3] + ".defs"
        d = "spec" if sub.startswith("common/") else os.path.join("spec", arch)
        steps.append(
            (
                os.path.join(ACCEPTED, d, name),
                f"Definitions added by loading {rel(path)}.",
                [f'needs "mlkem_native/{sub}";;'],
                path,
            )
        )
    return steps


# An outline wrapper replaces `prove` with one that asserts its goal with
# mk_thm, that is new_axiom, before it loads anything. Loading a file
# then makes its definitions but proves none of its theorems: writing a
# outline is cheap, and checks nothing. A definition does not depend on how its
# theorems were proved, except for the names that HOL Light takes from
# counters that proofs advance; the renderer hides those (see
# conform.Theory.temporaries and Renderer.number_generated). The result
# lists only the axioms from before the asserting `prove`, HOL Light's
# own, so conform can read it.
OUTLINE_START = """\
needs "mlkem_native/hol_trace/term_encoding.ml";;
let hol_trace_axioms = axioms ();;
let prove (tm, (_ : tactic)) = mk_thm ([], tm);;
"""
# Ends an outline wrapper: build-proof.sh appends check_axioms (), which the
# asserted theorems would fail.
OUTLINE_END = "exit 0;;\n"


def describe_steps(steps_of):
    """Print what the shared-file programs load, one per architecture,
    grouped by the accepted files that their definitions go to."""
    shared = "Specifications for both architectures -> accepted/spec/"
    groups = {}  # heading -> files, in load order within each group
    for arch, steps in steps_of.items():
        own = f"Specifications for {arch} -> accepted/spec/{arch}/"
        for k, (path, _, lines, source) in enumerate(steps):
            if k == 0:
                groups[f"HOL Light -> {conform.short(path)}"] = []
            elif k == 1:
                loaded = re.findall(r'"s2n_bignum/([^"]+)"', " ".join(lines))
                groups[f"s2n-bignum for {arch} -> {conform.short(path)}"] = loaded
            else:
                sub = os.path.relpath(source, PROOF_DIR)
                heading = shared if sub.startswith("common/") else own
                if sub not in groups.setdefault(heading, []):
                    groups[heading].append(sub)
    # HOL Light and s2n-bignum first, then the shared specifications.
    order = sorted(
        groups, key=lambda h: (not h.startswith(("HOL", "s2n")), h != shared)
    )
    print("extracting the outline of these files:", flush=True)
    for heading in order:
        print(f"  {heading}", flush=True)
        for f in groups[heading]:
            print(f"    + {f}", flush=True)


def dump_steps(arch, steps, work):
    """Run the load steps in one HOL Light process, as an outline; dump the
    kernel's theory after each step. Return the dump files."""
    wrapper = os.path.join(work, f"{arch}.ml")
    dumps = [os.path.join(work, f"{arch}-{k}.result") for k in range(len(steps))]
    with open(wrapper, "w") as f:
        f.write(OUTLINE_START)
        for (_, _, lines, _), dump in zip(steps, dumps):
            f.writelines(line + "\n" for line in lines)
            f.write(
                f'Hol_trace_term.write_theory ~axioms:hol_trace_axioms "{dump}" [];;\n'
            )
        f.write(OUTLINE_END)
    native = os.path.join(work, f"{arch}.native")
    hol = os.path.join(holtrace_hol("HOLTRACE_REPLAY_HOL"), "hol.sh")
    with open(os.path.join(work, f"{arch}.log"), "w") as log:
        rc, _, _ = run(
            [BUILD_PROOF, wrapper, hol, native],
            log,
            cwd=ROOT,
            env=fresh_imports(work),
        )
        if rc == 0:
            progress(f"loading the {arch} files, with proofs asserted")
            rc, _, _ = run([native], log, cwd=ROOT)
    if rc != 0:
        raise Failed(f"loading the {arch} layers failed; see {work}/{arch}.log")
    return dumps


def new_entries(dumps):
    """For each dump, the entries that it adds to the previous dumps, in
    kernel order, rendered as conform renders them."""
    results = [conform.read_result(d) for d in dumps]
    theory = conform.Theory(results[-1][1], results[-1][2])
    render = conform.Renderer(theory)
    seen, out = set(), []
    for axioms, definitions, typedefs, _ in results:
        entries = []
        for th in axioms:
            text = render.theorem(th)
            entries.append((conform.axiom_header(text), text))
        for th in reversed(definitions):  # the kernel lists newest first
            name = conform.dest_eq(th[1])[0][1]
            entries.append(
                (f"definition {theory.const_name(name)}", render.theorem(th))
            )
        for th in reversed(typedefs):  # newest first, too
            name = conform.dest_typedef(th)[0]
            text = render.theorem(th, theory.typedef_consts[name])
            entries.append((f"typedef {conform.qname(name)}", text))
        entries = [(h, conform.stored(t)) for h, t in entries if h not in seen]
        seen.update(h for h, _ in entries)
        out.append(entries)
    return out


def outline_shared(base, specs):
    """Regenerate accepted/base, accepted/spec or both."""
    pins = layer_pins()
    layers = {}  # file -> (comment, entries, source)
    work = tempfile.mkdtemp(prefix="hol-trace-layers-")
    # HOL Light and s2n-bignum, then, with specs, the specification files.
    steps_of = {a: layer_steps(a)[: None if specs else 2] for a in ARCHS}
    describe_steps(steps_of)
    for arch, steps in steps_of.items():
        dumps = dump_steps(arch, steps, work)
        progress(f"rendering the {arch} definitions")
        added = with_deep_stack(lambda: new_entries(dumps))
        for k, ((path, comment, _, source), entries) in enumerate(zip(steps, added)):
            # conform accepts axioms only from the HOL Light layer.
            if k and any(conform.is_axiom(h) for h, _ in entries):
                raise Failed(f"the step for {rel(path)} adds an axiom")
            layer = (comment, entries, source)
            if layers.setdefault(path, layer) != layer:
                diff = set(entries) ^ set(layers[path][1])
                raise Failed(
                    f"{rel(path)} differs between architectures: "
                    + "; ".join(sorted({h for h, _ in diff}))
                )
    shutil.rmtree(work, ignore_errors=True)

    dirs = [d for d, wanted in (("base", base), ("spec", specs)) if wanted]
    progress("writing " + " and ".join(f"accepted/{d}" for d in dirs))
    for d in dirs:
        shutil.rmtree(os.path.join(ACCEPTED, d), ignore_errors=True)
    for path, (comment, entries, source) in sorted(layers.items()):
        if os.path.relpath(path, ACCEPTED).split(os.sep)[0] not in dirs:
            continue
        header = conform.LICENSE_COMMENT
        header += f"# Generated by `hol-trace outline`; do not edit.\n# {comment}\n"
        header += conform.NOTATION_COMMENT
        header += "".join(f"# pin: {k} {v}\n" for k, v in pins.items())
        if source:
            header += f"# source: {rel(source)} {sha256(source)}\n"
        conform.write_entries(path, header, dict(entries), [h for h, _ in entries])
        print(f"  {conform.short(path)}: {len(entries)} entries", flush=True)
    return 0


def outline_log(arch, func):
    return os.path.join(TRACES, arch, func + ".outline.log")


def outline_one(arch, func, work, env_):
    """Load one proof as an outline and write its result file."""
    result = replay_paths(arch, func, "outline")["result"]
    if os.path.exists(result):
        os.remove(result)
    names = theorems(arch, func)
    tmp = os.path.join(work, arch, func)
    os.makedirs(tmp)
    wrapper = os.path.join(tmp, "outline.ml")
    named = "; ".join(f'("{n}", {n})' for n in names)
    with open(wrapper, "w") as f:
        f.write(OUTLINE_START)
        f.write(f'loadt "{proof_ml(arch, func)}";;\n')
        f.write(
            "Hol_trace_term.write_theory ~axioms:hol_trace_axioms "
            f'"{result}" [{named}];;\n'
        )
        f.write(OUTLINE_END)
    native = os.path.join(tmp, "outline.native")
    hol = os.path.join(holtrace_hol("HOLTRACE_REPLAY_HOL"), "hol.sh")
    os.makedirs(os.path.dirname(result), exist_ok=True)
    with open(outline_log(arch, func), "w") as log:
        rc, _, _ = run([BUILD_PROOF, wrapper, hol, native], log, cwd=ROOT, env=env_)
        if rc == 0:
            # The proofs name their object files relative to proofs/hol_light.
            rc, secs, rss = run([native], log, cwd=PROOF_DIR)
    if rc != 0 or not os.path.exists(result):
        raise Failed(f"outline failed, see {rel(outline_log(arch, func))}")
    return f"{secs:.0f} s, {rss / 2**20:.1f} GiB peak RSS"


def cmd_outline(arch, proofs, args):
    if proofs and (args.base or args.specs):
        die("--base and --specs write only shared files; they take no -p")
    if args.base or args.specs:
        outline_shared(args.base, args.specs)
        return 0
    if not proofs:
        outline_shared(True, True)
    selected = select(arch, proofs)
    build_objects(selected)
    jobs = min(args.jobs, len(selected))
    progress(
        f"writing outlines of {len(selected)} {arch} proofs, {jobs} at a "
        f"time; logs in traces/{arch}/FUNC.outline.log"
    )
    work = tempfile.mkdtemp(prefix="hol-trace-outline-")
    loaded = []

    def one(arch, func):
        info = outline_one(arch, func, work, env_)
        loaded.append((arch, func))
        return info

    try:
        env_ = fresh_imports(work)
        rc = run_all("outline", selected, args.jobs, one)
    finally:
        shutil.rmtree(work, ignore_errors=True)
    # Serial: like `compare --accept`. Keep the order of the selection.
    loaded = [p for p in selected if p in loaded]
    rc = (
        run_all(
            "outline compare",
            loaded,
            1,
            lambda a, f: with_deep_stack(
                lambda: compare_one(a, f, "outline", True, args.accept_hashed)
            ),
        )
        or rc
    )
    print(
        "\nWARNING: `hol-trace outline` writes the definitions and theorem "
        "statements\nthat the proofs claim, but checks none of the proofs. "
        "Review the changes\nto accepted/, then confirm them with "
        "`hol-trace gen` and `hol-trace check`."
    )
    return rc


def with_deep_stack(f):
    """Run f in a thread whose stack fits deeply nested kernel terms."""
    result = {}

    def target():
        try:
            result["value"] = f()
        except BaseException as e:  # re-raised below
            result["error"] = e

    sys.setrecursionlimit(1_000_000)
    threading.stack_size(1 << 30)
    t = threading.Thread(target=target)
    t.start()
    t.join()
    threading.stack_size(0)
    if "error" in result:
        raise result["error"]
    return result["value"]


def compare_in_child(arch, func, backend):
    """Compare one proof in a hol-trace process of its own, which has its
    own deep stack and conform's state to itself."""
    p = subprocess.run(
        [sys.executable, os.path.realpath(__file__), "compare"]
        + ["--backend", backend, "-p", f"{arch}/{func}"],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    # Pass on the report lines; take the result from the child's own
    # "[1/1] compare (BACKEND) FUNC: OK (...)" or "FAILED ...: REASON".
    outcome = None
    for line in p.stdout.splitlines():
        if line.startswith(f"  {func}: "):
            print(line, flush=True)
        m = re.match(rf"\[1/1\] compare \({re.escape(backend)}\) {func}: (.*)$", line)
        if m:
            outcome = m.group(1)
    if p.returncode != 0 or outcome is None or not outcome.startswith("OK ("):
        reason = outcome.split(": ", 1)[-1] if outcome else p.stdout.strip()[-500:]
        raise Failed(reason or "comparison failed")
    return outcome[len("OK (") : -1]


def cmd_compare(selected, args):
    if args.accept or args.accept_hashed or args.jobs == 1 or len(selected) == 1:
        # In this process; serially, since --accept rewrites the shared
        # accepted files.
        return run_all(
            f"compare ({args.backend})",
            selected,
            1,
            lambda a, f: with_deep_stack(
                lambda: compare_one(a, f, args.backend, args.accept, args.accept_hashed)
            ),
        )
    return run_all(
        f"compare ({args.backend})",
        selected,
        args.jobs,
        lambda a, f: compare_in_child(a, f, args.backend),
    )


def cmd_check(selected, args):
    rc = cmd_replay(selected, args)
    return cmd_compare(selected, args) or rc


# ----- driver


def run_all(what, selected, jobs, one):
    n, failed = len(selected), []

    def task(i, arch, func):
        name = func
        print(f"[{i}/{n}] {what} {name} ...", flush=True)
        start = time.time()
        try:
            info = one(arch, func)
            print(f"[{i}/{n}] {what} {name}: OK ({info})", flush=True)
        except Exception as e:
            dur = time.time() - start
            reason = str(e) or type(e).__name__
            print(
                f"[{i}/{n}] {what} {name}: FAILED after {dur:.0f} s: {reason}",
                flush=True,
            )
            failed.append(name)

    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
        list(pool.map(lambda x: task(x[0] + 1, *x[1]), enumerate(selected)))
    if failed:
        print(f"{what}: {len(failed)} of {n} failed: {' '.join(failed)}")
        return 1
    print(f"{what}: all {n} OK")
    return 0


def select(arch, proofs):
    """(arch, func) for the named proofs, as FUNC of arch or as ARCH/FUNC,
    or for all proofs of arch."""
    if not proofs:
        return [(arch, f) for f in functions(arch)]
    selected = []
    for name in proofs:
        a, _, func = name.rpartition("/")
        a = a or arch
        if a not in ARCHS:
            die(f"unknown architecture {a} in {name}")
        if func not in functions(a):
            other = [b for b in ARCHS if b != a and func in functions(b)]
            hint = f"; use {other[0]}/{func}" if other else ""
            die(f"unknown {a} function {func}{hint}; see `hol-trace list`")
        if (a, func) not in selected:
            selected.append((a, func))
    return selected


def main():
    parser = argparse.ArgumentParser(
        prog="hol-trace",
        description="Record HOLTrace traces of the HOL Light proofs (gen), "
        "replay them with a separate kernel (replay), and check the "
        "replayed theories against the accepted definitions and statements "
        "(compare). `check` is replay followed by compare.",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)
    arch = argparse.ArgumentParser(add_help=False)
    arch.add_argument(
        "-a",
        "--arch",
        choices=ARCHS,
        help="architecture whose proofs to process (default: the host's)",
    )
    common = argparse.ArgumentParser(add_help=False, parents=[arch])
    common.add_argument(
        "-p",
        "--proof",
        nargs="+",
        action="append",
        metavar="FUNC",
        help="functions to process, e.g. mlkem_ntt_aarch64_asm, or "
        "x86_64/mlkem_ntt_avx2_asm for one of another architecture than "
        "--arch (default: all functions of the architecture)",
    )
    common.add_argument(
        "-j",
        "--jobs",
        type=positive_int,
        help="functions to process in parallel (default 1, for outline half "
        "the CPUs up to 16; memory is the limit)",
    )
    backend = argparse.ArgumentParser(add_help=False)
    backend.add_argument(
        "--backend",
        choices=list(BACKENDS),
        default="hol-light",
        help="replay backend (default: hol-light)",
    )
    accept = argparse.ArgumentParser(add_help=False)
    accept.add_argument(
        "--accept",
        action="store_true",
        help="add new and changed definitions and statements to "
        "accepted/proofs/ARCH/FUNC.{defs,thms} instead of failing",
    )
    accept.add_argument(
        "--accept-hashed",
        action="store_true",
        help="like --accept, and also accept entries too large to show, "
        "which are stored as hashes",
    )
    gen = sub.add_parser("gen", parents=[common], help="record traces")
    prune = gen.add_mutually_exclusive_group()
    prune.add_argument(
        "--prune",
        dest="prune",
        action="store_true",
        default=True,
        help="keep only what the proof's theorems need (default)",
    )
    prune.add_argument(
        "--no-prune",
        dest="prune",
        action="store_false",
        help="keep the complete trace",
    )
    sub.add_parser("replay", parents=[common, backend], help="replay traces")
    sub.add_parser(
        "compare",
        parents=[common, backend, accept],
        help="check replay results against the accepted files",
    )
    sub.add_parser(
        "check", parents=[common, backend, accept], help="replay, then compare"
    )
    outline = sub.add_parser(
        "outline",
        parents=[common],
        help="write the accepted files without traces: accepted/base and "
        "accepted/spec for both architectures, then the files in "
        "accepted/proofs/ARCH with the proofs' theorems asserted, not "
        "proved (with -p, only those proofs' files)",
    )
    outline.add_argument(
        "--base",
        action="store_true",
        help="write only accepted/base, for both architectures, from the "
        "pinned HOL Light and s2n-bignum",
    )
    outline.add_argument(
        "--specs",
        action="store_true",
        help="write only accepted/spec, for both architectures, from the "
        "specification files (with --base, both)",
    )
    outline.add_argument(
        "--accept-hashed",
        action="store_true",
        help="also accept entries too large to show, which are stored as hashes",
    )
    sub.add_parser("list", parents=[arch], help="list functions")
    args = parser.parse_args()

    if getattr(args, "jobs", 0) is None:
        # An outline needs at most 0.4 GiB per proof; gen and replay far more.
        cpus = os.cpu_count() or 1
        args.jobs = max(1, min(16, cpus // 2)) if args.cmd == "outline" else 1
    arch = args.arch or native_arch()
    if args.cmd == "list":
        for _, func in select(arch, None):
            print(func)
        return 0
    proofs = [name for group in (args.proof or []) for name in group]
    if args.cmd == "outline":
        return cmd_outline(arch, proofs, args)
    selected = select(arch, proofs)
    return {
        "gen": cmd_gen,
        "replay": cmd_replay,
        "compare": cmd_compare,
        "check": cmd_check,
    }[args.cmd](selected, args)


if __name__ == "__main__":
    if sys.version_info < (3, 8):
        die("Python 3.8 or newer is required")
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        die("interrupted")
    except Exception as e:
        die(str(e) or type(e).__name__)
