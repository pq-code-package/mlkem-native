BUILD_PROOF = os.path.join(PROOF_DIR, "aarch64", "proofs", "build-proof.sh")

sys.path.insert(0, HERE)
# Proof code run by `gen` can write untracked files in the checkout, such
# as a __pycache__ entry for conform.py. Read and write bytecode elsewhere.
_pycache = tempfile.TemporaryDirectory(prefix="hol-trace-pycache-")
