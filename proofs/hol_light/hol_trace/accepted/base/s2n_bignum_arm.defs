definition arm_USHR_VEC
  |- (arm_USHR_VEC : ('?1, int128) component -> ('?1, int128) component -> num -> num -> num ->
         '?1 -> '?1 -> bool)
     = (specification "arm_USHR_VEC" arm_USHR_VEC:(('?1, int128) component ->
           ('?1, int128) component -> num -> num -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) amt:num esize:num datasize:num.
           arm_USHR_VEC Rd Rn amt esize datasize
           = (\s:'?1.
               let n:int128 = read Rn s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (usimd2 (\x:int64. word_ushr x amt) n)
                       (COND (esize = 32) (usimd4 (\x:int32. word_ushr x amt) n)
                         (COND (esize = 16) (usimd8 (\x:int16. word_ushr x amt) n)
                           (usimd16 (\x:byte. word_ushr x amt) n))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (usimd2 (\x:int32. word_ushr x amt) n)
                       (COND (esize = 16) (usimd4 (\x:int16. word_ushr x amt) n)
                         (usimd8 (\x:byte. word_ushr x amt) n)) in
                 := Rd (word_zx d : int128) s)))

definition word_ushl
  |- (word_ushl : 'N word -> 'N word -> 'N word)
     = (\_1:('N word) _2:('N word).
         let amt:byte = (word_subword _2 (0, 8) : byte) in
         COND (~ (bit 7 amt)) (word_shl _1 (val amt)) (word_ushr _1 (val (word_neg amt))))

definition arm_USHL_VEC
  |- arm_USHL_VEC
     = (specification "arm_USHL_VEC" arm_USHL_VEC:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> num -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) esize:num datasize:num.
           arm_USHL_VEC Rd Rn Rm esize datasize
           = (\s:armstate.
               let n:int128 = read Rn s
               and m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (simd2 (word_ushl : int64 -> int64 -> int64) n m)
                       (COND (esize = 32) (simd4 (word_ushl : int32 -> int32 -> int32) n m)
                         (COND (esize = 16) (simd8 (word_ushl : int16 -> int16 -> int16) n m)
                           (simd16 (word_ushl : byte -> byte -> byte) n m))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let m:int64 = (word_subword m (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (simd2 (word_ushl : int32 -> int32 -> int32) n m)
                       (COND (esize = 16) (simd4 (word_ushl : int16 -> int16 -> int16) n m)
                         (simd8 (word_ushl : byte -> byte -> byte) n m)) in
                 := Rd (word_zx d : int128) s)))

definition arm_USRA_VEC
  |- (arm_USRA_VEC : ('?1, int128) component -> ('?1, int128) component -> num -> num -> num ->
         '?1 -> '?1 -> bool)
     = (specification "arm_USRA_VEC" arm_USRA_VEC:(('?1, int128) component ->
           ('?1, int128) component -> num -> num -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) shift:num esize:num
          datasize:num.
           arm_USRA_VEC Rd Rn shift esize datasize
           = (\s:'?1.
               let n:int128 = read Rn s in
               let n:int128 =
                   COND (esize = 64) (usimd2 (\x:int64. word_ushr x shift) n)
                     (COND (esize = 32) (usimd4 (\x:int32. word_ushr x shift) n)
                       (COND (esize = 16) (usimd8 (\x:int16. word_ushr x shift) n)
                         (usimd16 (\x:byte. word_ushr x shift) n))) in
               let d:int128 = read Rd s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (simd2 (word_add : int64 -> int64 -> int64) d n)
                       (COND (esize = 32) (simd4 (word_add : int32 -> int32 -> int32) d n)
                         (COND (esize = 16) (simd8 (word_add : int16 -> int16 -> int16) d n)
                           (simd16 (word_add : byte -> byte -> byte) d n))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let d:int64 = (word_subword d (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (simd2 (word_add : int32 -> int32 -> int32) d n)
                       (COND (esize = 16) (simd4 (word_add : int16 -> int16 -> int16) d n)
                         (simd8 (word_add : byte -> byte -> byte) d n)) in
                 := Rd (word_zx d : int128) s)))

definition arm_UZP1
  |- arm_UZP1
     = (specification "arm_UZP1" arm_UZP1:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) esize:num.
           arm_UZP1 Rd Rn Rm esize
           = (\s:armstate.
               let n:int128 = read Rn s in
               let m:int128 = read Rm s in
               COND (esize = 64)
                 (let neven:int64 = (word_subword n (0, 64) : int64) in
                 let meven:int64 = (word_subword m (0, 64) : int64) in
                 := Rd (word_join meven neven : int128) s)
                 (COND (esize = 32)
                   (let neven:int64 = usimd2 (\x:int64. (word_subword x (0, 32) : int32)) n in
                   let meven:int64 = usimd2 (\x:int64. (word_subword x (0, 32) : int32)) m in
                   := Rd (word_join meven neven : int128) s)
                   (COND (esize = 16)
                     (let neven:int64 = usimd4 (\x:int32. (word_subword x (0, 16) : int16)) n in
                     let meven:int64 = usimd4 (\x:int32. (word_subword x (0, 16) : int16)) m in
                     := Rd (word_join meven neven : int128) s)
                     (let neven:int64 = usimd8 (\x:int16. (word_subword x (0, 8) : byte)) n in
                     let meven:int64 = usimd8 (\x:int16. (word_subword x (0, 8) : byte)) m in
                     := Rd (word_join meven neven : int128) s)))))

definition arm_UZP2
  |- arm_UZP2
     = (specification "arm_UZP2" arm_UZP2:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
