definition arm_RSHRN
  |- (arm_RSHRN : (armstate, '?1 word) component -> (armstate, int128) component -> num -> num ->
         armstate -> armstate -> bool)
     = (specification "arm_RSHRN" arm_RSHRN:((armstate, '?1 word) component ->
           (armstate, int128) component -> num -> num -> armstate -> armstate -> bool).
