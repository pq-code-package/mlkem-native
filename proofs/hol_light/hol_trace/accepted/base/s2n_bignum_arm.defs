definition _<Condition>
  |- _<Condition>
     = (\a:(4 word).
         _mk_condition ((\a:(4 word). CONSTR 0 a (\n:num. (BOTTOM : (4 word) recspace))) a))

definition Condition
  |- Condition = _<Condition>

definition Condition_EQ
  |- Condition_EQ
     = (specification "Condition_EQ" Condition_EQ:condition.
         Condition_EQ = Condition (word 0 : 4 word))

definition Condition_NE
  |- Condition_NE
     = (specification "Condition_NE" Condition_NE:condition.
         Condition_NE = Condition (word 1 : 4 word))

definition Condition_CS
  |- Condition_CS
     = (specification "Condition_CS" Condition_CS:condition.
         Condition_CS = Condition (word 2 : 4 word))

definition Condition_HS
  |- Condition_HS
     = (specification "Condition_HS" Condition_HS:condition.
         Condition_HS = Condition (word 2 : 4 word))

definition Condition_CC
  |- Condition_CC
     = (specification "Condition_CC" Condition_CC:condition.
         Condition_CC = Condition (word 3 : 4 word))

definition Condition_LO
  |- Condition_LO
     = (specification "Condition_LO" Condition_LO:condition.
         Condition_LO = Condition (word 3 : 4 word))

definition Condition_MI
  |- Condition_MI
     = (specification "Condition_MI" Condition_MI:condition.
         Condition_MI = Condition (word 4 : 4 word))

definition Condition_PL
  |- Condition_PL
     = (specification "Condition_PL" Condition_PL:condition.
         Condition_PL = Condition (word 5 : 4 word))

definition Condition_VS
  |- Condition_VS
     = (specification "Condition_VS" Condition_VS:condition.
         Condition_VS = Condition (word 6 : 4 word))

definition Condition_VC
  |- Condition_VC
     = (specification "Condition_VC" Condition_VC:condition.
         Condition_VC = Condition (word 7 : 4 word))

definition Condition_HI
  |- Condition_HI
     = (specification "Condition_HI" Condition_HI:condition.
         Condition_HI = Condition (word 8 : 4 word))

definition Condition_LS
  |- Condition_LS
     = (specification "Condition_LS" Condition_LS:condition.
         Condition_LS = Condition (word 9 : 4 word))

definition Condition_GE
  |- Condition_GE
     = (specification "Condition_GE" Condition_GE:condition.
         Condition_GE = Condition (word 10 : 4 word))

definition Condition_LT
  |- Condition_LT
     = (specification "Condition_LT" Condition_LT:condition.
         Condition_LT = Condition (word 11 : 4 word))

definition Condition_GT
  |- Condition_GT
     = (specification "Condition_GT" Condition_GT:condition.
         Condition_GT = Condition (word 12 : 4 word))

definition Condition_LE
  |- Condition_LE
     = (specification "Condition_LE" Condition_LE:condition.
         Condition_LE = Condition (word 13 : 4 word))

definition Condition_AL
  |- Condition_AL
     = (specification "Condition_AL" Condition_AL:condition.
         Condition_AL = Condition (word 14 : 4 word))

definition Condition_NV
  |- Condition_NV
     = (specification "Condition_NV" Condition_NV:condition.
         Condition_NV = Condition (word 15 : 4 word))

definition condition_semantics
  |- condition_semantics
     = (specification "condition_semantics" f:(condition -> armstate -> bool).
         (!s:armstate. f Condition_EQ s = read ZF s)
         /\ (!s:armstate. f Condition_NE s = ~ (read ZF s))
         /\ (!s:armstate. f Condition_CS s = read CF s)
         /\ (!s:armstate. f Condition_HS s = read CF s)
         /\ (!s:armstate. f Condition_CC s = ~ (read CF s))
         /\ (!s:armstate. f Condition_LO s = ~ (read CF s))
         /\ (!s:armstate. f Condition_MI s = read NF s)
         /\ (!s:armstate. f Condition_PL s = ~ (read NF s))
         /\ (!s:armstate. f Condition_VS s = read VF s)
         /\ (!s:armstate. f Condition_VC s = ~ (read VF s))
         /\ (!s:armstate. f Condition_HI s = (read CF s /\ ~ (read ZF s)))
         /\ (!s:armstate. f Condition_LS s = ~ (read CF s /\ ~ (read ZF s)))
         /\ (!s:armstate. f Condition_GE s = (read NF s = read VF s))
         /\ (!s:armstate. f Condition_LT s = ~ (read NF s = read VF s))
         /\ (!s:armstate. f Condition_GT s = (~ (read ZF s) /\ read NF s = read VF s))
         /\ (!s:armstate. f Condition_LE s = ~ (~ (read ZF s) /\ read NF s = read VF s))
         /\ (!s:armstate. f Condition_AL s = T)
         /\ (!s:armstate. f Condition_NV s = T))

definition invert_condition
  |- invert_condition
     = (specification "invert_condition" f:(condition -> condition).
         f Condition_EQ = Condition_NE
         /\ f Condition_NE = Condition_EQ
         /\ f Condition_CS = Condition_CC
         /\ f Condition_HS = Condition_LO
         /\ f Condition_CC = Condition_CS
         /\ f Condition_LO = Condition_HS
         /\ f Condition_MI = Condition_PL
         /\ f Condition_PL = Condition_MI
         /\ f Condition_VS = Condition_VC
         /\ f Condition_VC = Condition_VS
         /\ f Condition_HI = Condition_LS
         /\ f Condition_LS = Condition_HI
         /\ f Condition_GE = Condition_LT
         /\ f Condition_LT = Condition_GE
         /\ f Condition_GT = Condition_LE
         /\ f Condition_LE = Condition_GT
         /\ f Condition_AL = Condition_NV
         /\ f Condition_NV = Condition_AL)

definition _<Register_Offset>
  |- _<Register_Offset>
     = (\a:((armstate, int64) component).
         _mk_offset ((\a:((armstate, int64) component).
           CONSTR 0 (a, (@v:num. T), (@v:int64. T))
             (\n:num. (BOTTOM : ((armstate, int64) component # num # int64) recspace))) a))

definition _<Shiftreg_Offset>
  |- _<Shiftreg_Offset>
     = (\a0:((armstate, int64) component) a1:num.
         _mk_offset ((\a0:((armstate, int64) component) a1:num.
           CONSTR (SUC 0) (a0, a1, (@v:int64. T)) (\n:num.
             (BOTTOM : ((armstate, int64) component # num # int64) recspace))) a0 a1))

definition _<Postreg_Offset>
  |- _<Postreg_Offset>
     = (\a:((armstate, int64) component).
         _mk_offset ((\a:((armstate, int64) component).
           CONSTR (SUC (SUC 0)) (a, (@v:num. T), (@v:int64. T))
             (\n:num. (BOTTOM : ((armstate, int64) component # num # int64) recspace))) a))

definition _<Immediate_Offset>
  |- _<Immediate_Offset>
     = (\a:int64.
         _mk_offset ((\a:int64.
           CONSTR (SUC (SUC (SUC 0))) ((@v:((armstate, int64) component). T), (@v:num. T), a)
             (\n:num. (BOTTOM : ((armstate, int64) component # num # int64) recspace))) a))

definition _<Preimmediate_Offset>
  |- _<Preimmediate_Offset>
     = (\a:int64.
         _mk_offset ((\a:int64.
           CONSTR (SUC (SUC (SUC (SUC 0)))) ((@v:((armstate, int64) component). T), (@v:num. T), a)
             (\n:num. (BOTTOM : ((armstate, int64) component # num # int64) recspace))) a))

definition _<Postimmediate_Offset>
  |- _<Postimmediate_Offset>
     = (\a:int64.
         _mk_offset ((\a:int64.
           CONSTR (SUC (SUC (SUC (SUC (SUC 0)))))
             ((@v:((armstate, int64) component). T), (@v:num. T), a)
             (\n:num. (BOTTOM : ((armstate, int64) component # num # int64) recspace))) a))

definition Register_Offset
  |- Register_Offset = _<Register_Offset>

definition Shiftreg_Offset
  |- Shiftreg_Offset = _<Shiftreg_Offset>

definition Postreg_Offset
  |- Postreg_Offset = _<Postreg_Offset>

definition Immediate_Offset
  |- Immediate_Offset = _<Immediate_Offset>

definition Preimmediate_Offset
  |- Preimmediate_Offset = _<Preimmediate_Offset>

definition Postimmediate_Offset
  |- Postimmediate_Offset = _<Postimmediate_Offset>

definition No_Offset
  |- No_Offset
     = (specification "No_Offset" No_Offset:offset. No_Offset = Immediate_Offset (word 0 : int64))

definition offset_address
  |- offset_address
     = (specification "offset_address" offset_address:(offset -> armstate -> int64).
         (!r:((armstate, int64) component) s:armstate.
           offset_address (Register_Offset r) s = read r s)
         /\ (!r:((armstate, int64) component) k:num s:armstate.
              offset_address (Shiftreg_Offset r k) s = word_shl (read r s) k)
         /\ (!r:((armstate, int64) component) s:armstate.
              offset_address (Postreg_Offset r) s = (word 0 : int64))
         /\ (!w:int64 s:armstate. offset_address (Immediate_Offset w) s = w)
         /\ (!w:int64 s:armstate. offset_address (Preimmediate_Offset w) s = w)
         /\ (!w:int64 s:armstate. offset_address (Postimmediate_Offset w) s = (word 0 : int64)))

definition offset_writeback
  |- offset_writeback
     = (specification "offset_writeback" offset_writeback:(offset -> armstate -> int64).
         (!r:((armstate, int64) component) s:armstate.
           offset_writeback (Register_Offset r) s = (word 0 : int64))
         /\ (!r:((armstate, int64) component) k:num s:armstate.
              offset_writeback (Shiftreg_Offset r k) s = (word 0 : int64))
         /\ (!r:((armstate, int64) component) s:armstate.
              offset_writeback (Postreg_Offset r) s = read r s)
         /\ (!w:int64 s:armstate. offset_writeback (Immediate_Offset w) s = (word 0 : int64))
         /\ (!w:int64 s:armstate. offset_writeback (Preimmediate_Offset w) s = w)
         /\ (!w:int64 s:armstate. offset_writeback (Postimmediate_Offset w) s = w))

definition offset_writesback
  |- offset_writesback
     = (specification "offset_writesback" offset_writesback:(offset -> bool).
         (!r:((armstate, int64) component). offset_writesback (Register_Offset r) = F)
         /\ (!r:((armstate, int64) component) k:num. offset_writesback (Shiftreg_Offset r k) = F)
         /\ (!r:((armstate, int64) component). offset_writesback (Postreg_Offset r) = T)
         /\ (!w:int64. offset_writesback (Immediate_Offset w) = F)
         /\ (!w:int64. offset_writesback (Preimmediate_Offset w) = T)
         /\ (!w:int64. offset_writesback (Postimmediate_Offset w) = T))

definition SOME_FLAGS
  |- SOME_FLAGS = [NF; ZF; CF; VF]

definition C_ARGUMENTS
  |- C_ARGUMENTS
     = (specification "C_ARGUMENTS" C_ARGUMENTS:(int64 list -> armstate -> bool).
         (!a0:int64 a1:int64 a2:int64 a3:int64 a4:int64 a5:int64 a6:int64 a7:int64 s:armstate.
           C_ARGUMENTS [a0; a1; a2; a3; a4; a5; a6; a7] s
           = (read X0 s = a0
             /\ read X1 s = a1
             /\ read X2 s = a2
             /\ read X3 s = a3
             /\ read X4 s = a4
             /\ read X5 s = a5
             /\ read X6 s = a6
             /\ read X7 s = a7))
         /\ (!a0:int64 a1:int64 a2:int64 a3:int64 a4:int64 a5:int64 a6:int64 s:armstate.
              C_ARGUMENTS [a0; a1; a2; a3; a4; a5; a6] s
              = (read X0 s = a0
                /\ read X1 s = a1
                /\ read X2 s = a2
                /\ read X3 s = a3
                /\ read X4 s = a4
                /\ read X5 s = a5
                /\ read X6 s = a6))
         /\ (!a0:int64 a1:int64 a2:int64 a3:int64 a4:int64 a5:int64 s:armstate.
              C_ARGUMENTS [a0; a1; a2; a3; a4; a5] s
              = (read X0 s = a0
                /\ read X1 s = a1
                /\ read X2 s = a2
                /\ read X3 s = a3
                /\ read X4 s = a4
                /\ read X5 s = a5))
         /\ (!a0:int64 a1:int64 a2:int64 a3:int64 a4:int64 s:armstate.
              C_ARGUMENTS [a0; a1; a2; a3; a4] s
              = (read X0 s = a0
                /\ read X1 s = a1
                /\ read X2 s = a2
                /\ read X3 s = a3
                /\ read X4 s = a4))
         /\ (!a0:int64 a1:int64 a2:int64 a3:int64 s:armstate.
              C_ARGUMENTS [a0; a1; a2; a3] s
              = (read X0 s = a0 /\ read X1 s = a1 /\ read X2 s = a2 /\ read X3 s = a3))
         /\ (!a0:int64 a1:int64 a2:int64 s:armstate.
              C_ARGUMENTS [a0; a1; a2] s = (read X0 s = a0 /\ read X1 s = a1 /\ read X2 s = a2))
         /\ (!a0:int64 a1:int64 s:armstate.
              C_ARGUMENTS [a0; a1] s = (read X0 s = a0 /\ read X1 s = a1))
         /\ (!a0:int64 s:armstate. C_ARGUMENTS [a0] s = (read X0 s = a0))
         /\ (!s:armstate. C_ARGUMENTS (NIL : int64 list) s = T))

definition C_RETURN
  |- C_RETURN = (specification "C_RETURN" C_RETURN:(armstate -> int64). C_RETURN = read X0)

definition PRESERVED_GPRS
  |- PRESERVED_GPRS
     = (specification "PRESERVED_GPRS" PRESERVED_GPRS:(((armstate, int64) component) list).
         PRESERVED_GPRS = [X18; X19; X20; X21; X22; X23; X24; X25; X26; X27; X28; X29; X30; SP])

definition MODIFIABLE_GPRS
  |- MODIFIABLE_GPRS
     = (specification "MODIFIABLE_GPRS" MODIFIABLE_GPRS:(((armstate, int64) component) list).
         MODIFIABLE_GPRS
         = [X0; X1; X2; X3; X4; X5; X6; X7; X8; X9; X10; X11; X12; X13; X14; X15; X16; X17])

definition MODIFIABLE_SIMD_REGS
  |- MODIFIABLE_SIMD_REGS
     = (specification "MODIFIABLE_SIMD_REGS" MODIFIABLE_SIMD_REGS:(((armstate, int128) component)
         list).
         MODIFIABLE_SIMD_REGS
         = [Q0; Q1; Q2; Q3; Q4; Q5; Q6; Q7; Q16; Q17; Q18; Q19; Q20; Q21; Q22; Q23; Q24; Q25; Q26;
            Q27; Q28; Q29; Q30; Q31])

definition MODIFIABLE_UPPER_SIMD_REGS
  |- MODIFIABLE_UPPER_SIMD_REGS
     = (specification "MODIFIABLE_UPPER_SIMD_REGS" MODIFIABLE_UPPER_SIMD_REGS:(((armstate, int64)
         component) list).
         MODIFIABLE_UPPER_SIMD_REGS
         = [Q8 :> (tophalf : (int128, int64) component);
            Q9 :> (tophalf : (int128, int64) component);
            Q10 :> (tophalf : (int128, int64) component);
            Q11 :> (tophalf : (int128, int64) component);
            Q12 :> (tophalf : (int128, int64) component);
            Q13 :> (tophalf : (int128, int64) component);
            Q14 :> (tophalf : (int128, int64) component);
            Q15 :> (tophalf : (int128, int64) component)])

definition MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
  |- MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
     = MAYCHANGE [PC]
       ,, MAYCHANGE MODIFIABLE_GPRS
       ,, MAYCHANGE MODIFIABLE_SIMD_REGS
       ,, MAYCHANGE MODIFIABLE_UPPER_SIMD_REGS
       ,, MAYCHANGE SOME_FLAGS
       ,, MAYCHANGE [events]

definition masking
  |- (masking : ('N word -> 'N word -> bool) -> 'N word -> 'N word -> 'N word)
     = (\_1:('N word -> 'N word -> bool) _2:('N word) _3:('N word).
         word_neg (word (bitval (_1 _2 _3)) : 'N word))

definition arm_ADC
  |- (arm_ADC : (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, 'N word) component -> armstate -> armstate -> bool)
     = (specification "arm_ADC" arm_ADC:((armstate, 'N word) component ->
           (armstate, 'N word) component -> (armstate, 'N word) component -> armstate -> armstate ->
           bool).
         !Rd:((armstate, 'N word) component) Rm:((armstate, 'N word) component)
          Rn:((armstate, 'N word) component).
           arm_ADC Rd Rm Rn
           = (\s:armstate.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s
               and c:num = bitval (read CF s) in
               let d:('N word) = word_add (word_add m n) (word c : 'N word) in := Rd d s))

definition arm_ADCS
  |- (arm_ADCS : (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, 'N word) component -> armstate -> armstate -> bool)
     = (specification "arm_ADCS" arm_ADCS:((armstate, 'N word) component ->
           (armstate, 'N word) component -> (armstate, 'N word) component -> armstate -> armstate ->
           bool).
         !Rd:((armstate, 'N word) component) Rm:((armstate, 'N word) component)
          Rn:((armstate, 'N word) component).
           arm_ADCS Rd Rm Rn
           = (\s:armstate.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s
               and c:num = bitval (read CF s) in
               let d:('N word) = word_add (word_add m n) (word c : 'N word) in
               (,,) (:= Rd d)
                 (:= NF (ival d < &0)
                 ,, := ZF (val d = 0)
                 ,, := CF (~ (val m + val n + c = val d))
                 ,, := VF (~ (ival m + ival n + int_of_num c = ival d)))
                 s))

definition arm_ADD
  |- (arm_ADD : ('?1, 'N word) component -> ('?1, 'N word) component -> ('?1, 'N word) component ->
         '?1 -> '?1 -> bool)
     = (specification "arm_ADD" arm_ADD:(('?1, 'N word) component -> ('?1, 'N word) component ->
           ('?1, 'N word) component -> '?1 -> '?1 -> bool).
         !Rd:(('?1, 'N word) component) Rm:(('?1, 'N word) component) Rn:(('?1, 'N word) component).
           arm_ADD Rd Rm Rn
           = (\s:'?1.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s in
               let d:('N word) = word_add m n in := Rd d s))

definition arm_ADD_VEC
  |- (arm_ADD_VEC : ('?1, int128) component -> ('?1, int128) component -> ('?1, int128) component ->
         num -> num -> '?1 -> '?1 -> bool)
     = (specification "arm_ADD_VEC" arm_ADD_VEC:(('?1, int128) component ->
           ('?1, int128) component -> ('?1, int128) component -> num -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) Rm:(('?1, int128) component)
          esize:num datasize:num.
           arm_ADD_VEC Rd Rn Rm esize datasize
           = (\s:'?1.
               let n:int128 = read Rn s in
               let m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (simd2 (word_add : int64 -> int64 -> int64) n m)
                       (COND (esize = 32) (simd4 (word_add : int32 -> int32 -> int32) n m)
                         (COND (esize = 16) (simd8 (word_add : int16 -> int16 -> int16) n m)
                           (simd16 (word_add : byte -> byte -> byte) n m))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let m:int64 = (word_subword m (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (simd2 (word_add : int32 -> int32 -> int32) n m)
                       (COND (esize = 16) (simd4 (word_add : int16 -> int16 -> int16) n m)
                         (simd8 (word_add : byte -> byte -> byte) n m)) in
                 := Rd (word_zx d : int128) s)))

definition arm_ABS_VEC
  |- (arm_ABS_VEC : (armstate, int128) component ->
         (armstate, (((('?1 tybit0) tybit0) tybit0) tybit0) word) component -> num -> num ->
         armstate -> armstate -> bool)
     = (specification "arm_ABS_VEC" arm_ABS_VEC:((armstate, int128) component ->
           (armstate, (((('?1 tybit0) tybit0) tybit0) tybit0) word) component -> num -> num ->
           armstate -> armstate -> bool).
         !Rd:((armstate, int128) component)
          Rn:((armstate, (((('?1 tybit0) tybit0) tybit0) tybit0) word) component) esize:num
          datasize:num.
           arm_ABS_VEC Rd Rn esize datasize
           = (\s:armstate.
               let n:((((('?1 tybit0) tybit0) tybit0) tybit0) word) = read Rn s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64)
                       (usimd2
                         (\x:(((('?1 tybit0) tybit0) tybit0) word). (iword (abs (ival x)) : int64))
                         n)
                       (COND (esize = 32)
                         (usimd4 (\x:((('?1 tybit0) tybit0) word). (iword (abs (ival x)) : int32))
                           n)
                         (COND (esize = 16)
                           (usimd8 (\x:(('?1 tybit0) word). (iword (abs (ival x)) : int16)) n)
                           (usimd16 (\x:('?1 word). (iword (abs (ival x)) : byte)) n))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (usimd2 (\x:int32. (iword (abs (ival x)) : int32)) n)
                       (COND (esize = 16) (usimd4 (\x:int16. (iword (abs (ival x)) : int16)) n)
                         (usimd8 (\x:byte. (iword (abs (ival x)) : byte)) n)) in
                 := Rd (word_zx d : int128) s)))

definition arm_ADDS
  |- (arm_ADDS : (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, 'N word) component -> armstate -> armstate -> bool)
     = (specification "arm_ADDS" arm_ADDS:((armstate, 'N word) component ->
           (armstate, 'N word) component -> (armstate, 'N word) component -> armstate -> armstate ->
           bool).
         !Rd:((armstate, 'N word) component) Rm:((armstate, 'N word) component)
          Rn:((armstate, 'N word) component).
           arm_ADDS Rd Rm Rn
           = (\s:armstate.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s in
               let d:('N word) = word_add m n in
               (,,) (:= Rd d)
                 (:= NF (ival d < &0)
                 ,, := ZF (val d = 0)
                 ,, := CF (~ (val m + val n = val d))
                 ,, := VF (~ (ival m + ival n = ival d)))
                 s))

definition arm_ADR
  |- arm_ADR
     = (specification "arm_ADR" arm_ADR:((armstate, int64) component -> 21 word -> armstate ->
           armstate -> bool).
