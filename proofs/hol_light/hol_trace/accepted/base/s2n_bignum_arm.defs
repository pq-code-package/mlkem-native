           = (\s:'?1.
               let m:int128 = read Rm s
               and n:int128 = read Rn s
               and d:int128 = read Rd s in
               let out:int128 = word_or (word_and d (word_not m)) (word_and n m) in
               COND (datasize = 128) (:= Rd out s) (let out':int64 =
                   (word_subword out (0, 64) : int64) in
               := Rd (word_zx out' : int128) s)))

