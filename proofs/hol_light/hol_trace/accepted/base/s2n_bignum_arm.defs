                 _UNGUARDED_PATTERN (pat_set (CONSPAT NILPAT (word 3 : 2 word)) "BM%PVAR%12")
                   (SOME (arm_MOVK _2 _3 _4) = "BM%PVAR%13"))
               (_ELSEPATTERN (NONE : (armstate -> armstate -> bool) option)
