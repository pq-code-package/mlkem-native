               let pc_next:int64 =
                   COND (~ (read Rt s = (word 0 : '?1 word))) (word_add pc (word_sx off : int64))
                     (read PC s) in
               (,,) (:= PC pc_next) (:= events (CONS (EventJump (pc, pc_next)) (read events s))) s))

