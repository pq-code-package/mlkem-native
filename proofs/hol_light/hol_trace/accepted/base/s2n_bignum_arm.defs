definition arm_CCMN
  |- (arm_CCMN : (armstate, 'N word) component -> (armstate, 'N word) component -> 4 word ->
         condition -> armstate -> armstate -> bool)
     = (specification "arm_CCMN" arm_CCMN:((armstate, 'N word) component ->
           (armstate, 'N word) component -> 4 word -> condition -> armstate -> armstate -> bool).
         !Rm:((armstate, 'N word) component) Rn:((armstate, 'N word) component) nzcv:(4 word)
          cc:condition.
           arm_CCMN Rm Rn nzcv cc
           = (\s:armstate.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s
               and p:bool = condition_semantics cc s in
               let d:('N word) = word_add m n in
               (,,) (:= NF (COND p (ival d < &0) (bit 3 nzcv)))
                 (:= ZF (COND p (val d = 0) (bit 2 nzcv))
                 ,, := CF (COND p (~ (val m + val n = val d)) (bit 1 nzcv))
                 ,, := VF (COND p (~ (ival m + ival n = ival d)) (bit 0 nzcv)))
                 s))

definition arm_CCMP
  |- (arm_CCMP : (armstate, 'N word) component -> (armstate, 'N word) component -> 4 word ->
         condition -> armstate -> armstate -> bool)
     = (specification "arm_CCMP" arm_CCMP:((armstate, 'N word) component ->
           (armstate, 'N word) component -> 4 word -> condition -> armstate -> armstate -> bool).
         !Rm:((armstate, 'N word) component) Rn:((armstate, 'N word) component) nzcv:(4 word)
          cc:condition.
           arm_CCMP Rm Rn nzcv cc
           = (\s:armstate.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s
               and p:bool = condition_semantics cc s in
               let d:('N word) = word_sub m n in
               (,,) (:= NF (COND p (ival d < &0) (bit 3 nzcv)))
                 (:= ZF (COND p (val d = 0) (bit 2 nzcv))
                 ,, := CF (COND p (int_of_num (val m) - int_of_num (val n) = int_of_num (val d))
                      (bit 1 nzcv))
                 ,, := VF (COND p (~ (ival m - ival n = ival d)) (bit 0 nzcv)))
                 s))

