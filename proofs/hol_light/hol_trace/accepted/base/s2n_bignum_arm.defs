definition arm_SMULH
  |- (arm_SMULH : (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, 'N word) component -> armstate -> armstate -> bool)
     = (specification "arm_SMULH" arm_SMULH:((armstate, 'N word) component ->
           (armstate, 'N word) component -> (armstate, 'N word) component -> armstate -> armstate ->
           bool).
         !Rd:((armstate, 'N word) component) Rn:((armstate, 'N word) component)
          Rm:((armstate, 'N word) component).
           arm_SMULH Rd Rn Rm
           = (\s:armstate.
               let n:('N word) = read Rn s
               and m:('N word) = read Rm s in
               let d:('N word) =
                   (iword ((ival n * ival m) div &2 pow dimindex (UNIV : 'N -> bool)) : 'N word) in
               := Rd d s))

definition word_2smulh
  |- (word_2smulh : 'N word -> 'N word -> 'N word)
     = (specification "word_2smulh" word_2smulh:('N word -> 'N word -> 'N word).
         !x:('N word) y:('N word).
           word_2smulh x y
           = (iword_saturate ((&2 * ival x * ival y) div &2 pow dimindex (UNIV : 'N -> bool))
               : 'N word))

definition arm_SQDMULH_VEC
  |- arm_SQDMULH_VEC
     = (specification "arm_SQDMULH_VEC" arm_SQDMULH_VEC:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> num -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) esize:num datasize:num.
           arm_SQDMULH_VEC Rd Rn Rm esize datasize
           = (\s:armstate.
               let n:int128 = read Rn s
               and m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 32) (simd4 (word_2smulh : int32 -> int32 -> int32) n m)
                       (COND (esize = 16) (simd8 (word_2smulh : int16 -> int16 -> int16) n m)
                         (simd16 (word_2smulh : byte -> byte -> byte) n m)) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let m:int64 = (word_subword m (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (simd2 (word_2smulh : int32 -> int32 -> int32) n m)
                       (COND (esize = 16) (simd4 (word_2smulh : int16 -> int16 -> int16) n m)
                         (simd8 (word_2smulh : byte -> byte -> byte) n m)) in
                 := Rd (word_zx d : int128) s)))

definition word_2smulh_round
  |- (word_2smulh_round : 'N word -> 'N word -> 'N word)
     = (specification "word_2smulh_round" word_2smulh_round:('N word -> 'N word -> 'N word).
         !x:('N word) y:('N word).
           word_2smulh_round x y
           = (iword_saturate
               ((&2 * ival x * ival y + &2 pow (dimindex (UNIV : 'N -> bool) - 1))
               div &2 pow dimindex (UNIV : 'N -> bool))
               : 'N word))

definition arm_SQRDMULH_VEC
  |- arm_SQRDMULH_VEC
     = (specification "arm_SQRDMULH_VEC" arm_SQRDMULH_VEC:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> num -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) esize:num datasize:num.
           arm_SQRDMULH_VEC Rd Rn Rm esize datasize
           = (\s:armstate.
               let n:int128 = read Rn s
               and m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 32) (simd4 (word_2smulh_round : int32 -> int32 -> int32) n m)
                       (COND (esize = 16) (simd8 (word_2smulh_round : int16 -> int16 -> int16) n m)
                         (simd16 (word_2smulh_round : byte -> byte -> byte) n m)) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let m:int64 = (word_subword m (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (simd2 (word_2smulh_round : int32 -> int32 -> int32) n m)
                       (COND (esize = 16) (simd4 (word_2smulh_round : int16 -> int16 -> int16) n m)
                         (simd8 (word_2smulh_round : byte -> byte -> byte) n m)) in
                 := Rd (word_zx d : int128) s)))

definition arm_SUB
  |- (arm_SUB : ('?1, 'N word) component -> ('?1, 'N word) component -> ('?1, 'N word) component ->
         '?1 -> '?1 -> bool)
     = (specification "arm_SUB" arm_SUB:(('?1, 'N word) component -> ('?1, 'N word) component ->
           ('?1, 'N word) component -> '?1 -> '?1 -> bool).
         !Rd:(('?1, 'N word) component) Rm:(('?1, 'N word) component) Rn:(('?1, 'N word) component).
           arm_SUB Rd Rm Rn
           = (\s:'?1.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s in
               let d:('N word) = word_sub m n in := Rd d s))

definition arm_SUB_VEC
  |- (arm_SUB_VEC : ('?1, int128) component -> ('?1, int128) component -> ('?1, int128) component ->
         num -> num -> '?1 -> '?1 -> bool)
     = (specification "arm_SUB_VEC" arm_SUB_VEC:(('?1, int128) component ->
           ('?1, int128) component -> ('?1, int128) component -> num -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) Rm:(('?1, int128) component)
          esize:num datasize:num.
           arm_SUB_VEC Rd Rn Rm esize datasize
           = (\s:'?1.
               let n:int128 = read Rn s in
               let m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (simd2 (word_sub : int64 -> int64 -> int64) n m)
                       (COND (esize = 32) (simd4 (word_sub : int32 -> int32 -> int32) n m)
                         (COND (esize = 16) (simd8 (word_sub : int16 -> int16 -> int16) n m)
                           (simd16 (word_sub : byte -> byte -> byte) n m))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let m:int64 = (word_subword m (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (simd2 (word_sub : int32 -> int32 -> int32) n m)
                       (COND (esize = 16) (simd4 (word_sub : int16 -> int16 -> int16) n m)
                         (simd8 (word_sub : byte -> byte -> byte) n m)) in
                 := Rd (word_zx d : int128) s)))

definition arm_SUBS
  |- (arm_SUBS : (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, 'N word) component -> armstate -> armstate -> bool)
     = (specification "arm_SUBS" arm_SUBS:((armstate, 'N word) component ->
           (armstate, 'N word) component -> (armstate, 'N word) component -> armstate -> armstate ->
           bool).
         !Rd:((armstate, 'N word) component) Rm:((armstate, 'N word) component)
          Rn:((armstate, 'N word) component).
           arm_SUBS Rd Rm Rn
           = (\s:armstate.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s in
               let d:('N word) = word_sub m n in
               (,,) (:= Rd d)
                 (:= NF (ival d < &0)
                 ,, := ZF (val d = 0)
                 ,, := CF (int_of_num (val m) - int_of_num (val n) = int_of_num (val d))
                 ,, := VF (~ (ival m - ival n = ival d)))
                 s))

definition arm_UADDLP
  |- (arm_UADDLP : (armstate, int128) component ->
         (armstate, ((('?1 tybit0) tybit0) tybit0) word) component -> num -> armstate -> armstate ->
         bool)
     = (specification "arm_UADDLP" arm_UADDLP:((armstate, int128) component ->
           (armstate, ((('?1 tybit0) tybit0) tybit0) word) component -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component)
          Rn:((armstate, ((('?1 tybit0) tybit0) tybit0) word) component) esize:num.
           arm_UADDLP Rd Rn esize
           = (\s:armstate.
               let n:(((('?1 tybit0) tybit0) tybit0) word) = read Rn s in
               COND (esize = 32)
                 (let res:int128 =
                     usimd2
                       (\x:((('?1 tybit0) tybit0) word).
                         word_add (word_zx (word_subword x (0, 32) : int32) : int64)
                           (word_zx (word_subword x (32, 32) : int32) : int64))
                       n in
                 := Rd res s)
                 (COND (esize = 16)
                   (let res:int128 =
                       usimd4
                         (\x:(('?1 tybit0) word).
                           word_add (word_zx (word_subword x (0, 16) : int32) : int32)
                             (word_zx (word_subword x (16, 16) : int32) : int32))
                         n in
                   := Rd res s)
                   (let res:int128 =
                       usimd8
                         (\x:('?1 word).
                           word_add (word_zx (word_subword x (0, 8) : int32) : int16)
                             (word_zx (word_subword x (8, 8) : int32) : int16))
                         n in
                   := Rd res s))))

definition arm_UMIN_VEC
  |- arm_UMIN_VEC
     = (specification "arm_UMIN_VEC" arm_UMIN_VEC:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> num -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) esize:num datasize:num.
           arm_UMIN_VEC Rd Rn Rm esize datasize
           = (\s:armstate.
               let n:int128 = read Rn s in
               let m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (simd2 (word_umin : int64 -> int64 -> int64) n m)
                       (COND (esize = 32) (simd4 (word_umin : int32 -> int32 -> int32) n m)
                         (COND (esize = 16) (simd8 (word_umin : int16 -> int16 -> int16) n m)
                           (simd16 (word_umin : byte -> byte -> byte) n m))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let m:int64 = (word_subword m (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (simd2 (word_umin : int32 -> int32 -> int32) n m)
                       (COND (esize = 16) (simd4 (word_umin : int16 -> int16 -> int16) n m)
                         (simd8 (word_umin : byte -> byte -> byte) n m)) in
                 := Rd (word_zx d : int128) s)))

definition arm_UADDLV
  |- arm_UADDLV
     = (specification "arm_UADDLV" arm_UADDLV:((armstate, int128) component ->
           (armstate, int128) component -> num -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component) elements:num
          esize:num.
           arm_UADDLV Rd Rn elements esize
           = (\s:armstate.
               let n:int128 = read Rn s in
               let d:num =
                   nsum (0..(elements - 1)) (\i:num.
                     val (word_subword n (esize * i, esize) : int128)) in
               := Rd (word d : int128) s))

definition arm_UMAXV
  |- arm_UMAXV
     = (specification "arm_UMAXV" arm_UMAXV:((armstate, int128) component ->
           (armstate, int128) component -> num -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component) elements:num
          esize:num.
           arm_UMAXV Rd Rn elements esize
           = (\s:armstate.
               let n:int128 = read Rn s in
               let d:num =
                   iterate MAX (0..(elements - 1)) (\i:num.
                     val (word_subword n (esize * i, esize) : int128)) in
               := Rd (word d : int128) s))

definition arm_UBFM
  |- (arm_UBFM : (armstate, 'N word) component -> (armstate, 'N word) component -> num -> num ->
         armstate -> armstate -> bool)
     = (specification "arm_UBFM" arm_UBFM:((armstate, 'N word) component ->
           (armstate, 'N word) component -> num -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, 'N word) component) Rn:((armstate, 'N word) component) immr:num imms:num.
           arm_UBFM Rd Rn immr imms
           = (\s:armstate.
               let x:('N word) = read Rn s in
               let y:('N word) =
                   COND (imms >= immr) (word_subword x (immr, imms - immr + 1) : 'N word)
                     (word_shl (word_subword x (0, imms + 1) : 'N word)
                       (dimindex (UNIV : 'N -> bool) - immr)) in
               := Rd y s))

definition arm_UMADDL
  |- arm_UMADDL
     = (specification "arm_UMADDL" arm_UMADDL:((armstate, int64) component ->
           (armstate, int32) component -> (armstate, int32) component ->
           (armstate, int64) component -> armstate -> armstate -> bool).
         !Rd:((armstate, int64) component) Rn:((armstate, int32) component)
          Rm:((armstate, int32) component) Ra:((armstate, int64) component).
           arm_UMADDL Rd Rn Rm Ra
           = (\s:armstate.
               let n:int32 = read Rn s
               and m:int32 = read Rm s
               and a:int64 = read Ra s in
               let d:int64 = (word (val a + val n * val m) : int64) in := Rd d s))

definition arm_UMLAL_VEC
  |- arm_UMLAL_VEC
     = (specification "arm_UMLAL_VEC" arm_UMLAL_VEC:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) esize:num.
           arm_UMLAL_VEC Rd Rn Rm esize
           = (\s:armstate.
               let n:int128 = read Rn s in
               let m:int128 = read Rm s in
               let d:int128 = read Rd s in
               let nlow:int64 = (word_subword n (0, 64) : int64) in
               let mlow:int64 = (word_subword m (0, 64) : int64) in
               COND (esize = 32)
                 (let nlowzx:int128 = usimd2 (word_zx : int32 -> int64) nlow in
                 let mlowzx:int128 = usimd2 (word_zx : int32 -> int64) mlow in
                 := Rd
                   (simd2 (word_add : int64 -> int64 -> int64)
                     (simd2 (word_mul : int64 -> int64 -> int64) nlowzx mlowzx)
                     d)
                   s)
                 (COND (esize = 16)
                   (let nlowzx:int128 = usimd4 (word_zx : int16 -> int32) nlow in
                   let mlowzx:int128 = usimd4 (word_zx : int16 -> int32) mlow in
                   := Rd
                     (simd4 (word_add : int32 -> int32 -> int32)
                       (simd4 (word_mul : int32 -> int32 -> int32) nlowzx mlowzx)
                       d)
                     s)
                   (let nlowzx:int128 = usimd8 (word_zx : byte -> int16) nlow in
                   let mlowzx:int128 = usimd8 (word_zx : byte -> int16) mlow in
                   := Rd
                     (simd8 (word_add : int16 -> int16 -> int16)
                       (simd8 (word_mul : int16 -> int16 -> int16) nlowzx mlowzx)
                       d)
                     s))))

definition arm_UMLAL2_VEC
  |- arm_UMLAL2_VEC
     = (specification "arm_UMLAL2_VEC" arm_UMLAL2_VEC:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) esize:num.
           arm_UMLAL2_VEC Rd Rn Rm esize
           = (\s:armstate.
               let n:int128 = read Rn s in
               let m:int128 = read Rm s in
               let d:int128 = read Rd s in
               let nhi:int64 = (word_subword n (64, 64) : int64) in
               let mhi:int64 = (word_subword m (64, 64) : int64) in
               COND (esize = 32)
                 (let nhizx:int128 = usimd2 (word_zx : int32 -> int64) nhi in
                 let mhizx:int128 = usimd2 (word_zx : int32 -> int64) mhi in
                 := Rd
                   (simd2 (word_add : int64 -> int64 -> int64)
                     (simd2 (word_mul : int64 -> int64 -> int64) nhizx mhizx)
                     d)
                   s)
                 (COND (esize = 16)
                   (let nhizx:int128 = usimd4 (word_zx : int16 -> int32) nhi in
                   let mhizx:int128 = usimd4 (word_zx : int16 -> int32) mhi in
                   := Rd
                     (simd4 (word_add : int32 -> int32 -> int32)
                       (simd4 (word_mul : int32 -> int32 -> int32) nhizx mhizx)
                       d)
                     s)
                   (let nhizx:int128 = usimd8 (word_zx : byte -> int16) nhi in
                   let mhizx:int128 = usimd8 (word_zx : byte -> int16) mhi in
                   := Rd
                     (simd8 (word_add : int16 -> int16 -> int16)
                       (simd8 (word_mul : int16 -> int16 -> int16) nhizx mhizx)
                       d)
                     s))))

definition arm_UMLSL_VEC
  |- arm_UMLSL_VEC
     = (specification "arm_UMLSL_VEC" arm_UMLSL_VEC:((armstate, int128) component ->
