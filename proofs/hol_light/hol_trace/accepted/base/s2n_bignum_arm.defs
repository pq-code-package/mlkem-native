definition arm_UMSUBL
  |- arm_UMSUBL
     = (specification "arm_UMSUBL" arm_UMSUBL:((armstate, int64) component ->
           (armstate, int32) component -> (armstate, int32) component ->
           (armstate, int64) component -> armstate -> armstate -> bool).
         !Rd:((armstate, int64) component) Rn:((armstate, int32) component)
          Rm:((armstate, int32) component) Ra:((armstate, int64) component).
           arm_UMSUBL Rd Rn Rm Ra
           = (\s:armstate.
               let n:int32 = read Rn s
               and m:int32 = read Rm s
               and a:int64 = read Ra s in
               let d:int64 =
                   (iword (int_of_num (val a) - int_of_num (val n) * int_of_num (val m)) : int64) in
               := Rd d s))

definition arm_UMOV
  |- (arm_UMOV : (armstate, 'N word) component -> (armstate, '?1 word) component -> num -> num ->
         armstate -> armstate -> bool)
     = (specification "arm_UMOV" arm_UMOV:((armstate, 'N word) component ->
           (armstate, '?1 word) component -> num -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, 'N word) component) Rn:((armstate, '?1 word) component) idx:num size:num.
           arm_UMOV Rd Rn idx size
           = (\s:armstate.
               let n:('?1 word) = read Rn s in
               let d:('N word) = (word_subword n (idx * size * 8, size * 8) : 'N word) in
               := Rd d s))

definition arm_UMULH
  |- (arm_UMULH : (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, 'N word) component -> armstate -> armstate -> bool)
     = (specification "arm_UMULH" arm_UMULH:((armstate, 'N word) component ->
           (armstate, 'N word) component -> (armstate, 'N word) component -> armstate -> armstate ->
           bool).
         !Rd:((armstate, 'N word) component) Rn:((armstate, 'N word) component)
          Rm:((armstate, 'N word) component).
           arm_UMULH Rd Rn Rm
           = (\s:armstate.
               let n:('N word) = read Rn s
               and m:('N word) = read Rm s in
               let d:('N word) =
                   (word ((val n * val m) DIV 2 EXP dimindex (UNIV : 'N -> bool)) : 'N word) in
               := Rd d s))

definition arm_UMULL_VEC
  |- (arm_UMULL_VEC : ('?1, int128) component -> ('?1, int128) component ->
         ('?1, int128) component -> num -> '?1 -> '?1 -> bool)
     = (specification "arm_UMULL_VEC" arm_UMULL_VEC:(('?1, int128) component ->
           ('?1, int128) component -> ('?1, int128) component -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) Rm:(('?1, int128) component)
          esize:num.
           arm_UMULL_VEC Rd Rn Rm esize
           = (\s:'?1.
               let nl:int64 = (word_subword (read Rn s) (0, 64) : int64) in
               let ml:int64 = (word_subword (read Rm s) (0, 64) : int64) in
