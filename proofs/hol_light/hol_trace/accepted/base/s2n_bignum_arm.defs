definition XREG_SP
  |- XREG_SP = (\_1:(5 word). registers :> (element _1 : (5 word -> int64, int64) component))

definition WREG_SP
  |- WREG_SP = (\_1:(5 word). XREG_SP _1 :> zerotop_32)

definition XREG'
  |- XREG' = (\_1:(5 word). XREG (val _1))

definition WREG'
  |- WREG' = (\_1:(5 word). WREG (val _1))

definition QREG'
  |- QREG' = (\_1:(5 word). QREG (val _1))

definition DREG'
  |- DREG' = (\_1:(5 word). DREG (val _1))

definition QLANE
  |- QLANE
     = (specification "QLANE" QLANE:(5 word -> num -> num -> (armstate, int128) component).
         (!reg:(5 word) ix:num. QLANE reg 8 ix = QREG' reg :> LANE_B ix)
         /\ (!reg:(5 word) ix:num. QLANE reg 16 ix = QREG' reg :> LANE_H ix)
         /\ (!reg:(5 word) ix:num. QLANE reg 32 ix = QREG' reg :> LANE_S ix)
         /\ (!reg:(5 word) ix:num. QLANE reg 64 ix = QREG' reg :> LANE_D ix))

definition arm_logop
  |- (arm_logop : 2 word -> bool -> (armstate, 'N word) component ->
         (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate -> armstate -> bool) option)
     = (\_1:(2 word) _2:bool _3:((armstate, 'N word) component) _4:((armstate, 'N word) component)
         _5:((armstate, 'N word) component).
         _BITMATCH _1 (_SEQPATTERN
           (\"BM%PVAR%10":num "BM%PVAR%11":((armstate -> armstate -> bool) option).
             _UNGUARDED_PATTERN (pat_set (CONSPAT NILPAT (word 0 : 2 word)) "BM%PVAR%10")
               (SOME (COND _2
                 (arm_BIC : (armstate, 'N word) component -> (armstate, 'N word) component ->
                     (armstate, 'N word) component -> armstate -> armstate -> bool)
                 (arm_AND : (armstate, 'N word) component -> (armstate, 'N word) component ->
                     (armstate, 'N word) component -> armstate -> armstate -> bool)
                 _3
                 _4
                 _5)
               = "BM%PVAR%11"))
           (_SEQPATTERN
             (\"BM%PVAR%10":num "BM%PVAR%11":((armstate -> armstate -> bool) option).
               _UNGUARDED_PATTERN (pat_set (CONSPAT NILPAT (word 1 : 2 word)) "BM%PVAR%10")
                 (SOME (COND _2
                   (arm_ORN : (armstate, 'N word) component -> (armstate, 'N word) component ->
                       (armstate, 'N word) component -> armstate -> armstate -> bool)
                   (arm_ORR : (armstate, 'N word) component -> (armstate, 'N word) component ->
                       (armstate, 'N word) component -> armstate -> armstate -> bool)
                   _3
                   _4
                   _5)
                 = "BM%PVAR%11"))
             (_SEQPATTERN
               (\"BM%PVAR%10":num "BM%PVAR%11":((armstate -> armstate -> bool) option).
                 _UNGUARDED_PATTERN (pat_set (CONSPAT NILPAT (word 2 : 2 word)) "BM%PVAR%10")
                   (SOME (COND _2
                     (arm_EON : (armstate, 'N word) component -> (armstate, 'N word) component ->
                         (armstate, 'N word) component -> armstate -> armstate -> bool)
                     (arm_EOR : (armstate, 'N word) component -> (armstate, 'N word) component ->
                         (armstate, 'N word) component -> armstate -> armstate -> bool)
                     _3
                     _4
                     _5)
                   = "BM%PVAR%11"))
               (_SEQPATTERN
                 (\"BM%PVAR%10":num "BM%PVAR%11":((armstate -> armstate -> bool) option).
                   _UNGUARDED_PATTERN (pat_set (CONSPAT NILPAT (word 3 : 2 word)) "BM%PVAR%10")
                     (SOME (COND _2
                       (arm_BICS : (armstate, 'N word) component -> (armstate, 'N word) component ->
                           (armstate, 'N word) component -> armstate -> armstate -> bool)
                       (arm_ANDS : (armstate, 'N word) component -> (armstate, 'N word) component ->
                           (armstate, 'N word) component -> armstate -> armstate -> bool)
                       _3
                       _4
                       _5)
                     = "BM%PVAR%11"))
                 (_ELSEPATTERN (ARB : (armstate -> armstate -> bool) option)
                   : num -> (armstate -> armstate -> bool) option -> bool))))))

definition arm_adcop
  |- (arm_adcop : bool -> bool -> (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, 'N word) component -> armstate -> armstate -> bool)
