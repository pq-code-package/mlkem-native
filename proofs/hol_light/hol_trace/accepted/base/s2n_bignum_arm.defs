                 := Rd (word_zx nlow : int128) s)
                 (COND (esize = 16)
                   (let nlow:int64 = usimd4 (\x:int32. (word_subword x (0, 16) : int16)) n in
                   := Rd (word_zx nlow : int128) s)
                   (let nlow:int64 = usimd8 (\x:int16. (word_subword x (0, 8) : byte)) n in
                   := Rd (word_zx nlow : int128) s))))

definition word_split_lohi
  |- (word_split_lohi : ('N tybit0) word -> 'N word # 'N word)
     = (\_1:(('N tybit0) word).
         (word_subword _1 (0, dimindex (UNIV : 'N -> bool)) : 'N word)
         , (word_subword _1 (dimindex (UNIV : 'N -> bool), dimindex (UNIV : 'N -> bool)) : 'N word))

definition word_split_lo
  |- (word_split_lo : ('N tybit0) word -> 'N word)
     = (\_1:(('N tybit0) word). (word_subword _1 (0, dimindex (UNIV : 'N -> bool)) : 'N word))

definition word_split_hi
  |- (word_split_hi : ('N tybit0) word -> 'N word)
     = (\_1:(('N tybit0) word).
         (word_subword _1 (dimindex (UNIV : 'N -> bool), dimindex (UNIV : 'N -> bool)) : 'N word))

definition word_interleave2
  |- (word_interleave2 : ('N tybit0) word -> ('N tybit0) word -> (('N tybit0) tybit0) word)
     = (\_1:(('N tybit0) word) _2:(('N tybit0) word).
         LET
           (GABS (\f:('N word # 'N word -> (('N tybit0) tybit0) word).
             !xlo:('N word) xhi:('N word).
               GEQ (f (xlo, xhi)) (LET_END (LET
                 (GABS (\f:('N word # 'N word -> (('N tybit0) tybit0) word).
                   !ylo:('N word) yhi:('N word).
                     GEQ (f (ylo, yhi)) (LET_END (word_join (word_join yhi xhi : ('N tybit0) word)
                       (word_join ylo xlo : ('N tybit0) word)
                       : (('N tybit0) tybit0) word))))
                 (word_split_lohi _2)))))
           (word_split_lohi _1))

definition word_interleave4
  |- (word_interleave4 : (('N tybit0) tybit0) word -> (('N tybit0) tybit0) word ->
         ((('N tybit0) tybit0) tybit0) word)
     = (\_1:((('N tybit0) tybit0) word) _2:((('N tybit0) tybit0) word).
         LET
           (GABS (\f:(('N tybit0) word # ('N tybit0) word -> ((('N tybit0) tybit0) tybit0) word).
             !xlo:(('N tybit0) word) xhi:(('N tybit0) word).
               GEQ (f (xlo, xhi)) (LET_END (LET
                 (GABS (\f:(('N tybit0) word # ('N tybit0) word ->
                             ((('N tybit0) tybit0) tybit0) word).
                   !ylo:(('N tybit0) word) yhi:(('N tybit0) word).
                     GEQ (f (ylo, yhi)) (LET_END (word_join (word_interleave2 xhi yhi)
                       (word_interleave2 xlo ylo)
                       : ((('N tybit0) tybit0) tybit0) word))))
                 (word_split_lohi _2)))))
           (word_split_lohi _1))

definition word_interleave8
  |- (word_interleave8 : ((('N tybit0) tybit0) tybit0) word -> ((('N tybit0) tybit0) tybit0) word ->
         (((('N tybit0) tybit0) tybit0) tybit0) word)
     = (\_1:(((('N tybit0) tybit0) tybit0) word) _2:(((('N tybit0) tybit0) tybit0) word).
         LET
           (GABS (\f:((('N tybit0) tybit0) word # (('N tybit0) tybit0) word ->
                       (((('N tybit0) tybit0) tybit0) tybit0) word).
             !xlo:((('N tybit0) tybit0) word) xhi:((('N tybit0) tybit0) word).
               GEQ (f (xlo, xhi)) (LET_END (LET
                 (GABS (\f:((('N tybit0) tybit0) word # (('N tybit0) tybit0) word ->
                             (((('N tybit0) tybit0) tybit0) tybit0) word).
                   !ylo:((('N tybit0) tybit0) word) yhi:((('N tybit0) tybit0) word).
                     GEQ (f (ylo, yhi)) (LET_END (word_join (word_interleave4 xhi yhi)
                       (word_interleave4 xlo ylo)
                       : (((('N tybit0) tybit0) tybit0) tybit0) word))))
                 (word_split_lohi _2)))))
           (word_split_lohi _1))

definition word_interleave16
  |- (word_interleave16 : (((('N tybit0) tybit0) tybit0) tybit0) word ->
         (((('N tybit0) tybit0) tybit0) tybit0) word ->
         ((((('N tybit0) tybit0) tybit0) tybit0) tybit0) word)
     = (\_1:((((('N tybit0) tybit0) tybit0) tybit0) word)
         _2:((((('N tybit0) tybit0) tybit0) tybit0) word).
         LET
           (GABS (\f:(((('N tybit0) tybit0) tybit0) word # ((('N tybit0) tybit0) tybit0) word ->
                       ((((('N tybit0) tybit0) tybit0) tybit0) tybit0) word).
             !xlo:(((('N tybit0) tybit0) tybit0) word) xhi:(((('N tybit0) tybit0) tybit0) word).
               GEQ (f (xlo, xhi)) (LET_END (LET
                 (GABS (\f:(((('N tybit0) tybit0) tybit0) word #
                                 ((('N tybit0) tybit0) tybit0) word ->
                             ((((('N tybit0) tybit0) tybit0) tybit0) tybit0) word).
                   !ylo:(((('N tybit0) tybit0) tybit0) word)
                    yhi:(((('N tybit0) tybit0) tybit0) word).
                     GEQ (f (ylo, yhi)) (LET_END (word_join (word_interleave8 xhi yhi)
                       (word_interleave8 xlo ylo)
                       : ((((('N tybit0) tybit0) tybit0) tybit0) tybit0) word))))
                 (word_split_lohi _2)))))
           (word_split_lohi _1))

definition arm_ZIP1
  |- (arm_ZIP1 : ('?1, int128) component -> ('?1, '?2 word) component ->
         ('?1, '?3 word) component -> num -> num -> '?1 -> '?1 -> bool)
     = (\_1:(('?1, int128) component) _2:(('?1, '?2 word) component) _3:(('?1, '?3 word) component)
         _4:num _5:num s:'?1.
         let n:('?2 word) = read _2 s in
         let m:('?3 word) = read _3 s in
         COND (_5 = 128)
           (let n:int64 = (word_subword n (0, 64) : int64) in
           let m:int64 = (word_subword m (0, 64) : int64) in
           let d:int128 =
               COND (_4 = 64) (word_join m n : int128)
                 (COND (_4 = 32) (word_interleave2 n m)
                   (COND (_4 = 16) (word_interleave4 n m) (word_interleave8 n m))) in
           := _1 d s)
           (let n:int32 = (word_subword n (0, 32) : int32) in
           let m:int32 = (word_subword m (0, 32) : int32) in
           let d:int64 =
               COND (_4 = 32) (word_join m n : int64)
                 (COND (_4 = 16) (word_interleave2 n m) (word_interleave4 n m)) in
           := _1 (word_zx d : int128) s))

definition arm_ZIP2
  |- (arm_ZIP2 : ('?1, int128) component -> ('?1, '?2 word) component ->
         ('?1, '?3 word) component -> num -> num -> '?1 -> '?1 -> bool)
     = (\_1:(('?1, int128) component) _2:(('?1, '?2 word) component) _3:(('?1, '?3 word) component)
         _4:num _5:num s:'?1.
         let n:('?2 word) = read _2 s in
         let m:('?3 word) = read _3 s in
         COND (_5 = 128)
           (let n:int64 = (word_subword n (64, 64) : int64) in
           let m:int64 = (word_subword m (64, 64) : int64) in
           let d:int128 =
               COND (_4 = 64) (word_join m n : int128)
                 (COND (_4 = 32) (word_interleave2 n m)
                   (COND (_4 = 16) (word_interleave4 n m) (word_interleave8 n m))) in
           := _1 d s)
           (let n:int32 = (word_subword n (32, 32) : int32) in
           let m:int32 = (word_subword m (32, 32) : int32) in
           let d:int64 =
               COND (_4 = 32) (word_join m n : int64)
                 (COND (_4 = 16) (word_interleave2 n m) (word_interleave4 n m)) in
           := _1 (word_zx d : int128) s))

definition word_interleave_lo
  |- (word_interleave_lo : ('N tybit0) word -> ('N tybit0) word -> ('N tybit0) word)
     = (specification "word_interleave_lo" word_interleave_lo:(('N tybit0) word ->
           ('N tybit0) word -> ('N tybit0) word).
         !x:(('N tybit0) word) y:(('N tybit0) word).
           word_interleave_lo x y
           = (word_join (word_subword y (0, dimindex (UNIV : 'N -> bool)) : 'N word)
               (word_subword x (0, dimindex (UNIV : 'N -> bool)) : 'N word)
               : ('N tybit0) word))

definition word_interleave_hi
  |- (word_interleave_hi : ('N tybit0) word -> ('N tybit0) word -> ('N tybit0) word)
     = (specification "word_interleave_hi" word_interleave_hi:(('N tybit0) word ->
           ('N tybit0) word -> ('N tybit0) word).
         !x:(('N tybit0) word) y:(('N tybit0) word).
           word_interleave_hi x y
           = (word_join
               (word_subword y (dimindex (UNIV : 'N -> bool), dimindex (UNIV : 'N -> bool))
                 : 'N word)
               (word_subword x (dimindex (UNIV : 'N -> bool), dimindex (UNIV : 'N -> bool))
                 : 'N word)
               : ('N tybit0) word))

definition arm_TRN1
  |- (arm_TRN1 : ('?1, int128) component -> ('?1, int128) component -> ('?1, int128) component ->
         num -> num -> '?1 -> '?1 -> bool)
     = (specification "arm_TRN1" arm_TRN1:(('?1, int128) component -> ('?1, int128) component ->
           ('?1, int128) component -> num -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) Rm:(('?1, int128) component)
          esize:num datasize:num.
           arm_TRN1 Rd Rn Rm esize datasize
           = (\s:'?1.
               let n:int128 = read Rn s in
               let m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (word_interleave_lo n m)
                       (COND (esize = 32) (simd2 (word_interleave_lo : int64 -> int64 -> int64) n m)
                         (COND (esize = 16)
                           (simd4 (word_interleave_lo : int32 -> int32 -> int32) n m)
                           (simd8 (word_interleave_lo : int16 -> int16 -> int16) n m))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let m:int64 = (word_subword m (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (word_interleave_lo n m)
                       (COND (esize = 16) (simd2 (word_interleave_lo : int32 -> int32 -> int32) n m)
                         (simd4 (word_interleave_lo : int16 -> int16 -> int16) n m)) in
                 := Rd (word_zx d : int128) s)))

definition arm_TRN2
  |- (arm_TRN2 : ('?1, int128) component -> ('?1, int128) component -> ('?1, int128) component ->
         num -> num -> '?1 -> '?1 -> bool)
     = (specification "arm_TRN2" arm_TRN2:(('?1, int128) component -> ('?1, int128) component ->
           ('?1, int128) component -> num -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) Rm:(('?1, int128) component)
          esize:num datasize:num.
           arm_TRN2 Rd Rn Rm esize datasize
           = (\s:'?1.
               let n:int128 = read Rn s in
               let m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (word_interleave_hi n m)
                       (COND (esize = 32) (simd2 (word_interleave_hi : int64 -> int64 -> int64) n m)
                         (COND (esize = 16)
                           (simd4 (word_interleave_hi : int32 -> int32 -> int32) n m)
                           (simd8 (word_interleave_hi : int16 -> int16 -> int16) n m))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let m:int64 = (word_subword m (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (word_interleave_hi n m)
                       (COND (esize = 16) (simd2 (word_interleave_hi : int32 -> int32 -> int32) n m)
                         (simd4 (word_interleave_hi : int16 -> int16 -> int16) n m)) in
                 := Rd (word_zx d : int128) s)))

definition arm_TBL
  |- (arm_TBL : (armstate, int128) component -> ((armstate, int128) component) list ->
         (armstate, (((('?1 tybit0) tybit0) tybit0) tybit0) word) component -> num -> armstate ->
         armstate -> bool)
     = (specification "arm_TBL" arm_TBL:((armstate, int128) component ->
           ((armstate, int128) component) list ->
           (armstate, (((('?1 tybit0) tybit0) tybit0) tybit0) word) component -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, (((('?1 tybit0) tybit0) tybit0) tybit0) word) component) datasize:num.
           arm_TBL Rd [Rn] Rm datasize
           = (\s:armstate.
               let n:int128 = read Rn s in
               let m:((((('?1 tybit0) tybit0) tybit0) tybit0) word) = read Rm s in
               COND (datasize = 128)
                 (let d:int128 =
                     usimd16 (\x:('?1 word). (word_subword n (8 * val x, 8) : byte)) m in
                 := Rd d s)
                 (let d:int64 =
                     usimd8 (\x:byte. (word_subword n (8 * val x, 8) : byte)) (word_zx m : int64) in
                 := Rd (word_zx d : int128) s)))

definition arm_TBL2
  |- (arm_TBL2 : (armstate, int128) component -> (armstate, int128) component ->
         (armstate, int128) component ->
         (armstate, (((('?1 tybit0) tybit0) tybit0) tybit0) word) component -> num -> armstate ->
         armstate -> bool)
     = (specification "arm_TBL2" arm_TBL2:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component ->
           (armstate, (((('?1 tybit0) tybit0) tybit0) tybit0) word) component -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn1:((armstate, int128) component)
          Rn2:((armstate, int128) component)
          Rm:((armstate, (((('?1 tybit0) tybit0) tybit0) tybit0) word) component) datasize:num.
           arm_TBL2 Rd Rn1 Rn2 Rm datasize
           = (\s:armstate.
               let n1:int128 = read Rn1 s in
               let n2:int128 = read Rn2 s in
               let table:(256 word) = (word_join n2 n1 : 256 word) in
               let m:((((('?1 tybit0) tybit0) tybit0) tybit0) word) = read Rm s in
               COND (datasize = 128)
                 (let d:int128 =
                     usimd16 (\x:('?1 word). (word_subword table (8 * val x, 8) : byte)) m in
                 := Rd d s)
                 (let d:int64 =
                     usimd8 (\x:byte. (word_subword table (8 * val x, 8) : byte))
                       (word_zx m : int64) in
                 := Rd (word_zx d : int128) s)))

definition arm_LDR
  |- (arm_LDR : (armstate, 'N word) component -> (armstate, int64) component -> offset ->
         armstate -> armstate -> bool)
     = (specification "arm_LDR" arm_LDR:((armstate, 'N word) component ->
           (armstate, int64) component -> offset -> armstate -> armstate -> bool).
         !Rt:((armstate, 'N word) component) Rn:((armstate, int64) component) off:offset.
           arm_LDR Rt Rn off
           = (\s:armstate.
               let base:int64 = read Rn s in
               let addr:int64 = word_add base (offset_address off s) in
               COND
                 ((Rn = SP ==> aligned 16 base)
                 /\ (offset_writesback off ==> orthogonal_components Rt Rn))
                 (:= Rt (read (memory :> (wbytes addr : (int64 -> byte, 'N word) component)) s)
                 ,, := events (CONS (EventLoad (addr, dimindex (UNIV : 'N -> bool) DIV 8))
                      (read events s))
                 ,, COND (offset_writesback off) (:= Rn (word_add base (offset_writeback off s)))
                      ((=) : armstate -> armstate -> bool))
                 (ASSIGNS (entirety : (armstate, armstate) component))
                 s))

definition arm_STR
  |- (arm_STR : (armstate, 'N word) component -> (armstate, int64) component -> offset ->
         armstate -> armstate -> bool)
     = (specification "arm_STR" arm_STR:((armstate, 'N word) component ->
           (armstate, int64) component -> offset -> armstate -> armstate -> bool).
         !Rt:((armstate, 'N word) component) Rn:((armstate, int64) component) off:offset.
           arm_STR Rt Rn off
           = (\s:armstate.
               let base:int64 = read Rn s in
               let addr:int64 = word_add base (offset_address off s) in
               COND
                 ((Rn = SP ==> aligned 16 base)
                 /\ (offset_writesback off ==> orthogonal_components Rt Rn))
                 (:= (memory :> (wbytes addr : (int64 -> byte, 'N word) component)) (read Rt s)
                 ,, := events (CONS (EventStore (addr, dimindex (UNIV : 'N -> bool) DIV 8))
                      (read events s))
                 ,, COND (offset_writesback off) (:= Rn (word_add base (offset_writeback off s)))
                      ((=) : armstate -> armstate -> bool))
                 (ASSIGNS (entirety : (armstate, armstate) component))
                 s))

definition arm_LDRB
  |- (arm_LDRB : (armstate, 'N word) component -> (armstate, int64) component -> offset ->
         armstate -> armstate -> bool)
     = (specification "arm_LDRB" arm_LDRB:((armstate, 'N word) component ->
           (armstate, int64) component -> offset -> armstate -> armstate -> bool).
         !Rt:((armstate, 'N word) component) Rn:((armstate, int64) component) off:offset.
           arm_LDRB Rt Rn off
           = (\s:armstate.
               let base:int64 = read Rn s in
               let addr:int64 = word_add base (offset_address off s) in
               COND
                 ((Rn = SP ==> aligned 16 base)
                 /\ (offset_writesback off ==> orthogonal_components Rt Rn))
                 (:= Rt (word_zx (read (memory :> bytes8 addr) s) : 'N word)
                 ,, := events (CONS (EventLoad (addr, 1)) (read events s))
                 ,, COND (offset_writesback off) (:= Rn (word_add base (offset_writeback off s)))
                      ((=) : armstate -> armstate -> bool))
                 (ASSIGNS (entirety : (armstate, armstate) component))
                 s))

definition arm_STRB
  |- (arm_STRB : (armstate, 'N word) component -> (armstate, int64) component -> offset ->
         armstate -> armstate -> bool)
     = (specification "arm_STRB" arm_STRB:((armstate, 'N word) component ->
           (armstate, int64) component -> offset -> armstate -> armstate -> bool).
         !Rt:((armstate, 'N word) component) Rn:((armstate, int64) component) off:offset.
           arm_STRB Rt Rn off
           = (\s:armstate.
               let base:int64 = read Rn s in
               let addr:int64 = word_add base (offset_address off s) in
               COND
                 ((Rn = SP ==> aligned 16 base)
                 /\ (offset_writesback off ==> orthogonal_components Rt Rn))
                 (:= (memory :> bytes8 addr) (word_zx (read Rt s) : byte)
                 ,, := events (CONS (EventStore (addr, 1)) (read events s))
                 ,, COND (offset_writesback off) (:= Rn (word_add base (offset_writeback off s)))
                      ((=) : armstate -> armstate -> bool))
                 (ASSIGNS (entirety : (armstate, armstate) component))
                 s))

definition arm_LDP
  |- (arm_LDP : (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, int64) component -> offset -> armstate -> armstate -> bool)
     = (specification "arm_LDP" arm_LDP:((armstate, 'N word) component ->
           (armstate, 'N word) component -> (armstate, int64) component -> offset -> armstate ->
           armstate -> bool).
         !Rt1:((armstate, 'N word) component) Rt2:((armstate, 'N word) component)
          Rn:((armstate, int64) component) off:offset.
           arm_LDP Rt1 Rt2 Rn off
           = (\s:armstate.
               let base:int64 = read Rn s in
               let addr:int64 = word_add base (offset_address off s) in
               COND
                 ((Rn = SP ==> aligned 16 base)
                 /\ orthogonal_components Rt1 Rt2
                 /\ (offset_writesback off
                    ==> orthogonal_components Rt1 Rn /\ orthogonal_components Rt2 Rn))
                 (let w:num = dimindex (UNIV : 'N -> bool) DIV 8 in
                 := Rt1 (read (memory :> (wbytes addr : (int64 -> byte, 'N word) component)) s)
                 ,, := Rt2 (read
                      (memory
                      :> (wbytes (word_add addr (word w : int64))
                           : (int64 -> byte, 'N word) component))
                      s)
                 ,, := events (CONS (EventLoad (addr, 2 * w)) (read events s))
                 ,, COND (offset_writesback off) (:= Rn (word_add base (offset_writeback off s)))
                      ((=) : armstate -> armstate -> bool))
                 (ASSIGNS (entirety : (armstate, armstate) component))
                 s))

definition arm_STP
  |- (arm_STP : (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, int64) component -> offset -> armstate -> armstate -> bool)
     = (specification "arm_STP" arm_STP:((armstate, 'N word) component ->
           (armstate, 'N word) component -> (armstate, int64) component -> offset -> armstate ->
           armstate -> bool).
         !Rt1:((armstate, 'N word) component) Rt2:((armstate, 'N word) component)
          Rn:((armstate, int64) component) off:offset.
           arm_STP Rt1 Rt2 Rn off
           = (\s:armstate.
               let base:int64 = read Rn s in
               let addr:int64 = word_add base (offset_address off s) in
               COND
                 ((Rn = SP ==> aligned 16 base)
                 /\ (offset_writesback off
                    ==> orthogonal_components Rt1 Rn /\ orthogonal_components Rt2 Rn))
                 (let w:num = dimindex (UNIV : 'N -> bool) DIV 8 in
                 := (memory :> (wbytes addr : (int64 -> byte, 'N word) component)) (read Rt1 s)
                 ,, :=
                      (memory
                      :> (wbytes (word_add addr (word w : int64))
                           : (int64 -> byte, 'N word) component))
                      (read Rt2 s)
                 ,, := events (CONS (EventStore (addr, 2 * w)) (read events s))
                 ,, COND (offset_writesback off) (:= Rn (word_add base (offset_writeback off s)))
                      ((=) : armstate -> armstate -> bool))
                 (ASSIGNS (entirety : (armstate, armstate) component))
                 s))

definition arm_LDP4
  |- (arm_LDP4 : (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, int64) component -> offset -> armstate -> armstate -> bool)
     = (specification "arm_LDP4" arm_LDP4:((armstate, 'N word) component ->
           (armstate, 'N word) component -> (armstate, 'N word) component ->
           (armstate, 'N word) component -> (armstate, int64) component -> offset -> armstate ->
           armstate -> bool).
         !Rt1:((armstate, 'N word) component) Rt2:((armstate, 'N word) component)
          Rt3:((armstate, 'N word) component) Rt4:((armstate, 'N word) component)
          Rn:((armstate, int64) component) off:offset.
           arm_LDP4 Rt1 Rt2 Rt3 Rt4 Rn off
           = (\s:armstate.
               let base:int64 = read Rn s in
               let addr:int64 = word_add base (offset_address off s) in
               COND
                 ((Rn = SP ==> aligned 16 base)
                 /\ orthogonal_components Rt1 Rt2
                 /\ orthogonal_components Rt1 Rt3
                 /\ orthogonal_components Rt1 Rt4
                 /\ orthogonal_components Rt2 Rt3
                 /\ orthogonal_components Rt2 Rt4
                 /\ orthogonal_components Rt3 Rt4
                 /\ (offset_writesback off
                    ==> orthogonal_components Rt1 Rn
                        /\ orthogonal_components Rt2 Rn
                        /\ orthogonal_components Rt3 Rn
                        /\ orthogonal_components Rt4 Rn))
                 (let w:num = dimindex (UNIV : 'N -> bool) DIV 8 in
                 := Rt1 (read (memory :> (wbytes addr : (int64 -> byte, 'N word) component)) s)
                 ,, := Rt2 (read
                      (memory
                      :> (wbytes (word_add addr (word w : int64))
                           : (int64 -> byte, 'N word) component))
                      s)
                 ,, := Rt3 (read
                      (memory
                      :> (wbytes (word_add addr (word (2 * w) : int64))
                           : (int64 -> byte, 'N word) component))
                      s)
                 ,, := Rt4 (read
                      (memory
                      :> (wbytes (word_add addr (word (3 * w) : int64))
                           : (int64 -> byte, 'N word) component))
                      s)
                 ,, := events (CONS (EventLoad (addr, 4 * w)) (read events s))
                 ,, COND (offset_writesback off) (:= Rn (word_add base (offset_writeback off s)))
                      ((=) : armstate -> armstate -> bool))
                 (ASSIGNS (entirety : (armstate, armstate) component))
                 s))

definition arm_STP4
  |- (arm_STP4 : (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, int64) component -> offset -> armstate -> armstate -> bool)
     = (specification "arm_STP4" arm_STP4:((armstate, 'N word) component ->
           (armstate, 'N word) component -> (armstate, 'N word) component ->
           (armstate, 'N word) component -> (armstate, int64) component -> offset -> armstate ->
           armstate -> bool).
         !Rt1:((armstate, 'N word) component) Rt2:((armstate, 'N word) component)
          Rt3:((armstate, 'N word) component) Rt4:((armstate, 'N word) component)
          Rn:((armstate, int64) component) off:offset.
           arm_STP4 Rt1 Rt2 Rt3 Rt4 Rn off
           = (\s:armstate.
               let base:int64 = read Rn s in
               let addr:int64 = word_add base (offset_address off s) in
               COND
                 ((Rn = SP ==> aligned 16 base)
                 /\ (offset_writesback off
                    ==> orthogonal_components Rt1 Rn
                        /\ orthogonal_components Rt2 Rn
                        /\ orthogonal_components Rt3 Rn
                        /\ orthogonal_components Rt4 Rn))
                 (let w:num = dimindex (UNIV : 'N -> bool) DIV 8 in
                 := (memory :> (wbytes addr : (int64 -> byte, 'N word) component)) (read Rt1 s)
                 ,, :=
                      (memory
                      :> (wbytes (word_add addr (word w : int64))
                           : (int64 -> byte, 'N word) component))
                      (read Rt2 s)
                 ,, :=
                      (memory
                      :> (wbytes (word_add addr (word (2 * w) : int64))
                           : (int64 -> byte, 'N word) component))
                      (read Rt3 s)
                 ,, :=
                      (memory
                      :> (wbytes (word_add addr (word (3 * w) : int64))
                           : (int64 -> byte, 'N word) component))
                      (read Rt4 s)
                 ,, := events (CONS (EventStore (addr, 4 * w)) (read events s))
                 ,, COND (offset_writesback off) (:= Rn (word_add base (offset_writeback off s)))
                      ((=) : armstate -> armstate -> bool))
                 (ASSIGNS (entirety : (armstate, armstate) component))
                 s))

definition word_deinterleave2_x
  |- (word_deinterleave2_x : (('N tybit0) tybit0) word -> ('N tybit0) word)
     = (\_1:((('N tybit0) tybit0) word).
         let zlo:(('N tybit0) word) = word_split_lo _1 in
         let zhi:(('N tybit0) word) = word_split_hi _1 in
         let xlo:('N word) = word_split_lo zlo in
         let xhi:('N word) = word_split_lo zhi in (word_join xhi xlo : ('N tybit0) word))

definition word_deinterleave2_y
  |- (word_deinterleave2_y : (('N tybit0) tybit0) word -> ('N tybit0) word)
     = (\_1:((('N tybit0) tybit0) word).
         let zlo:(('N tybit0) word) = word_split_lo _1 in
         let zhi:(('N tybit0) word) = word_split_hi _1 in
         let ylo:('N word) = word_split_hi zlo in
         let yhi:('N word) = word_split_hi zhi in (word_join yhi ylo : ('N tybit0) word))

definition word_deinterleave4_x
  |- (word_deinterleave4_x : ((('N tybit0) tybit0) tybit0) word -> (('N tybit0) tybit0) word)
     = (\_1:(((('N tybit0) tybit0) tybit0) word).
         let zlo:((('N tybit0) tybit0) word) = word_split_lo _1 in
         let zhi:((('N tybit0) tybit0) word) = word_split_hi _1 in
         let xlo:(('N tybit0) word) = word_deinterleave2_x zlo in
         let xhi:(('N tybit0) word) = word_deinterleave2_x zhi in
         (word_join xhi xlo : (('N tybit0) tybit0) word))

definition word_deinterleave4_y
  |- (word_deinterleave4_y : ((('N tybit0) tybit0) tybit0) word -> (('N tybit0) tybit0) word)
     = (\_1:(((('N tybit0) tybit0) tybit0) word).
         let zlo:((('N tybit0) tybit0) word) = word_split_lo _1 in
         let zhi:((('N tybit0) tybit0) word) = word_split_hi _1 in
         let ylo:(('N tybit0) word) = word_deinterleave2_y zlo in
         let yhi:(('N tybit0) word) = word_deinterleave2_y zhi in
         (word_join yhi ylo : (('N tybit0) tybit0) word))

definition word_deinterleave8_x
  |- (word_deinterleave8_x : (((('N tybit0) tybit0) tybit0) tybit0) word ->
         ((('N tybit0) tybit0) tybit0) word)
     = (\_1:((((('N tybit0) tybit0) tybit0) tybit0) word).
         let zlo:(((('N tybit0) tybit0) tybit0) word) = word_split_lo _1 in
         let zhi:(((('N tybit0) tybit0) tybit0) word) = word_split_hi _1 in
         let xlo:((('N tybit0) tybit0) word) = word_deinterleave4_x zlo in
         let xhi:((('N tybit0) tybit0) word) = word_deinterleave4_x zhi in
         (word_join xhi xlo : ((('N tybit0) tybit0) tybit0) word))

definition word_deinterleave8_y
  |- (word_deinterleave8_y : (((('N tybit0) tybit0) tybit0) tybit0) word ->
         ((('N tybit0) tybit0) tybit0) word)
     = (\_1:((((('N tybit0) tybit0) tybit0) tybit0) word).
         let zlo:(((('N tybit0) tybit0) tybit0) word) = word_split_lo _1 in
         let zhi:(((('N tybit0) tybit0) tybit0) word) = word_split_hi _1 in
         let ylo:((('N tybit0) tybit0) word) = word_deinterleave4_y zlo in
         let yhi:((('N tybit0) tybit0) word) = word_deinterleave4_y zhi in
         (word_join yhi ylo : ((('N tybit0) tybit0) tybit0) word))

definition word_deinterleave16_x
  |- (word_deinterleave16_x : ((((('N tybit0) tybit0) tybit0) tybit0) tybit0) word ->
         (((('N tybit0) tybit0) tybit0) tybit0) word)
     = (\_1:(((((('N tybit0) tybit0) tybit0) tybit0) tybit0) word).
         let zlo:((((('N tybit0) tybit0) tybit0) tybit0) word) = word_split_lo _1 in
         let zhi:((((('N tybit0) tybit0) tybit0) tybit0) word) = word_split_hi _1 in
         let xlo:(((('N tybit0) tybit0) tybit0) word) = word_deinterleave8_x zlo in
         let xhi:(((('N tybit0) tybit0) tybit0) word) = word_deinterleave8_x zhi in
         (word_join xhi xlo : (((('N tybit0) tybit0) tybit0) tybit0) word))

definition word_deinterleave16_y
  |- (word_deinterleave16_y : ((((('N tybit0) tybit0) tybit0) tybit0) tybit0) word ->
         (((('N tybit0) tybit0) tybit0) tybit0) word)
     = (\_1:(((((('N tybit0) tybit0) tybit0) tybit0) tybit0) word).
         let zlo:((((('N tybit0) tybit0) tybit0) tybit0) word) = word_split_lo _1 in
         let zhi:((((('N tybit0) tybit0) tybit0) tybit0) word) = word_split_hi _1 in
         let ylo:(((('N tybit0) tybit0) tybit0) word) = word_deinterleave8_y zlo in
         let yhi:(((('N tybit0) tybit0) tybit0) word) = word_deinterleave8_y zhi in
         (word_join yhi ylo : (((('N tybit0) tybit0) tybit0) tybit0) word))

definition arm_LD2
  |- arm_LD2
     = (specification "arm_LD2" arm_LD2:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int64) component -> offset -> num -> num ->
           armstate -> armstate -> bool).
         !Rt:((armstate, int128) component) Rtt:((armstate, int128) component)
          Rn:((armstate, int64) component) off:offset datasize:num esize:num.
           arm_LD2 Rt Rtt Rn off datasize esize
           = (\s:armstate.
               let address:int64 = read Rn s in
               let eaddr:int64 = word_add address (offset_address off s) in
               COND
                 ((Rn = SP ==> aligned 16 address)
                 /\ (offset_writesback off ==> orthogonal_components Rt Rn))
                 (COND (datasize = 128)
                   (let tmp:(256 word) =
                       read (memory :> (wbytes eaddr : (int64 -> byte, 256 word) component)) s in
                   let x:int128 =
                       COND (esize = 64) (word_deinterleave2_x tmp)
                         (COND (esize = 32) (word_deinterleave4_x tmp)
                           (COND (esize = 16) (word_deinterleave8_x tmp)
                             (word_deinterleave16_x tmp))) in
                   let y:int128 =
                       COND (esize = 64) (word_deinterleave2_y tmp)
                         (COND (esize = 32) (word_deinterleave4_y tmp)
                           (COND (esize = 16) (word_deinterleave8_y tmp)
                             (word_deinterleave16_y tmp))) in
                   := Rt x
                   ,, := Rtt y
                   ,, := events (CONS (EventLoad (eaddr, 32)) (read events s))
                   ,, COND (offset_writesback off)
                        (:= Rn (word_add address (offset_writeback off s)))
                        ((=) : armstate -> armstate -> bool))
                   (let tmp:int128 =
                       read (memory :> (wbytes eaddr : (int64 -> byte, int128) component)) s in
                   let x:int64 =
                       COND (esize = 32) (word_deinterleave2_x tmp)
                         (COND (esize = 16) (word_deinterleave4_x tmp)
                           (word_deinterleave8_x tmp)) in
                   let y:int64 =
                       COND (esize = 32) (word_deinterleave2_y tmp)
                         (COND (esize = 16) (word_deinterleave4_y tmp)
                           (word_deinterleave8_y tmp)) in
                   := Rt (word_zx x : int128)
                   ,, := Rtt (word_zx y : int128)
                   ,, := events (CONS (EventLoad (eaddr, 16)) (read events s))
                   ,, COND (offset_writesback off)
                        (:= Rn (word_add address (offset_writeback off s)))
                        ((=) : armstate -> armstate -> bool)))
                 (ASSIGNS (entirety : (armstate, armstate) component))
                 s))

definition arm_ST2
  |- arm_ST2
     = (specification "arm_ST2" arm_ST2:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int64) component -> offset -> num -> num ->
           armstate -> armstate -> bool).
         !Rt:((armstate, int128) component) Rtt:((armstate, int128) component)
          Rn:((armstate, int64) component) off:offset datasize:num esize:num.
           arm_ST2 Rt Rtt Rn off datasize esize
           = (\s:armstate.
               let address:int64 = read Rn s in
               let eaddr:int64 = word_add address (offset_address off s) in
               COND
                 ((Rn = SP ==> aligned 16 address)
                 /\ (offset_writesback off ==> orthogonal_components Rt Rn))
                 (let x:int128 = read Rt s in
                 let y:int128 = read Rtt s in
                 COND (datasize = 128)
                   (let tmp:(256 word) =
                       COND (esize = 64) (word_interleave2 x y)
                         (COND (esize = 32) (word_interleave4 x y)
                           (COND (esize = 16) (word_interleave8 x y) (word_interleave16 x y))) in
                   := (memory :> (wbytes eaddr : (int64 -> byte, 256 word) component)) tmp)
                   (let x:int64 = (word_subword x (0, 64) : int64) in
                   let y:int64 = (word_subword y (0, 64) : int64) in
                   let tmp:int128 =
                       COND (esize = 32) (word_interleave2 x y)
                         (COND (esize = 16) (word_interleave4 x y) (word_interleave8 x y)) in
                   := (memory :> (wbytes eaddr : (int64 -> byte, int128) component)) tmp)
                 ,, := events (CONS (EventStore (eaddr, datasize DIV 4)) (read events s))
                 ,, COND (offset_writesback off) (:= Rn (word_add address (offset_writeback off s)))
                      ((=) : armstate -> armstate -> bool))
                 (ASSIGNS (entirety : (armstate, armstate) component))
                 s))

definition arm_LD1R
  |- arm_LD1R
     = (specification "arm_LD1R" arm_LD1R:((armstate, int128) component ->
           (armstate, int64) component -> offset -> num -> num -> armstate -> armstate -> bool).
         !Rt:((armstate, int128) component) Rn:((armstate, int64) component) off:offset esize:num
          datasize:num.
           arm_LD1R Rt Rn off esize datasize
           = (\s:armstate.
               let base:int64 = read Rn s in
               let addr:int64 = word_add base (offset_address off s) in
               COND
                 ((Rn = SP ==> aligned 16 base)
                 /\ (offset_writesback off ==> orthogonal_components Rt Rn))
                 (COND (datasize = 128)
                   (let replicated:int128 =
                       COND (esize = 64)
                         (word_duplicate
                           (read (memory :> (wbytes addr : (int64 -> byte, int64) component)) s)
                           : int128)
                         (COND (esize = 32)
                           (word_duplicate
                             (read (memory :> (wbytes addr : (int64 -> byte, int32) component)) s)
                             : int128)
                           (COND (esize = 16)
                             (word_duplicate
                               (read (memory :> (wbytes addr : (int64 -> byte, int16) component)) s)
                               : int128)
                             (word_duplicate
                               (read (memory :> (wbytes addr : (int64 -> byte, byte) component)) s)
                               : int128))) in
                   := Rt replicated)
                   (let replicated:int64 =
                       COND (esize = 64)
                         (read (memory :> (wbytes addr : (int64 -> byte, int64) component)) s)
                         (COND (esize = 32)
                           (word_duplicate
                             (read (memory :> (wbytes addr : (int64 -> byte, int32) component)) s)
                             : int64)
                           (COND (esize = 16)
                             (word_duplicate
                               (read (memory :> (wbytes addr : (int64 -> byte, int16) component)) s)
                               : int64)
                             (word_duplicate
                               (read (memory :> (wbytes addr : (int64 -> byte, byte) component)) s)
                               : int64))) in
                   := Rt (word_zx replicated : int128))
                 ,, := events (CONS (EventLoad (addr, esize DIV 8)) (read events s))
                 ,, COND (offset_writesback off) (:= Rn (word_add base (offset_writeback off s)))
                      ((=) : armstate -> armstate -> bool))
                 (ASSIGNS (entirety : (armstate, armstate) component))
                 s))

definition arm_LD3
  |- arm_LD3
     = (specification "arm_LD3" arm_LD3:(((armstate, int128) component) list ->
           (armstate, int64) component -> offset -> num -> num -> armstate -> armstate -> bool).
         !Rt1:((armstate, int128) component) Rt2:((armstate, int128) component)
          Rt3:((armstate, int128) component) Rn:((armstate, int64) component) off:offset
          datasize:num esize:num.
           arm_LD3 [Rt1; Rt2; Rt3] Rn off datasize esize
           = (\s:armstate.
               let address:int64 = read Rn s in
               let eaddr:int64 = word_add address (offset_address off s) in
               COND (Rn = SP ==> aligned 16 address)
                 (COND (datasize = 128)
                   (let raw:(384 word) =
                       read (memory :> (wbytes eaddr : (int64 -> byte, 384 word) component)) s in
                   LET
                     (GABS (\f:(int128 list -> armstate -> armstate -> bool).
                       !il1:int128 il2:int128 il3:int128.
                         GEQ (f [il1; il2; il3]) (LET_END
                           (:= Rt1 il1 ,, := Rt2 il2 ,, := Rt3 il3))))
                     (word_deinterleave 3 esize raw : int128 list))
                   (let raw:(192 word) =
                       read (memory :> (wbytes eaddr : (int64 -> byte, 192 word) component)) s in
                   LET
                     (GABS (\f:(int64 list -> armstate -> armstate -> bool).
                       !il1:int64 il2:int64 il3:int64.
                         GEQ (f [il1; il2; il3]) (LET_END
                           (:= Rt1 (word_zx il1 : int128)
                           ,, := Rt2 (word_zx il2 : int128)
                           ,, := Rt3 (word_zx il3 : int128)))))
                     (word_deinterleave 3 esize raw : int64 list))
                 ,, := events (CONS (EventLoad (eaddr, 3 * datasize DIV 8)) (read events s))
                 ,, COND (offset_writesback off) (:= Rn (word_add address (offset_writeback off s)))
                      ((=) : armstate -> armstate -> bool))
                 (ASSIGNS (entirety : (armstate, armstate) component))
                 s))

definition arm_ST3
  |- arm_ST3
     = (specification "arm_ST3" arm_ST3:(((armstate, int128) component) list ->
           (armstate, int64) component -> offset -> num -> num -> armstate -> armstate -> bool).
         !Rt1:((armstate, int128) component) Rt2:((armstate, int128) component)
          Rt3:((armstate, int128) component) Rn:((armstate, int64) component) off:offset
          datasize:num esize:num.
           arm_ST3 [Rt1; Rt2; Rt3] Rn off datasize esize
           = (\s:armstate.
               let address:int64 = read Rn s in
               let eaddr:int64 = word_add address (offset_address off s) in
               COND (Rn = SP ==> aligned 16 address)
                 (let raw1:int128 = read Rt1 s
                 and raw2:int128 = read Rt2 s
                 and raw3:int128 = read Rt3 s in
                 COND (datasize = 128)
                   (let ilv:(384 word) = (word_interleave esize [raw1; raw2; raw3] : 384 word) in
                   := (memory :> (wbytes eaddr : (int64 -> byte, 384 word) component)) ilv)
                   (let ilv:(192 word) =
                       (word_interleave esize
                         [(word_zx raw1 : int64); (word_zx raw2 : int64); (word_zx raw3 : int64)]
                         : 192 word) in
                   := (memory :> (wbytes eaddr : (int64 -> byte, 192 word) component)) ilv)
                 ,, := events (CONS (EventStore (eaddr, 3 * datasize DIV 8)) (read events s))
                 ,, COND (offset_writesback off) (:= Rn (word_add address (offset_writeback off s)))
                      ((=) : armstate -> armstate -> bool))
                 (ASSIGNS (entirety : (armstate, armstate) component))
                 s))

definition arm_SHA256H
  |- arm_SHA256H
     = (specification "arm_SHA256H" arm_SHA256H:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> armstate -> armstate ->
           bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component).
           arm_SHA256H Rd Rn Rm
           = (\s:armstate.
               let d:int128 = read Rd s
               and n:int128 = read Rn s
               and m:int128 = read Rm s in
               let d':int128 = sha256h d n m in := Rd d' s))

