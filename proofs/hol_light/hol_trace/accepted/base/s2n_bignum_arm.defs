               (\"BM%PVAR%14":num "BM%PVAR%15":((armstate -> armstate -> bool) option).
                 _UNGUARDED_PATTERN (pat_set (CONSPAT NILPAT (word 2 : 2 word)) "BM%PVAR%14")
                   (SOME (arm_ASRV _2 _3 _4) = "BM%PVAR%15"))
               (_SEQPATTERN
                 (\"BM%PVAR%14":num "BM%PVAR%15":((armstate -> armstate -> bool) option).
                   _UNGUARDED_PATTERN (pat_set (CONSPAT NILPAT (word 3 : 2 word)) "BM%PVAR%14")
                     (SOME (arm_RORV _2 _3 _4) = "BM%PVAR%15"))
                 (_ELSEPATTERN (ARB : (armstate -> armstate -> bool) option)
