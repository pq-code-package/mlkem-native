       = {r:(bool, 'N) cart})

typedef bitpat
  |- (\x:(num # (num -> bool)). !a:num. SND x a ==> a < 2 EXP FST x) {r:num # (num -> bool)}
     = ((dest_bitpat : bitpat -> num # (num -> bool))
         ((mk_bitpat : num # (num -> bool) -> bitpat) {r:num # (num -> bool)})
       = {r:num # (num -> bool)})

typedef component
  |- (\rw:(('S -> 'V) # ('V -> 'S -> 'S)). T) {r:('S -> 'V) # ('V -> 'S -> 'S)}
     = ((dest_component : ('S, 'V) component -> ('S -> 'V) # ('V -> 'S -> 'S))
         ((component : ('S -> 'V) # ('V -> 'S -> 'S) -> ('S, 'V) component)
           {r:('S -> 'V) # ('V -> 'S -> 'S)})
       = {r:('S -> 'V) # ('V -> 'S -> 'S)})

typedef address_uarch_event
  |- (\a:((('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num) recspace).
       !address_uarch_event':((('A word # num) # ('A word # 'A word) # (int64 # int64 # num) #
                int64 # num) recspace -> bool).
         (!a:((('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num)
             recspace).
           (?a:('A word # num).
             {a:(('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num)
               recspace}
             = (\a:('A word # num).
                 CONSTR 0
                   (a
                   , (@v:('A word # 'A word). T)
                     , (@v:(int64 # int64 # num). T), (@v:(int64 # num). T))
                   (\n:num.
                     (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) #
                         int64 # num) recspace))) a)
           \/ (?a:('A word # num).
                {a:(('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num)
                  recspace}
                = (\a:('A word # num).
                    CONSTR (SUC 0)
                      (a
                      , (@v:('A word # 'A word). T)
                        , (@v:(int64 # int64 # num). T), (@v:(int64 # num). T))
                      (\n:num.
                        (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) #
                            int64 # num) recspace))) a)
           \/ (?a:('A word # 'A word).
                {a:(('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num)
                  recspace}
                = (\a:('A word # 'A word).
                    CONSTR (SUC (SUC 0))
                      ((@v:('A word # num). T)
                      , a, (@v:(int64 # int64 # num). T), (@v:(int64 # num). T))
                      (\n:num.
                        (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) #
                            int64 # num) recspace))) a)
           \/ (?a:(int64 # int64 # num).
                {a:(('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num)
                  recspace}
                = (\a:(int64 # int64 # num).
                    CONSTR (SUC (SUC (SUC 0)))
                      ((@v:('A word # num). T)
                      , (@v:('A word # 'A word). T), a, (@v:(int64 # num). T))
                      (\n:num.
                        (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) #
                            int64 # num) recspace))) a)
           \/ (?a:(int64 # num).
                {a:(('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num)
                  recspace}
                = (\a:(int64 # num).
                    CONSTR (SUC (SUC (SUC (SUC 0))))
                      ((@v:('A word # num). T)
                      , (@v:('A word # 'A word). T), (@v:(int64 # int64 # num). T), a)
                      (\n:num.
                        (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) #
                            int64 # num) recspace))) a)
           ==> address_uarch_event' a)
         ==> address_uarch_event' a) {r:(('A word # num) # ('A word # 'A word) #
         (int64 # int64 # num) # int64 # num) recspace}
     = ((_dest_address_uarch_event : 'A address_uarch_event ->
           (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num) recspace)
         ((_mk_address_uarch_event : (('A word # num) # ('A word # 'A word) #
                 (int64 # int64 # num) # int64 # num) recspace -> 'A address_uarch_event)
           {r:(('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num)
             recspace})
       = {r:(('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num) recspace})

typedef armstate
  |- (\a:((int64 # (5 word -> int64) # (5 word -> int128) # 4 word # (int64 -> byte) #
           (64 address_uarch_event) list) recspace).
       !armstate':((int64 # (5 word -> int64) # (5 word -> int128) # 4 word # (int64 -> byte) #
                (64 address_uarch_event) list) recspace -> bool).
         (!a:((int64 # (5 word -> int64) # (5 word -> int128) # 4 word # (int64 -> byte) #
               (64 address_uarch_event) list) recspace).
           (?a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word) a4:(int64 -> byte)
             a5:((64 address_uarch_event) list).
             a
             = (\a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word) a4:(int64 -> byte)
                 a5:((64 address_uarch_event) list).
                 CONSTR 0 (a0, a1, a2, a3, a4, a5) (\n:num.
                   (BOTTOM : (int64 # (5 word -> int64) # (5 word -> int128) # 4 word #
                       (int64 -> byte) # (64 address_uarch_event) list) recspace))) a0 a1 a2 a3 a4
                 a5)
           ==> armstate' a)
         ==> armstate' a) {r:(int64 # (5 word -> int64) # (5 word -> int128) # 4 word #
         (int64 -> byte) # (64 address_uarch_event) list) recspace}
     = ((_dest_armstate : armstate ->
           (int64 # (5 word -> int64) # (5 word -> int128) # 4 word # (int64 -> byte) #
               (64 address_uarch_event) list) recspace)
         ((_mk_armstate : (int64 # (5 word -> int64) # (5 word -> int128) # 4 word #
                 (int64 -> byte) # (64 address_uarch_event) list) recspace -> armstate)
           {r:(int64 # (5 word -> int64) # (5 word -> int128) # 4 word # (int64 -> byte) #
               (64 address_uarch_event) list) recspace})
       = {r:(int64 # (5 word -> int64) # (5 word -> int128) # 4 word # (int64 -> byte) #
             (64 address_uarch_event) list) recspace})

typedef regshift
  |- (\a:(bool recspace).
       !regshift':(bool recspace -> bool).
         (!a:(bool recspace).
           a = CONSTR 0 (@x:bool. T) (\n:num. (BOTTOM : bool recspace))
           \/ a = CONSTR (SUC 0) (@x:bool. T) (\n:num. (BOTTOM : bool recspace))
           \/ a = CONSTR (SUC (SUC 0)) (@x:bool. T) (\n:num. (BOTTOM : bool recspace))
           \/ a = CONSTR (SUC (SUC (SUC 0))) (@x:bool. T) (\n:num. (BOTTOM : bool recspace))
           ==> regshift' a)
         ==> regshift' a) {r:bool recspace}
     = ((_dest_regshift : regshift -> bool recspace)
         ((_mk_regshift : bool recspace -> regshift) {r:bool recspace})
       = {r:bool recspace})

typedef extendtype
  |- (\a:(bool recspace).
       !extendtype':(bool recspace -> bool).
         (!a:(bool recspace).
           a = CONSTR 0 (@x:bool. T) (\n:num. (BOTTOM : bool recspace))
           \/ a = CONSTR (SUC 0) (@x:bool. T) (\n:num. (BOTTOM : bool recspace))
           \/ a = CONSTR (SUC (SUC 0)) (@x:bool. T) (\n:num. (BOTTOM : bool recspace))
           \/ a = CONSTR (SUC (SUC (SUC 0))) (@x:bool. T) (\n:num. (BOTTOM : bool recspace))
           \/ a = CONSTR (SUC (SUC (SUC (SUC 0)))) (@x:bool. T) (\n:num. (BOTTOM : bool recspace))
           \/ a
              = CONSTR (SUC (SUC (SUC (SUC (SUC 0))))) (@x:bool. T)
                  (\n:num. (BOTTOM : bool recspace))
           \/ a
              = CONSTR (SUC (SUC (SUC (SUC (SUC (SUC 0)))))) (@x:bool. T)
                  (\n:num. (BOTTOM : bool recspace))
           \/ a
              = CONSTR (SUC (SUC (SUC (SUC (SUC (SUC (SUC 0))))))) (@x:bool. T)
                  (\n:num. (BOTTOM : bool recspace))
           ==> extendtype' a)
         ==> extendtype' a) {r:bool recspace}
     = ((_dest_extendtype : extendtype -> bool recspace)
         ((_mk_extendtype : bool recspace -> extendtype) {r:bool recspace})
       = {r:bool recspace})

typedef condition
  |- (\a:((4 word) recspace).
       !condition':((4 word) recspace -> bool).
         (!a:((4 word) recspace).
           (?a:(4 word).
             {a:(4 word) recspace}
             = (\a:(4 word). CONSTR 0 a (\n:num. (BOTTOM : (4 word) recspace))) a)
           ==> condition' a)
         ==> condition' a) {r:(4 word) recspace}
     = ((_dest_condition : condition -> (4 word) recspace)
         ((_mk_condition : (4 word) recspace -> condition) {r:(4 word) recspace})
       = {r:(4 word) recspace})

typedef offset
  |- (\a:(((armstate, int64) component # num # int64) recspace).
       !offset':(((armstate, int64) component # num # int64) recspace -> bool).
         (!a:(((armstate, int64) component # num # int64) recspace).
           (?a:((armstate, int64) component).
             {a:((armstate, int64) component # num # int64) recspace}
             = (\a:((armstate, int64) component).
                 CONSTR 0 (a, (@v:num. T), (@v:int64. T))
                   (\n:num. (BOTTOM : ((armstate, int64) component # num # int64) recspace))) a)
           \/ (?a0:((armstate, int64) component) a1:num.
                a
                = (\a0:((armstate, int64) component) a1:num.
                    CONSTR (SUC 0) (a0, a1, (@v:int64. T))
                      (\n:num. (BOTTOM : ((armstate, int64) component # num # int64) recspace))) a0
                    a1)
           \/ (?a:((armstate, int64) component).
                {a:((armstate, int64) component # num # int64) recspace}
                = (\a:((armstate, int64) component).
                    CONSTR (SUC (SUC 0)) (a, (@v:num. T), (@v:int64. T))
                      (\n:num. (BOTTOM : ((armstate, int64) component # num # int64) recspace))) a)
           \/ (?a:int64.
                {a:((armstate, int64) component # num # int64) recspace}
                = (\a:int64.
                    CONSTR (SUC (SUC (SUC 0)))
                      ((@v:((armstate, int64) component). T), (@v:num. T), a)
                      (\n:num. (BOTTOM : ((armstate, int64) component # num # int64) recspace))) a)
           \/ (?a:int64.
                {a:((armstate, int64) component # num # int64) recspace}
                = (\a:int64.
                    CONSTR (SUC (SUC (SUC (SUC 0))))
                      ((@v:((armstate, int64) component). T), (@v:num. T), a)
                      (\n:num. (BOTTOM : ((armstate, int64) component # num # int64) recspace))) a)
           \/ (?a:int64.
                {a:((armstate, int64) component # num # int64) recspace}
                = (\a:int64.
                    CONSTR (SUC (SUC (SUC (SUC (SUC 0)))))
                      ((@v:((armstate, int64) component). T), (@v:num. T), a)
                      (\n:num. (BOTTOM : ((armstate, int64) component # num # int64) recspace))) a)
           ==> offset' a)
         ==> offset' a) {r:((armstate, int64) component # num # int64) recspace}
     = ((_dest_offset : offset -> ((armstate, int64) component # num # int64) recspace)
         ((_mk_offset : ((armstate, int64) component # num # int64) recspace -> offset)
           {r:((armstate, int64) component # num # int64) recspace})
       = {r:((armstate, int64) component # num # int64) recspace})
