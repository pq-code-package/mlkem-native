  |- LANE_H
     = (specification "LANE_H" LANE_H:(num -> (int128, int128) component).
         !i:num.
           LANE_H i
           = through ((\w:int128. (word_duplicate (word_subword w (16 * i, 16) : int16) : int128))
             , (I : int128 -> int128)))

