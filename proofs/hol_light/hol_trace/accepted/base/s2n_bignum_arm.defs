           = (\s:armstate.
               let n:int128 = read Rn s in
               let m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (simd2 (masking (\x:int64 y:int64. ival x >= ival y)) n m)
                       (COND (esize = 32) (simd4 (masking (\x:int32 y:int32. ival x >= ival y)) n m)
                         (COND (esize = 16)
                           (simd8 (masking (\x:int16 y:int16. ival x >= ival y)) n m)
                           (simd16 (masking (\x:byte y:byte. ival x >= ival y)) n m))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let m:int64 = (word_subword m (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (simd2 (masking (\x:int32 y:int32. ival x >= ival y)) n m)
                       (COND (esize = 16) (simd4 (masking (\x:int16 y:int16. ival x >= ival y)) n m)
                         (simd8 (masking (\x:byte y:byte. ival x >= ival y)) n m)) in
                 := Rd (word_zx d : int128) s)))

definition arm_CMGT_VEC
  |- arm_CMGT_VEC
     = (specification "arm_CMGT_VEC" arm_CMGT_VEC:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> num -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) esize:num datasize:num.
           arm_CMGT_VEC Rd Rn Rm esize datasize
           = (\s:armstate.
               let n:int128 = read Rn s in
               let m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (simd2 (masking (word_igt : int64 -> int64 -> bool)) n m)
                       (COND (esize = 32) (simd4 (masking (word_igt : int32 -> int32 -> bool)) n m)
                         (COND (esize = 16)
                           (simd8 (masking (word_igt : int16 -> int16 -> bool)) n m)
                           (simd16 (masking (word_igt : byte -> byte -> bool)) n m))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let m:int64 = (word_subword m (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (simd2 (masking (word_igt : int32 -> int32 -> bool)) n m)
                       (COND (esize = 16) (simd4 (masking (word_igt : int16 -> int16 -> bool)) n m)
                         (simd8 (masking (word_igt : byte -> byte -> bool)) n m)) in
                 := Rd (word_zx d : int128) s)))

definition arm_CMLE_VEC_ZERO
  |- arm_CMLE_VEC_ZERO
     = (specification "arm_CMLE_VEC_ZERO" arm_CMLE_VEC_ZERO:((armstate, int128) component ->
           (armstate, int128) component -> num -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component) esize:num
          datasize:num.
           arm_CMLE_VEC_ZERO Rd Rn esize datasize
           = (\s:armstate.
               let n:int128 = read Rn s in
               let z:int128 = (word 0 : int128) in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (simd2 (masking (word_ile : int64 -> int64 -> bool)) n z)
                       (COND (esize = 32) (simd4 (masking (word_ile : int32 -> int32 -> bool)) n z)
                         (COND (esize = 16)
                           (simd8 (masking (word_ile : int16 -> int16 -> bool)) n z)
                           (simd16 (masking (word_ile : byte -> byte -> bool)) n z))) in
                 := Rd d s)
                 (let n':int64 = (word_subword n (0, 64) : int64) in
                 let z':int64 = (word 0 : int64) in
                 let d:int64 =
                     COND (esize = 32) (simd2 (masking (word_ile : int32 -> int32 -> bool)) n' z')
                       (COND (esize = 16)
                         (simd4 (masking (word_ile : int16 -> int16 -> bool)) n' z')
                         (simd8 (masking (word_ile : byte -> byte -> bool)) n' z')) in
                 := Rd (word_zx d : int128) s)))

definition arm_CNT
  |- (arm_CNT : (armstate, int128) component ->
         (armstate, (((('?1 tybit0) tybit0) tybit0) tybit0) word) component -> num -> armstate ->
         armstate -> bool)
     = (specification "arm_CNT" arm_CNT:((armstate, int128) component ->
           (armstate, (((('?1 tybit0) tybit0) tybit0) tybit0) word) component -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component)
          Rn:((armstate, (((('?1 tybit0) tybit0) tybit0) tybit0) word) component) datasize:num.
           arm_CNT Rd Rn datasize
           = (\s:armstate.
               let n:((((('?1 tybit0) tybit0) tybit0) tybit0) word) = read Rn s in
               COND (datasize = 128)
                 (let d:int128 =
                     usimd16 ((word : num -> byte) o (word_popcount : '?1 word -> num)) n in
                 := Rd d s)
                 (let n':int64 = (word_subword n (0, 64) : int64) in
                 let d:int64 = usimd8 ((word : num -> byte) o (word_popcount : byte -> num)) n' in
                 := Rd (word_zx d : int128) s)))

definition arm_CSEL
  |- (arm_CSEL : (armstate, '?1) component -> (armstate, '?1) component ->
         (armstate, '?1) component -> condition -> armstate -> armstate -> bool)
     = (specification "arm_CSEL" arm_CSEL:((armstate, '?1) component -> (armstate, '?1) component ->
           (armstate, '?1) component -> condition -> armstate -> armstate -> bool).
         !Rd:((armstate, '?1) component) Rn:((armstate, '?1) component)
          Rm:((armstate, '?1) component) cc:condition.
           arm_CSEL Rd Rn Rm cc
           = (\s:armstate. := Rd (COND (condition_semantics cc s) (read Rn s) (read Rm s)) s))

definition arm_CSINC
  |- (arm_CSINC : (armstate, '?1 word) component -> (armstate, '?1 word) component ->
         (armstate, '?1 word) component -> condition -> armstate -> armstate -> bool)
     = (specification "arm_CSINC" arm_CSINC:((armstate, '?1 word) component ->
           (armstate, '?1 word) component -> (armstate, '?1 word) component -> condition ->
           armstate -> armstate -> bool).
         !Rd:((armstate, '?1 word) component) Rn:((armstate, '?1 word) component)
          Rm:((armstate, '?1 word) component) cc:condition.
           arm_CSINC Rd Rn Rm cc
           = (\s:armstate.
               := Rd
                 (COND (condition_semantics cc s) (read Rn s)
                   (word_add (read Rm s) (word 1 : '?1 word)))
                 s))

definition arm_CSINV
  |- (arm_CSINV : (armstate, '?1 word) component -> (armstate, '?1 word) component ->
         (armstate, '?1 word) component -> condition -> armstate -> armstate -> bool)
     = (specification "arm_CSINV" arm_CSINV:((armstate, '?1 word) component ->
           (armstate, '?1 word) component -> (armstate, '?1 word) component -> condition ->
           armstate -> armstate -> bool).
         !Rd:((armstate, '?1 word) component) Rn:((armstate, '?1 word) component)
          Rm:((armstate, '?1 word) component) cc:condition.
           arm_CSINV Rd Rn Rm cc
           = (\s:armstate.
               := Rd (COND (condition_semantics cc s) (read Rn s) (word_not (read Rm s))) s))

definition arm_CSNEG
  |- (arm_CSNEG : (armstate, '?1 word) component -> (armstate, '?1 word) component ->
         (armstate, '?1 word) component -> condition -> armstate -> armstate -> bool)
     = (specification "arm_CSNEG" arm_CSNEG:((armstate, '?1 word) component ->
           (armstate, '?1 word) component -> (armstate, '?1 word) component -> condition ->
           armstate -> armstate -> bool).
         !Rd:((armstate, '?1 word) component) Rn:((armstate, '?1 word) component)
          Rm:((armstate, '?1 word) component) cc:condition.
           arm_CSNEG Rd Rn Rm cc
           = (\s:armstate.
               := Rd (COND (condition_semantics cc s) (read Rn s) (word_neg (read Rm s))) s))

definition arm_DUP_GEN
  |- arm_DUP_GEN
     = (specification "arm_DUP_GEN" arm_DUP_GEN:((armstate, int128) component ->
           (armstate, int64) component -> num -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int64) component) esize:num datasize:num.
           arm_DUP_GEN Rd Rn esize datasize
           = (\s:armstate.
               let n:int64 = read Rn s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (word_duplicate n : int128)
                       (COND (esize = 32) (word_duplicate (word_zx n : int32) : int128)
                         (COND (esize = 16) (word_duplicate (word_zx n : int16) : int128)
                           (word_duplicate (word_zx n : byte) : int128))) in
                 := Rd d s)
                 (let d:int64 =
                     COND (esize = 32) (word_duplicate (word_zx n : int32) : int64)
                       (COND (esize = 16) (word_duplicate (word_zx n : int16) : int64)
                         (word_duplicate (word_zx n : byte) : int64)) in
                 := Rd (word_zx d : int128) s)))

definition arm_EON
  |- (arm_EON : ('?1, 'N word) component -> ('?1, 'N word) component -> ('?1, 'N word) component ->
         '?1 -> '?1 -> bool)
     = (specification "arm_EON" arm_EON:(('?1, 'N word) component -> ('?1, 'N word) component ->
           ('?1, 'N word) component -> '?1 -> '?1 -> bool).
         !Rd:(('?1, 'N word) component) Rm:(('?1, 'N word) component) Rn:(('?1, 'N word) component).
           arm_EON Rd Rm Rn
           = (\s:'?1.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s in
               let d:('N word) = word_xor m (word_not n) in := Rd d s))

definition arm_EOR
  |- (arm_EOR : ('?1, 'N word) component -> ('?1, 'N word) component -> ('?1, 'N word) component ->
         '?1 -> '?1 -> bool)
     = (specification "arm_EOR" arm_EOR:(('?1, 'N word) component -> ('?1, 'N word) component ->
           ('?1, 'N word) component -> '?1 -> '?1 -> bool).
         !Rd:(('?1, 'N word) component) Rm:(('?1, 'N word) component) Rn:(('?1, 'N word) component).
           arm_EOR Rd Rm Rn
           = (\s:'?1.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s in
               let d:('N word) = word_xor m n in := Rd d s))

definition arm_EOR_VEC
  |- (arm_EOR_VEC : ('?1, int128) component -> ('?1, int128) component -> ('?1, int128) component ->
         num -> '?1 -> '?1 -> bool)
     = (specification "arm_EOR_VEC" arm_EOR_VEC:(('?1, int128) component ->
           ('?1, int128) component -> ('?1, int128) component -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) Rm:(('?1, int128) component)
          datasize:num.
           arm_EOR_VEC Rd Rn Rm datasize
           = (\s:'?1.
               let m:int128 = read Rm s
               and n:int128 = read Rn s in
               COND (datasize = 128) (let d:int128 = word_xor m n in := Rd d s)
                 (let d:int64 = (word_subword (word_xor m n) (0, 64) : int64) in
                 := Rd (word_zx d : int128) s)))

definition arm_EXT
  |- (arm_EXT : ('?1, 'N word) component -> ('?1, 'N word) component -> ('?1, 'N word) component ->
         num -> '?1 -> '?1 -> bool)
     = (specification "arm_EXT" arm_EXT:(('?1, 'N word) component -> ('?1, 'N word) component ->
           ('?1, 'N word) component -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, 'N word) component) Rn:(('?1, 'N word) component) Rm:(('?1, 'N word) component)
          pos:num.
           arm_EXT Rd Rn Rm pos
           = (\s:'?1.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s in
               let mn:(('N tybit0) word) = (word_join m n : ('N tybit0) word) in
               let d:('N word) = (word_subword mn (pos, dimindex (UNIV : 'N -> bool)) : 'N word) in
               := Rd d s))

definition arm_EXTR
  |- (arm_EXTR : ('?1, 'N word) component -> ('?1, 'N word) component -> ('?1, 'N word) component ->
         num -> '?1 -> '?1 -> bool)
     = (specification "arm_EXTR" arm_EXTR:(('?1, 'N word) component -> ('?1, 'N word) component ->
           ('?1, 'N word) component -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, 'N word) component) Rn:(('?1, 'N word) component) Rm:(('?1, 'N word) component)
          lsb:num.
           arm_EXTR Rd Rn Rm lsb
           = (\s:'?1.
               let n:('N word) = read Rn s
               and m:('N word) = read Rm s
               and l:num = lsb MOD dimindex (UNIV : 'N -> bool) in
               let concat:(('N tybit0) word) = (word_join n m : ('N tybit0) word) in
               let d:('N word) =
                   (word_subword concat (l, dimindex (UNIV : 'N -> bool)) : 'N word) in
               := Rd d s))

definition arm_FCSEL
  |- (arm_FCSEL : (armstate, '?1 word) component -> (armstate, int128) component ->
         (armstate, int128) component -> condition -> num -> armstate -> armstate -> bool)
     = (specification "arm_FCSEL" arm_FCSEL:((armstate, '?1 word) component ->
           (armstate, int128) component -> (armstate, int128) component -> condition -> num ->
           armstate -> armstate -> bool).
         !Rd:((armstate, '?1 word) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) cc:condition datasize:num.
           arm_FCSEL Rd Rn Rm cc datasize
           = (\s:armstate.
               let n:int128 = read Rn s
               and m:int128 = read Rm s
               and p:bool = condition_semantics cc s in
               := Rd (word_subword (COND p n m) (0, datasize) : '?1 word) s))

definition arm_INS
  |- arm_INS
     = (specification "arm_INS" arm_INS:((armstate, int128) component ->
           (armstate, int128) component -> num -> num -> num -> num -> armstate -> armstate ->
           bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component) destindex:num
          srcindex:num esize:num datasize:num.
           arm_INS Rd Rn destindex srcindex esize datasize
           = (\s:armstate.
               let d:int128 = read Rd s
               and n:int128 = read Rn s in
               let n':int128 = (word_subword n (0, datasize) : int128) in
               let n'':int128 = (word_subword n' (srcindex, esize) : int128) in
               let d':int128 = (word_insert d (destindex, esize) n'' : int128) in := Rd d' s))

definition arm_INS_GEN
  |- (arm_INS_GEN : (armstate, int128) component -> (armstate, 'N word) component -> num -> num ->
         armstate -> armstate -> bool)
     = (specification "arm_INS_GEN" arm_INS_GEN:((armstate, int128) component ->
           (armstate, 'N word) component -> num -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, 'N word) component) ix:num esize:num.
           arm_INS_GEN Rd Rn ix esize
           = (\s:armstate.
               let d:int128 = read Rd s
               and n:('N word) = read Rn s in
               let d':int128 = (word_insert d (ix, esize) n : int128) in := Rd d' s))

definition arm_LSLV
  |- (arm_LSLV : ('?1, 'N word) component -> ('?1, 'N word) component -> ('?1, 'N word) component ->
         '?1 -> '?1 -> bool)
     = (specification "arm_LSLV" arm_LSLV:(('?1, 'N word) component -> ('?1, 'N word) component ->
           ('?1, 'N word) component -> '?1 -> '?1 -> bool).
         !Rd:(('?1, 'N word) component) Rm:(('?1, 'N word) component) Rn:(('?1, 'N word) component).
           arm_LSLV Rd Rm Rn
           = (\s:'?1.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s in
               let d:('N word) = word_jshl m n in := Rd d s))

definition arm_LSRV
  |- (arm_LSRV : ('?1, 'N word) component -> ('?1, 'N word) component -> ('?1, 'N word) component ->
         '?1 -> '?1 -> bool)
     = (specification "arm_LSRV" arm_LSRV:(('?1, 'N word) component -> ('?1, 'N word) component ->
           ('?1, 'N word) component -> '?1 -> '?1 -> bool).
         !Rd:(('?1, 'N word) component) Rm:(('?1, 'N word) component) Rn:(('?1, 'N word) component).
           arm_LSRV Rd Rm Rn
           = (\s:'?1.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s in
               let d:('N word) = word_jushr m n in := Rd d s))

definition arm_MADD
  |- (arm_MADD : ('?1, 'N word) component -> ('?1, 'N word) component -> ('?1, 'N word) component ->
         ('?1, 'N word) component -> '?1 -> '?1 -> bool)
     = (specification "arm_MADD" arm_MADD:(('?1, 'N word) component -> ('?1, 'N word) component ->
           ('?1, 'N word) component -> ('?1, 'N word) component -> '?1 -> '?1 -> bool).
         !Rd:(('?1, 'N word) component) Rn:(('?1, 'N word) component) Rm:(('?1, 'N word) component)
          Ra:(('?1, 'N word) component).
           arm_MADD Rd Rn Rm Ra
           = (\s:'?1.
               let n:('N word) = read Rn s
               and m:('N word) = read Rm s
               and a:('N word) = read Ra s in
               let d:('N word) = (word (val a + val n * val m) : 'N word) in := Rd d s))

definition arm_MLS_VEC
  |- arm_MLS_VEC
     = (specification "arm_MLS_VEC" arm_MLS_VEC:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> num -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) esize:num datasize:num.
           arm_MLS_VEC Rd Rn Rm esize datasize
           = (\s:armstate.
               let d:int128 = read Rd s
               and n:int128 = read Rn s
               and m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d':int128 =
                     COND (esize = 32)
                       (simd4 (word_sub : int32 -> int32 -> int32) d
                         (simd4 (word_mul : int32 -> int32 -> int32) n m))
                       (COND (esize = 16)
                         (simd8 (word_sub : int16 -> int16 -> int16) d
                           (simd8 (word_mul : int16 -> int16 -> int16) n m))
                         (simd16 (word_sub : byte -> byte -> byte) d
                           (simd16 (word_mul : byte -> byte -> byte) n m))) in
                 := Rd d' s)
                 (let d:int64 = (word_subword d (0, 64) : int64)
                 and n:int64 = (word_subword n (0, 64) : int64)
                 and m:int64 = (word_subword m (0, 64) : int64) in
                 let d':int64 =
                     COND (esize = 32)
                       (simd2 (word_sub : int32 -> int32 -> int32) d
                         (simd2 (word_mul : int32 -> int32 -> int32) n m))
                       (COND (esize = 16)
                         (simd4 (word_sub : int16 -> int16 -> int16) d
                           (simd4 (word_mul : int16 -> int16 -> int16) n m))
                         (simd8 (word_sub : byte -> byte -> byte) d
                           (simd8 (word_mul : byte -> byte -> byte) n m))) in
                 := Rd (word_zx d' : int128) s)))

definition arm_MLA_VEC
  |- arm_MLA_VEC
     = (specification "arm_MLA_VEC" arm_MLA_VEC:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> num -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) esize:num datasize:num.
           arm_MLA_VEC Rd Rn Rm esize datasize
           = (\s:armstate.
               let d:int128 = read Rd s
               and n:int128 = read Rn s
               and m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d':int128 =
                     COND (esize = 32)
                       (simd4 (word_add : int32 -> int32 -> int32) d
                         (simd4 (word_mul : int32 -> int32 -> int32) n m))
                       (COND (esize = 16)
                         (simd8 (word_add : int16 -> int16 -> int16) d
                           (simd8 (word_mul : int16 -> int16 -> int16) n m))
                         (simd16 (word_add : byte -> byte -> byte) d
                           (simd16 (word_mul : byte -> byte -> byte) n m))) in
                 := Rd d' s)
                 (let d:int64 = (word_subword d (0, 64) : int64)
                 and n:int64 = (word_subword n (0, 64) : int64)
                 and m:int64 = (word_subword m (0, 64) : int64) in
                 let d':int64 =
                     COND (esize = 32)
                       (simd2 (word_add : int32 -> int32 -> int32) d
                         (simd2 (word_mul : int32 -> int32 -> int32) n m))
                       (COND (esize = 16)
                         (simd4 (word_add : int16 -> int16 -> int16) d
                           (simd4 (word_mul : int16 -> int16 -> int16) n m))
                         (simd8 (word_add : byte -> byte -> byte) d
                           (simd8 (word_mul : byte -> byte -> byte) n m))) in
                 := Rd (word_zx d' : int128) s)))

definition arm_MOVI
  |- (arm_MOVI : (armstate, 'N word) component -> int64 -> armstate -> armstate -> bool)
     = (specification "arm_MOVI" arm_MOVI:((armstate, 'N word) component -> int64 -> armstate ->
           armstate -> bool).
         !Rd:((armstate, 'N word) component) imm:int64.
           arm_MOVI Rd imm
           = (\s:armstate.
               let immN:('N word) =
                   COND (dimindex (UNIV : 'N -> bool) = 128) (word_join imm imm : 'N word)
                     (word (val imm) : 'N word) in
               := Rd immN s))

definition arm_MOVK
  |- (arm_MOVK : (armstate, 'N word) component -> int16 -> num -> armstate -> armstate -> bool)
     = (specification "arm_MOVK" arm_MOVK:((armstate, 'N word) component -> int16 -> num ->
           armstate -> armstate -> bool).
         !Rd:((armstate, 'N word) component) imm:int16 pos:num.
           arm_MOVK Rd imm pos = := (Rd :> (subword (pos, 16) : ('N word, int16) component)) imm)

definition arm_MOVN
  |- (arm_MOVN : (armstate, 'N word) component -> int16 -> num -> armstate -> armstate -> bool)
     = (specification "arm_MOVN" arm_MOVN:((armstate, 'N word) component -> int16 -> num ->
           armstate -> armstate -> bool).
         !Rd:((armstate, 'N word) component) imm:int16 pos:num.
           arm_MOVN Rd imm pos = := Rd (word_not (word (val imm * 2 EXP pos) : 'N word)))

definition arm_MOVZ
  |- (arm_MOVZ : (armstate, 'N word) component -> int16 -> num -> armstate -> armstate -> bool)
     = (specification "arm_MOVZ" arm_MOVZ:((armstate, 'N word) component -> int16 -> num ->
           armstate -> armstate -> bool).
         !Rd:((armstate, 'N word) component) imm:int16 pos:num.
           arm_MOVZ Rd imm pos = := Rd (word (val imm * 2 EXP pos) : 'N word))

definition arm_FMOV_FtoI
  |- (arm_FMOV_FtoI : ('?1, '?2 word) component -> ('?1, int128) component -> num -> num -> '?1 ->
         '?1 -> bool)
     = (specification "arm_FMOV_FtoI" arm_FMOV_FtoI:(('?1, '?2 word) component ->
           ('?1, int128) component -> num -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, '?2 word) component) Rn:(('?1, int128) component) part:num esize:num.
           arm_FMOV_FtoI Rd Rn part esize
           = (\s:'?1.
               let n:int128 = read Rn s in
               let intval:('?2 word) = (word_subword n (part * esize, esize) : '?2 word) in
               := Rd intval s))

definition arm_FMOV_ItoF
  |- (arm_FMOV_ItoF : ('?1, int128) component -> ('?1, int64) component -> num -> '?1 -> '?1 ->
         bool)
     = (specification "arm_FMOV_ItoF" arm_FMOV_ItoF:(('?1, int128) component ->
           ('?1, int64) component -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int64) component) part:num.
           arm_FMOV_ItoF Rd Rn part
           = (\s:'?1.
               let fltval:int64 = read Rn s in
               let d:int128 = read Rd s in
               COND (part = 0) (:= Rd (word_zx fltval : int128) s)
                 (:= Rd (word_insert d (64, 64) fltval : int128) s)))

definition arm_MSUB
  |- (arm_MSUB : ('?1, 'N word) component -> ('?1, 'N word) component -> ('?1, 'N word) component ->
         ('?1, 'N word) component -> '?1 -> '?1 -> bool)
     = (specification "arm_MSUB" arm_MSUB:(('?1, 'N word) component -> ('?1, 'N word) component ->
           ('?1, 'N word) component -> ('?1, 'N word) component -> '?1 -> '?1 -> bool).
         !Rd:(('?1, 'N word) component) Rn:(('?1, 'N word) component) Rm:(('?1, 'N word) component)
          Ra:(('?1, 'N word) component).
           arm_MSUB Rd Rn Rm Ra
           = (\s:'?1.
               let n:('N word) = read Rn s
               and m:('N word) = read Rm s
               and a:('N word) = read Ra s in
               let d:('N word) = (iword (ival a - ival n * ival m) : 'N word) in := Rd d s))

definition arm_MUL_VEC
  |- (arm_MUL_VEC : ('?1, int128) component -> ('?1, int128) component -> ('?1, int128) component ->
         num -> num -> '?1 -> '?1 -> bool)
     = (specification "arm_MUL_VEC" arm_MUL_VEC:(('?1, int128) component ->
           ('?1, int128) component -> ('?1, int128) component -> num -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) Rm:(('?1, int128) component)
          esize:num datasize:num.
           arm_MUL_VEC Rd Rn Rm esize datasize
           = (\s:'?1.
               let n:int128 = read Rn s in
               let m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 32) (simd4 (word_mul : int32 -> int32 -> int32) n m)
                       (COND (esize = 16) (simd8 (word_mul : int16 -> int16 -> int16) n m)
                         (simd16 (word_mul : byte -> byte -> byte) n m)) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let m:int64 = (word_subword m (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (simd2 (word_mul : int32 -> int32 -> int32) n m)
                       (COND (esize = 16) (simd4 (word_mul : int16 -> int16 -> int16) n m)
                         (simd8 (word_mul : byte -> byte -> byte) n m)) in
                 := Rd (word_zx d : int128) s)))

definition arm_PMUL_VEC
  |- (arm_PMUL_VEC : ('?1, int128) component -> ('?1, int128) component ->
         ('?1, int128) component -> num -> '?1 -> '?1 -> bool)
     = (specification "arm_PMUL_VEC" arm_PMUL_VEC:(('?1, int128) component ->
           ('?1, int128) component -> ('?1, int128) component -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) Rm:(('?1, int128) component)
          datasize:num.
           arm_PMUL_VEC Rd Rn Rm datasize
           = (\s:'?1.
               let n:int128 = read Rn s in
               let m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d:int128 = simd16 (word_pmul : byte -> byte -> byte) n m in := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let m:int64 = (word_subword m (0, 64) : int64) in
                 let d:int64 = simd8 (word_pmul : byte -> byte -> byte) n m in
                 := Rd (word_zx d : int128) s)))

definition arm_NOP
  |- arm_NOP = (\s:armstate s':armstate. s = s')

definition arm_BTI
  |- arm_BTI = (\s:armstate s':armstate. s = s')

definition arm_ORN
  |- (arm_ORN : ('?1, 'N word) component -> ('?1, 'N word) component -> ('?1, 'N word) component ->
         '?1 -> '?1 -> bool)
     = (specification "arm_ORN" arm_ORN:(('?1, 'N word) component -> ('?1, 'N word) component ->
           ('?1, 'N word) component -> '?1 -> '?1 -> bool).
         !Rd:(('?1, 'N word) component) Rm:(('?1, 'N word) component) Rn:(('?1, 'N word) component).
           arm_ORN Rd Rm Rn
           = (\s:'?1.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s in
               let d:('N word) = word_or m (word_not n) in := Rd d s))

definition arm_ORR
  |- (arm_ORR : ('?1, 'N word) component -> ('?1, 'N word) component -> ('?1, 'N word) component ->
         '?1 -> '?1 -> bool)
     = (specification "arm_ORR" arm_ORR:(('?1, 'N word) component -> ('?1, 'N word) component ->
           ('?1, 'N word) component -> '?1 -> '?1 -> bool).
         !Rd:(('?1, 'N word) component) Rm:(('?1, 'N word) component) Rn:(('?1, 'N word) component).
           arm_ORR Rd Rm Rn
           = (\s:'?1.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s in
               let d:('N word) = word_or m n in := Rd d s))

definition arm_ORR_VEC
  |- (arm_ORR_VEC : ('?1, int128) component -> ('?1, int128) component -> ('?1, int128) component ->
         num -> '?1 -> '?1 -> bool)
     = (specification "arm_ORR_VEC" arm_ORR_VEC:(('?1, int128) component ->
           ('?1, int128) component -> ('?1, int128) component -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) Rm:(('?1, int128) component)
          datasize:num.
           arm_ORR_VEC Rd Rn Rm datasize
           = (\s:'?1.
               let m:int128 = read Rm s
               and n:int128 = read Rn s in
               COND (datasize = 128) (let d:int128 = word_or m n in := Rd d s)
                 (let d:int64 = (word_subword (word_or m n) (0, 64) : int64) in
                 := Rd (word_zx d : int128) s)))

definition arm_RET
  |- arm_RET
     = (specification "arm_RET" arm_RET:((armstate, int64) component -> armstate -> armstate ->
           bool).
         !Rn:((armstate, int64) component).
           arm_RET Rn
           = (\s:armstate.
               let pc:int64 = word_sub (read PC s) (word 4 : int64) in
               let pc_next:int64 = read Rn s in
               (,,) (:= PC pc_next) (:= events (CONS (EventJump (pc, pc_next)) (read events s))) s))

definition arm_REV
  |- (arm_REV : ('?1, ((('?2 tybit0) tybit0) tybit0) word) component ->
         ('?1, ((('?2 tybit0) tybit0) tybit0) word) component -> '?1 -> '?1 -> bool)
     = (specification "arm_REV" arm_REV:(('?1, ((('?2 tybit0) tybit0) tybit0) word) component ->
           ('?1, ((('?2 tybit0) tybit0) tybit0) word) component -> '?1 -> '?1 -> bool).
         !Rd:(('?1, ((('?2 tybit0) tybit0) tybit0) word) component)
          Rn:(('?1, ((('?2 tybit0) tybit0) tybit0) word) component).
           arm_REV Rd Rn
           = (\s:'?1.
               let n:(((('?2 tybit0) tybit0) tybit0) word) = read Rn s in
               let d:(((('?2 tybit0) tybit0) tybit0) word) = word_bytereverse n in := Rd d s))

definition arm_REV64_VEC
  |- arm_REV64_VEC
     = (specification "arm_REV64_VEC" arm_REV64_VEC:((armstate, int128) component ->
           (armstate, int128) component -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component) esize:num.
           arm_REV64_VEC Rd Rn esize
           = (\s:armstate.
               let n:int128 = read Rn s in
               let n_reversed32:int128 =
                   usimd2
                     (\x:int64.
                       (word_join (word_subword x (0, 32) : int32) (word_subword x (32, 32) : int32)
                         : int64))
                     n in
               COND (esize = 32) (:= Rd n_reversed32 s)
                 (let n_reversed16:int128 =
                     usimd4
                       (\x:int32.
                         (word_join (word_subword x (0, 16) : int16)
                           (word_subword x (16, 16) : int16)
                           : int32))
                       n_reversed32 in
                 COND (esize = 16) (:= Rd n_reversed16 s)
                   (let n_reversed8:int128 =
                       usimd8
                         (\x:int16.
                           (word_join (word_subword x (0, 8) : byte) (word_subword x (8, 8) : byte)
                             : int16))
                         n_reversed16 in
                   := Rd n_reversed8 s))))

definition arm_REV32_VEC
  |- arm_REV32_VEC
     = (specification "arm_REV32_VEC" arm_REV32_VEC:((armstate, int128) component ->
           (armstate, int128) component -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component) esize:num.
           arm_REV32_VEC Rd Rn esize
           = (\s:armstate.
               let n:int128 = read Rn s in
               let n_reversed:int128 = usimd4 (word_reversefields esize : int32 -> int32) n in
               := Rd n_reversed s))

definition arm_RORV
  |- (arm_RORV : ('?1, 'N word) component -> ('?1, 'N word) component -> ('?1, 'N word) component ->
         '?1 -> '?1 -> bool)
     = (specification "arm_RORV" arm_RORV:(('?1, 'N word) component -> ('?1, 'N word) component ->
           ('?1, 'N word) component -> '?1 -> '?1 -> bool).
         !Rd:(('?1, 'N word) component) Rm:(('?1, 'N word) component) Rn:(('?1, 'N word) component).
           arm_RORV Rd Rm Rn
           = (\s:'?1.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s in
               let d:('N word) = word_jror m n in := Rd d s))

definition arm_SBC
  |- (arm_SBC : (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, 'N word) component -> armstate -> armstate -> bool)
     = (specification "arm_SBC" arm_SBC:((armstate, 'N word) component ->
           (armstate, 'N word) component -> (armstate, 'N word) component -> armstate -> armstate ->
           bool).
         !Rd:((armstate, 'N word) component) Rm:((armstate, 'N word) component)
          Rn:((armstate, 'N word) component).
           arm_SBC Rd Rm Rn
           = (\s:armstate.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s
               and c:num = bitval (~ (read CF s)) in
               let d:('N word) = word_sub m (word_add n (word c : 'N word)) in := Rd d s))

definition arm_SBCS
  |- (arm_SBCS : (armstate, 'N word) component -> (armstate, 'N word) component ->
         (armstate, 'N word) component -> armstate -> armstate -> bool)
     = (specification "arm_SBCS" arm_SBCS:((armstate, 'N word) component ->
           (armstate, 'N word) component -> (armstate, 'N word) component -> armstate -> armstate ->
           bool).
         !Rd:((armstate, 'N word) component) Rm:((armstate, 'N word) component)
          Rn:((armstate, 'N word) component).
           arm_SBCS Rd Rm Rn
           = (\s:armstate.
               let m:('N word) = read Rm s
               and n:('N word) = read Rn s
               and c:num = bitval (~ (read CF s)) in
               let d:('N word) = word_sub m (word_add n (word c : 'N word)) in
               (,,) (:= Rd d)
                 (:= NF (ival d < &0)
                 ,, := ZF (val d = 0)
                 ,, := CF (int_of_num (val m) - (int_of_num (val n) + int_of_num c)
                    = int_of_num (val d))
                 ,, := VF (~ (ival m - (ival n + int_of_num c) = ival d)))
                 s))

definition arm_SBFM
  |- (arm_SBFM : (armstate, 'N word) component -> (armstate, 'N word) component -> num -> num ->
         armstate -> armstate -> bool)
     = (specification "arm_SBFM" arm_SBFM:((armstate, 'N word) component ->
           (armstate, 'N word) component -> num -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, 'N word) component) Rn:((armstate, 'N word) component) immr:num imms:num.
           arm_SBFM Rd Rn immr imms
           = (\s:armstate.
               let x:('N word) = read Rn s in
               let y:('N word) =
                   COND (imms >= immr)
                     (word_sxfrom (imms - immr) (word_subword x (immr, imms - immr + 1) : 'N word))
                     (word_sxfrom (dimindex (UNIV : 'N -> bool) - (immr - imms))
                       (word_shl (word_subword x (0, imms + 1) : 'N word)
                         (dimindex (UNIV : 'N -> bool) - immr))) in
               := Rd y s))

definition arm_SHL_VEC
  |- (arm_SHL_VEC : ('?1, int128) component -> ('?1, int128) component -> num -> num -> num ->
         '?1 -> '?1 -> bool)
     = (specification "arm_SHL_VEC" arm_SHL_VEC:(('?1, int128) component ->
           ('?1, int128) component -> num -> num -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) amt:num esize:num datasize:num.
           arm_SHL_VEC Rd Rn amt esize datasize
           = (\s:'?1.
               let n:int128 = read Rn s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (usimd2 (\x:int64. word_shl x amt) n)
                       (COND (esize = 32) (usimd4 (\x:int32. word_shl x amt) n)
                         (COND (esize = 16) (usimd8 (\x:int16. word_shl x amt) n)
                           (usimd16 (\x:byte. word_shl x amt) n))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (usimd2 (\x:int32. word_shl x amt) n)
                       (COND (esize = 16) (usimd4 (\x:int16. word_shl x amt) n)
                         (usimd8 (\x:byte. word_shl x amt) n)) in
                 := Rd (word_zx d : int128) s)))

definition word_ishr_round
  |- (word_ishr_round : 'N word -> num -> 'N word)
     = (\_1:('N word) _2:num. (iword ((ival _1 + &2 pow _2 div &2) div &2 pow _2) : 'N word))

definition arm_SRSHR_VEC
  |- arm_SRSHR_VEC
     = (specification "arm_SRSHR_VEC" arm_SRSHR_VEC:((armstate, int128) component ->
           (armstate, int128) component -> num -> num -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component) amt:num esize:num
          datasize:num.
           arm_SRSHR_VEC Rd Rn amt esize datasize
           = (\s:armstate.
               let n:int128 = read Rn s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (usimd2 (\x:int64. word_ishr_round x amt) n)
                       (COND (esize = 32) (usimd4 (\x:int32. word_ishr_round x amt) n)
                         (COND (esize = 16) (usimd8 (\x:int16. word_ishr_round x amt) n)
                           (usimd16 (\x:byte. word_ishr_round x amt) n))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (usimd2 (\x:int32. word_ishr_round x amt) n)
                       (COND (esize = 16) (usimd4 (\x:int16. word_ishr_round x amt) n)
                         (usimd8 (\x:byte. word_ishr_round x amt) n)) in
                 := Rd (word_zx d : int128) s)))

definition arm_SSHR_VEC
  |- arm_SSHR_VEC
     = (specification "arm_SSHR_VEC" arm_SSHR_VEC:((armstate, int128) component ->
           (armstate, int128) component -> num -> num -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component) amt:num esize:num
          datasize:num.
           arm_SSHR_VEC Rd Rn amt esize datasize
           = (\s:armstate.
               let n:int128 = read Rn s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (usimd2 (\x:int64. word_ishr x amt) n)
                       (COND (esize = 32) (usimd4 (\x:int32. word_ishr x amt) n)
                         (COND (esize = 16) (usimd8 (\x:int16. word_ishr x amt) n)
                           (usimd16 (\x:byte. word_ishr x amt) n))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (usimd2 (\x:int32. word_ishr x amt) n)
                       (COND (esize = 16) (usimd4 (\x:int16. word_ishr x amt) n)
                         (usimd8 (\x:byte. word_ishr x amt) n)) in
                 := Rd (word_zx d : int128) s)))

definition arm_SLI_VEC
  |- (arm_SLI_VEC : ('?1, int128) component -> ('?1, int128) component -> num -> num -> num ->
         '?1 -> '?1 -> bool)
     = (specification "arm_SLI_VEC" arm_SLI_VEC:(('?1, int128) component ->
           ('?1, int128) component -> num -> num -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) shiftamnt:num datasize:num
          esize:num.
           arm_SLI_VEC Rd Rn shiftamnt datasize esize
           = (\s:'?1.
               let n:int128 = read Rn s
               and d:int128 = read Rd s in
               let mask:num = 2 EXP shiftamnt - 1 in
               let op8:(byte -> byte -> byte) =
                   \ni:byte di:byte.
                     word_or (word_shl ni shiftamnt) (word_and di (word mask : byte)) in
               let op16:(int16 -> int16 -> int16) =
                   \ni:int16 di:int16.
                     word_or (word_shl ni shiftamnt) (word_and di (word mask : int16)) in
               let op32:(int32 -> int32 -> int32) =
                   \ni:int32 di:int32.
                     word_or (word_shl ni shiftamnt) (word_and di (word mask : int32)) in
               let op64:(int64 -> int64 -> int64) =
                   \ni:int64 di:int64.
                     word_or (word_shl ni shiftamnt) (word_and di (word mask : int64)) in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (simd2 op64 n d)
                       (COND (esize = 32) (simd4 op32 n d)
                         (COND (esize = 16) (simd8 op16 n d) (simd16 op8 n d))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let d:int64 = (word_subword d (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (simd2 op32 n d)
                       (COND (esize = 16) (simd4 op16 n d) (simd8 op8 n d)) in
                 := Rd (word_zx d : int128) s)))

definition arm_SRI_VEC
  |- (arm_SRI_VEC : ('?1, int128) component -> ('?1, int128) component -> num -> num -> num ->
         '?1 -> '?1 -> bool)
     = (specification "arm_SRI_VEC" arm_SRI_VEC:(('?1, int128) component ->
           ('?1, int128) component -> num -> num -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) shiftamnt:num esize:num
          datasize:num.
           arm_SRI_VEC Rd Rn shiftamnt esize datasize
           = (\s:'?1.
               let n:int128 = read Rn s in
               let d:int128 = read Rd s in
               let mask:num = 2 EXP (esize - shiftamnt) - 1 in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64)
                       (simd2
                         (\ni:int64 di:int64.
                           word_or (word_ushr ni shiftamnt)
                             (word_and di (word_not (word mask : int64))))
                         n
                         d)
                       (COND (esize = 32)
                         (simd4
                           (\ni:int32 di:int32.
                             word_or (word_ushr ni shiftamnt)
                               (word_and di (word_not (word mask : int32))))
                           n
                           d)
                         (COND (esize = 16)
                           (simd8
                             (\ni:int16 di:int16.
                               word_or (word_ushr ni shiftamnt)
                                 (word_and di (word_not (word mask : int16))))
                             n
                             d)
                           (simd16
                             (\ni:byte di:byte.
                               word_or (word_ushr ni shiftamnt)
                                 (word_and di (word_not (word mask : byte))))
                             n
                             d))) in
                 := Rd d s)
                 (let nd:int64 = (word_subword n (0, 64) : int64) in
                 let dd:int64 = (word_subword d (0, 64) : int64) in
                 let dd:int64 =
                     COND (esize = 32)
                       (simd2
                         (\ni:int32 di:int32.
                           word_or (word_ushr ni shiftamnt)
                             (word_and di (word_not (word mask : int32))))
                         nd
                         dd)
                       (COND (esize = 16)
                         (simd4
                           (\ni:int16 di:int16.
                             word_or (word_ushr ni shiftamnt)
                               (word_and di (word_not (word mask : int16))))
                           nd
                           dd)
                         (simd8
                           (\ni:byte di:byte.
                             word_or (word_ushr ni shiftamnt)
                               (word_and di (word_not (word mask : byte))))
                           nd
                           dd)) in
                 := Rd (word_zx dd : int128) s)))

definition arm_SHRN
  |- (arm_SHRN : ('?1, '?2 word) component -> ('?1, int128) component -> num -> num -> '?1 -> '?1 ->
         bool)
     = (specification "arm_SHRN" arm_SHRN:(('?1, '?2 word) component -> ('?1, int128) component ->
           num -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, '?2 word) component) Rn:(('?1, int128) component) amnt:num esize:num.
           arm_SHRN Rd Rn amnt esize
           = (\s:'?1.
               let n:int128 = read Rn s in
               let res:int64 =
                   COND (esize = 32)
                     (usimd2 (\x:int64. (word_subword (word_ushr x amnt) (0, 32) : int32)) n)
                     (COND (esize = 16)
                       (usimd4 (\x:int32. (word_subword (word_ushr x amnt) (0, 16) : int16)) n)
                       (usimd8 (\x:int16. (word_subword (word_ushr x amnt) (0, 8) : byte)) n)) in
               := Rd (word_subword res (0, 128) : '?2 word) s))

definition word_uqshrun
  |- (word_uqshrun : 'N word -> num -> 'M word)
     = (\_1:('N word) _2:num.
         let v:int = ival _1 div &2 pow _2 in
         COND (v < &0) (word 0 : 'M word) (COND (v > &2 pow dimindex (UNIV : 'M -> bool) - &1)
           (word (2 EXP dimindex (UNIV : 'M -> bool) - 1) : 'M word)
           (iword v : 'M word)))

definition word_uqrshrun
  |- (word_uqrshrun : 'N word -> num -> 'M word)
     = (\_1:('N word) _2:num.
         let v:int = (ival _1 + &2 pow (_2 - 1)) div &2 pow _2 in
         COND (v < &0) (word 0 : 'M word) (COND (v > &2 pow dimindex (UNIV : 'M -> bool) - &1)
           (word (2 EXP dimindex (UNIV : 'M -> bool) - 1) : 'M word)
           (iword v : 'M word)))

definition word_rshrn
  |- (word_rshrn : 'N word -> num -> 'M word)
     = (\_1:('N word) _2:num. (word ((val _1 + 2 EXP (_2 - 1)) DIV 2 EXP _2) : 'M word))

definition arm_SQSHRUN
  |- (arm_SQSHRUN : (armstate, '?1 word) component -> (armstate, int128) component -> num -> num ->
         armstate -> armstate -> bool)
     = (specification "arm_SQSHRUN" arm_SQSHRUN:((armstate, '?1 word) component ->
           (armstate, int128) component -> num -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, '?1 word) component) Rn:((armstate, int128) component) amnt:num esize:num.
           arm_SQSHRUN Rd Rn amnt esize
           = (\s:armstate.
               let n:int128 = read Rn s in
               let res:int64 =
                   COND (esize = 32) (usimd2 (\x:int64. (word_uqshrun x amnt : int32)) n)
                     (COND (esize = 16) (usimd4 (\x:int32. (word_uqshrun x amnt : int16)) n)
                       (usimd8 (\x:int16. (word_uqshrun x amnt : byte)) n)) in
               := Rd (word_subword res (0, 128) : '?1 word) s))

definition arm_SQSHRUN2
  |- arm_SQSHRUN2
     = (specification "arm_SQSHRUN2" arm_SQSHRUN2:((armstate, int128) component ->
           (armstate, int128) component -> num -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component) amnt:num esize:num.
           arm_SQSHRUN2 Rd Rn amnt esize
           = (\s:armstate.
               let n:int128 = read Rn s in
               let d:int128 = read Rd s in
               let res:int64 =
                   COND (esize = 32) (usimd2 (\x:int64. (word_uqshrun x amnt : int32)) n)
                     (COND (esize = 16) (usimd4 (\x:int32. (word_uqshrun x amnt : int16)) n)
                       (usimd8 (\x:int16. (word_uqshrun x amnt : byte)) n)) in
               := Rd (word_join res (word_subword d (0, 64) : int64) : int128) s))

definition arm_SQRSHRUN
  |- (arm_SQRSHRUN : (armstate, '?1 word) component -> (armstate, int128) component -> num -> num ->
         armstate -> armstate -> bool)
     = (specification "arm_SQRSHRUN" arm_SQRSHRUN:((armstate, '?1 word) component ->
           (armstate, int128) component -> num -> num -> armstate -> armstate -> bool).
