definition _<LSL>
  |- _<LSL> = _mk_regshift (CONSTR 0 (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition _<LSR>
  |- _<LSR> = _mk_regshift (CONSTR (SUC 0) (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition _<ASR>
  |- _<ASR> = _mk_regshift (CONSTR (SUC (SUC 0)) (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition _<ROR>
  |- _<ROR>
     = _mk_regshift (CONSTR (SUC (SUC (SUC 0))) (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition LSL
  |- LSL = _<LSL>

definition LSR
  |- LSR = _<LSR>

definition ASR
  |- ASR = _<ASR>

definition ROR
  |- ROR = _<ROR>

definition regshift_operation
  |- (regshift_operation : regshift -> '?1 word -> num -> '?1 word)
     = (specification "regshift_operation" regshift_operation:(regshift -> '?1 word -> num ->
           '?1 word).
         regshift_operation LSL = (word_shl : '?1 word -> num -> '?1 word)
         /\ regshift_operation LSR = (word_ushr : '?1 word -> num -> '?1 word)
         /\ regshift_operation ASR = (word_ishr : '?1 word -> num -> '?1 word)
         /\ regshift_operation ROR = (word_ror : '?1 word -> num -> '?1 word))

definition Shiftedreg
  |- (Shiftedreg : ('?1, '?2 word) component -> regshift -> num -> ('?1, '?2 word) component)
     = (specification "Shiftedreg" Shiftedreg:(('?1, '?2 word) component -> regshift -> num ->
           ('?1, '?2 word) component).
         !reg:(('?1, '?2 word) component) sty:regshift sam:num.
           Shiftedreg reg sty sam
           = component ((\s:'?1. regshift_operation sty (read reg s) sam), write reg))

definition _<UXTB>
  |- _<UXTB> = _mk_extendtype (CONSTR 0 (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition _<UXTH>
  |- _<UXTH> = _mk_extendtype (CONSTR (SUC 0) (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition _<UXTW>
  |- _<UXTW> = _mk_extendtype (CONSTR (SUC (SUC 0)) (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition _<UXTX>
  |- _<UXTX>
     = _mk_extendtype (CONSTR (SUC (SUC (SUC 0))) (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition _<SXTB>
  |- _<SXTB>
     = _mk_extendtype (CONSTR (SUC (SUC (SUC (SUC 0)))) (@x:bool. T)
         (\n:num. (BOTTOM : bool recspace)))

definition _<SXTH>
  |- _<SXTH>
     = _mk_extendtype (CONSTR (SUC (SUC (SUC (SUC (SUC 0))))) (@x:bool. T)
         (\n:num. (BOTTOM : bool recspace)))

definition _<SXTW>
  |- _<SXTW>
     = _mk_extendtype (CONSTR (SUC (SUC (SUC (SUC (SUC (SUC 0)))))) (@x:bool. T)
         (\n:num. (BOTTOM : bool recspace)))

definition _<SXTX>
  |- _<SXTX>
     = _mk_extendtype (CONSTR (SUC (SUC (SUC (SUC (SUC (SUC (SUC 0))))))) (@x:bool. T)
         (\n:num. (BOTTOM : bool recspace)))

definition UXTB
  |- UXTB = _<UXTB>

definition UXTH
  |- UXTH = _<UXTH>

definition UXTW
  |- UXTW = _<UXTW>

definition UXTX
  |- UXTX = _<UXTX>

definition SXTB
  |- SXTB = _<SXTB>

definition SXTH
  |- SXTH = _<SXTH>

definition SXTW
  |- SXTW = _<SXTW>

definition SXTX
  |- SXTX = _<SXTX>

definition extendreg_operation
  |- (extendreg_operation : extendtype -> '?1 word -> '?2 word)
     = (specification "extendreg_operation" extendreg_operation:(extendtype -> '?1 word ->
           '?2 word).
         (!x:('?1 word). extendreg_operation UXTB x = (word_zx (word_zx x : byte) : '?2 word))
         /\ (!x:('?1 word). extendreg_operation UXTH x = (word_zx (word_zx x : int16) : '?2 word))
         /\ (!x:('?1 word). extendreg_operation UXTW x = (word_zx (word_zx x : int32) : '?2 word))
         /\ (!x:('?1 word). extendreg_operation UXTX x = (word_zx (word_zx x : int64) : '?2 word))
         /\ (!x:('?1 word). extendreg_operation SXTB x = (word_sx (word_zx x : byte) : '?2 word))
         /\ (!x:('?1 word). extendreg_operation SXTH x = (word_sx (word_zx x : int16) : '?2 word))
         /\ (!x:('?1 word). extendreg_operation SXTW x = (word_sx (word_zx x : int32) : '?2 word))
         /\ (!x:('?1 word). extendreg_operation SXTX x = (word_sx (word_zx x : int64) : '?2 word)))

definition Extendedreg
  |- (Extendedreg : ('?1, '?2 word) component -> extendtype -> ('?1, '?3 word) component)
     = (specification "Extendedreg" Extendedreg:(('?1, '?2 word) component -> extendtype ->
           ('?1, '?3 word) component).
         !reg:(('?1, '?2 word) component) ety:extendtype.
           Extendedreg reg ety
           = component ((\s:'?1. (extendreg_operation ety (read reg s) : '?3 word))
             , (ARB : '?3 word -> '?1 -> '?1)))

definition QREG
  |- QREG
     = (specification "QREG" QREG:(num -> (armstate, int128) component).
         !n:num.
           QREG n
           = simdregisters :> (element (word n : 5 word) : (5 word -> int128, int128) component))

definition DREG
  |- DREG
     = (specification "DREG" DREG:(num -> (armstate, int64) component).
         !n:num. DREG n = QREG n :> zerotop_64)

definition SREG
  |- SREG
     = (specification "SREG" SREG:(num -> (armstate, int32) component).
         !n:num. SREG n = DREG n :> zerotop_32)

definition HREG
  |- HREG
     = (specification "HREG" HREG:(num -> (armstate, int16) component).
         !n:num. HREG n = SREG n :> zerotop_16)

definition BREG
  |- BREG
     = (specification "BREG" BREG:(num -> (armstate, byte) component).
         !n:num. BREG n = HREG n :> zerotop_8)

