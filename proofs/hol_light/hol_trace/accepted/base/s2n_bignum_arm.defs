         '?1 -> bool)
     = (specification "arm_USHLL2_VEC" arm_USHLL2_VEC:(('?1, int128) component ->
           ('?1, int128) component -> num -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) shift:num esize:num.
           arm_USHLL2_VEC Rd Rn shift esize
           = (\s:'?1.
               let nl:int64 = (word_subword (read Rn s) (64, 64) : int64) in
               COND (esize = 32)
                 (let r:int128 = usimd2 (\x:int32. word_shl (word_zx x : int64) shift) nl in
                 := Rd r s)
                 (COND (esize = 16)
                   (let r:int128 = usimd4 (\x:int16. word_shl (word_zx x : int32) shift) nl in
                   := Rd r s)
                   (let r:int128 = usimd8 (\x:byte. word_shl (word_zx x : int16) shift) nl in
                   := Rd r s))))

definition arm_SSHLL_VEC
  |- (arm_SSHLL_VEC : ('?1, int128) component -> ('?1, int128) component -> num -> num -> '?1 ->
         '?1 -> bool)
     = (specification "arm_SSHLL_VEC" arm_SSHLL_VEC:(('?1, int128) component ->
           ('?1, int128) component -> num -> num -> '?1 -> '?1 -> bool).
         !Rd:(('?1, int128) component) Rn:(('?1, int128) component) shift:num esize:num.
           arm_SSHLL_VEC Rd Rn shift esize
           = (\s:'?1.
               let nl:int64 = (word_subword (read Rn s) (0, 64) : int64) in
               COND (esize = 32)
                 (let r:int128 = usimd2 (\x:int32. word_shl (word_sx x : int64) shift) nl in
                 := Rd r s)
                 (COND (esize = 16)
                   (let r:int128 = usimd4 (\x:int16. word_shl (word_sx x : int32) shift) nl in
                   := Rd r s)
                   (let r:int128 = usimd8 (\x:byte. word_shl (word_sx x : int16) shift) nl in
                   := Rd r s))))

definition arm_SSHLL2_VEC
  |- (arm_SSHLL2_VEC : ('?1, int128) component -> ('?1, int128) component -> num -> num -> '?1 ->
         '?1 -> bool)
     = (specification "arm_SSHLL2_VEC" arm_SSHLL2_VEC:(('?1, int128) component ->
           ('?1, int128) component -> num -> num -> '?1 -> '?1 -> bool).
