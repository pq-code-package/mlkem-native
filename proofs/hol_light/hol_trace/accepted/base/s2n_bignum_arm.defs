definition arm_LD2
  |- (= arm_LD2
       (@
         (\arm_LD2:((num # num # num # num # num # num # num) -> (component armstate (word #128)) -> (component armstate (word #128)) -> (component armstate (word #64)) -> offset -> num -> num -> armstate -> armstate -> bool).
           (!_1:(num # num # num # num # num # num # num) Rt:(component armstate (word #128)) Rtt:(component armstate (word #128)) Rn:(component armstate (word #64)) off:offset datasize:num esize:num.
             (= (arm_LD2 _1 Rt Rtt Rn off datasize esize)
               (\s:armstate.
                 (LET
                   (\address:(word #64).
                     (LET_END
                       (LET
                         (\eaddr:(word #64).
                           (LET_END
                             (COND
                               (/\ (==> (= Rn SP) (aligned #16 address))
                                 (==> (offset_writesback off) (orthogonal_components Rt Rn)))
                               (COND (= datasize #128)
                                 (LET
                                   (\tmp:(word #256).
                                     (LET_END
                                       (LET
                                         (\x:(word #128).
                                           (LET_END
                                             (LET
                                               (\y:(word #128).
                                                 (LET_END
                                                   (,, (":=" Rt x)
                                                     (,, (":=" Rtt y)
                                                       (,,
                                                         (":=" events
                                                           (CONS (EventLoad (, eaddr #32))
                                                             (read events s)))
                                                         (COND (offset_writesback off)
                                                           (":=" Rn
                                                             (word_add address
                                                               (offset_writeback off s)))
                                                           =:(armstate -> armstate -> bool)))))))
                                               (COND (= esize #64) (word_deinterleave2_y tmp)
                                                 (COND (= esize #32) (word_deinterleave4_y tmp)
                                                   (COND (= esize #16) (word_deinterleave8_y tmp)
                                                     (word_deinterleave16_y tmp)))))))
                                         (COND (= esize #64) (word_deinterleave2_x tmp)
                                           (COND (= esize #32) (word_deinterleave4_x tmp)
                                             (COND (= esize #16) (word_deinterleave8_x tmp)
                                               (word_deinterleave16_x tmp)))))))
                                   (read
                                     (":>" memory
                                       (wbytes:((word #64) -> (component ((word #64) -> (word #8)) (word #256)))
                                         eaddr))
                                     s))
                                 (LET
                                   (\tmp:(word #128).
                                     (LET_END
                                       (LET
                                         (\x:(word #64).
                                           (LET_END
                                             (LET
                                               (\y:(word #64).
                                                 (LET_END
                                                   (,,
                                                     (":=" Rt (word_zx:((word #64) -> (word #128)) x))
                                                     (,,
                                                       (":=" Rtt
                                                         (word_zx:((word #64) -> (word #128)) y))
                                                       (,,
                                                         (":=" events
                                                           (CONS (EventLoad (, eaddr #16))
                                                             (read events s)))
                                                         (COND (offset_writesback off)
                                                           (":=" Rn
                                                             (word_add address
                                                               (offset_writeback off s)))
                                                           =:(armstate -> armstate -> bool)))))))
                                               (COND (= esize #32) (word_deinterleave2_y tmp)
                                                 (COND (= esize #16) (word_deinterleave4_y tmp)
                                                   (word_deinterleave8_y tmp))))))
                                         (COND (= esize #32) (word_deinterleave2_x tmp)
                                           (COND (= esize #16) (word_deinterleave4_x tmp)
                                             (word_deinterleave8_x tmp))))))
                                   (read
                                     (":>" memory
                                       (wbytes:((word #64) -> (component ((word #64) -> (word #8)) (word #128)))
                                         eaddr))
                                     s)))
