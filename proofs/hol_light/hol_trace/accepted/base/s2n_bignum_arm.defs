definition arm_movop
  |- (arm_movop : 2 word -> (armstate, 'N word) component -> int16 -> num ->
         (armstate -> armstate -> bool) option)
     = (\_1:(2 word) _2:((armstate, 'N word) component) _3:int16 _4:num.
         _BITMATCH _1 (_SEQPATTERN
           (\"BM%PVAR%12":num "BM%PVAR%13":((armstate -> armstate -> bool) option).
             _UNGUARDED_PATTERN (pat_set (CONSPAT NILPAT (word 0 : 2 word)) "BM%PVAR%12")
               (SOME (arm_MOVN _2 _3 _4) = "BM%PVAR%13"))
