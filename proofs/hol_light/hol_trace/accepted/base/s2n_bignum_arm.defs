     = (specification "arm_Bcond" arm_Bcond:(condition -> 21 word -> armstate -> armstate -> bool).
         !cc:condition off:(21 word).
           arm_Bcond cc off
           = (\s:armstate.
               let pc:int64 = word_sub (read PC s) (word 4 : int64) in
               let pc_next:int64 =
                   COND (condition_semantics cc s) (word_add pc (word_sx off : int64))
