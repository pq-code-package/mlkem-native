definition SP
  |- SP
     = (specification "SP" SP:((armstate, int64) component).
         SP = registers :> (element (word 31 : 5 word) : (5 word -> int64, int64) component))

definition WREG
  |- WREG
     = (specification "WREG" WREG:(num -> (armstate, int32) component).
         !n:num. WREG n = XREG n :> zerotop_32)

definition WSP
  |- WSP = (specification "WSP" WSP:((armstate, int32) component). WSP = SP :> zerotop_32)

definition W0
  |- W0 = (specification "W0" W0:((armstate, int32) component). W0 = WREG 0)

definition W1
  |- W1 = (specification "W1" W1:((armstate, int32) component). W1 = WREG 1)

