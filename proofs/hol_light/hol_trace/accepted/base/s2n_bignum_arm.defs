               let n:int128 = read Rn s in
               let m:int128 = read Rm s in
               COND (esize = 64)
                 (let nodd:int64 = (word_subword n (64, 64) : int64) in
                 let modd:int64 = (word_subword m (64, 64) : int64) in
                 := Rd (word_join modd nodd : int128) s)
                 (COND (esize = 32)
                   (let nodd:int64 = usimd2 (\x:int64. (word_subword x (32, 32) : int32)) n in
                   let modd:int64 = usimd2 (\x:int64. (word_subword x (32, 32) : int32)) m in
                   := Rd (word_join modd nodd : int128) s)
                   (COND (esize = 16)
                     (let nodd:int64 = usimd4 (\x:int32. (word_subword x (16, 16) : int16)) n in
                     let modd:int64 = usimd4 (\x:int32. (word_subword x (16, 16) : int16)) m in
                     := Rd (word_join modd nodd : int128) s)
                     (let nodd:int64 = usimd8 (\x:int16. (word_subword x (8, 8) : byte)) n in
                     let modd:int64 = usimd8 (\x:int16. (word_subword x (8, 8) : byte)) m in
                     := Rd (word_join modd nodd : int128) s)))))

definition arm_XTN
  |- arm_XTN
     = (specification "arm_XTN" arm_XTN:((armstate, int128) component ->
           (armstate, int128) component -> num -> armstate -> armstate -> bool).
