definition arm_ldst
  |- arm_ldst
     = (\_1:bool _2:bool _3:(5 word).
         COND _2
           (COND _1
             (arm_LDR : (armstate, int64) component -> (armstate, int64) component -> offset ->
                 armstate -> armstate -> bool)
             (arm_STR : (armstate, int64) component -> (armstate, int64) component -> offset ->
                 armstate -> armstate -> bool)
             (XREG' _3))
           (COND _1
             (arm_LDR : (armstate, int32) component -> (armstate, int64) component -> offset ->
                 armstate -> armstate -> bool)
             (arm_STR : (armstate, int32) component -> (armstate, int64) component -> offset ->
                 armstate -> armstate -> bool)
