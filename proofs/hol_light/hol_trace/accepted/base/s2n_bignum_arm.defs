             (\"BM%PVAR%12":num "BM%PVAR%13":((armstate -> armstate -> bool) option).
               _UNGUARDED_PATTERN (pat_set (CONSPAT NILPAT (word 2 : 2 word)) "BM%PVAR%12")
                 (SOME (arm_MOVZ _2 _3 _4) = "BM%PVAR%13"))
