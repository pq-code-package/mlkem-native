definition arm_ldstp_4q
  |- arm_ldstp_4q
     = (\_1:bool _2:(5 word).
         let Rt2:(5 word) = (word ((val _2 + 1) MOD 32) : 5 word) in
         let Rt3:(5 word) = (word ((val _2 + 2) MOD 32) : 5 word) in
         let Rt4:(5 word) = (word ((val _2 + 3) MOD 32) : 5 word) in
         COND _1
           (arm_LDP4 : (armstate, int128) component -> (armstate, int128) component ->
               (armstate, int128) component -> (armstate, int128) component ->
