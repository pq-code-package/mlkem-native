definition arm_CINC
  |- (arm_CINC : (armstate, '?1 word) component -> (armstate, '?1 word) component -> condition ->
         armstate -> armstate -> bool)
     = (specification "arm_CINC" arm_CINC:((armstate, '?1 word) component ->
           (armstate, '?1 word) component -> condition -> armstate -> armstate -> bool).
         !Rd:((armstate, '?1 word) component) Rn:((armstate, '?1 word) component) cc:condition.
           arm_CINC Rd Rn cc = arm_CSINC Rd Rn Rn (invert_condition cc))

definition arm_CINV
  |- (arm_CINV : (armstate, '?1 word) component -> (armstate, '?1 word) component -> condition ->
