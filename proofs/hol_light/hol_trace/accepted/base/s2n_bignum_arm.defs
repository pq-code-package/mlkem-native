definition aesd
  |- aesd
     = (\_1:int128 _2:int128. aes_sub_bytes joined_GF2_inv (aes_inv_shift_rows (word_xor _1 _2)))

definition aesimc
  |- aesimc = (\_1:int128. aes_inv_mix_columns _1)

definition _<armstate_RECORD>
  |- _<armstate_RECORD>
     = (\a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word) a4:(int64 -> byte)
         a5:((64 address_uarch_event) list).
         _mk_armstate ((\a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word)
                         a4:(int64 -> byte) a5:((64 address_uarch_event) list).
           CONSTR 0 (a0, a1, a2, a3, a4, a5) (\n:num.
             (BOTTOM : (int64 # (5 word -> int64) # (5 word -> int128) # 4 word # (int64 -> byte) #
                 (64 address_uarch_event) list) recspace))) a0 a1 a2 a3 a4 a5))

definition armstate_RECORD
  |- armstate_RECORD = _<armstate_RECORD>

definition PC
  |- PC
     = (specification "PC" c:((armstate, int64) component).
         (!a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word) a4:(int64 -> byte)
           a5:((64 address_uarch_event) list).
           read c (armstate_RECORD a0 a1 a2 a3 a4 a5) = a0)
         /\ (!a0':int64 a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word)
              a4:(int64 -> byte) a5:((64 address_uarch_event) list).
              write c a0' (armstate_RECORD a0 a1 a2 a3 a4 a5) = armstate_RECORD a0' a1 a2 a3 a4 a5))

definition registers
  |- registers
     = (specification "registers" c:((armstate, 5 word -> int64) component).
         (!a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word) a4:(int64 -> byte)
           a5:((64 address_uarch_event) list).
           read c (armstate_RECORD a0 a1 a2 a3 a4 a5) = a1)
         /\ (!a1':(5 word -> int64) a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word)
              a4:(int64 -> byte) a5:((64 address_uarch_event) list).
              write c a1' (armstate_RECORD a0 a1 a2 a3 a4 a5) = armstate_RECORD a0 a1' a2 a3 a4 a5))

definition simdregisters
  |- simdregisters
     = (specification "simdregisters" c:((armstate, 5 word -> int128) component).
         (!a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word) a4:(int64 -> byte)
           a5:((64 address_uarch_event) list).
           read c (armstate_RECORD a0 a1 a2 a3 a4 a5) = a2)
         /\ (!a2':(5 word -> int128) a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word)
              a4:(int64 -> byte) a5:((64 address_uarch_event) list).
              write c a2' (armstate_RECORD a0 a1 a2 a3 a4 a5) = armstate_RECORD a0 a1 a2' a3 a4 a5))

definition flags
  |- flags
     = (specification "flags" c:((armstate, 4 word) component).
         (!a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word) a4:(int64 -> byte)
           a5:((64 address_uarch_event) list).
           read c (armstate_RECORD a0 a1 a2 a3 a4 a5) = a3)
         /\ (!a3':(4 word) a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word)
              a4:(int64 -> byte) a5:((64 address_uarch_event) list).
              write c a3' (armstate_RECORD a0 a1 a2 a3 a4 a5) = armstate_RECORD a0 a1 a2 a3' a4 a5))

definition memory
  |- memory
     = (specification "memory" c:((armstate, int64 -> byte) component).
         (!a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word) a4:(int64 -> byte)
           a5:((64 address_uarch_event) list).
           read c (armstate_RECORD a0 a1 a2 a3 a4 a5) = a4)
         /\ (!a4':(int64 -> byte) a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word)
              a4:(int64 -> byte) a5:((64 address_uarch_event) list).
              write c a4' (armstate_RECORD a0 a1 a2 a3 a4 a5) = armstate_RECORD a0 a1 a2 a3 a4' a5))

definition events
  |- events
     = (specification "events" c:((armstate, (64 address_uarch_event) list) component).
         (!a0:int64 a1:(5 word -> int64) a2:(5 word -> int128) a3:(4 word) a4:(int64 -> byte)
           a5:((64 address_uarch_event) list).
           read c (armstate_RECORD a0 a1 a2 a3 a4 a5) = a5)
         /\ (!a5':((64 address_uarch_event) list) a0:int64 a1:(5 word -> int64)
              a2:(5 word -> int128) a3:(4 word) a4:(int64 -> byte)
              a5:((64 address_uarch_event) list).
              write c a5' (armstate_RECORD a0 a1 a2 a3 a4 a5) = armstate_RECORD a0 a1 a2 a3 a4 a5'))

definition bytes_loaded
  |- bytes_loaded
     = (\_1:armstate _2:int64 _3:(byte list). read (memory :> bytelist (_2, LENGTH _3)) _1 = _3)

definition aligned_bytes_loaded
  |- aligned_bytes_loaded
     = (\_1:armstate _2:int64 _3:(byte list). num_divides 4 (val _2) /\ bytes_loaded _1 _2 _3)

definition NF
  |- NF
     = (specification "NF" NF:((armstate, bool) component).
         NF = flags :> (bitelement 3 : (4 word, bool) component))

definition ZF
  |- ZF
     = (specification "ZF" ZF:((armstate, bool) component).
         ZF = flags :> (bitelement 2 : (4 word, bool) component))

definition CF
  |- CF
     = (specification "CF" CF:((armstate, bool) component).
         CF = flags :> (bitelement 1 : (4 word, bool) component))

definition VF
  |- VF
     = (specification "VF" VF:((armstate, bool) component).
         VF = flags :> (bitelement 0 : (4 word, bool) component))

definition XZR
  |- XZR
     = (specification "XZR" XZR:((armstate, int64) component).
         XZR = (rvalue (word 0 : int64) : (armstate, int64) component))

definition WZR
  |- WZR = (specification "WZR" WZR:((armstate, int32) component). WZR = XZR :> bottom_32)

definition ZR
  |- (ZR : (armstate, 'N word) component)
     = (specification "ZR" ZR:((armstate, 'N word) component).
         ZR = (rvalue (word 0 : 'N word) : (armstate, 'N word) component))

definition XREG
  |- XREG
     = (specification "XREG" XREG:(num -> (armstate, int64) component).
         !n:num.
           XREG n
           = COND (n >= 31) XZR (registers
             :> (element (word n : 5 word) : (5 word -> int64, int64) component)))

definition X0
  |- X0 = (specification "X0" X0:((armstate, int64) component). X0 = XREG 0)

definition X1
  |- X1 = (specification "X1" X1:((armstate, int64) component). X1 = XREG 1)

definition X2
