definition arm_ADRP
  |- arm_ADRP
     = (specification "arm_ADRP" arm_ADRP:((armstate, int64) component -> 21 word -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int64) component) off:(21 word).
           arm_ADRP Rd off
           = (\s:armstate.
               let pc0:int64 = word_sub (read PC s) (word 4 : int64) in
               let pc_page:int64 = word_and pc0 (word 18446744073709547520 : int64) in
               let off0:int64 = (word_sx (word_join off (word 0 : 12 word) : 33 word) : int64) in
               let d:int64 = word_add pc_page off0 in := Rd d s))

