                 (let nlzx:int128 = usimd2 (word_zx : int32 -> int64) nl in
                 let mlzx:int128 = usimd2 (word_zx : int32 -> int64) ml in
                 := Rd (simd2 (word_mul : int64 -> int64 -> int64) nlzx mlzx) s)
                 (COND (esize = 16)
                   (let nlzx:int128 = usimd4 (word_zx : int16 -> int32) nl in
                   let mlzx:int128 = usimd4 (word_zx : int16 -> int32) ml in
                   := Rd (simd4 (word_mul : int32 -> int32 -> int32) nlzx mlzx) s)
                   (let nlzx:int128 = usimd8 (word_zx : byte -> int16) nl in
                   let mlzx:int128 = usimd8 (word_zx : byte -> int16) ml in
                   := Rd (simd8 (word_mul : int16 -> int16 -> int16) nlzx mlzx) s))))

