definition arm_XAR
  |- (arm_XAR : (armstate, int128) component -> (armstate, int128) component ->
         (armstate, int128) component -> '?1 word -> armstate -> armstate -> bool)
     = (specification "arm_XAR" arm_XAR:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> '?1 word -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) imm6:('?1 word).
           arm_XAR Rd Rn Rm imm6
           = (\s:armstate.
               let n:int128 = read Rn s
               and m:int128 = read Rm s in
               let tmp:int128 = word_xor n m in
               let hi:int64 = (word_subword tmp (64, 64) : int64)
               and lo:int64 = (word_subword tmp (0, 64) : int64) in
               let d':int128 =
                   (word_join (word_ror hi (val imm6)) (word_ror lo (val imm6)) : int128) in
               := Rd d' s))

