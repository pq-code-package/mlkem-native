definition LANE_B
  |- LANE_B
     = (specification "LANE_B" LANE_B:(num -> (int128, int128) component).
         !i:num.
           LANE_B i
           = through ((\w:int128. (word_duplicate (word_subword w (8 * i, 8) : byte) : int128))
             , (I : int128 -> int128)))

