           (armstate, '?1 word) component -> armstate -> armstate -> bool).
         !Rm:((armstate, '?1 word) component) Rn:((armstate, '?1 word) component).
           arm_CMN Rm Rn = arm_ADDS (ZR : (armstate, '?1 word) component) Rm Rn)

definition arm_CMP
  |- (arm_CMP : (armstate, '?1 word) component -> (armstate, '?1 word) component -> armstate ->
         armstate -> bool)
     = (specification "arm_CMP" arm_CMP:((armstate, '?1 word) component ->
           (armstate, '?1 word) component -> armstate -> armstate -> bool).
         !Rm:((armstate, '?1 word) component) Rn:((armstate, '?1 word) component).
           arm_CMP Rm Rn = arm_SUBS (ZR : (armstate, '?1 word) component) Rm Rn)

definition arm_CSET
  |- (arm_CSET : (armstate, '?1 word) component -> condition -> armstate -> armstate -> bool)
     = (specification "arm_CSET" arm_CSET:((armstate, '?1 word) component -> condition ->
           armstate -> armstate -> bool).
         !Rd:((armstate, '?1 word) component) cc:condition.
           arm_CSET Rd cc
           = arm_CSINC Rd (ZR : (armstate, '?1 word) component)
               (ZR : (armstate, '?1 word) component)
               (invert_condition cc))

definition arm_CSETM
  |- (arm_CSETM : (armstate, '?1 word) component -> condition -> armstate -> armstate -> bool)
     = (specification "arm_CSETM" arm_CSETM:((armstate, '?1 word) component -> condition ->
           armstate -> armstate -> bool).
         !Rd:((armstate, '?1 word) component) cc:condition.
           arm_CSETM Rd cc
           = arm_CSINV Rd (ZR : (armstate, '?1 word) component)
               (ZR : (armstate, '?1 word) component)
               (invert_condition cc))

