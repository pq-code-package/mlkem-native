definition arm_RAX1
  |- arm_RAX1
     = (specification "arm_RAX1" arm_RAX1:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> armstate -> armstate ->
           bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component).
           arm_RAX1 Rd Rn Rm
           = (\s:armstate.
               let n:int128 = read Rn s
               and m:int128 = read Rm s in
               let hi:int64 = (word_subword m (64, 64) : int64)
               and lo:int64 = (word_subword m (0, 64) : int64) in
               let d':int128 = word_xor n (word_join (word_rol hi 1) (word_rol lo 1) : int128) in
               := Rd d' s))

definition arm_EOR3
  |- arm_EOR3
     = (specification "arm_EOR3" arm_EOR3:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component ->
           (armstate, int128) component -> armstate -> armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) Ra:((armstate, int128) component).
           arm_EOR3 Rd Rn Rm Ra
           = (\s:armstate.
               let n:int128 = read Rn s
               and m:int128 = read Rm s
               and a:int128 = read Ra s in
               let d':int128 = word_xor (word_xor n m) a in := Rd d' s))

definition arm_BCAX
  |- arm_BCAX
     = (specification "arm_BCAX" arm_BCAX:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component ->
           (armstate, int128) component -> armstate -> armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) Ra:((armstate, int128) component).
           arm_BCAX Rd Rn Rm Ra
           = (\s:armstate.
               let n:int128 = read Rn s
               and m:int128 = read Rm s
               and a:int128 = read Ra s in
               let d':int128 = word_xor n (word_and m (word_not a)) in := Rd d' s))

