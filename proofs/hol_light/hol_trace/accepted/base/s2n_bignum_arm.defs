               (SOME (arm_LSLV _2 _3 _4) = "BM%PVAR%15"))
           (_SEQPATTERN
             (\"BM%PVAR%14":num "BM%PVAR%15":((armstate -> armstate -> bool) option).
               _UNGUARDED_PATTERN (pat_set (CONSPAT NILPAT (word 1 : 2 word)) "BM%PVAR%14")
                 (SOME (arm_LSRV _2 _3 _4) = "BM%PVAR%15"))
