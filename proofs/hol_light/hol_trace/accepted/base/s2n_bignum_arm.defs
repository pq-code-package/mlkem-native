           '?1 -> '?1 -> bool).
         !Rd:(('?1, 'N word) component) Rn:(('?1, 'N word) component).
           arm_CLZ Rd Rn = (\s:'?1. := Rd (word (word_clz (read Rn s)) : 'N word) s))

definition arm_CMHI_VEC
  |- arm_CMHI_VEC
     = (specification "arm_CMHI_VEC" arm_CMHI_VEC:((armstate, int128) component ->
           (armstate, int128) component -> (armstate, int128) component -> num -> num -> armstate ->
           armstate -> bool).
         !Rd:((armstate, int128) component) Rn:((armstate, int128) component)
          Rm:((armstate, int128) component) esize:num datasize:num.
           arm_CMHI_VEC Rd Rn Rm esize datasize
           = (\s:armstate.
               let n:int128 = read Rn s in
               let m:int128 = read Rm s in
               COND (datasize = 128)
                 (let d:int128 =
                     COND (esize = 64) (simd2 (masking (word_ugt : int64 -> int64 -> bool)) n m)
                       (COND (esize = 32) (simd4 (masking (word_ugt : int32 -> int32 -> bool)) n m)
                         (COND (esize = 16)
                           (simd8 (masking (word_ugt : int16 -> int16 -> bool)) n m)
                           (simd16 (masking (word_ugt : byte -> byte -> bool)) n m))) in
                 := Rd d s)
                 (let n:int64 = (word_subword n (0, 64) : int64) in
                 let m:int64 = (word_subword m (0, 64) : int64) in
                 let d:int64 =
                     COND (esize = 32) (simd2 (masking (word_ugt : int32 -> int32 -> bool)) n m)
                       (COND (esize = 16) (simd4 (masking (word_ugt : int16 -> int16 -> bool)) n m)
                         (simd8 (masking (word_ugt : byte -> byte -> bool)) n m)) in
                 := Rd (word_zx d : int128) s)))

