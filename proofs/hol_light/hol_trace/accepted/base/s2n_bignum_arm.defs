definition arm_BFM
  |- (arm_BFM : (armstate, 'N word) component -> (armstate, 'N word) component -> num -> num ->
         armstate -> armstate -> bool)
     = (specification "arm_BFM" arm_BFM:((armstate, 'N word) component ->
           (armstate, 'N word) component -> num -> num -> armstate -> armstate -> bool).
         !Rd:((armstate, 'N word) component) Rn:((armstate, 'N word) component) immr:num imms:num.
           arm_BFM Rd Rn immr imms
           = (\s:armstate.
               let x:('N word) = read Rn s
               and d:('N word) = read Rd s in
               let y:('N word) =
                   COND (imms >= immr)
                     (word_insert d (0, imms - immr + 1) (word_ushr x immr) : 'N word)
                     (word_insert d (dimindex (UNIV : 'N -> bool) - immr, imms + 1) x : 'N word) in
               := Rd y s))

