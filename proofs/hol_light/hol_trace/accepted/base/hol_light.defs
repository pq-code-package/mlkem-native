     = (\a0:bool a1:bool a2:bool a3:bool a4:bool a5:bool a6:bool a7:bool.
         _mk_char ((\a0:bool a1:bool a2:bool a3:bool a4:bool a5:bool a6:bool a7:bool.
           CONSTR 0 (a0, a1, a2, a3, a4, a5, a6, a7)
             (\n:num. (BOTTOM : (bool # bool # bool # bool # bool # bool # bool # bool) recspace)))
           a0
           a1
           a2
           a3
           a4
           a5
           a6
           a7))

definition ASCII
  |- ASCII = _<ASCII>

definition dist
  |- dist = (\_1:(num # num). FST _1 - SND _1 + SND _1 - FST _1)

definition is_nadd
  |- is_nadd = (\_1:(num -> num). ?B:num. !m:num n:num. dist (m * _1 n, n * _1 m) <= B * (m + n))

definition nadd_eq
  |- nadd_eq = (\_1:nadd _2:nadd. ?B:num. !n:num. dist (dest_nadd _1 n, dest_nadd _2 n) <= B)

definition nadd_of_num
  |- nadd_of_num = (\_1:num. mk_nadd (\n:num. _1 * n))

definition nadd_le
  |- nadd_le = (\_1:nadd _2:nadd. ?B:num. !n:num. dest_nadd _1 n <= dest_nadd _2 n + B)

definition nadd_add
  |- nadd_add = (\_1:nadd _2:nadd. mk_nadd (\n:num. dest_nadd _1 n + dest_nadd _2 n))

definition nadd_mul
  |- nadd_mul = (\_1:nadd _2:nadd. mk_nadd (\n:num. dest_nadd _1 (dest_nadd _2 n)))

definition nadd_rinv
  |- nadd_rinv = (\_1:nadd n:num. (n * n) DIV dest_nadd _1 n)

definition nadd_inv
  |- nadd_inv
     = (\_1:nadd. COND (nadd_eq _1 (nadd_of_num 0)) (nadd_of_num 0) (mk_nadd (nadd_rinv _1)))

definition hreal_of_num
  |- hreal_of_num = (\m:num. mk_hreal (\u:nadd. nadd_eq (nadd_of_num m) u))

definition hreal_add
  |- hreal_add
     = (\x:hreal y:hreal.
         mk_hreal (\u:nadd.
           ?x:nadd y:nadd.
             nadd_eq (nadd_add x y) u /\ dest_hreal {x:hreal} x /\ dest_hreal {y:hreal} y))

definition hreal_mul
  |- hreal_mul
     = (\x:hreal y:hreal.
         mk_hreal (\u:nadd.
           ?x:nadd y:nadd.
             nadd_eq (nadd_mul x y) u /\ dest_hreal {x:hreal} x /\ dest_hreal {y:hreal} y))

definition hreal_le
  |- hreal_le
     = (\x:hreal y:hreal.
         @u:bool.
           ?x:nadd y:nadd. nadd_le x y = u /\ dest_hreal {x:hreal} x /\ dest_hreal {y:hreal} y)

definition hreal_inv
  |- hreal_inv
     = (\x:hreal. mk_hreal (\u:nadd. ?x:nadd. nadd_eq (nadd_inv x) u /\ dest_hreal {x:hreal} x))

definition treal_of_num
  |- treal_of_num = (\_1:num. hreal_of_num _1, hreal_of_num 0)

definition treal_neg
  |- treal_neg = (\_1:(hreal # hreal). SND _1, FST _1)

definition treal_add
  |- treal_add
     = (\_1:(hreal # hreal) _2:(hreal # hreal).
         hreal_add (FST _1) (FST _2), hreal_add (SND _1) (SND _2))

definition treal_mul
  |- treal_mul
     = (\_1:(hreal # hreal) _2:(hreal # hreal).
         hreal_add (hreal_mul (FST _1) (FST _2)) (hreal_mul (SND _1) (SND _2))
         , hreal_add (hreal_mul (FST _1) (SND _2)) (hreal_mul (SND _1) (FST _2)))

definition treal_le
  |- treal_le
     = (\_1:(hreal # hreal) _2:(hreal # hreal).
         hreal_le (hreal_add (FST _1) (SND _2)) (hreal_add (FST _2) (SND _1)))

definition treal_inv
  |- treal_inv
     = (\_1:(hreal # hreal).
         COND (FST _1 = SND _1) (hreal_of_num 0, hreal_of_num 0)
           (COND (hreal_le (SND _1) (FST _1))
             (hreal_inv (@d:hreal. FST _1 = hreal_add (SND _1) d), hreal_of_num 0)
             (hreal_of_num 0, hreal_inv (@d:hreal. SND _1 = hreal_add (FST _1) d))))

definition treal_eq
  |- treal_eq
     = (\_1:(hreal # hreal) _2:(hreal # hreal).
         hreal_add (FST _1) (SND _2) = hreal_add (FST _2) (SND _1))

definition real_of_num
  |- real_of_num = (\m:num. mk_real (\u:(hreal # hreal). treal_eq (treal_of_num m) u))

definition real_neg
  |- real_neg
     = (\x1:real.
         mk_real (\u:(hreal # hreal).
           ?x1:(hreal # hreal). treal_eq (treal_neg x1) u /\ dest_real {x1:real} x1))

definition real_add
  |- real_add
     = (\x1:real y1:real.
         mk_real (\u:(hreal # hreal).
           ?x1:(hreal # hreal) y1:(hreal # hreal).
             treal_eq (treal_add x1 y1) u /\ dest_real {x1:real} x1 /\ dest_real {y1:real} y1))

definition real_mul
  |- real_mul
     = (\x1:real y1:real.
         mk_real (\u:(hreal # hreal).
           ?x1:(hreal # hreal) y1:(hreal # hreal).
             treal_eq (treal_mul x1 y1) u /\ dest_real {x1:real} x1 /\ dest_real {y1:real} y1))

definition real_le
  |- real_le
     = (\x1:real y1:real.
         @u:bool.
           ?x1:(hreal # hreal) y1:(hreal # hreal).
             treal_le x1 y1 = u /\ dest_real {x1:real} x1 /\ dest_real {y1:real} y1)

definition real_inv
  |- real_inv
     = (\x:real.
         mk_real (\u:(hreal # hreal).
           ?x:(hreal # hreal). treal_eq (treal_inv x) u /\ dest_real {x:real} x))

definition real_sub
  |- real_sub = (\_1:real _2:real. real_add _1 (real_neg _2))

definition real_lt
  |- real_lt = (\_1:real _2:real. ~ (real_le _2 _1))

definition real_ge
  |- real_ge = (\_1:real _2:real. real_le _2 _1)

definition real_gt
  |- real_gt = (\_1:real _2:real. real_lt _2 _1)

definition real_abs
  |- real_abs = (\_1:real. COND (real_le (real_of_num 0) _1) _1 (real_neg _1))

definition real_pow
  |- real_pow
     = (specification "real_pow" real_pow:(real -> num -> real).
         (!x:real. real_pow x 0 = real_of_num 1)
         /\ (!x:real n:num. real_pow x (SUC n) = real_mul x (real_pow x n)))

definition real_div
  |- real_div = (\_1:real _2:real. real_mul _1 (real_inv _2))

definition real_max
  |- real_max = (\_1:real _2:real. COND (real_le _1 _2) _2 _1)

definition real_min
  |- real_min = (\_1:real _2:real. COND (real_le _1 _2) _1 _2)

definition real_sgn
  |- real_sgn
     = (\_1:real.
         COND (real_lt (real_of_num 0) _1) (real_of_num 1)
           (COND (real_lt _1 (real_of_num 0)) (real_neg (real_of_num 1)) (real_of_num 0)))

definition sqrt
  |- sqrt = (\_1:real. @y:real. real_sgn y = real_sgn _1 /\ real_pow y 2 = real_abs _1)

definition DECIMAL
  |- DECIMAL = (\_1:num _2:num. real_div (real_of_num _1) (real_of_num _2))

definition integer
  |- integer = (\_1:real. ?n:num. real_abs _1 = real_of_num n)

definition int_le
  |- int_le = (\_1:int _2:int. real_le (real_of_int _1) (real_of_int _2))

definition int_lt
  |- int_lt = (\_1:int _2:int. real_lt (real_of_int _1) (real_of_int _2))

definition int_ge
  |- int_ge = (\_1:int _2:int. real_ge (real_of_int _1) (real_of_int _2))

definition int_gt
  |- int_gt = (\_1:int _2:int. real_gt (real_of_int _1) (real_of_int _2))

definition int_of_num
  |- int_of_num = (\_1:num. int_of_real (real_of_num _1))

definition int_neg
  |- int_neg = (\_1:int. int_of_real (real_neg (real_of_int _1)))

definition int_add
  |- int_add = (\_1:int _2:int. int_of_real (real_add (real_of_int _1) (real_of_int _2)))

definition int_sub
  |- int_sub = (\_1:int _2:int. int_of_real (real_sub (real_of_int _1) (real_of_int _2)))

definition int_mul
  |- int_mul = (\_1:int _2:int. int_of_real (real_mul (real_of_int _1) (real_of_int _2)))

definition int_abs
  |- int_abs = (\_1:int. int_of_real (real_abs (real_of_int _1)))

definition int_sgn
  |- int_sgn = (\_1:int. int_of_real (real_sgn (real_of_int _1)))

definition int_max
  |- int_max = (\_1:int _2:int. int_of_real (real_max (real_of_int _1) (real_of_int _2)))

definition int_min
  |- int_min = (\_1:int _2:int. int_of_real (real_min (real_of_int _1) (real_of_int _2)))

definition int_pow
  |- int_pow = (\_1:int _2:num. int_of_real (real_pow (real_of_int _1) _2))

definition div
  |- (div)
     = (specification "div" q:(int -> int -> int).
         ?r:(int -> int -> int).
           !m:int n:int.
             COND (n = &0) (q m n = &0 /\ r m n = m)
               (&0 <= r m n /\ r m n < abs n /\ m = q m n * n + r m n))

definition rem
  |- (rem)
     = (specification "rem" r:(int -> int -> int).
         !m:int n:int.
           COND (n = &0) (m div n = &0 /\ r m n = m)
             (&0 <= r m n /\ r m n < abs n /\ m = m div n * n + r m n))

definition ==
  |- ((==) : 'A -> 'A -> ('A -> 'A -> bool) -> bool)
     = (\_1:'A _2:'A _3:('A -> 'A -> bool). _3 _1 _2)

definition real_mod
  |- real_mod = (\_1:real _2:real _3:real. ?q:real. integer q /\ real_sub _2 _3 = real_mul q _1)

definition int_divides
  |- int_divides = (\_1:int _2:int. ?x:int. _2 = _1 * x)

definition int_mod
  |- int_mod = (\_1:int _2:int _3:int. int_divides _1 (_2 - _3))

definition int_coprime
  |- int_coprime = (\_1:(int # int). ?x:int y:int. FST _1 * x + SND _1 * y = &1)

definition int_gcd
  |- int_gcd
     = (specification "int_gcd" d:(int # int -> int).
         !a:int b:int.
           &0 <= d (a, b)
           /\ int_divides (d (a, b)) a
           /\ int_divides (d (a, b)) b
           /\ (?x:int y:int. d (a, b) = a * x + b * y))

definition int_lcm
  |- int_lcm
     = (\_1:(int # int).
         COND (FST _1 * SND _1 = &0) &0 (abs (FST _1 * SND _1) div int_gcd (FST _1, SND _1)))

definition num_of_int
  |- num_of_int = (\_1:int. @n:num. int_of_num n = _1)

definition num_divides
  |- num_divides = (\_1:num _2:num. int_divides (int_of_num _1) (int_of_num _2))

definition num_mod
  |- num_mod = (\_1:num _2:num _3:num. mod (int_of_num _1) (int_of_num _2) (int_of_num _3))

definition num_coprime
  |- num_coprime = (\_1:(num # num). int_coprime (int_of_num (FST _1), int_of_num (SND _1)))

definition num_gcd
  |- num_gcd = (\_1:(num # num). num_of_int (int_gcd (int_of_num (FST _1), int_of_num (SND _1))))

definition num_lcm
  |- num_lcm = (\_1:(num # num). num_of_int (int_lcm (int_of_num (FST _1), int_of_num (SND _1))))

definition prime
  |- prime = (\_1:num. ~ (_1 = 1) /\ (!x:num. num_divides x _1 ==> x = 1 \/ x = _1))

definition real_zpow
  |- real_zpow
     = (\_1:real _2:int.
         COND (&0 <= _2) (real_pow _1 (num_of_int _2)) (real_inv (real_pow _1 (num_of_int (-_2)))))

definition IN
  |- (IN : 'A -> ('A -> bool) -> bool) = (\_1:'A _2:('A -> bool). _2 _1)

definition GSPEC
  |- (GSPEC : ('A -> bool) -> 'A -> bool) = (\_1:('A -> bool). _1)

definition SETSPEC
  |- (SETSPEC : 'A -> bool -> 'A -> bool) = (\_1:'A _2:bool _3:'A. _2 /\ _1 = _3)

definition EMPTY
  |- (EMPTY : 'A -> bool) = (\x:'A. F)

definition INSERT
  |- (INSERT : 'A -> ('A -> bool) -> 'A -> bool) = (\_1:'A _2:('A -> bool) y:'A. IN y _2 \/ y = _1)

definition UNIV
  |- (UNIV : 'A -> bool) = (\x:'A. T)

definition UNION
  |- (UNION : ('A -> bool) -> ('A -> bool) -> 'A -> bool)
     = (\_1:('A -> bool) _2:('A -> bool).
         GSPEC (\"GEN%PVAR%1":'A. ?x:'A. SETSPEC "GEN%PVAR%1" (IN x _1 \/ IN x _2) x))

definition UNIONS
  |- (UNIONS : (('A -> bool) -> bool) -> 'A -> bool)
     = (\_1:(('A -> bool) -> bool).
         GSPEC (\"GEN%PVAR%1":'A.
           ?x:'A. SETSPEC "GEN%PVAR%1" (?u:('A -> bool). IN u _1 /\ IN x u) x))

definition INTER
  |- (INTER : ('A -> bool) -> ('A -> bool) -> 'A -> bool)
     = (\_1:('A -> bool) _2:('A -> bool).
         GSPEC (\"GEN%PVAR%1":'A. ?x:'A. SETSPEC "GEN%PVAR%1" (IN x _1 /\ IN x _2) x))

definition INTERS
  |- (INTERS : (('A -> bool) -> bool) -> 'A -> bool)
     = (\_1:(('A -> bool) -> bool).
         GSPEC (\"GEN%PVAR%1":'A.
           ?x:'A. SETSPEC "GEN%PVAR%1" (!u:('A -> bool). IN u _1 ==> IN x u) x))

definition DIFF
  |- (DIFF : ('A -> bool) -> ('A -> bool) -> 'A -> bool)
     = (\_1:('A -> bool) _2:('A -> bool).
         GSPEC (\"GEN%PVAR%1":'A. ?x:'A. SETSPEC "GEN%PVAR%1" (IN x _1 /\ ~ (IN x _2)) x))

definition DELETE
  |- (DELETE : ('A -> bool) -> 'A -> 'A -> bool)
     = (\_1:('A -> bool) _2:'A.
         GSPEC (\"GEN%PVAR%1":'A. ?y:'A. SETSPEC "GEN%PVAR%1" (IN y _1 /\ ~ (y = _2)) y))

definition SUBSET
  |- (SUBSET : ('A -> bool) -> ('A -> bool) -> bool)
     = (\_1:('A -> bool) _2:('A -> bool). !x:'A. IN x _1 ==> IN x _2)

definition PSUBSET
  |- (PSUBSET : ('A -> bool) -> ('A -> bool) -> bool)
     = (\_1:('A -> bool) _2:('A -> bool). SUBSET _1 _2 /\ ~ (_1 = _2))

definition DISJOINT
  |- (DISJOINT : ('A -> bool) -> ('A -> bool) -> bool)
     = (\_1:('A -> bool) _2:('A -> bool). INTER _1 _2 = (EMPTY : 'A -> bool))

definition SING
  |- (SING : ('A -> bool) -> bool) = (\_1:('A -> bool). ?x:'A. _1 = INSERT x (EMPTY : 'A -> bool))

definition FINITE
  |- (FINITE : ('A -> bool) -> bool)
     = (\a:('A -> bool).
         !FINITE':(('A -> bool) -> bool).
           (!a:('A -> bool).
             a = (EMPTY : 'A -> bool) \/ (?x:'A s:('A -> bool). a = INSERT x s /\ FINITE' s)
             ==> FINITE' a)
           ==> FINITE' a)

definition INFINITE
  |- (INFINITE : ('A -> bool) -> bool) = (\_1:('A -> bool). ~ (FINITE _1))

definition IMAGE
  |- (IMAGE : ('A -> 'B) -> ('A -> bool) -> 'B -> bool)
     = (\_1:('A -> 'B) _2:('A -> bool).
         GSPEC (\"GEN%PVAR%1":'B. ?y:'B. SETSPEC "GEN%PVAR%1" (?x:'A. IN x _2 /\ y = _1 x) y))

definition INJ
  |- (INJ : ('A -> 'B) -> ('A -> bool) -> ('B -> bool) -> bool)
     = (\_1:('A -> 'B) _2:('A -> bool) _3:('B -> bool).
         (!x:'A. IN x _2 ==> IN (_1 x) _3)
         /\ (!x:'A y:'A. IN x _2 /\ IN y _2 /\ _1 x = _1 y ==> x = y))

definition SURJ
  |- (SURJ : ('A -> 'B) -> ('A -> bool) -> ('B -> bool) -> bool)
     = (\_1:('A -> 'B) _2:('A -> bool) _3:('B -> bool).
         (!x:'A. IN x _2 ==> IN (_1 x) _3) /\ (!x:'B. IN x _3 ==> (?y:'A. IN y _2 /\ _1 y = x)))

definition BIJ
  |- (BIJ : ('A -> 'B) -> ('A -> bool) -> ('B -> bool) -> bool)
     = (\_1:('A -> 'B) _2:('A -> bool) _3:('B -> bool). INJ _1 _2 _3 /\ SURJ _1 _2 _3)

definition CHOICE
  |- (CHOICE : ('A -> bool) -> 'A) = (\_1:('A -> bool). @x:'A. IN x _1)

definition REST
  |- (REST : ('A -> bool) -> 'A -> bool) = (\_1:('A -> bool). DELETE _1 (CHOICE _1))

definition FINREC
  |- (FINREC : ('A -> 'B -> 'B) -> 'B -> ('A -> bool) -> 'B -> num -> bool)
     = (specification "FINREC" FINREC:(('A -> 'B -> 'B) -> 'B -> ('A -> bool) -> 'B -> num -> bool).
         (!f:('A -> 'B -> 'B) s:('A -> bool) a:'B b:'B.
           FINREC f b s a 0 = (s = (EMPTY : 'A -> bool) /\ a = b))
         /\ (!b:'B s:('A -> bool) n:num a:'B f:('A -> 'B -> 'B).
              FINREC f b s a (SUC n)
              = (?x:'A c:'B. IN x s /\ FINREC f b (DELETE s x) c n /\ a = f x c)))

definition ITSET
  |- (ITSET : ('A -> 'B -> 'B) -> ('A -> bool) -> 'B -> 'B)
     = (\_1:('A -> 'B -> 'B) _2:('A -> bool) _3:'B.
         (@g:(('A -> bool) -> 'B).
           g (EMPTY : 'A -> bool) = _3
           /\ (!x:'A s:('A -> bool).
                FINITE s ==> g (INSERT x s) = COND (IN x s) (g s) (_1 x (g s)))) _2)

definition CARD
  |- (CARD : ('A -> bool) -> num) = (\_1:('A -> bool). ITSET (\x:'A n:num. SUC n) _1 0)

definition HAS_SIZE
  |- (HAS_SIZE : ('A -> bool) -> num -> bool) = (\_1:('A -> bool) _2:num. FINITE _1 /\ CARD _1 = _2)

definition CROSS
  |- (CROSS : ('A -> bool) -> ('B -> bool) -> 'A # 'B -> bool)
     = (\_1:('A -> bool) _2:('B -> bool).
         GSPEC (\"GEN%PVAR%1":('A # 'B).
           ?x:'A y:'B. SETSPEC "GEN%PVAR%1" (IN x _1 /\ IN y _2) (x, y)))

definition ARB
  |- (ARB : 'A) = (@x:'A. F)

definition EXTENSIONAL
  |- (EXTENSIONAL : ('A -> bool) -> ('A -> 'B) -> bool)
     = (\_1:('A -> bool).
         GSPEC (\"GEN%PVAR%1":('A -> 'B).
           ?f:('A -> 'B). SETSPEC "GEN%PVAR%1" (!x:'A. ~ (IN x _1) ==> f x = (ARB : 'B)) f))

definition RESTRICTION
  |- (RESTRICTION : ('A -> bool) -> ('A -> 'B) -> 'A -> 'B)
     = (\_1:('A -> bool) _2:('A -> 'B) _3:'A. COND (IN _3 _1) (_2 _3) (ARB : 'B))

definition cartesian_product
  |- (cartesian_product : ('K -> bool) -> ('K -> 'A -> bool) -> ('K -> 'A) -> bool)
     = (\_1:('K -> bool) _2:('K -> 'A -> bool).
         GSPEC (\"GEN%PVAR%1":('K -> 'A).
           ?f:('K -> 'A).
             SETSPEC "GEN%PVAR%1" (EXTENSIONAL _1 f /\ (!i:'K. IN i _1 ==> IN (f i) (_2 i))) f))

definition product_map
  |- (product_map : ('K -> bool) -> ('K -> 'A -> 'B) -> ('K -> 'A) -> 'K -> 'B)
     = (\_1:('K -> bool) _2:('K -> 'A -> 'B) x:('K -> 'A). RESTRICTION _1 (\i:'K. _2 i (x i)))

definition disjoint_union
  |- (disjoint_union : ('K -> bool) -> ('K -> 'A -> bool) -> 'K # 'A -> bool)
     = (\_1:('K -> bool) _2:('K -> 'A -> bool).
         GSPEC (\"GEN%PVAR%1":('K # 'A).
           ?i:'K x:'A. SETSPEC "GEN%PVAR%1" (IN i _1 /\ IN x (_2 i)) (i, x)))

definition set_of_list
  |- (set_of_list : 'A list -> 'A -> bool)
     = (specification "set_of_list" set_of_list:('A list -> 'A -> bool).
         set_of_list (NIL : 'A list) = (EMPTY : 'A -> bool)
         /\ (!h:'A t:('A list). set_of_list (CONS h t) = INSERT h (set_of_list t)))

definition list_of_set
  |- (list_of_set : ('A -> bool) -> 'A list)
     = (\_1:('A -> bool). @l:('A list). set_of_list l = _1 /\ LENGTH l = CARD _1)

definition pairwise
  |- (pairwise : ('A -> 'A -> bool) -> ('A -> bool) -> bool)
     = (\_1:('A -> 'A -> bool) _2:('A -> bool).
         !x:'A y:'A. IN x _2 /\ IN y _2 /\ ~ (x = y) ==> _1 x y)

definition UNION_OF
  |- (UNION_OF : ((('A -> bool) -> bool) -> bool) -> (('A -> bool) -> bool) -> ('A -> bool) -> bool)
     = (\_1:((('A -> bool) -> bool) -> bool) _2:(('A -> bool) -> bool) s:('A -> bool).
         ?u:(('A -> bool) -> bool). _1 u /\ (!c:('A -> bool). IN c u ==> _2 c) /\ UNIONS u = s)

definition INTERSECTION_OF
  |- (INTERSECTION_OF : ((('A -> bool) -> bool) -> bool) -> (('A -> bool) -> bool) ->
         ('A -> bool) -> bool)
     = (\_1:((('A -> bool) -> bool) -> bool) _2:(('A -> bool) -> bool) s:('A -> bool).
         ?u:(('A -> bool) -> bool). _1 u /\ (!c:('A -> bool). IN c u ==> _2 c) /\ INTERS u = s)

definition ARBITRARY
  |- (ARBITRARY : (('A -> bool) -> bool) -> bool) = (\_1:(('A -> bool) -> bool). T)

definition "<=_c"
  |- ("<=_c" : ('A -> bool) -> ('B -> bool) -> bool)
     = (\_1:('A -> bool) _2:('B -> bool).
         ?f:('A -> 'B).
           (!x:'A. IN x _1 ==> IN (f x) _2)
           /\ (!x:'A y:'A. IN x _1 /\ IN y _1 /\ f x = f y ==> x = y))

definition "<_c"
  |- ("<_c" : ('A -> bool) -> ('B -> bool) -> bool)
     = (\_1:('A -> bool) _2:('B -> bool). "<=_c" _1 _2 /\ ~ ("<=_c" _2 _1))

definition "=_c"
  |- ("=_c" : ('A -> bool) -> ('B -> bool) -> bool)
     = (\_1:('A -> bool) _2:('B -> bool).
         ?f:('A -> 'B).
           (!x:'A. IN x _1 ==> IN (f x) _2) /\ (!y:'B. IN y _2 ==> (?!x:'A. IN x _1 /\ f x = y)))

definition ">=_c"
  |- (">=_c" : ('A -> bool) -> ('B -> bool) -> bool)
     = (\_1:('A -> bool) _2:('B -> bool). "<=_c" _2 _1)

definition ">_c"
  |- (">_c" : ('A -> bool) -> ('B -> bool) -> bool)
     = (\_1:('A -> bool) _2:('B -> bool). "<_c" _2 _1)

definition COUNTABLE
  |- (COUNTABLE : ('A -> bool) -> bool) = (\_1:('A -> bool). ">=_c" (UNIV : num -> bool) _1)

definition sup
  |- sup
     = (\_1:(real -> bool).
         @a:real.
           (!x:real. IN x _1 ==> real_le x a)
           /\ (!b:real. (!x:real. IN x _1 ==> real_le x b) ==> real_le a b))

definition inf
  |- inf
     = (\_1:(real -> bool).
         @a:real.
           (!x:real. IN x _1 ==> real_le a x)
           /\ (!b:real. (!x:real. IN x _1 ==> real_le b x) ==> real_le b a))

definition has_inf
  |- has_inf
     = (\_1:(real -> bool) _2:real. !c:real. (!x:real. IN x _1 ==> real_le c x) = real_le c _2)

definition has_sup
  |- has_sup
     = (\_1:(real -> bool) _2:real. !c:real. (!x:real. IN x _1 ==> real_le x c) = real_le _2 c)

definition ".."
  |- (..)
     = (\_1:num _2:num.
         GSPEC (\"GEN%PVAR%1":num. ?x:num. SETSPEC "GEN%PVAR%1" (_1 <= x /\ x <= _2) x))

definition neutral
  |- (neutral : ('A -> 'A -> 'A) -> 'A)
     = (\_1:('A -> 'A -> 'A). @x:'A. !y:'A. _1 x y = y /\ _1 y x = y)

definition monoidal
  |- (monoidal : ('A -> 'A -> 'A) -> bool)
     = (\_1:('A -> 'A -> 'A).
         (!x:'A y:'A. _1 x y = _1 y x)
         /\ (!x:'A y:'A z:'A. _1 x (_1 y z) = _1 (_1 x y) z)
         /\ (!x:'A. _1 (neutral _1) x = x))

definition support
  |- (support : ('B -> 'B -> 'B) -> ('A -> 'B) -> ('A -> bool) -> 'A -> bool)
     = (\_1:('B -> 'B -> 'B) _2:('A -> 'B) _3:('A -> bool).
         GSPEC (\"GEN%PVAR%1":'A. ?x:'A. SETSPEC "GEN%PVAR%1" (IN x _3 /\ ~ (_2 x = neutral _1)) x))

definition iterate
  |- (iterate : ('B -> 'B -> 'B) -> ('A -> bool) -> ('A -> 'B) -> 'B)
     = (\_1:('B -> 'B -> 'B) _2:('A -> bool) _3:('A -> 'B).
         COND (FINITE (support _1 _3 _2))
           (ITSET (\x:'A a:'B. _1 (_3 x) a) (support _1 _3 _2) (neutral _1))
           (neutral _1))

definition iterato
  |- (iterato : ('A -> bool) -> 'A -> ('A -> 'A -> 'A) -> ('K -> 'K -> bool) -> ('K -> bool) ->
         ('K -> 'A) -> 'A)
     = (specification "iterato" itty:(('A -> bool) -> 'A -> ('A -> 'A -> 'A) ->
           ('K -> 'K -> bool) -> ('K -> bool) -> ('K -> 'A) -> 'A).
         !dom:('A -> bool) neut:'A op:('A -> 'A -> 'A) "<<=":('K -> 'K -> bool) k:('K -> bool)
          f:('K -> 'A).
           itty dom neut op "<<=" k f
           = COND
               (FINITE (GSPEC (\"GEN%PVAR%1":'K.
                 ?i:'K.
                   SETSPEC "GEN%PVAR%1"
                     (IN i k /\ IN (f i) (DIFF dom (INSERT neut (EMPTY : 'A -> bool))))
                     i))
               /\ ~ (GSPEC (\"GEN%PVAR%2":'K.
                    ?i:'K.
                      SETSPEC "GEN%PVAR%2"
                        (IN i k /\ IN (f i) (DIFF dom (INSERT neut (EMPTY : 'A -> bool))))
                        i)
                  = (EMPTY : 'K -> bool)))
               (let i:'K =
                   COND
                     (?i:'K.
                       IN i k
                       /\ IN (f i) (DIFF dom (INSERT neut (EMPTY : 'A -> bool)))
                       /\ (!j:'K.
                            "<<=" j i
                            /\ IN j k
                            /\ IN (f j) (DIFF dom (INSERT neut (EMPTY : 'A -> bool)))
                            ==> j = i))
                     (@i:'K.
                       IN i k
                       /\ IN (f i) (DIFF dom (INSERT neut (EMPTY : 'A -> bool)))
                       /\ (!j:'K.
                            "<<=" j i
                            /\ IN j k
                            /\ IN (f j) (DIFF dom (INSERT neut (EMPTY : 'A -> bool)))
                            ==> j = i))
                     (@i:'K. IN i k /\ IN (f i) (DIFF dom (INSERT neut (EMPTY : 'A -> bool)))) in
               op (f i) (itty dom neut op "<<="
                 (GSPEC (\"GEN%PVAR%3":'K.
                   ?j:'K.
                     SETSPEC "GEN%PVAR%3"
                       (IN j (DELETE k i) /\ IN (f j) (DIFF dom (INSERT neut (EMPTY : 'A -> bool))))
                       j))
                 f))
               neut)

definition nproduct
  |- (nproduct : ('A -> bool) -> ('A -> num) -> num)
     = (iterate (*) : ('A -> bool) -> ('A -> num) -> num)

definition iproduct
  |- (iproduct : ('A -> bool) -> ('A -> int) -> int)
     = (iterate int_mul : ('A -> bool) -> ('A -> int) -> int)

definition product
  |- (product : ('A -> bool) -> ('A -> real) -> real)
     = (iterate real_mul : ('A -> bool) -> ('A -> real) -> real)

definition isum
  |- (isum : ('A -> bool) -> ('A -> int) -> int)
     = (iterate int_add : ('A -> bool) -> ('A -> int) -> int)

definition nsum
  |- (nsum : ('A -> bool) -> ('A -> num) -> num)
     = (iterate (+) : ('A -> bool) -> ('A -> num) -> num)

definition sum
  |- (sum : ('A -> bool) -> ('A -> real) -> real)
     = (iterate real_add : ('A -> bool) -> ('A -> real) -> real)

definition polynomial_function
  |- polynomial_function
     = (\_1:(real -> real).
         ?m:num c:(num -> real). !x:real. _1 x = sum (0..m) (\i:num. real_mul (c i) (real_pow x i)))

definition dimindex
  |- (dimindex : ('A -> bool) -> num)
     = (\_1:('A -> bool). COND (FINITE (UNIV : 'A -> bool)) (CARD (UNIV : 'A -> bool)) 1)

definition "$"
  |- ("$" : ('A, 'N) cart -> num -> 'A)
     = (\_1:(('A, 'N) cart) _2:num. dest_cart _1 (finite_index _2 : 'N finite_image))

definition lambda
  |- (lambda : (num -> 'A) -> ('A, 'B) cart)
     = (\_1:(num -> 'A).
         @f:(('A, 'B) cart). !i:num. 1 <= i /\ i <= dimindex (UNIV : 'B -> bool) ==> "$" f i = _1 i)

definition pastecart
  |- (pastecart : ('A, 'M) cart -> ('A, 'N) cart -> ('A, ('M, 'N) finite_sum) cart)
     = (\_1:(('A, 'M) cart) _2:(('A, 'N) cart).
         (lambda
           (\i:num.
             COND (i <= dimindex (UNIV : 'M -> bool)) ("$" _1 i)
               ("$" _2 (i - dimindex (UNIV : 'M -> bool))))
           : ('A, ('M, 'N) finite_sum) cart))

definition fstcart
  |- (fstcart : ('A, ('M, 'N) finite_sum) cart -> ('A, 'M) cart)
     = (\_1:(('A, ('M, 'N) finite_sum) cart). (lambda (\i:num. "$" _1 i) : ('A, 'M) cart))

definition sndcart
  |- (sndcart : ('A, ('M, 'N) finite_sum) cart -> ('A, 'N) cart)
     = (\_1:(('A, ('M, 'N) finite_sum) cart).
         (lambda (\i:num. "$" _1 (i + dimindex (UNIV : 'M -> bool))) : ('A, 'N) cart))

definition _<mktybit0>
  |- (_<mktybit0> : ('A, 'A) finite_sum -> 'A tybit0)
     = (\a:(('A, 'A) finite_sum).
         _mk_tybit0 ((\a:(('A, 'A) finite_sum).
           CONSTR 0 a (\n:num. (BOTTOM : (('A, 'A) finite_sum) recspace))) a))

definition mktybit0
  |- (mktybit0 : ('A, 'A) finite_sum -> 'A tybit0)
     = (_<mktybit0> : ('A, 'A) finite_sum -> 'A tybit0)

definition _<mktybit1>
  |- (_<mktybit1> : (('A, 'A) finite_sum, 1) finite_sum -> 'A tybit1)
     = (\a:((('A, 'A) finite_sum, 1) finite_sum).
         _mk_tybit1 ((\a:((('A, 'A) finite_sum, 1) finite_sum).
           CONSTR 0 a (\n:num. (BOTTOM : ((('A, 'A) finite_sum, 1) finite_sum) recspace))) a))

definition mktybit1
  |- (mktybit1 : (('A, 'A) finite_sum, 1) finite_sum -> 'A tybit1)
     = (_<mktybit1> : (('A, 'A) finite_sum, 1) finite_sum -> 'A tybit1)

definition vector
  |- (vector : 'A list -> ('A, 'N) cart)
     = (\_1:('A list). (lambda (\i:num. EL (i - 1) _1) : ('A, 'N) cart))

definition PCROSS
  |- (PCROSS : (('A, 'M) cart -> bool) -> (('A, 'N) cart -> bool) ->
         ('A, ('M, 'N) finite_sum) cart -> bool)
     = (\_1:(('A, 'M) cart -> bool) _2:(('A, 'N) cart -> bool).
         GSPEC (\"GEN%PVAR%1":(('A, ('M, 'N) finite_sum) cart).
           ?x:(('A, 'M) cart) y:(('A, 'N) cart).
             SETSPEC "GEN%PVAR%1" (IN x _1 /\ IN y _2) (pastecart x y)))

definition CASEWISE
  |- (CASEWISE : (('?1 -> '?2) # ('?3 -> '?1 -> '?4)) list -> '?3 -> '?2 -> '?4)
     = (specification "CASEWISE" CASEWISE:((('?1 -> '?2) # ('?3 -> '?1 -> '?4)) list -> '?3 ->
           '?2 -> '?4).
         (!f:'?3 x:'?2.
           CASEWISE (NIL : (('?1 -> '?2) # ('?3 -> '?1 -> '?4)) list) f x = (@y:'?4. T))
         /\ (!h:(('?1 -> '?2) # ('?3 -> '?1 -> '?4)) t:((('?1 -> '?2) # ('?3 -> '?1 -> '?4)) list)
              f:'?3 x:'?2.
              CASEWISE (CONS h t) f x
              = COND (?y:'?1. FST h y = x) (SND h f (@y:'?1. FST h y = x)) (CASEWISE t f x)))

definition admissible
  |- (admissible : ('?1 -> '?2 -> bool) -> (('?1 -> '?3) -> '?4 -> bool) -> ('?4 -> '?2) ->
         (('?1 -> '?3) -> '?4 -> '?5) -> bool)
     = (\_1:('?1 -> '?2 -> bool) _2:(('?1 -> '?3) -> '?4 -> bool) _3:('?4 -> '?2)
         _4:(('?1 -> '?3) -> '?4 -> '?5).
         !f:('?1 -> '?3) g:('?1 -> '?3) a:'?4.
           _2 f a /\ _2 g a /\ (!z:'?1. _1 z (_3 a) ==> f z = g z) ==> _4 f a = _4 g a)

definition tailadmissible
  |- (tailadmissible : ('A -> 'A -> bool) -> (('A -> 'B) -> 'P -> bool) -> ('P -> 'A) ->
         (('A -> 'B) -> 'P -> 'B) -> bool)
     = (\_1:('A -> 'A -> bool) _2:(('A -> 'B) -> 'P -> bool) _3:('P -> 'A)
         _4:(('A -> 'B) -> 'P -> 'B).
         ?P:(('A -> 'B) -> 'P -> bool) G:(('A -> 'B) -> 'P -> 'A) H:(('A -> 'B) -> 'P -> 'B).
           (!f:('A -> 'B) a:'P y:'A. P f a /\ _1 y (G f a) ==> _1 y (_3 a))
           /\ (!f:('A -> 'B) g:('A -> 'B) a:'P.
                (!z:'A. _1 z (_3 a) ==> f z = g z)
                ==> P f a = P g a /\ G f a = G g a /\ H f a = H g a)
           /\ (!f:('A -> 'B) a:'P. _2 f a ==> _4 f a = COND (P f a) (f (G f a)) (H f a)))

definition superadmissible
  |- (superadmissible : ('?1 -> '?1 -> bool) -> (('?1 -> '?2) -> '?3 -> bool) -> ('?3 -> '?1) ->
         (('?1 -> '?2) -> '?3 -> '?2) -> bool)
     = (\_1:('?1 -> '?1 -> bool) _2:(('?1 -> '?2) -> '?3 -> bool) _3:('?3 -> '?1)
         _4:(('?1 -> '?2) -> '?3 -> '?2).
         admissible _1 (\f:('?1 -> '?2) a:'?3. T) _3 _2 ==> tailadmissible _1 _2 _3 _4)

typedef 1
  |- (\b:bool. b) {r:bool} = ((one_REP : 1 -> bool) ((one_ABS : bool -> 1) {r:bool}) = {r:bool})

typedef prod
  |- (\x:('A -> 'B -> bool). ?a:'A b:'B. x = mk_pair a b) {r:'A -> 'B -> bool}
     = ((REP_prod : 'A # 'B -> 'A -> 'B -> bool) ((ABS_prod : ('A -> 'B -> bool) -> 'A # 'B)
         {r:'A -> 'B -> bool})
       = {r:'A -> 'B -> bool})

typedef num
  |- NUM_REP {r:ind} = ((dest_num : num -> ind) ((mk_num : ind -> num) {r:ind}) = {r:ind})

typedef recspace
  |- ZRECSPACE {r:num -> 'A -> bool}
     = ((_dest_rec : 'A recspace -> num -> 'A -> bool)
         ((_mk_rec : (num -> 'A -> bool) -> 'A recspace) {r:num -> 'A -> bool})
       = {r:num -> 'A -> bool})

typedef sum
  |- (\a:(('A # 'B) recspace).
       !sum':(('A # 'B) recspace -> bool).
         (!a:(('A # 'B) recspace).
           (?a:'A.
             {a:('A # 'B) recspace}
             = (\a:'A. CONSTR 0 (a, (@v:'B. T)) (\n:num. (BOTTOM : ('A # 'B) recspace))) a)
           \/ (?a:'B.
                {a:('A # 'B) recspace}
                = (\a:'B. CONSTR (SUC 0) ((@v:'A. T), a) (\n:num. (BOTTOM : ('A # 'B) recspace))) a)
           ==> sum' a)
         ==> sum' a) {r:('A # 'B) recspace}
     = ((_dest_sum : ('A, 'B) sum -> ('A # 'B) recspace)
         ((_mk_sum : ('A # 'B) recspace -> ('A, 'B) sum) {r:('A # 'B) recspace})
       = {r:('A # 'B) recspace})

typedef option
  |- (\a:('A recspace).
       !option':('A recspace -> bool).
         (!a:('A recspace).
           a = CONSTR 0 (@v:'A. T) (\n:num. (BOTTOM : 'A recspace))
           \/ (?a:'A.
                {a:'A recspace} = (\a:'A. CONSTR (SUC 0) a (\n:num. (BOTTOM : 'A recspace))) a)
           ==> option' a)
         ==> option' a) {r:'A recspace}
     = ((_dest_option : 'A option -> 'A recspace) ((_mk_option : 'A recspace -> 'A option)
         {r:'A recspace})
       = {r:'A recspace})

typedef list
  |- (\a:('A recspace).
       !list':('A recspace -> bool).
         (!a:('A recspace).
           a = CONSTR 0 (@v:'A. T) (\n:num. (BOTTOM : 'A recspace))
           \/ (?a0:'A a1:('A recspace).
                a
                = (\a0:'A a1:('A recspace).
                    CONSTR (SUC 0) a0 (FCONS a1 (\n:num. (BOTTOM : 'A recspace)))) a0 a1
                /\ list' a1)
           ==> list' a)
         ==> list' a) {r:'A recspace}
     = ((_dest_list : 'A list -> 'A recspace) ((_mk_list : 'A recspace -> 'A list) {r:'A recspace})
       = {r:'A recspace})

typedef char
  |- (\a:((bool # bool # bool # bool # bool # bool # bool # bool) recspace).
       !char':((bool # bool # bool # bool # bool # bool # bool # bool) recspace -> bool).
         (!a:((bool # bool # bool # bool # bool # bool # bool # bool) recspace).
           (?a0:bool a1:bool a2:bool a3:bool a4:bool a5:bool a6:bool a7:bool.
             a
             = (\a0:bool a1:bool a2:bool a3:bool a4:bool a5:bool a6:bool a7:bool.
                 CONSTR 0 (a0, a1, a2, a3, a4, a5, a6, a7)
                   (\n:num.
                     (BOTTOM : (bool # bool # bool # bool # bool # bool # bool # bool) recspace)))
                 a0
                 a1
                 a2
                 a3
                 a4
                 a5
                 a6
                 a7)
           ==> char' a)
         ==> char' a) {r:(bool # bool # bool # bool # bool # bool # bool # bool) recspace}
     = ((_dest_char : char -> (bool # bool # bool # bool # bool # bool # bool # bool) recspace)
         ((_mk_char : (bool # bool # bool # bool # bool # bool # bool # bool) recspace -> char)
           {r:(bool # bool # bool # bool # bool # bool # bool # bool) recspace})
       = {r:(bool # bool # bool # bool # bool # bool # bool # bool) recspace})

typedef nadd
  |- is_nadd {r:num -> num}
     = ((dest_nadd : nadd -> num -> num) ((mk_nadd : (num -> num) -> nadd) {r:num -> num})
       = {r:num -> num})

typedef hreal
  |- (\s:(nadd -> bool). ?x:nadd. s = nadd_eq x) {r:nadd -> bool}
     = ((dest_hreal : hreal -> nadd -> bool) ((mk_hreal : (nadd -> bool) -> hreal) {r:nadd -> bool})
       = {r:nadd -> bool})

typedef real
  |- (\s:(hreal # hreal -> bool). ?x:(hreal # hreal). s = treal_eq x) {r:hreal # hreal -> bool}
     = ((dest_real : real -> hreal # hreal -> bool)
         ((mk_real : (hreal # hreal -> bool) -> real) {r:hreal # hreal -> bool})
       = {r:hreal # hreal -> bool})

typedef int
  |- (\x:real. integer x) {r:real}
     = ((real_of_int : int -> real) ((int_of_real : real -> int) {r:real}) = {r:real})

typedef finite_image
  |- (\x:num. IN x (1..dimindex (UNIV : 'A -> bool))) {r:num}
     = ((dest_finite_image : 'A finite_image -> num)
         ((finite_index : num -> 'A finite_image) {r:num})
       = {r:num})

typedef cart
  |- (\f:('B finite_image -> 'A). T) {r:'B finite_image -> 'A}
     = ((dest_cart : ('A, 'B) cart -> 'B finite_image -> 'A)
         ((mk_cart : ('B finite_image -> 'A) -> ('A, 'B) cart) {r:'B finite_image -> 'A})
       = {r:'B finite_image -> 'A})

typedef finite_sum
  |- (\x:num. IN x (1..(dimindex (UNIV : 'A -> bool) + dimindex (UNIV : 'B -> bool)))) {r:num}
     = ((dest_finite_sum : ('A, 'B) finite_sum -> num)
         ((mk_finite_sum : num -> ('A, 'B) finite_sum) {r:num})
       = {r:num})

typedef finite_diff
  |- (\x:num.
       IN x (1
       .. COND (dimindex (UNIV : 'B -> bool) < dimindex (UNIV : 'A -> bool))
            (dimindex (UNIV : 'A -> bool) - dimindex (UNIV : 'B -> bool))
            1)) {r:num}
     = ((dest_finite_diff : ('A, 'B) finite_diff -> num)
         ((mk_finite_diff : num -> ('A, 'B) finite_diff) {r:num})
       = {r:num})

typedef finite_prod
  |- (\x:num. IN x (1..(dimindex (UNIV : 'A -> bool) * dimindex (UNIV : 'B -> bool)))) {r:num}
     = ((dest_finite_prod : ('A, 'B) finite_prod -> num)
         ((mk_finite_prod : num -> ('A, 'B) finite_prod) {r:num})
       = {r:num})

typedef tybit0
  |- (\a:((('A, 'A) finite_sum) recspace).
       !tybit0':((('A, 'A) finite_sum) recspace -> bool).
         (!a:((('A, 'A) finite_sum) recspace).
           (?a:(('A, 'A) finite_sum).
             {a:(('A, 'A) finite_sum) recspace}
             = (\a:(('A, 'A) finite_sum).
                 CONSTR 0 a (\n:num. (BOTTOM : (('A, 'A) finite_sum) recspace))) a)
           ==> tybit0' a)
         ==> tybit0' a) {r:(('A, 'A) finite_sum) recspace}
     = ((_dest_tybit0 : 'A tybit0 -> (('A, 'A) finite_sum) recspace)
         ((_mk_tybit0 : (('A, 'A) finite_sum) recspace -> 'A tybit0)
           {r:(('A, 'A) finite_sum) recspace})
       = {r:(('A, 'A) finite_sum) recspace})

typedef tybit1
  |- (\a:(((('A, 'A) finite_sum, 1) finite_sum) recspace).
       !tybit1':(((('A, 'A) finite_sum, 1) finite_sum) recspace -> bool).
         (!a:(((('A, 'A) finite_sum, 1) finite_sum) recspace).
           (?a:((('A, 'A) finite_sum, 1) finite_sum).
             {a:((('A, 'A) finite_sum, 1) finite_sum) recspace}
             = (\a:((('A, 'A) finite_sum, 1) finite_sum).
                 CONSTR 0 a (\n:num. (BOTTOM : ((('A, 'A) finite_sum, 1) finite_sum) recspace))) a)
           ==> tybit1' a)
         ==> tybit1' a) {r:((('A, 'A) finite_sum, 1) finite_sum) recspace}
     = ((_dest_tybit1 : 'A tybit1 -> ((('A, 'A) finite_sum, 1) finite_sum) recspace)
         ((_mk_tybit1 : ((('A, 'A) finite_sum, 1) finite_sum) recspace -> 'A tybit1)
           {r:((('A, 'A) finite_sum, 1) finite_sum) recspace})
       = {r:((('A, 'A) finite_sum, 1) finite_sum) recspace})
