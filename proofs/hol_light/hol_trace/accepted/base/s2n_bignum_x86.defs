definition x86_IMUL3
  |- (x86_IMUL3 : (x86state, 'N word) component ->
         (x86state, 'N word) component # (x86state, 'N word) component -> x86state -> x86state ->
         bool)
     = (\_1:((x86state, 'N word) component)
         _2:((x86state, 'N word) component # (x86state, 'N word) component) _3:x86state.
         let x:('N word) = read (FST _2) _3
         and y:('N word) = read (SND _2) _3 in
         let z:('N word) = word_mul x y in
         (,,) (:= _1 z)
           (:= CF (~ (ival x * ival y = ival z))
           ,, := OF (~ (ival x * ival y = ival z))
           ,, UNDEFINED_VALUES [ZF; SF; PF; AF])
           _3)

