definition x86_VPERMQ
  |- (x86_VPERMQ : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, byte) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, byte) component) _4:x86state.
         let x:('N word) = read _2 _4
         and od:byte = read _3 _4 in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) =
               usimd4
                 (\od:(2 word). (word_subword (word_zx x : 256 word) (val od * 64, 64) : int64))
                 od in
           := _1 (word_zx res : 'N word) _4)
           (raise_exception x86_Exception_UD _4))

definition x86_VPERM2I128
  |- (x86_VPERM2I128 : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> (x86state, byte) component -> x86state -> x86state ->
         bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:((x86state, byte) component) _5:x86state.
         let x1:('N word) = read _2 _5
         and x2:('N word) = read _3 _5
         and od:byte = read _4 _5 in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) =
               usimd2
                 (\od:(4 word).
                   let sel:num = val od in
                   let zero_flag:bool = sel DIV 8 MOD 2 = 1 in
                   COND zero_flag (word 0 : int128)
                     (let lane_sel:num = sel MOD 4 in
                     COND (lane_sel = 0) (word_subword (word_zx x1 : 256 word) (0, 128) : int128)
                       (COND (lane_sel = 1)
                         (word_subword (word_zx x1 : 256 word) (128, 128) : int128)
                         (COND (lane_sel = 2)
                           (word_subword (word_zx x2 : 256 word) (0, 128) : int128)
                           (word_subword (word_zx x2 : 256 word) (128, 128) : int128)))))
                 od in
           := _1 (word_zx res : 'N word) _5)
           (raise_exception x86_Exception_UD _5))

