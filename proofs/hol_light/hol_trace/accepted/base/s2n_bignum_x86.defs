definition bignum_from_memory
  |- bignum_from_memory
     = (\_1:(int64 # num) _2:x86state.
         nsum (GSPEC (\"GEN%PVAR%1":num. ?i:num. SETSPEC "GEN%PVAR%1" (i < SND _1) i))
           (\i:num.
             2 EXP (64 * i)
             * read (memory :> bytes (word_add (FST _1) (word (8 * i) : int64), 8)) _2))

