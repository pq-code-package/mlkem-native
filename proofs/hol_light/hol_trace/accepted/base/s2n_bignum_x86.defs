definition num_of_wordlist
  |- (num_of_wordlist : ('N word) list -> num)
     = (specification "num_of_wordlist" num_of_wordlist:(('N word) list -> num).
         num_of_wordlist (NIL : ('N word) list) = 0
         /\ (!h:('N word) t:(('N word) list).
              num_of_wordlist (CONS h t)
              = val h + 2 EXP dimindex (UNIV : 'N -> bool) * num_of_wordlist t))

definition wordlist_of_num
  |- (wordlist_of_num : num -> num -> ('N word) list)
     = (specification "wordlist_of_num" wordlist_of_num:(num -> num -> ('N word) list).
         (!n:num. wordlist_of_num 0 n = (NIL : ('N word) list))
         /\ (!k:num n:num.
              wordlist_of_num (SUC k) n
              = CONS (word (n MOD 2 EXP dimindex (UNIV : 'N -> bool)) : 'N word)
                  (wordlist_of_num k (n DIV 2 EXP dimindex (UNIV : 'N -> bool)))))

definition wordlist_from_memory
  |- (wordlist_from_memory : int64 # num -> x86state -> ('N word) list)
     = (specification "wordlist_from_memory" wordlist_from_memory:(int64 # num -> x86state ->
           ('N word) list).
         !a:int64 n:num s:x86state.
           wordlist_from_memory (a, n) s
           = (wordlist_of_num n
               (read (memory :> bytes (a, (dimindex (UNIV : 'N -> bool) * n + 7) DIV 8)) s)
               : ('N word) list))

definition pair_wordlist
  |- (pair_wordlist : ('N word) list -> (('N tybit0) word) list)
     = (specification "pair_wordlist" pair_wordlist:(('N word) list -> (('N tybit0) word) list).
         (!hi:('N word) lo:('N word) rest:(('N word) list).
           pair_wordlist (CONS lo (CONS hi rest))
           = CONS (word_join hi lo : ('N tybit0) word) (pair_wordlist rest))
         /\ (!w:('N word).
              pair_wordlist [w] = [(word_join (word 0 : 'N word) w : ('N tybit0) word)])
         /\ pair_wordlist (NIL : ('N word) list) = (NIL : (('N tybit0) word) list))

definition bigdigit
  |- bigdigit = (\_1:num _2:num. _1 DIV 2 EXP (64 * _2) MOD 2 EXP 64)

