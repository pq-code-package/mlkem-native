definition read_VEX
  |- read_VEX
     = (specification "read_VEX" read_VEX:(bool -> byte list ->
           (((4 word) option # VEXM # 4 word # bool # bool # rep_pfx # seg_pfx) # byte list)
             option).
         (!l:(byte list).
           read_VEX T l
           = >>= (read_byte l) (GABS (\f:(byte # byte list ->
