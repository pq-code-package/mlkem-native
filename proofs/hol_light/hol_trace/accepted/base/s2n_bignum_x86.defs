definition condition_semantics
  |- condition_semantics
     = (specification "condition_semantics" condition_semantics:(condition -> x86state -> bool).
         (!s:x86state. condition_semantics Unconditional s = T)
         /\ (!s:x86state. condition_semantics Condition_B s = read CF s)
         /\ (!s:x86state. condition_semantics Condition_BE s = (read CF s \/ read ZF s))
         /\ (!s:x86state. condition_semantics Condition_L s = ~ (read SF s = read OF s))
         /\ (!s:x86state.
              condition_semantics Condition_LE s = (~ (read SF s = read OF s) \/ read ZF s))
         /\ (!s:x86state. condition_semantics Condition_NB s = ~ (read CF s))
         /\ (!s:x86state. condition_semantics Condition_NBE s = ~ (read CF s \/ read ZF s))
         /\ (!s:x86state. condition_semantics Condition_NL s = (read SF s = read OF s))
         /\ (!s:x86state.
              condition_semantics Condition_NLE s = (read SF s = read OF s /\ ~ (read ZF s)))
         /\ (!s:x86state. condition_semantics Condition_NO s = ~ (read OF s))
         /\ (!s:x86state. condition_semantics Condition_NP s = ~ (read PF s))
         /\ (!s:x86state. condition_semantics Condition_NS s = ~ (read SF s))
         /\ (!s:x86state. condition_semantics Condition_NZ s = ~ (read ZF s))
         /\ (!s:x86state. condition_semantics Condition_O s = read OF s)
         /\ (!s:x86state. condition_semantics Condition_P s = read PF s)
         /\ (!s:x86state. condition_semantics Condition_S s = read SF s)
         /\ (!s:x86state. condition_semantics Condition_Z s = read ZF s))

definition raise_exception
  |- raise_exception = (\_1:byte. ASSIGNS (entirety : (x86state, x86state) component))

definition raise_exception_with
  |- raise_exception_with = (\_1:byte _2:int64. ASSIGNS (entirety : (x86state, x86state) component))

