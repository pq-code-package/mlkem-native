definition x86_VPMULLW
  |- (x86_VPMULLW : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:x86state.
         let x:('N word) = read _2 _4
         and y:('N word) = read _3 _4 in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) =
               simd16 (word_mul : int16 -> int16 -> int16) (word_zx x : 256 word)
                 (word_zx y : 256 word) in
           := _1 (word_zx res : 'N word) _4)
           (let res:int128 =
