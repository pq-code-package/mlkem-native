definition x86_PBLENDW
  |- x86_PBLENDW
     = (\_1:((x86state, int128) component) _2:((x86state, int128) component)
         _3:((x86state, byte) component) _4:x86state.
         let x:int128 = read _1 _4
         and y:int128 = read _2 _4
         and imm8:byte = read _3 _4 in
         let fn:(1 word -> int16 -> int16 -> int16) =
             \i:(1 word) x:int16 y:int16. COND (i = (word 1 : 1 word)) y x in
         let res:int128 = msimd8 fn imm8 x y in := _1 res _4)

definition x86_PCMPGTD
  |- (x86_PCMPGTD : ('?1, int128) component -> ('?1, int128) component -> '?1 -> '?1 -> bool)
     = (\_1:(('?1, int128) component) _2:(('?1, int128) component) _3:'?1.
         let x:int128 = read _1 _3 in
         let y:int128 = read _2 _3 in
         let res:int128 =
             simd4
               (\x:int32 y:int32. COND (word_igt x y) (word 4294967295 : int32) (word 0 : int32))
               x
               y in
         := _1 res _3)

definition x86_PCMPGTW
  |- (x86_PCMPGTW : ('?1, int128) component -> ('?1, int128) component -> '?1 -> '?1 -> bool)
     = (\_1:(('?1, int128) component) _2:(('?1, int128) component) _3:'?1.
         let x:int128 = read _1 _3 in
         let y:int128 = read _2 _3 in
         let res:int128 =
             simd8 (\x:int16 y:int16. COND (word_igt x y) (word 65535 : int16) (word 0 : int16)) x
               y in
         := _1 res _3)

definition x86_PEXT
  |- (x86_PEXT : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:x86state.
         let x:('N word) = read _2 _4
         and y:('N word) = read _3 _4 in
         let res:('N word) = word_condense x y in
         (,,)
           (:= events (CONS
             (EventX86PEXT ((word_zx x : int64), (word_zx y : int64), dimindex (UNIV : 'N -> bool))
               : 64 address_uarch_event)
             (read events _4)))
           (:= _1 res)
           _4)

definition x86_PINSRD
  |- x86_PINSRD
     = (\_1:((x86state, int128) component) _2:((x86state, int32) component)
         _3:((x86state, byte) component) _4:x86state.
         let x:int128 = read _1 _4
         and w:int32 = read _2 _4
         and sel:num = val (read _3 _4) MOD 4 in
         let res:int128 = (word_insert x (32 * sel, 32) w : int128) in := _1 res _4)

definition x86_PINSRQ
  |- x86_PINSRQ
     = (\_1:((x86state, int128) component) _2:((x86state, int64) component)
         _3:((x86state, byte) component) _4:x86state.
         let x:int128 = read _1 _4
         and w:int64 = read _2 _4
         and sel:num = val (read _3 _4) MOD 2 in
         let res:int128 = (word_insert x (64 * sel, 64) w : int128) in := _1 res _4)

definition x86_PMOVMSKB
  |- (x86_PMOVMSKB : (x86state, 'N word) component -> (x86state, int128) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, int128) component) _3:x86state.
         let x:int128 = read _2 _3 in
         let res:int16 = usimd16 (\x:byte. COND (bit 7 x) (word 1 : 1 word) (word 0 : 1 word)) x in
         := _1 (word_zx res : 'N word) _3)

definition x86_VMOVMSKPS
  |- x86_VMOVMSKPS
     = (\_1:((x86state, int32) component) _2:((x86state, 256 word) component) _3:x86state.
         let x:(256 word) = read _2 _3 in
         let res:byte =
             (word
               (bitval (bit 31 (word_subword x (0, 32) : int32))
               + 2 * bitval (bit 31 (word_subword x (32, 32) : int32))
               + 4 * bitval (bit 31 (word_subword x (64, 32) : int32))
               + 8 * bitval (bit 31 (word_subword x (96, 32) : int32))
               + 16 * bitval (bit 31 (word_subword x (128, 32) : int32))
               + 32 * bitval (bit 31 (word_subword x (160, 32) : int32))
               + 64 * bitval (bit 31 (word_subword x (192, 32) : int32))
               + 128 * bitval (bit 31 (word_subword x (224, 32) : int32)))
               : byte) in
         := _1 (word_zx res : int32) _3)

definition x86_VPMOVMSKB
  |- x86_VPMOVMSKB
     = (\_1:((x86state, int32) component) _2:((x86state, 256 word) component) _3:x86state.
         let x:(256 word) = read _2 _3 in
         := _1
           (word
             (nsum (0..31) (\i:num. 2 EXP i * bitval (bit 7 (word_subword x (8 * i, 8) : byte))))
             : int32)
           _3)

definition x86_POP
  |- (x86_POP : (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:x86state.
         let n:num = dimindex (UNIV : 'N -> bool) DIV 8 in
         let p:int64 = read RSP _2 in
         let x:('N word) = (word (read (memory :> bytes (p, n)) _2) : 'N word) in
         let p':int64 = word_add p (word n : int64) in
         (,,) (:= events (CONS (EventLoad (p, n)) (read events _2))) (:= RSP p' ,, := _1 x) _2)

definition x86_POPCNT
  |- (x86_POPCNT : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _2 _3 in
         let z:('N word) = (word (word_popcount x) : 'N word) in
         (,,)
           (:= events (CONS
             (EventX86POPCNT ((word_zx x : int64), dimindex (UNIV : 'N -> bool))
               : 64 address_uarch_event)
             (read events _3)))
           (:= _1 z ,, := OF F ,, := SF F ,, := AF F ,, := CF F ,, := PF F ,, := ZF (val x = 0))
           _3)

definition x86_PUSH
  |- (x86_PUSH : (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:x86state.
         let n:num = dimindex (UNIV : 'N -> bool) DIV 8 in
         let p:int64 = read RSP _2
         and x:num = val (read _1 _2) in
         let p':int64 = word_sub p (word n : int64) in
         (,,) (:= events (CONS (EventStore (p', n)) (read events _2)))
           (:= RSP p' ,, := (memory :> bytes (p', n)) x)
           _2)

definition x86_PSHUFB
  |- x86_PSHUFB
     = (\_1:((x86state, int128) component) _2:((x86state, int128) component) _3:x86state.
         let x:int128 = read _1 _3
         and ix:int128 = read _2 _3 in
         let f8:(byte -> byte) =
             \i:byte.
               COND (bit 7 i) (word 0 : byte) (word_subword x
                 (8 * val (word_subword i (0, 4) : 4 word), 8)
                 : byte) in
         let res:int128 = usimd16 f8 ix in := _1 res _3)

definition x86_PSHUFD
  |- (x86_PSHUFD : ('?1, int128) component -> ('?1, '?2 word) component -> ('?1, byte) component ->
         '?1 -> '?1 -> bool)
     = (\_1:(('?1, int128) component) _2:(('?1, '?2 word) component) _3:(('?1, byte) component)
         _4:'?1.
         let src:('?2 word) = read _2 _4 in
         let od:byte = read _3 _4 in
         let res:int128 = usimd4 (\od:(2 word). (word_subword src (val od * 32, 32) : int32)) od in
         := _1 res _4)

definition x86_PSRAD
  |- (x86_PSRAD : ('?1, int128) component -> ('?1, '?2 word) component -> '?1 -> '?1 -> bool)
     = (\_1:(('?1, int128) component) _2:(('?1, '?2 word) component) _3:'?1.
         let d:int128 = read _1 _3 in
         let count:num = val (read _2 _3) in
         let res:int128 = usimd4 (\x:int32. word_ishr x count) d in := _1 res _3)

definition x86_PSRLW
  |- (x86_PSRLW : ('?1, int128) component -> ('?1, '?2 word) component -> '?1 -> '?1 -> bool)
     = (\_1:(('?1, int128) component) _2:(('?1, '?2 word) component) _3:'?1.
         let d:int128 = read _1 _3 in
         let count:num = val (read _2 _3) in
         let res:int128 = usimd8 (\x:int16. word_ushr x count) d in := _1 res _3)

definition x86_PXOR
  |- (x86_PXOR : ('?1, '?2 word) component -> ('?1, '?2 word) component -> '?1 -> '?1 -> bool)
     = (\_1:(('?1, '?2 word) component) _2:(('?1, '?2 word) component) _3:'?1.
         let x:('?2 word) = read _1 _3 in let y:('?2 word) = read _2 _3 in := _1 (word_xor x y) _3)

definition x86_CALL
  |- x86_CALL
     = (\_1:int64 _2:x86state.
         (,,) (:= events (CONS (EventJump (read RIP _2, _1)) (read events _2)))
           (x86_PUSH RIP ,, := RIP _1)
           _2)

definition x86_RET
  |- x86_RET
     = (\_1:x86state.
         let p:int64 = read RSP _1 in
         let p':int64 = word_add p (word 8 : int64)
         and ip':int64 = read (memory :> bytes64 p) _1 in
         (,,)
           (:= events (CONS (EventJump (read RIP _1, ip'))
             (CONS (EventLoad (p, 8)) (read events _1))))
           (:= RSP p' ,, := RIP ip')
           _1)

definition x86_RCL
  |- (x86_RCL : (x86state, 'N word) component -> num -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:num _3:x86state.
         let x:('N word) = read _1 _3
         and cin:bool = read CF _3 in
         let xx:(((1, 'N) finite_sum) word) =
             (word_join (word (bitval cin) : 1 word) x : ((1, 'N) finite_sum) word) in
         let zz:(((1, 'N) finite_sum) word) = word_rol xx _2 in
         let z:('N word) = (word_subword zz (0, dimindex (UNIV : 'N -> bool)) : 'N word)
         and cout:bool = bit (dimindex (UNIV : 'N -> bool)) zz in
         (,,) (:= _1 z)
           (:= CF cout
           ,, COND (_2 = 0) (:= OF (read OF _3)) (COND (_2 = 1)
                (:= OF (~ (bit (dimindex (UNIV : 'N -> bool) - 1) z = cout)))
                (UNDEFINED_VALUES [OF])))
           _3)

definition x86_RCR
  |- (x86_RCR : (x86state, 'N word) component -> num -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:num _3:x86state.
         let x:('N word) = read _1 _3
         and cin:bool = read CF _3 in
         let xx:(((1, 'N) finite_sum) word) =
             (word_join (word (bitval cin) : 1 word) x : ((1, 'N) finite_sum) word) in
         let zz:(((1, 'N) finite_sum) word) = word_ror xx _2 in
         let z:('N word) = (word_subword zz (0, dimindex (UNIV : 'N -> bool)) : 'N word)
         and cout:bool = bit (dimindex (UNIV : 'N -> bool)) zz in
         (,,) (:= _1 z)
           (:= CF cout
           ,, COND (_2 = 0) (:= OF (read OF _3)) (COND (_2 = 1)
                (:= OF (~ (bit (dimindex (UNIV : 'N -> bool) - 1) z
                = bit (dimindex (UNIV : 'N -> bool) - 2) z)))
                (UNDEFINED_VALUES [OF])))
           _3)

definition x86_ROL
  |- (x86_ROL : (x86state, 'N word) component -> num -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:num _3:x86state.
         let x:('N word) = read _1 _3 in
         let z:('N word) = word_rol x _2 in
         (,,) (:= _1 z)
           (:= CF (COND (_2 = 0) (read CF _3) (bit 0 z))
           ,, COND (_2 = 0) (:= OF (read OF _3)) (COND (_2 = 1)
                (:= OF (~ (bit (dimindex (UNIV : 'N -> bool) - 1) z = bit 0 z)))
                (UNDEFINED_VALUES [OF])))
           _3)

definition x86_ROR
  |- (x86_ROR : (x86state, 'N word) component -> num -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:num _3:x86state.
         let x:('N word) = read _1 _3 in
         let z:('N word) = word_ror x _2 in
         (,,) (:= _1 z)
           (:= CF (COND (_2 = 0) (read CF _3) (bit (dimindex (UNIV : 'N -> bool) - 1) z))
           ,, COND (_2 = 0) (:= OF (read OF _3)) (COND (_2 = 1)
                (:= OF (~ (bit (dimindex (UNIV : 'N -> bool) - 1) z
                = bit (dimindex (UNIV : 'N -> bool) - 2) z)))
                (UNDEFINED_VALUES [OF])))
           _3)

definition x86_SAR
  |- (x86_SAR : (x86state, 'N word) component -> num -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:num _3:x86state.
         let x:('N word) = read _1 _3 in
         let z:('N word) = word_ishr x _2 in
         (,,) (:= _1 z)
           (:= ZF (COND (_2 = 0) (read ZF _3) (val z = 0))
           ,, := SF (COND (_2 = 0) (read SF _3) (ival z < &0))
           ,, := PF (COND (_2 = 0) (read PF _3) (word_evenparity (word_zx z : byte)))
           ,, := CF (COND (_2 = 0) (read CF _3) (bit 0 (word_ishr x (_2 - 1))))
           ,, COND (_2 = 0) (:= OF (read OF _3)) (COND (_2 = 1) (:= OF F) (UNDEFINED_VALUES [OF]))
           ,, COND (_2 = 0) (:= AF (read AF _3)) (UNDEFINED_VALUES [AF]))
           _3)

definition x86_SBB
  |- (x86_SBB : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _1 _3
         and y:('N word) = read _2 _3
         and c:num = bitval (read CF _3) in
         let z:('N word) = word_sub x (word_add y (word c : 'N word)) in
         (,,) (:= _1 z)
           (:= ZF (val z = 0)
           ,, := SF (ival z < &0)
           ,, := PF (word_evenparity (word_zx z : byte))
           ,, := CF (~ (int_of_num (val x) - (int_of_num (val y) + int_of_num c)
              = int_of_num (val z)))
           ,, := OF (~ (ival x - (ival y + int_of_num c) = ival z))
           ,, := AF (~ (int_of_num (val (word_zx x : 4 word))
              - (int_of_num (val (word_zx y : 4 word)) + int_of_num c)
              = int_of_num (val (word_zx z : 4 word)))))
           _3)

definition x86_SET
  |- x86_SET
     = (\_1:condition _2:((x86state, byte) component) _3:x86state.
         := _2 (COND (condition_semantics _1 _3) (word 1 : byte) (word 0 : byte)) _3)

definition x86_SHL
  |- (x86_SHL : (x86state, 'N word) component -> num -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:num _3:x86state.
         let x:('N word) = read _1 _3 in
         let z:('N word) = word_shl x _2 in
         (,,) (:= _1 z)
           (:= ZF (COND (_2 = 0) (read ZF _3) (val z = 0))
           ,, := SF (COND (_2 = 0) (read SF _3) (ival z < &0))
           ,, := PF (COND (_2 = 0) (read PF _3) (word_evenparity (word_zx z : byte)))
           ,, := CF (COND (_2 = 0) (read CF _3) (bit (dimindex (UNIV : 'N -> bool) - 1)
                (word_shl x (_2 - 1))))
           ,, COND (_2 = 0) (:= OF (read OF _3)) (COND (_2 = 1)
                (:= OF (~ (bit (dimindex (UNIV : 'N -> bool) - 1) x
                = bit (dimindex (UNIV : 'N -> bool) - 2) x)))
                (UNDEFINED_VALUES [OF]))
           ,, COND (_2 = 0) (:= AF (read AF _3)) (UNDEFINED_VALUES [AF]))
           _3)

definition x86_SHLD
  |- (x86_SHLD : (x86state, 'N word) component -> (x86state, 'N word) component -> num ->
         x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:num _4:x86state.
         let h:('N word) = read _1 _4
         and l:('N word) = read _2 _4 in
         let concat:(('N tybit0) word) = (word_join h l : ('N tybit0) word) in
         let z:('N word) =
             (word_subword concat (dimindex (UNIV : 'N -> bool) - _3, dimindex (UNIV : 'N -> bool))
               : 'N word) in
         (,,) (:= _1 z)
           (:= ZF (COND (_3 = 0) (read ZF _4) (val z = 0))
           ,, := SF (COND (_3 = 0) (read SF _4) (ival z < &0))
           ,, := PF (COND (_3 = 0) (read PF _4) (word_evenparity (word_zx z : byte)))
           ,, := CF (COND (_3 = 0) (read CF _4) (bit (dimindex (UNIV : 'N -> bool) - _3) h))
           ,, COND (_3 = 0) (:= OF (read OF _4)) (COND (_3 = 1)
                (:= OF (~ (bit (dimindex (UNIV : 'N -> bool) - 1) z
                = bit (dimindex (UNIV : 'N -> bool) - 1) h)))
                (UNDEFINED_VALUES [OF]))
           ,, COND (_3 = 0) (:= AF (read AF _4)) (UNDEFINED_VALUES [AF]))
           _4)

definition x86_SHR
  |- (x86_SHR : (x86state, 'N word) component -> num -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:num _3:x86state.
         let x:('N word) = read _1 _3 in
         let z:('N word) = word_ushr x _2 in
         (,,) (:= _1 z)
           (:= ZF (COND (_2 = 0) (read ZF _3) (val z = 0))
           ,, := SF (COND (_2 = 0) (read SF _3) (ival z < &0))
           ,, := PF (COND (_2 = 0) (read PF _3) (word_evenparity (word_zx z : byte)))
           ,, := CF (COND (_2 = 0) (read CF _3) (bit 0 (word_ushr x (_2 - 1))))
           ,, COND (_2 = 0) (:= OF (read OF _3)) (COND (_2 = 1)
                (:= OF (bit (dimindex (UNIV : 'N -> bool) - 1) x))
                (UNDEFINED_VALUES [OF]))
           ,, COND (_2 = 0) (:= AF (read AF _3)) (UNDEFINED_VALUES [AF]))
           _3)

definition x86_SHRD
  |- (x86_SHRD : (x86state, 'N word) component -> (x86state, 'N word) component -> num ->
         x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:num _4:x86state.
         let h:('N word) = read _2 _4
         and l:('N word) = read _1 _4 in
         let concat:(('N tybit0) word) = (word_join h l : ('N tybit0) word) in
         let z:('N word) = (word_subword concat (_3, dimindex (UNIV : 'N -> bool)) : 'N word) in
         (,,) (:= _1 z)
           (:= ZF (COND (_3 = 0) (read ZF _4) (val z = 0))
           ,, := SF (COND (_3 = 0) (read SF _4) (ival z < &0))
           ,, := PF (COND (_3 = 0) (read PF _4) (word_evenparity (word_zx z : byte)))
           ,, := CF (COND (_3 = 0) (read CF _4) (bit (_3 - 1) l))
           ,, COND (_3 = 0) (:= OF (read OF _4)) (COND (_3 = 1)
                (:= OF (~ (bit (dimindex (UNIV : 'N -> bool) - 1) z
                = bit (dimindex (UNIV : 'N -> bool) - 1) l)))
                (UNDEFINED_VALUES [OF]))
           ,, COND (_3 = 0) (:= AF (read AF _4)) (UNDEFINED_VALUES [AF]))
           _4)

definition x86_STC
  |- x86_STC = (\_1:x86state. := CF T _1)

definition x86_STD
  |- x86_STD = (\_1:x86state. := DF T _1)

definition x86_SUB
  |- (x86_SUB : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _1 _3
         and y:('N word) = read _2 _3 in
         let z:('N word) = word_sub x y in
         (,,) (:= _1 z)
           (:= ZF (val z = 0)
           ,, := SF (ival z < &0)
           ,, := PF (word_evenparity (word_zx z : byte))
           ,, := CF (~ (int_of_num (val x) - int_of_num (val y) = int_of_num (val z)))
           ,, := OF (~ (ival x - ival y = ival z))
           ,, := AF (~ (int_of_num (val (word_zx x : 4 word))
              - int_of_num (val (word_zx y : 4 word))
              = int_of_num (val (word_zx z : 4 word)))))
           _3)

definition x86_VMOVSLDUP
  |- (x86_VMOVSLDUP : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _2 _3 in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) =
               usimd4 (\pair:int64. (word_duplicate (word_subword pair (0, 32) : int32) : int64))
                 (word_zx x : 256 word) in
           := _1 (word_zx res : 'N word) _3)
           (let res:int128 =
               usimd2 (\pair:int64. (word_duplicate (word_subword pair (0, 32) : int32) : int64))
                 (word_zx x : int128) in
           := _1 (word_zx res : 'N word) _3))

definition x86_VMOVDQA
  |- (x86_VMOVDQA : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _2 _3 in := _1 x _3)

definition x86_VMOVDQU
  |- (x86_VMOVDQU : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _2 _3 in := _1 x _3)

definition x86_VMOVSHDUP
  |- (x86_VMOVSHDUP : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _2 _3 in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) =
               usimd4 (\pair:int64. (word_duplicate (word_subword pair (32, 32) : int32) : int64))
                 (word_zx x : 256 word) in
           := _1 (word_zx res : 'N word) _3)
           (let res:int128 =
               usimd2 (\pair:int64. (word_duplicate (word_subword pair (32, 32) : int32) : int64))
                 (word_zx x : int128) in
           := _1 (word_zx res : 'N word) _3))

definition x86_VPADDB
  |- (x86_VPADDB : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:x86state.
         let x:('N word) = read _2 _4
         and y:('N word) = read _3 _4 in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) =
               simd32 (word_add : byte -> byte -> byte) (word_zx x : 256 word)
                 (word_zx y : 256 word) in
           := _1 (word_zx res : 'N word) _4)
           (let res:int128 =
               simd16 (word_add : byte -> byte -> byte) (word_zx x : int128) (word_zx y : int128) in
           := _1 (word_zx res : 'N word) _4))

definition x86_VPADDD
  |- (x86_VPADDD : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:x86state.
         let x:('N word) = read _2 _4
         and y:('N word) = read _3 _4 in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) =
               simd8 (word_add : int32 -> int32 -> int32) (word_zx x : 256 word)
                 (word_zx y : 256 word) in
           := _1 (word_zx res : 'N word) _4)
           (let res:int128 =
               simd4 (word_add : int32 -> int32 -> int32) (word_zx x : int128)
                 (word_zx y : int128) in
           := _1 (word_zx res : 'N word) _4))

