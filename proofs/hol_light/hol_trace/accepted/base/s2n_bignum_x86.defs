definition x86_MOVSB
  |- x86_MOVSB
     = (\_1:bool _2:((x86state, int64) component) _3:((x86state, int64) component)
         _4:((x86state, int64) component) _5:x86state.
         let sptr:int64 = read _3 _5
         and dptr:int64 = read _2 _5
         and n:int64 = read _4 _5
         and df:bool = read DF _5 in
         let sbuf:int64 = COND df (word_sub sptr (word_sub n (word 1 : int64))) sptr
         and dbuf:int64 = COND df (word_sub dptr (word_sub n (word 1 : int64))) dptr in
         (,,)
           (:= events (CONS (EventStore (dbuf, val n))
             (CONS (EventLoad (sbuf, val n)) (read events _5))))
           ((\s:x86state s':x86state. x86_movsb df sbuf dbuf (val n) s = s')
           ,, := _3 (COND df (word_sub sptr n) (word_add sptr n))
           ,, := _2 (COND df (word_sub dptr n) (word_add dptr n))
           ,, COND _1 (:= _4 (word 0 : int64)) ((=) : x86state -> x86state -> bool))
           _5)

