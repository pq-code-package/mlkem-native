definition x86_VPBLENDD
  |- (x86_VPBLENDD : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> (x86state, '?1 word) component -> x86state -> x86state ->
         bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:((x86state, '?1 word) component) _5:x86state.
         let x:('N word) = read _2 _5
         and y:('N word) = read _3 _5
         and imm8:('?1 word) = read _4 _5 in
         let fn:(1 word -> int32 -> int32 -> int32) =
             \i:(1 word) x:int32 y:int32. COND (i = (word 1 : 1 word)) y x in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) =
               msimd8 fn (word_zx imm8 : byte) (word_zx x : 256 word) (word_zx y : 256 word) in
           := _1 (word_zx res : 'N word) _5)
           (let res:int128 =
               msimd4 fn (word_zx imm8 : 4 word) (word_zx x : int128) (word_zx y : int128) in
           := _1 (word_zx res : 'N word) _5))

definition x86_VPBLENDW
  |- (x86_VPBLENDW : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> (x86state, '?1 word) component -> x86state -> x86state ->
         bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:((x86state, '?1 word) component) _5:x86state.
         let x:('N word) = read _2 _5
         and y:('N word) = read _3 _5
         and imm8:('?1 word) = read _4 _5 in
         let fn:(1 word -> int16 -> int16 -> int16) =
             \i:(1 word) x:int16 y:int16. COND (i = (word 1 : 1 word)) y x in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) =
               msimd16 fn (word_join imm8 imm8 : int16) (word_zx x : 256 word)
                 (word_zx y : 256 word) in
           := _1 (word_zx res : 'N word) _5)
           (let res:int128 =
               msimd8 fn (word_zx imm8 : byte) (word_zx x : int128) (word_zx y : int128) in
           := _1 (word_zx res : 'N word) _5))

definition x86_VPCLMULQDQ
  |- (x86_VPCLMULQDQ : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> (x86state, byte) component -> x86state -> x86state ->
         bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:((x86state, byte) component) _5:x86state.
         let x:('N word) = read _2 _5
         and y:('N word) = read _3 _5
         and imm:byte = read _4 _5 in
         let f:(int128 -> int128 -> int128) =
             \x:int128 y:int128.
               let a:int64 =
                   COND (bit 0 imm) (word_subword x (64, 64) : int64)
                     (word_subword x (0, 64) : int64)
               and b:int64 =
                   COND (bit 4 imm) (word_subword y (64, 64) : int64)
                     (word_subword y (0, 64) : int64) in
               (word_pmul a b : int128) in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) = simd2 f (word_zx x : 256 word) (word_zx y : 256 word) in
           := _1 (word_zx res : 'N word) _5)
           (let res:int128 = f (word_zx x : int128) (word_zx y : int128) in
           := _1 (word_zx res : 'N word) _5))

definition x86_VPBROADCASTD
  |- (x86_VPBROADCASTD : (x86state, 'N word) component -> (x86state, 'M word) component ->
         x86state -> x86state -> bool)
