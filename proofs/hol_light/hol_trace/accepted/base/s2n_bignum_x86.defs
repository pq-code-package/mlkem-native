         (,,) (:= _1 z)
           (:= ZF (val z = 0)
           ,, := SF (ival z < &0)
           ,, := PF (word_evenparity (word_zx z : byte))
           ,, := CF F
           ,, := OF F
           ,, UNDEFINED_VALUES [AF])
           _3)

definition x86_PADDD
