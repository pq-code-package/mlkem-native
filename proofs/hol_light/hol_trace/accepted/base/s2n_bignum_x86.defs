               word_add
                 (word_mul (word_sx (word_subword x (0, 16) : int16) : int32)
                   (word_sx (word_subword y (0, 16) : int16) : int32))
                 (word_mul (word_sx (word_subword x (16, 16) : int16) : int32)
                   (word_sx (word_subword y (16, 16) : int16) : int32)) in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) = simd8 f (word_zx x : 256 word) (word_zx y : 256 word) in
           := _1 (word_zx res : 'N word) _4)
           (let res:int128 = simd4 f (word_zx x : int128) (word_zx y : int128) in
           := _1 (word_zx res : 'N word) _4))

