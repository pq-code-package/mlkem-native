definition WINDOWS_C_ARGUMENTS
  |- WINDOWS_C_ARGUMENTS
     = (specification "WINDOWS_C_ARGUMENTS" WINDOWS_C_ARGUMENTS:(int64 list -> x86state -> bool).
         (!a1:int64 a2:int64 a3:int64 a4:int64 a5:int64 a6:int64 s:x86state.
           WINDOWS_C_ARGUMENTS [a1; a2; a3; a4; a5; a6] s
           = (read RCX s = a1
             /\ read RDX s = a2
             /\ read R8 s = a3
             /\ read R9 s = a4
             /\ read (memory :> bytes64 (word_add (read RSP s) (word 40 : int64))) s = a5
             /\ read (memory :> bytes64 (word_add (read RSP s) (word 48 : int64))) s = a6))
         /\ (!a1:int64 a2:int64 a3:int64 a4:int64 a5:int64 s:x86state.
              WINDOWS_C_ARGUMENTS [a1; a2; a3; a4; a5] s
              = (read RCX s = a1
                /\ read RDX s = a2
                /\ read R8 s = a3
                /\ read R9 s = a4
                /\ read (memory :> bytes64 (word_add (read RSP s) (word 40 : int64))) s = a5))
         /\ (!a1:int64 a2:int64 a3:int64 a4:int64 s:x86state.
              WINDOWS_C_ARGUMENTS [a1; a2; a3; a4] s
              = (read RCX s = a1 /\ read RDX s = a2 /\ read R8 s = a3 /\ read R9 s = a4))
         /\ (!a1:int64 a2:int64 a3:int64 s:x86state.
              WINDOWS_C_ARGUMENTS [a1; a2; a3] s
              = (read RCX s = a1 /\ read RDX s = a2 /\ read R8 s = a3))
         /\ (!a1:int64 a2:int64 s:x86state.
              WINDOWS_C_ARGUMENTS [a1; a2] s = (read RCX s = a1 /\ read RDX s = a2))
         /\ (!a1:int64 s:x86state. WINDOWS_C_ARGUMENTS [a1] s = (read RCX s = a1))
         /\ (!s:x86state. WINDOWS_C_ARGUMENTS (NIL : int64 list) s = T))

