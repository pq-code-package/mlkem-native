definition decode_aux
  sha256 7a94cf7781114be46a27902afe166e6225c20d227e4363b757ab30c15934d03c (1522655 characters, not shown)

definition decode
  |- decode
     = (\_1:(byte list).
         >>= (read_prefixes _1 (F, Rep0, SG0)) (GABS
           (\f:((bool # rep_pfx # seg_pfx) # byte list -> (instruction # byte list) option).
             !p:(bool # rep_pfx # seg_pfx) l:(byte list).
               GEQ (f (p, l)) (LET
                 (GABS (\f:((4 word) option # byte list -> (instruction # byte list) option).
                   !rex:((4 word) option) l:(byte list).
                     GEQ (f (rex, l)) (LET_END (decode_aux p rex l))))
                 (read_REX_prefix l)))))

definition decode'
  |- decode'
     = (\_1:(bool # rep_pfx # seg_pfx) _2:((4 word) option) _3:(byte list).
         COND (is_some _2) (decode_aux _1 _2 _3) (>>= (read_prefixes _3 _1)
           (GABS (\f:((bool # rep_pfx # seg_pfx) # byte list -> (instruction # byte list) option).
             !p:(bool # rep_pfx # seg_pfx) l:(byte list).
               GEQ (f (p, l)) (LET
                 (GABS (\f:((4 word) option # byte list -> (instruction # byte list) option).
                   !rex:((4 word) option) l:(byte list).
                     GEQ (f (rex, l)) (LET_END (decode_aux p rex l))))
                 (read_REX_prefix l))))))

definition list_linear
  |- (list_linear : ('A list -> 'A list -> bool) -> bool)
     = (\_1:('A list -> 'A list -> bool).
         !l1:('A list) l2:('A list).
           _1 l1 l2 ==> (?l:('A list). l1 = APPEND l l2 /\ (!l2':('A list). _1 (APPEND l l2') l2')))

definition list_linear_f
  |- (list_linear_f : ('A list -> ('B # 'A list) option) -> bool)
     = (\_1:('A list -> ('B # 'A list) option).
         !b:'B. list_linear (\l1:('A list) l2:('A list). _1 l1 = SOME (b, l2)))

definition decode_len
  |- decode_len
     = (\_1:(byte list) _2:(num # instruction) _3:(byte list).
         decode _1 = SOME (SND _2, _3) /\ LENGTH _1 = LENGTH _3 + FST _2)

definition riprel32_within_bounds
  |- riprel32_within_bounds
     = (\_1:num _2:num.
         -(int_of_num (2 EXP 31)) <= int_of_num _1 - int_of_num _2
         /\ int_of_num _1 - int_of_num _2 < int_of_num (2 EXP 31))

definition bytesize
  |- bytesize
     = (specification "bytesize" bytesize:(wordsize -> num).
         bytesize Byte = 8
         /\ bytesize Word = 16
         /\ bytesize Doubleword = 32
         /\ bytesize Quadword = 64
         /\ bytesize Word128 = 128
         /\ bytesize Word256 = 256)

definition regsize
  |- regsize
     = (specification "regsize" regsize:(regsize -> num).
         regsize Full_64 = 64
         /\ regsize Lower_32 = 32
         /\ regsize Lower_16 = 16
         /\ regsize Upper_8 = 8
         /\ regsize Lower_8 = 8)

definition simdregsize
  |- simdregsize
     = (specification "simdregsize" simdregsize:(simdregsize -> num).
         simdregsize Full_512 = 512 /\ simdregsize Lower_256 = 256 /\ simdregsize Lower_128 = 128)

definition register_size
  |- register_size
     = (specification "register_size" register_size:(gpr -> num).
         !n:(4 word) w:regsize. register_size (Gpr n w) = regsize w)

definition simdregister_size
  |- simdregister_size
     = (specification "simdregister_size" simdregister_size:(simdreg -> num).
         !n:(5 word) w:simdregsize. simdregister_size (Simdreg n w) = simdregsize w)

definition operand_size
  |- operand_size
     = (specification "operand_size" operand_size:(operand -> num).
         (!r:gpr. operand_size (Register r) = register_size r)
         /\ (!s:simdreg. operand_size (Simdregister s) = simdregister_size s)
         /\ (!i8:byte. operand_size (Imm8 i8) = 8)
         /\ (!i16:int16. operand_size (Imm16 i16) = 16)
         /\ (!i32:int32. operand_size (Imm32 i32) = 32)
         /\ (!i64:int64. operand_size (Imm64 i64) = 64)
         /\ (!w:wordsize b:bsid. operand_size (Memop w b) = bytesize w))

definition _<x86state_RECORD>
  |- _<x86state_RECORD>
     = (\a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word) a3:(3 word -> int64) a4:int64
         a5:(int64 -> byte) a6:((64 address_uarch_event) list).
         _mk_x86state ((\a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word) a3:(3 word -> int64)
                         a4:int64 a5:(int64 -> byte) a6:((64 address_uarch_event) list).
           CONSTR 0 (a0, a1, a2, a3, a4, a5, a6) (\n:num.
             (BOTTOM : (int64 # (4 word -> int64) # (5 word -> 512 word) # (3 word -> int64) #
                 int64 # (int64 -> byte) # (64 address_uarch_event) list) recspace))) a0 a1 a2 a3 a4
           a5
           a6))

definition x86state_RECORD
  |- x86state_RECORD = _<x86state_RECORD>

definition RIP
  |- RIP
     = (specification "RIP" c:((x86state, int64) component).
         (!a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word) a3:(3 word -> int64) a4:int64
           a5:(int64 -> byte) a6:((64 address_uarch_event) list).
           read c (x86state_RECORD a0 a1 a2 a3 a4 a5 a6) = a0)
         /\ (!a0':int64 a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word) a3:(3 word -> int64)
              a4:int64 a5:(int64 -> byte) a6:((64 address_uarch_event) list).
              write c a0' (x86state_RECORD a0 a1 a2 a3 a4 a5 a6)
              = x86state_RECORD a0' a1 a2 a3 a4 a5 a6))

definition registers
  |- registers
     = (specification "registers" c:((x86state, 4 word -> int64) component).
         (!a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word) a3:(3 word -> int64) a4:int64
           a5:(int64 -> byte) a6:((64 address_uarch_event) list).
           read c (x86state_RECORD a0 a1 a2 a3 a4 a5 a6) = a1)
         /\ (!a1':(4 word -> int64) a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word)
              a3:(3 word -> int64) a4:int64 a5:(int64 -> byte) a6:((64 address_uarch_event) list).
              write c a1' (x86state_RECORD a0 a1 a2 a3 a4 a5 a6)
              = x86state_RECORD a0 a1' a2 a3 a4 a5 a6))

definition simdregisters
  |- simdregisters
     = (specification "simdregisters" c:((x86state, 5 word -> 512 word) component).
         (!a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word) a3:(3 word -> int64) a4:int64
           a5:(int64 -> byte) a6:((64 address_uarch_event) list).
           read c (x86state_RECORD a0 a1 a2 a3 a4 a5 a6) = a2)
         /\ (!a2':(5 word -> 512 word) a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word)
              a3:(3 word -> int64) a4:int64 a5:(int64 -> byte) a6:((64 address_uarch_event) list).
              write c a2' (x86state_RECORD a0 a1 a2 a3 a4 a5 a6)
              = x86state_RECORD a0 a1 a2' a3 a4 a5 a6))

definition maskregisters
  |- maskregisters
     = (specification "maskregisters" c:((x86state, 3 word -> int64) component).
         (!a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word) a3:(3 word -> int64) a4:int64
           a5:(int64 -> byte) a6:((64 address_uarch_event) list).
           read c (x86state_RECORD a0 a1 a2 a3 a4 a5 a6) = a3)
         /\ (!a3':(3 word -> int64) a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word)
              a3:(3 word -> int64) a4:int64 a5:(int64 -> byte) a6:((64 address_uarch_event) list).
              write c a3' (x86state_RECORD a0 a1 a2 a3 a4 a5 a6)
              = x86state_RECORD a0 a1 a2 a3' a4 a5 a6))

definition rflags
  |- rflags
     = (specification "rflags" c:((x86state, int64) component).
         (!a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word) a3:(3 word -> int64) a4:int64
           a5:(int64 -> byte) a6:((64 address_uarch_event) list).
           read c (x86state_RECORD a0 a1 a2 a3 a4 a5 a6) = a4)
         /\ (!a4':int64 a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word) a3:(3 word -> int64)
              a4:int64 a5:(int64 -> byte) a6:((64 address_uarch_event) list).
              write c a4' (x86state_RECORD a0 a1 a2 a3 a4 a5 a6)
              = x86state_RECORD a0 a1 a2 a3 a4' a5 a6))

definition memory
  |- memory
     = (specification "memory" c:((x86state, int64 -> byte) component).
         (!a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word) a3:(3 word -> int64) a4:int64
           a5:(int64 -> byte) a6:((64 address_uarch_event) list).
           read c (x86state_RECORD a0 a1 a2 a3 a4 a5 a6) = a5)
         /\ (!a5':(int64 -> byte) a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word)
              a3:(3 word -> int64) a4:int64 a5:(int64 -> byte) a6:((64 address_uarch_event) list).
              write c a5' (x86state_RECORD a0 a1 a2 a3 a4 a5 a6)
              = x86state_RECORD a0 a1 a2 a3 a4 a5' a6))

definition events
  |- events
     = (specification "events" c:((x86state, (64 address_uarch_event) list) component).
         (!a0:int64 a1:(4 word -> int64) a2:(5 word -> 512 word) a3:(3 word -> int64) a4:int64
           a5:(int64 -> byte) a6:((64 address_uarch_event) list).
           read c (x86state_RECORD a0 a1 a2 a3 a4 a5 a6) = a6)
         /\ (!a6':((64 address_uarch_event) list) a0:int64 a1:(4 word -> int64)
              a2:(5 word -> 512 word) a3:(3 word -> int64) a4:int64 a5:(int64 -> byte)
              a6:((64 address_uarch_event) list).
              write c a6' (x86state_RECORD a0 a1 a2 a3 a4 a5 a6)
              = x86state_RECORD a0 a1 a2 a3 a4 a5 a6'))

definition bytes_loaded
  |- bytes_loaded
     = (\_1:x86state _2:int64 _3:(byte list). read (memory :> bytelist (_2, LENGTH _3)) _1 = _3)

definition aligned_bytes_loaded
  |- aligned_bytes_loaded
     = (\_1:x86state _2:int64 _3:(byte list). num_divides 4 (val _2) /\ bytes_loaded _1 _2 _3)

