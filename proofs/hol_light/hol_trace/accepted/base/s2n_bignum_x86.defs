                      (\"BM%PVAR%26":num
                        "BM%PVAR%27":((((4 word) option # VEXM # 4 word # bool # bool # rep_pfx #
                                seg_pfx) # byte list) option).
                        ?rxb:(3 word) m:(5 word).
                          _UNGUARDED_PATTERN (pat_set (CONSPAT (CONSPAT NILPAT rxb) m) "BM%PVAR%26")
                            (>>= (read_byte l) (GABS
                              (\f:(byte # byte list ->
                                    (((4 word) option # VEXM # 4 word # bool # bool # rep_pfx #
                                            seg_pfx) # byte list) option).
                                !b:byte l:(byte list).
                                  GEQ (f (b, l)) (_BITMATCH b
                                    (_SEQPATTERN
                                      (\"BM%PVAR%24":num
                                        "BM%PVAR%25":((((4 word) option # VEXM # 4 word # bool #
                                                bool # rep_pfx # seg_pfx) # byte list) option).
                                        ?w:bool v:(4 word) L:bool p:(2 word).
