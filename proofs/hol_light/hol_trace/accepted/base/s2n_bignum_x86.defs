definition x86_MULX4
  |- (x86_MULX4 : ('?1, 'N word) component # ('?1, 'N word) component ->
         ('?1, 'N word) component # ('?1, 'N word) component -> '?1 -> '?1 -> bool)
     = (\_1:(('?1, 'N word) component # ('?1, 'N word) component)
         _2:(('?1, 'N word) component # ('?1, 'N word) component) _3:'?1.
         let x:('N word) = read (FST _2) _3
         and y:('N word) = read (SND _2) _3 in
         let z:(('N tybit0) word) = (word (val x * val y) : ('N tybit0) word) in
         let z_hi:('N word) = (word_zx (word_ushr z (dimindex (UNIV : 'N -> bool))) : 'N word)
         and z_lo:('N word) = (word_zx z : 'N word) in
         (,,) (:= (SND _1) z_lo) (:= (FST _1) z_hi) _3)

definition x86_MUL2
  |- (x86_MUL2 : (x86state, 'N word) component # (x86state, 'N word) component ->
         (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component # (x86state, 'N word) component)
         _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read (SND _1) _3
         and y:('N word) = read _2 _3 in
         let z:(('N tybit0) word) = (word (val x * val y) : ('N tybit0) word) in
         let z_hi:('N word) = (word_zx (word_ushr z (dimindex (UNIV : 'N -> bool))) : 'N word)
         and z_lo:('N word) = (word_zx z : 'N word) in
         (,,) (:= (FST _1) z_hi)
           (:= (SND _1) z_lo
           ,, := CF (~ (z_hi = (word 0 : 'N word)))
           ,, := OF (~ (z_hi = (word 0 : 'N word)))
           ,, UNDEFINED_VALUES [ZF; SF; PF; AF])
           _3)

definition x86_NEG
  |- (x86_NEG : (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:x86state.
         let x:('N word) = read _1 _2 in
         let z:('N word) = word_neg x in
         (,,) (:= _1 z)
           (:= ZF (val z = 0)
           ,, := SF (ival z < &0)
           ,, := PF (word_evenparity (word_zx z : byte))
           ,, := CF (~ (x = (word 0 : 'N word)))
           ,, := OF (~ (-(ival x) = ival z))
           ,, := AF (~ (-(int_of_num (val (word_zx x : 4 word)))
              = int_of_num (val (word_zx z : 4 word)))))
           _2)

