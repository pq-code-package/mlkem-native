definition %%
  |- %%
     = (specification "%%" "%%":(gpr # num -> bsid).
         !r:gpr d:num.
           "%%" (r, d) = Bsid (SOME r) (NONE : gpr option) (word 0 : 2 word) (word d : int64))

definition %%%
  |- %%%
     = (specification "%%%" "%%%":(gpr # num # gpr -> bsid).
         !r:gpr s:num i:gpr.
           "%%%" (r, s, i) = Bsid (SOME r) (SOME i) (word s : 2 word) (word 0 : int64))

definition %%%%
  |- %%%%
     = (specification "%%%%" "%%%%":(gpr # num # gpr # int -> bsid).
         !r:gpr s:num i:gpr d:int.
           "%%%%" (r, s, i, d) = Bsid (SOME r) (SOME i) (word s : 2 word) (iword d : int64))

