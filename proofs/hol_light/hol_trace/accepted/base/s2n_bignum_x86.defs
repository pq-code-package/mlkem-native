           ,, := SF (ival z < &0)
           ,, := PF (word_evenparity (word_zx z : byte))
           ,, := OF (~ (ival x - &1 = ival z))
           ,, := AF (~ (int_of_num (val (word_zx x : 4 word)) - &1
              = int_of_num (val (word_zx z : 4 word)))))
           _2)

