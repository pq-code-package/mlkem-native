                   (\"BM%PVAR%22":num
                     "BM%PVAR%23":((((4 word) option # VEXM # 4 word # bool # bool # rep_pfx #
                             seg_pfx) # byte list) option).
                     ?r:(1 word) v:(4 word) L:bool p:(2 word).
                       _UNGUARDED_PATTERN
                         (pat_set (CONSPAT (CONSPAT (CONSPAT (CONSPAT NILPAT r) v) (word1 L)) p)
