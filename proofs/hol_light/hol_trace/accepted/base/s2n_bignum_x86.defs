  |- word_join_list_16_8
     = (\_1:(byte list).
         (word_join (EL 0 _1)
           (word_join (EL 1 _1)
             (word_join (EL 2 _1)
               (word_join (EL 3 _1)
                 (word_join (EL 4 _1)
                   (word_join (EL 5 _1)
                     (word_join (EL 6 _1)
                       (word_join (EL 7 _1)
                         (word_join (EL 8 _1)
                           (word_join (EL 9 _1)
                             (word_join (EL 10 _1)
                               (word_join (EL 11 _1)
                                 (word_join (EL 12 _1)
                                   (word_join (EL 13 _1) (word_join (EL 14 _1) (EL 15 _1) : int16)
                                     : 24 word)
                                   : int32)
                                 : 40 word)
                               : 48 word)
                             : 56 word)
                           : int64)
                         : 72 word)
                       : 80 word)
                     : 88 word)
                   : 96 word)
                 : 104 word)
               : 112 word)
             : 120 word)
           : int128))

