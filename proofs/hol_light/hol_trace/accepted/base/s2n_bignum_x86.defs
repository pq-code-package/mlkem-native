           ,, := YMM3 (word_zx (word_subword (read YMM3 _1) (0, 128) : int128) : 256 word)
           ,, := YMM4 (word_zx (word_subword (read YMM4 _1) (0, 128) : int128) : 256 word)
           ,, := YMM5 (word_zx (word_subword (read YMM5 _1) (0, 128) : int128) : 256 word)
           ,, := YMM6 (word_zx (word_subword (read YMM6 _1) (0, 128) : int128) : 256 word)
           ,, := YMM7 (word_zx (word_subword (read YMM7 _1) (0, 128) : int128) : 256 word)
           ,, := YMM8 (word_zx (word_subword (read YMM8 _1) (0, 128) : int128) : 256 word)
           ,, := YMM9 (word_zx (word_subword (read YMM9 _1) (0, 128) : int128) : 256 word)
           ,, := YMM10 (word_zx (word_subword (read YMM10 _1) (0, 128) : int128) : 256 word)
           ,, := YMM11 (word_zx (word_subword (read YMM11 _1) (0, 128) : int128) : 256 word)
           ,, := YMM12 (word_zx (word_subword (read YMM12 _1) (0, 128) : int128) : 256 word)
           ,, := YMM13 (word_zx (word_subword (read YMM13 _1) (0, 128) : int128) : 256 word)
           ,, := YMM14 (word_zx (word_subword (read YMM14 _1) (0, 128) : int128) : 256 word)
           ,, := YMM15 (word_zx (word_subword (read YMM15 _1) (0, 128) : int128) : 256 word))
