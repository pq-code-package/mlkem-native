     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, '?1 word) component) _4:x86state.
         let x:('N word) = read _2 _4 in
         let count:num = 8 * val (read _3 _4) in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) = usimd2 (\z:int128. word_ushr z count) (word_zx x : 256 word) in
           := _1 (word_zx res : 'N word) _4)
           (let x128:int128 = (word_zx x : int128) in
           let res:int128 = word_ushr x128 count in := _1 (word_zx res : 'N word) _4))

definition x86_VPSRAW
  |- (x86_VPSRAW : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, '?1 word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, '?1 word) component) _4:x86state.
         let x:('N word) = read _2 _4 in
         let count:num = val (read _3 _4) in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) = usimd16 (\z:int16. word_ishr z count) (word_zx x : 256 word) in
           := _1 (word_zx res : 'N word) _4)
           (let res:int128 = usimd8 (\z:int16. word_ishr z count) (word_zx x : int128) in
           := _1 (word_zx res : 'N word) _4))

definition x86_VPSRLW
  |- (x86_VPSRLW : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, '?1 word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, '?1 word) component) _4:x86state.
         let x:('N word) = read _2 _4 in
         let count:num = val (read _3 _4) in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) = usimd16 (\z:int16. word_ushr z count) (word_zx x : 256 word) in
           := _1 (word_zx res : 'N word) _4)
           (let res:int128 = usimd8 (\z:int16. word_ushr z count) (word_zx x : int128) in
           := _1 (word_zx res : 'N word) _4))

definition x86_VPTEST
  |- (x86_VPTEST : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _1 _3
         and y:('N word) = read _2 _3 in
         (,,) (:= ZF (val (word_and x y) = 0))
           (:= CF (val (word_and y (word_not x)) = 0) ,, := AF F ,, := OF F ,, := PF F ,, := SF F)
           _3)

definition x86_VPUNPCKHQDQ
  |- (x86_VPUNPCKHQDQ : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:x86state.
         let x:('N word) = read _2 _4
         and y:('N word) = read _3 _4 in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let x_low_high:int64 = (word_subword (word_zx x : 256 word) (64, 64) : int64)
           and x_high_high:int64 = (word_subword (word_zx x : 256 word) (192, 64) : int64)
           and y_low_high:int64 = (word_subword (word_zx y : 256 word) (64, 64) : int64)
           and y_high_high:int64 = (word_subword (word_zx y : 256 word) (192, 64) : int64) in
           let res:(256 word) =
               (word_join (word_join y_high_high x_high_high : int128)
                 (word_join y_low_high x_low_high : int128)
                 : 256 word) in
           := _1 (word_zx res : 'N word) _4)
           (let x_high:int64 = (word_subword (word_zx x : int128) (64, 64) : int64)
           and y_high:int64 = (word_subword (word_zx y : int128) (64, 64) : int64) in
           let res:int128 = (word_join y_high x_high : int128) in := _1 (word_zx res : 'N word) _4))

definition x86_VPUNPCKLQDQ
  |- (x86_VPUNPCKLQDQ : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:x86state.
         let x:('N word) = read _2 _4
         and y:('N word) = read _3 _4 in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let x_low:int64 = (word_subword (word_zx x : 256 word) (0, 64) : int64)
           and x_high:int64 = (word_subword (word_zx x : 256 word) (128, 64) : int64)
           and y_low:int64 = (word_subword (word_zx y : 256 word) (0, 64) : int64)
           and y_high:int64 = (word_subword (word_zx y : 256 word) (128, 64) : int64) in
           let res:(256 word) =
               (word_join (word_join y_high x_high : int128) (word_join y_low x_low : int128)
                 : 256 word) in
           := _1 (word_zx res : 'N word) _4)
           (let x_low:int64 = (word_subword (word_zx x : int128) (0, 64) : int64)
           and y_low:int64 = (word_subword (word_zx y : int128) (0, 64) : int64) in
           let res:int128 = (word_join y_low x_low : int128) in := _1 (word_zx res : 'N word) _4))

definition x86_TEST
  |- (x86_TEST : (x86state, '?1 word) component -> (x86state, '?1 word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, '?1 word) component) _2:((x86state, '?1 word) component) _3:x86state.
         let x:('?1 word) = read _1 _3
         and y:('?1 word) = read _2 _3 in
         let z:('?1 word) = word_and x y in
         (,,) (:= ZF (val z = 0))
           (:= SF (ival z < &0)
           ,, := PF (word_evenparity (word_zx z : byte))
           ,, := CF F
           ,, := OF F
           ,, UNDEFINED_VALUES [AF])
           _3)

definition x86_TZCNT
  |- (x86_TZCNT : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _2 _3 in
         let z:('N word) = (word (word_ctz x) : 'N word) in
         (,,) (:= _1 z)
           (:= CF (val x = 0) ,, := ZF (val z = 0) ,, UNDEFINED_VALUES [OF; SF; PF; AF])
           _3)

definition x86_VPAND
  |- (x86_VPAND : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:x86state.
         let x:('N word) = read _2 _4
         and y:('N word) = read _3 _4 in
         let z:('N word) = word_and x y in := _1 z _4)

definition x86_VPANDN
  |- (x86_VPANDN : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:x86state.
         let x:('N word) = read _2 _4
         and y:('N word) = read _3 _4 in
         let z:('N word) = word_and (word_not x) y in := _1 z _4)

definition x86_VPOR
  |- (x86_VPOR : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:x86state.
         let x:('N word) = read _2 _4
         and y:('N word) = read _3 _4 in
         let z:('N word) = word_or x y in := _1 z _4)

definition x86_VPXOR
  |- (x86_VPXOR : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:x86state.
         let x:('N word) = read _2 _4
         and y:('N word) = read _3 _4 in
         let z:('N word) = word_xor x y in := _1 z _4)

definition x86_XCHG
  |- (x86_XCHG : ('?1, '?2) component -> ('?1, '?2) component -> '?1 -> '?1 -> bool)
     = (\_1:(('?1, '?2) component) _2:(('?1, '?2) component) _3:'?1.
         let temp:'?2 = read _1 _3 in (,,) (:= _1 (read _2 _3)) (:= _2 temp) _3)

definition x86_XOR
  |- (x86_XOR : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _1 _3
         and y:('N word) = read _2 _3 in
         let z:('N word) = word_xor x y in
         (,,) (:= _1 z)
           (:= ZF (val z = 0)
           ,, := SF (ival z < &0)
           ,, := PF (word_evenparity (word_zx z : byte))
           ,, := CF F
           ,, := OF F
           ,, UNDEFINED_VALUES [AF])
           _3)

definition GPR8
  |- GPR8
     = (specification "GPR8" GPR8:(gpr -> (x86state, byte) component).
         (!reg:(4 word).
           GPR8 (Gpr reg Upper_8)
           = registers
             :> (element reg : (4 word -> int64, int64) component)
                :> bottom_32 :> bottom_16 :> top_8)
         /\ (!reg:(4 word).
              GPR8 (Gpr reg Lower_8)
              = registers
                :> (element reg : (4 word -> int64, int64) component)
                   :> bottom_32 :> bottom_16 :> bottom_8))

definition GPR16
  |- GPR16
     = (specification "GPR16" GPR16:(gpr -> (x86state, int16) component).
         !reg:(4 word).
           GPR16 (Gpr reg Lower_16)
           = registers
             :> (element reg : (4 word -> int64, int64) component) :> bottom_32 :> bottom_16)

definition GPR32
  |- GPR32
     = (specification "GPR32" GPR32:(gpr -> (x86state, int32) component).
         !reg:(4 word).
           GPR32 (Gpr reg Lower_32)
           = registers :> (element reg : (4 word -> int64, int64) component) :> bottom_32)

definition GPR32_Z
  |- GPR32_Z
     = (specification "GPR32_Z" GPR32_Z:(gpr -> (x86state, int32) component).
         !reg:(4 word).
           GPR32_Z (Gpr reg Lower_32)
           = registers :> (element reg : (4 word -> int64, int64) component) :> zerotop_32)

definition GPR64
  |- GPR64
     = (specification "GPR64" GPR64:(gpr -> (x86state, int64) component).
         !reg:(4 word).
           GPR64 (Gpr reg Full_64)
           = registers :> (element reg : (4 word -> int64, int64) component))

definition GPR
  |- GPR
     = (specification "GPR" GPR:(gpr -> (x86state, num) component).
         (!reg:(4 word).
           GPR (Gpr reg Full_64)
           = registers
             :> (element reg : (4 word -> int64, int64) component)
                :> (asnumber : (int64, num) component))
         /\ (!reg:(4 word).
              GPR (Gpr reg Lower_32)
              = registers
                :> (element reg : (4 word -> int64, int64) component)
                   :> bottom_32 :> (asnumber : (int32, num) component))
         /\ (!reg:(4 word).
              GPR (Gpr reg Lower_16)
              = registers
                :> (element reg : (4 word -> int64, int64) component)
                   :> bottom_32 :> bottom_16 :> (asnumber : (int16, num) component))
         /\ (!reg:(4 word).
              GPR (Gpr reg Upper_8)
              = registers
                :> (element reg : (4 word -> int64, int64) component)
                   :> bottom_32 :> bottom_16 :> top_8 :> (asnumber : (byte, num) component))
         /\ (!reg:(4 word).
              GPR (Gpr reg Lower_8)
              = registers
                :> (element reg : (4 word -> int64, int64) component)
                   :> bottom_32 :> bottom_16 :> bottom_8 :> (asnumber : (byte, num) component)))

definition SIMD256
  |- SIMD256
     = (specification "SIMD256" SIMD256:(simdreg -> (x86state, 256 word) component).
         !reg:(5 word).
           SIMD256 (Simdreg reg Lower_256)
           = simdregisters
             :> (element reg : (5 word -> 512 word, 512 word) component) :> zerotop_256)

definition SIMD128
  |- SIMD128
     = (specification "SIMD128" SIMD128:(simdreg -> (x86state, int128) component).
         !reg:(5 word).
           SIMD128 (Simdreg reg Lower_128)
           = simdregisters
             :> (element reg : (5 word -> 512 word, 512 word) component)
                :> zerotop_256 :> zerotop_128)

definition SIMD128_SSE
  |- SIMD128_SSE
     = (specification "SIMD128_SSE" SIMD128_SSE:(simdreg -> (x86state, int128) component).
         !reg:(5 word).
           SIMD128_SSE (Simdreg reg Lower_128)
           = simdregisters
             :> (element reg : (5 word -> 512 word, 512 word) component)
                :> bottom_256 :> bottom_128)

definition bsid_semantics
  |- bsid_semantics
     = (specification "bsid_semantics" bsid_semantics:(bsid -> x86state -> int64).
         (!obase:(gpr option) oind:(gpr option) scl:(2 word) disp:int64 s:x86state.
           bsid_semantics (Bsid obase oind scl disp) s
           = (let bv:num =
                 _MATCH obase (_SEQPATTERN
                   (\"GEN%PVAR%1":(gpr option) "GEN%PVAR%2":num.
                     ?base:gpr.
                       _UNGUARDED_PATTERN (GEQ (SOME base) "GEN%PVAR%1")
                         (GEQ (read (GPR base) s) "GEN%PVAR%2"))
                   (\"GEN%PVAR%3":(gpr option) "GEN%PVAR%4":num.
                     _UNGUARDED_PATTERN (GEQ (NONE : gpr option) "GEN%PVAR%3")
                       (GEQ 0 "GEN%PVAR%4")))
             and iv:num =
                 _MATCH oind (_SEQPATTERN
                   (\"GEN%PVAR%5":(gpr option) "GEN%PVAR%6":num.
                     ?ind:gpr.
                       _UNGUARDED_PATTERN (GEQ (SOME ind) "GEN%PVAR%5")
                         (GEQ (read (GPR ind) s) "GEN%PVAR%6"))
                   (\"GEN%PVAR%7":(gpr option) "GEN%PVAR%8":num.
                     _UNGUARDED_PATTERN (GEQ (NONE : gpr option) "GEN%PVAR%7")
                       (GEQ 0 "GEN%PVAR%8"))) in
             (word (bv + 2 EXP val scl * iv + val disp) : int64)))
         /\ (!off:int64 s:x86state.
              bsid_semantics (Riprel off) s = (word (val (read RIP s) + val off) : int64)))

definition OPERAND256
  |- OPERAND256
     = (specification "OPERAND256" OPERAND256:(operand -> x86state ->
           (x86state, 256 word) component).
         (!r:simdreg s:x86state.
           OPERAND256 (Simdregister r) s
           = COND (simdregister_size r = 256) (SIMD256 r) (ARB : (x86state, 256 word) component))
         /\ (!w:wordsize ea:bsid s:x86state.
              OPERAND256 (Memop w ea) s
              = COND (w = Word256) (memory :> bytes256 (bsid_semantics ea s))
                  (ARB : (x86state, 256 word) component)))

definition OPERAND128
  |- OPERAND128
     = (specification "OPERAND128" OPERAND128:(operand -> x86state -> (x86state, int128) component).
         (!r:simdreg s:x86state.
           OPERAND128 (Simdregister r) s
           = COND (simdregister_size r = 128) (SIMD128 r) (ARB : (x86state, int128) component))
         /\ (!w:wordsize ea:bsid s:x86state.
              OPERAND128 (Memop w ea) s
              = COND (w = Word128) (memory :> bytes128 (bsid_semantics ea s))
                  (ARB : (x86state, int128) component)))

definition OPERAND128_SSE
  |- OPERAND128_SSE
     = (specification "OPERAND128_SSE" OPERAND128_SSE:(operand -> x86state ->
           (x86state, int128) component).
         (!r:simdreg s:x86state.
           OPERAND128_SSE (Simdregister r) s
           = COND (simdregister_size r = 128) (SIMD128_SSE r) (ARB : (x86state, int128) component))
         /\ (!w:wordsize ea:bsid s:x86state.
              OPERAND128_SSE (Memop w ea) s
              = COND (w = Word128) (memory :> bytes128 (bsid_semantics ea s))
                  (ARB : (x86state, int128) component)))

definition OPERAND64
  |- OPERAND64
     = (specification "OPERAND64" OPERAND64:(operand -> x86state -> (x86state, int64) component).
         (!r:gpr s:x86state.
           OPERAND64 (Register r) s
           = COND (register_size r = 64) (GPR64 r) (ARB : (x86state, int64) component))
         /\ (!imm8:byte s:x86state.
              OPERAND64 (Imm8 imm8) s
              = (rvalue (word_sx imm8 : int64) : (x86state, int64) component))
         /\ (!imm16:int16 s:x86state.
              OPERAND64 (Imm16 imm16) s
              = (rvalue (word_sx imm16 : int64) : (x86state, int64) component))
         /\ (!imm32:int32 s:x86state.
              OPERAND64 (Imm32 imm32) s
              = (rvalue (word_sx imm32 : int64) : (x86state, int64) component))
         /\ (!imm64:int64 s:x86state.
              OPERAND64 (Imm64 imm64) s = (rvalue imm64 : (x86state, int64) component))
         /\ (!w:wordsize ea:bsid s:x86state.
              OPERAND64 (Memop w ea) s
              = COND (w = Quadword) (memory :> bytes64 (bsid_semantics ea s))
                  (ARB : (x86state, int64) component)))

definition OPERAND32
  |- OPERAND32
     = (specification "OPERAND32" OPERAND32:(operand -> x86state -> (x86state, int32) component).
         (!r:gpr s:x86state.
           OPERAND32 (Register r) s
           = COND (register_size r = 32) (GPR32_Z r) (ARB : (x86state, int32) component))
         /\ (!imm8:byte s:x86state.
              OPERAND32 (Imm8 imm8) s
              = (rvalue (word_sx imm8 : int32) : (x86state, int32) component))
         /\ (!imm16:int16 s:x86state.
              OPERAND32 (Imm16 imm16) s
              = (rvalue (word_sx imm16 : int32) : (x86state, int32) component))
         /\ (!imm32:int32 s:x86state.
              OPERAND32 (Imm32 imm32) s = (rvalue imm32 : (x86state, int32) component))
         /\ (!w:wordsize ea:bsid s:x86state.
              OPERAND32 (Memop w ea) s
              = COND (w = Doubleword) (memory :> bytes32 (bsid_semantics ea s))
                  (ARB : (x86state, int32) component)))

definition OPERAND16
  |- OPERAND16
     = (specification "OPERAND16" OPERAND16:(operand -> x86state -> (x86state, int16) component).
         (!r:gpr s:x86state.
           OPERAND16 (Register r) s
           = COND (register_size r = 16) (GPR16 r) (ARB : (x86state, int16) component))
         /\ (!imm8:byte s:x86state.
              OPERAND16 (Imm8 imm8) s
              = (rvalue (word_sx imm8 : int16) : (x86state, int16) component))
         /\ (!imm16:int16 s:x86state.
              OPERAND16 (Imm16 imm16) s = (rvalue imm16 : (x86state, int16) component))
         /\ (!w:wordsize ea:bsid s:x86state.
              OPERAND16 (Memop w ea) s
              = COND (w = Word) (memory :> bytes16 (bsid_semantics ea s))
                  (ARB : (x86state, int16) component)))

definition OPERAND8
  |- OPERAND8
     = (specification "OPERAND8" OPERAND8:(operand -> x86state -> (x86state, byte) component).
         (!r:gpr s:x86state.
           OPERAND8 (Register r) s
           = COND (register_size r = 8) (GPR8 r) (ARB : (x86state, byte) component))
         /\ (!imm8:byte s:x86state.
              OPERAND8 (Imm8 imm8) s = (rvalue imm8 : (x86state, byte) component))
         /\ (!w:wordsize ea:bsid s:x86state.
              OPERAND8 (Memop w ea) s
              = COND (w = Byte) (memory :> bytes8 (bsid_semantics ea s))
                  (ARB : (x86state, byte) component)))

definition aligned_OPERAND128
  |- aligned_OPERAND128
     = (specification "aligned_OPERAND128" aligned_OPERAND128:(operand -> x86state -> bool).
         (!r:simdreg s:x86state. aligned_OPERAND128 (Simdregister r) s = T)
         /\ (!w:wordsize ea:bsid s:x86state.
              aligned_OPERAND128 (Memop w ea) s = aligned 16 (bsid_semantics ea s)))

definition aligned_OPERAND256
  |- aligned_OPERAND256
     = (specification "aligned_OPERAND256" aligned_OPERAND256:(operand -> x86state -> bool).
         (!r:simdreg s:x86state. aligned_OPERAND256 (Simdregister r) s = T)
         /\ (!w:wordsize ea:bsid s:x86state.
              aligned_OPERAND256 (Memop w ea) s = aligned 32 (bsid_semantics ea s)))

definition x86_decode
  |- x86_decode
     = (\_1:x86state _2:int64 _3:(num # instruction).
         ?l:(byte list).
           bytes_loaded _1 _2 l /\ LENGTH l = FST _3 /\ decode l = SOME (SND _3, (NIL : byte list)))

definition add_store_event
  |- add_store_event
     = (specification "add_store_event" add_store_event:(operand -> x86state -> x86state ->
           x86state -> bool).
         add_store_event
         = (\op:operand s:x86state s0:x86state.
             _MATCH op (_SEQPATTERN
               (\"GEN%PVAR%1":operand "GEN%PVAR%2":(x86state -> bool).
                 ?w:wordsize bs:bsid.
                   _UNGUARDED_PATTERN (GEQ (Memop w bs) "GEN%PVAR%1")
                     (GEQ
                       (:= events
                         (CONS (EventStore (bsid_semantics bs s, bytesize w DIV 8))
                           (read events s0))
                         s0)
                       "GEN%PVAR%2"))
               (\"GEN%PVAR%3":operand "GEN%PVAR%4":(x86state -> bool).
                 ?_:operand. _UNGUARDED_PATTERN (GEQ _ "GEN%PVAR%3") (GEQ ((=) s0) "GEN%PVAR%4")))))

definition add_load_event
  |- add_load_event
     = (specification "add_load_event" add_load_event:(operand -> x86state -> x86state ->
           x86state -> bool).
         add_load_event
         = (\op:operand s:x86state s0:x86state.
             _MATCH op (_SEQPATTERN
               (\"GEN%PVAR%1":operand "GEN%PVAR%2":(x86state -> bool).
                 ?w:wordsize bs:bsid.
                   _UNGUARDED_PATTERN (GEQ (Memop w bs) "GEN%PVAR%1")
                     (GEQ
                       (:= events
                         (CONS (EventLoad (bsid_semantics bs s, bytesize w DIV 8)) (read events s0))
                         s0)
                       "GEN%PVAR%2"))
               (\"GEN%PVAR%3":operand "GEN%PVAR%4":(x86state -> bool).
                 ?_:operand. _UNGUARDED_PATTERN (GEQ _ "GEN%PVAR%3") (GEQ ((=) s0) "GEN%PVAR%4")))))

definition x86_execute
  sha256 318294ed955e0166218241e9cbb3dcb90f3a50a341357ad57016bb3f87cc83d8 (2201118 characters, not shown)

definition x86
  |- x86
     = (specification "x86" x86:(x86state -> x86state -> bool).
         !s:x86state s':x86state.
           x86 s s'
           = (?len:num instr:instruction.
               x86_decode s (read RIP s) (len, instr)
               /\ (,,) (:= RIP (word_add (read RIP s) (word len : int64))) (x86_execute instr) s
                    s'))

definition SOME_FLAGS
  |- SOME_FLAGS = [CF; PF; AF; ZF; SF; OF]

definition C_ARGUMENTS
  |- C_ARGUMENTS
     = (specification "C_ARGUMENTS" C_ARGUMENTS:(int64 list -> x86state -> bool).
         (!a1:int64 a2:int64 a3:int64 a4:int64 a5:int64 a6:int64 s:x86state.
           C_ARGUMENTS [a1; a2; a3; a4; a5; a6] s
           = (read RDI s = a1
             /\ read RSI s = a2
             /\ read RDX s = a3
             /\ read RCX s = a4
             /\ read R8 s = a5
             /\ read R9 s = a6))
         /\ (!a1:int64 a2:int64 a3:int64 a4:int64 a5:int64 s:x86state.
              C_ARGUMENTS [a1; a2; a3; a4; a5] s
              = (read RDI s = a1
                /\ read RSI s = a2
                /\ read RDX s = a3
                /\ read RCX s = a4
                /\ read R8 s = a5))
         /\ (!a1:int64 a2:int64 a3:int64 a4:int64 s:x86state.
              C_ARGUMENTS [a1; a2; a3; a4] s
              = (read RDI s = a1 /\ read RSI s = a2 /\ read RDX s = a3 /\ read RCX s = a4))
         /\ (!a1:int64 a2:int64 a3:int64 s:x86state.
              C_ARGUMENTS [a1; a2; a3] s = (read RDI s = a1 /\ read RSI s = a2 /\ read RDX s = a3))
         /\ (!a1:int64 a2:int64 s:x86state.
              C_ARGUMENTS [a1; a2] s = (read RDI s = a1 /\ read RSI s = a2))
         /\ (!a1:int64 s:x86state. C_ARGUMENTS [a1] s = (read RDI s = a1))
         /\ (!s:x86state. C_ARGUMENTS (NIL : int64 list) s = T))

definition C_RETURN
  |- C_RETURN = (specification "C_RETURN" C_RETURN:(x86state -> int64). C_RETURN = read RAX)

