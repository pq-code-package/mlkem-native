definition _<Rep0>
  |- _<Rep0> = _mk_rep_pfx (CONSTR 0 (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition _<RepZ>
  |- _<RepZ> = _mk_rep_pfx (CONSTR (SUC 0) (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition _<RepNZ>
  |- _<RepNZ> = _mk_rep_pfx (CONSTR (SUC (SUC 0)) (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition Rep0
  |- Rep0 = _<Rep0>

definition RepZ
  |- RepZ = _<RepZ>

definition RepNZ
  |- RepNZ = _<RepNZ>

definition _<SG0>
  |- _<SG0> = _mk_seg_pfx (CONSTR 0 (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition _<CS>
  |- _<CS> = _mk_seg_pfx (CONSTR (SUC 0) (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition _<SS>
  |- _<SS> = _mk_seg_pfx (CONSTR (SUC (SUC 0)) (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition _<DS>
  |- _<DS>
     = _mk_seg_pfx (CONSTR (SUC (SUC (SUC 0))) (@x:bool. T) (\n:num. (BOTTOM : bool recspace)))

definition _<ES>
  |- _<ES>
     = _mk_seg_pfx (CONSTR (SUC (SUC (SUC (SUC 0)))) (@x:bool. T)
         (\n:num. (BOTTOM : bool recspace)))

definition SG0
  |- SG0 = _<SG0>

definition CS
  |- CS = _<CS>

definition SS
  |- SS = _<SS>

definition DS
  |- DS = _<DS>

definition ES
  |- ES = _<ES>

definition has_pfxs
  |- has_pfxs = (\_1:(bool # rep_pfx # seg_pfx). ~ (_1 = F, Rep0, SG0))

definition has_unhandled_pfxs
  |- has_unhandled_pfxs
     = (\_1:(bool # rep_pfx # seg_pfx). ~ (FST (SND _1) = Rep0) \/ ~ (SND (SND _1) = SG0))

definition has_operand_override
  |- has_operand_override = (\_1:(bool # rep_pfx # seg_pfx). FST _1)

definition pfxs_set_opo
  |- (pfxs_set_opo : '?1 # '?2 # '?3 -> (bool # '?2 # '?3) option)
     = (\_1:('?1 # '?2 # '?3). SOME (T, FST (SND _1), SND (SND _1)))

definition pfxs_set_repz
  |- (pfxs_set_repz : '?1 # rep_pfx # '?2 -> ('?1 # rep_pfx # '?2) option)
     = (\_1:('?1 # rep_pfx # '?2).
         COND (FST (SND _1) = Rep0) (SOME (FST _1, RepZ, SND (SND _1)))
           (NONE : ('?1 # rep_pfx # '?2) option))

definition pfxs_set_repnz
  |- (pfxs_set_repnz : '?1 # rep_pfx # '?2 -> ('?1 # rep_pfx # '?2) option)
     = (\_1:('?1 # rep_pfx # '?2).
         COND (FST (SND _1) = Rep0) (SOME (FST _1, RepNZ, SND (SND _1)))
           (NONE : ('?1 # rep_pfx # '?2) option))

definition pfxs_set_cs
  |- (pfxs_set_cs : '?1 # '?2 # seg_pfx -> ('?1 # '?2 # seg_pfx) option)
     = (\_1:('?1 # '?2 # seg_pfx).
         COND (SND (SND _1) = SG0) (SOME (FST _1, FST (SND _1), CS))
           (NONE : ('?1 # '?2 # seg_pfx) option))

definition pfxs_set_ds
  |- (pfxs_set_ds : '?1 # '?2 # seg_pfx -> ('?1 # '?2 # seg_pfx) option)
     = (\_1:('?1 # '?2 # seg_pfx).
         COND (SND (SND _1) = SG0) (SOME (FST _1, FST (SND _1), DS))
           (NONE : ('?1 # '?2 # seg_pfx) option))

definition pfxs_set_es
  |- (pfxs_set_es : '?1 # '?2 # seg_pfx -> ('?1 # '?2 # seg_pfx) option)
     = (\_1:('?1 # '?2 # seg_pfx).
         COND (SND (SND _1) = SG0) (SOME (FST _1, FST (SND _1), ES))
           (NONE : ('?1 # '?2 # seg_pfx) option))

definition pfxs_set_ss
  |- (pfxs_set_ss : '?1 # '?2 # seg_pfx -> ('?1 # '?2 # seg_pfx) option)
     = (\_1:('?1 # '?2 # seg_pfx).
         COND (SND (SND _1) = SG0) (SOME (FST _1, FST (SND _1), SS))
           (NONE : ('?1 # '?2 # seg_pfx) option))

definition read_prefixes
  |- read_prefixes
     = (specification "read_prefixes" read_prefixes:(byte list -> bool # rep_pfx # seg_pfx ->
           ((bool # rep_pfx # seg_pfx) # byte list) option).
         (!p:(bool # rep_pfx # seg_pfx).
           read_prefixes (NIL : byte list) p
           = (NONE : ((bool # rep_pfx # seg_pfx) # byte list) option))
         /\ (!b:byte l:(byte list) p:(bool # rep_pfx # seg_pfx).
              read_prefixes (CONS b l) p
              = _BITMATCH b (_SEQPATTERN
                  (\"BM%PVAR%10":num "BM%PVAR%11":(((bool # rep_pfx # seg_pfx) # byte list) option).
                    _UNGUARDED_PATTERN (pat_set (CONSPAT NILPAT (word 102 : byte)) "BM%PVAR%10")
                      (>>= (pfxs_set_opo p) (read_prefixes l) = "BM%PVAR%11"))
                  (_SEQPATTERN
                    (\"BM%PVAR%10":num
                      "BM%PVAR%11":(((bool # rep_pfx # seg_pfx) # byte list) option).
                      _UNGUARDED_PATTERN (pat_set (CONSPAT NILPAT (word 242 : byte)) "BM%PVAR%10")
                        (>>= (pfxs_set_repnz p) (read_prefixes l) = "BM%PVAR%11"))
                    (_SEQPATTERN
                      (\"BM%PVAR%10":num
                        "BM%PVAR%11":(((bool # rep_pfx # seg_pfx) # byte list) option).
                        _UNGUARDED_PATTERN (pat_set (CONSPAT NILPAT (word 243 : byte)) "BM%PVAR%10")
                          (>>= (pfxs_set_repz p) (read_prefixes l) = "BM%PVAR%11"))
                      (_SEQPATTERN
                        (\"BM%PVAR%10":num
                          "BM%PVAR%11":(((bool # rep_pfx # seg_pfx) # byte list) option).
                          _UNGUARDED_PATTERN
                            (pat_set (CONSPAT NILPAT (word 46 : byte)) "BM%PVAR%10")
                            (>>= (pfxs_set_cs p) (read_prefixes l) = "BM%PVAR%11"))
                        (_SEQPATTERN
                          (\"BM%PVAR%10":num
                            "BM%PVAR%11":(((bool # rep_pfx # seg_pfx) # byte list) option).
                            _UNGUARDED_PATTERN
                              (pat_set (CONSPAT NILPAT (word 54 : byte)) "BM%PVAR%10")
                              (>>= (pfxs_set_ss p) (read_prefixes l) = "BM%PVAR%11"))
                          (_SEQPATTERN
                            (\"BM%PVAR%10":num
                              "BM%PVAR%11":(((bool # rep_pfx # seg_pfx) # byte list) option).
                              _UNGUARDED_PATTERN
                                (pat_set (CONSPAT NILPAT (word 62 : byte)) "BM%PVAR%10")
                                (>>= (pfxs_set_ds p) (read_prefixes l) = "BM%PVAR%11"))
                            (_SEQPATTERN
                              (\"BM%PVAR%10":num
                                "BM%PVAR%11":(((bool # rep_pfx # seg_pfx) # byte list) option).
                                _UNGUARDED_PATTERN
                                  (pat_set (CONSPAT NILPAT (word 38 : byte)) "BM%PVAR%10")
                                  (>>= (pfxs_set_es p) (read_prefixes l) = "BM%PVAR%11"))
                              (_SEQPATTERN
                                (\"BM%PVAR%10":num
                                  "BM%PVAR%11":(((bool # rep_pfx # seg_pfx) # byte list) option).
                                  _UNGUARDED_PATTERN
                                    (pat_set (CONSPAT NILPAT (word 240 : byte)) "BM%PVAR%10")
                                    ((NONE : ((bool # rep_pfx # seg_pfx) # byte list) option)
                                    = "BM%PVAR%11"))
                                (_SEQPATTERN
                                  (\"BM%PVAR%10":num
                                    "BM%PVAR%11":(((bool # rep_pfx # seg_pfx) # byte list) option).
                                    _UNGUARDED_PATTERN
                                      (pat_set (CONSPAT NILPAT (word 100 : byte)) "BM%PVAR%10")
                                      ((NONE : ((bool # rep_pfx # seg_pfx) # byte list) option)
                                      = "BM%PVAR%11"))
                                  (_SEQPATTERN
                                    (\"BM%PVAR%10":num
                                      "BM%PVAR%11":(((bool # rep_pfx # seg_pfx) # byte list)
                                        option).
                                      _UNGUARDED_PATTERN
                                        (pat_set (CONSPAT NILPAT (word 101 : byte)) "BM%PVAR%10")
                                        ((NONE : ((bool # rep_pfx # seg_pfx) # byte list) option)
                                        = "BM%PVAR%11"))
                                    (_SEQPATTERN
                                      (\"BM%PVAR%10":num
                                        "BM%PVAR%11":(((bool # rep_pfx # seg_pfx) # byte list)
                                          option).
                                        _UNGUARDED_PATTERN
                                          (pat_set (CONSPAT NILPAT (word 103 : byte)) "BM%PVAR%10")
                                          ((NONE : ((bool # rep_pfx # seg_pfx) # byte list) option)
                                          = "BM%PVAR%11"))
                                      (_ELSEPATTERN (SOME (p, CONS b l))
                                        : num -> ((bool # rep_pfx # seg_pfx) # byte list) option ->
                                            bool))))))))))))))

definition read_REX_prefix
  |- read_REX_prefix
     = (specification "read_REX_prefix" read_REX_prefix:(byte list -> (4 word) option # byte list).
         read_REX_prefix (NIL : byte list) = (NONE : (4 word) option), (NIL : byte list)
         /\ (!b:byte l:(byte list).
              read_REX_prefix (CONS b l)
              = _BITMATCH b (_SEQPATTERN
                  (\"BM%PVAR%12":num "BM%PVAR%13":((4 word) option # byte list).
                    ?rex:(4 word).
                      _UNGUARDED_PATTERN
                        (pat_set (CONSPAT (CONSPAT NILPAT (word 4 : 4 word)) rex) "BM%PVAR%12")
                        (SOME rex, l = "BM%PVAR%13"))
                  (_ELSEPATTERN ((NONE : (4 word) option), CONS b l)
                    : num -> (4 word) option # byte list -> bool))))

definition rex_num
  |- rex_num
     = (specification "rex_num" rex_num:((4 word) option -> 4 word).
         rex_num (NONE : (4 word) option) = (word 0 : 4 word)
         /\ (!n:(4 word). rex_num (SOME n) = n))

definition rex_B
  |- rex_B = (\_1:((4 word) option). bit 0 (rex_num _1))

definition rex_X
  |- rex_X = (\_1:((4 word) option). bit 1 (rex_num _1))

definition rex_R
  |- rex_R = (\_1:((4 word) option). bit 2 (rex_num _1))

definition rex_W
  |- rex_W = (\_1:((4 word) option). bit 3 (rex_num _1))

definition regsize8
  |- regsize8
     = (specification "regsize8" regsize8:(bool -> regsize).
         regsize8 F = Upper_8 /\ regsize8 T = Lower_8)

definition op_size
  |- op_size
     = (\_1:bool _2:bool _3:bool _4:(bool # rep_pfx # seg_pfx).
         COND (~ _3) (regsize8 _1) (COND _2 Full_64
           (COND (has_operand_override _4) Lower_16 Lower_32)))

definition adx
  |- adx
     = (specification "adx" adx:(wordsize -> operand # operand).
         adx Byte = Register ah, Register al
         /\ adx Word = Register dx, Register ax
         /\ adx Doubleword = Register edx, Register eax
         /\ adx Quadword = Register rdx, Register rax)

definition to_wordsize
  |- to_wordsize
     = (specification "to_wordsize" to_wordsize:(regsize -> wordsize).
         to_wordsize Lower_8 = Byte
         /\ to_wordsize Upper_8 = Byte
         /\ to_wordsize Lower_16 = Word
         /\ to_wordsize Lower_32 = Doubleword
         /\ to_wordsize Full_64 = Quadword)

definition simd_to_wordsize
  |- simd_to_wordsize
     = (specification "simd_to_wordsize" simd_to_wordsize:(simdregsize -> wordsize).
         simd_to_wordsize Lower_128 = Word128
         /\ simd_to_wordsize Lower_256 = Word256
         /\ simd_to_wordsize Full_512 = Word512)

definition op_size_W
  |- op_size_W = (\_1:((4 word) option). op_size (is_some _1) (rex_W _1))

definition rex_reg
  |- rex_reg = (\_1:bool _2:(3 word). (word_join (word1 _1) _2 : 4 word))

definition read_imm
  |- read_imm
     = (specification "read_imm" read_imm:(wordsize -> byte list -> (operand # byte list) option).
         (!l:(byte list).
           read_imm Byte l
           = >>= (read_byte l) (GABS (\f:(byte # byte list -> (operand # byte list) option).
               !b:byte l:(byte list). GEQ (f (b, l)) (SOME (Imm8 b, l)))))
         /\ (!l:(byte list).
              read_imm Word l
              = >>= (read_int16 l) (GABS (\f:(int16 # byte list -> (operand # byte list) option).
                  !b:int16 l:(byte list). GEQ (f (b, l)) (SOME (Imm16 b, l)))))
         /\ (!l:(byte list).
              read_imm Doubleword l
              = >>= (read_int32 l) (GABS (\f:(int32 # byte list -> (operand # byte list) option).
                  !b:int32 l:(byte list). GEQ (f (b, l)) (SOME (Imm32 b, l)))))
         /\ (!l:(byte list).
              read_imm Quadword l
              = >>= (read_int32 l) (GABS (\f:(int32 # byte list -> (operand # byte list) option).
                  !b:int32 l:(byte list). GEQ (f (b, l)) (SOME (Imm32 b, l)))))
         /\ (!l:(byte list).
              read_imm Word128 l
              = >>= (read_int32 l) (GABS (\f:(int32 # byte list -> (operand # byte list) option).
                  !b:int32 l:(byte list). GEQ (f (b, l)) (NONE : (operand # byte list) option))))
         /\ (!l:(byte list).
              read_imm Word256 l
              = >>= (read_int32 l) (GABS (\f:(int32 # byte list -> (operand # byte list) option).
                  !b:int32 l:(byte list). GEQ (f (b, l)) (NONE : (operand # byte list) option))))
         /\ (!l:(byte list).
              read_imm Word512 l
              = >>= (read_int32 l) (GABS (\f:(int32 # byte list -> (operand # byte list) option).
                  !b:int32 l:(byte list). GEQ (f (b, l)) (NONE : (operand # byte list) option)))))

definition read_full_imm
  |- read_full_imm
     = (specification "read_full_imm" read_full_imm:(wordsize -> byte list ->
           (operand # byte list) option).
         (!l:(byte list).
           read_full_imm Byte l
           = >>= (read_byte l) (GABS (\f:(byte # byte list -> (operand # byte list) option).
               !b:byte l:(byte list). GEQ (f (b, l)) (SOME (Imm8 b, l)))))
         /\ (!l:(byte list).
              read_full_imm Word l
              = >>= (read_int16 l) (GABS (\f:(int16 # byte list -> (operand # byte list) option).
                  !b:int16 l:(byte list). GEQ (f (b, l)) (SOME (Imm16 b, l)))))
         /\ (!l:(byte list).
              read_full_imm Doubleword l
              = >>= (read_int32 l) (GABS (\f:(int32 # byte list -> (operand # byte list) option).
                  !b:int32 l:(byte list). GEQ (f (b, l)) (SOME (Imm32 b, l)))))
         /\ (!l:(byte list).
              read_full_imm Quadword l
              = >>= (read_int64 l) (GABS (\f:(int64 # byte list -> (operand # byte list) option).
                  !b:int64 l:(byte list). GEQ (f (b, l)) (SOME (Imm64 b, l)))))
         /\ (!l:(byte list).
              read_full_imm Word128 l
              = >>= (read_int64 l) (GABS (\f:(int64 # byte list -> (operand # byte list) option).
                  !b:int64 l:(byte list). GEQ (f (b, l)) (NONE : (operand # byte list) option))))
         /\ (!l:(byte list).
              read_full_imm Word256 l
              = >>= (read_int64 l) (GABS (\f:(int64 # byte list -> (operand # byte list) option).
                  !b:int64 l:(byte list). GEQ (f (b, l)) (NONE : (operand # byte list) option))))
         /\ (!l:(byte list).
              read_full_imm Word512 l
              = >>= (read_int64 l) (GABS (\f:(int64 # byte list -> (operand # byte list) option).
                  !b:int64 l:(byte list). GEQ (f (b, l)) (NONE : (operand # byte list) option)))))

definition read_displacement
  |- read_displacement
     = (\_1:(2 word) _2:(byte list).
         _MATCH (val _1) (_SEQPATTERN
           (\"GEN%PVAR%1":num "GEN%PVAR%2":((int64 # byte list) option).
             _UNGUARDED_PATTERN (GEQ 0 "GEN%PVAR%1")
               (GEQ (SOME ((word 0 : int64), _2)) "GEN%PVAR%2"))
           (_SEQPATTERN
             (\"GEN%PVAR%3":num "GEN%PVAR%4":((int64 # byte list) option).
               _UNGUARDED_PATTERN (GEQ 1 "GEN%PVAR%3")
                 (GEQ
                   (>>= (read_byte _2) (GABS (\f:(byte # byte list -> (int64 # byte list) option).
                     !b:byte l:(byte list). GEQ (f (b, l)) (SOME ((word_sx b : int64), l)))))
                   "GEN%PVAR%4"))
             (_SEQPATTERN
               (\"GEN%PVAR%5":num "GEN%PVAR%6":((int64 # byte list) option).
                 _UNGUARDED_PATTERN (GEQ 2 "GEN%PVAR%5")
                   (GEQ
                     (>>= (read_int32 _2) (GABS (\f:(int32 # byte list ->
                                                      (int64 # byte list) option).
                       !w:int32 l:(byte list). GEQ (f (w, l)) (SOME ((word_sx w : int64), l)))))
                     "GEN%PVAR%6"))
               (\"GEN%PVAR%7":num "GEN%PVAR%8":((int64 # byte list) option).
                 ?_:num.
                   _UNGUARDED_PATTERN (GEQ _ "GEN%PVAR%7")
                     (GEQ (NONE : (int64 # byte list) option) "GEN%PVAR%8"))))))

definition _<RM_reg>
  |- _<RM_reg>
     = (\a:(4 word).
         _mk_RM ((\a:(4 word).
           CONSTR 0 (a, (@v:bsid. T)) (\n:num. (BOTTOM : (4 word # bsid) recspace))) a))

definition _<RM_mem>
  |- _<RM_mem>
     = (\a:bsid.
         _mk_RM ((\a:bsid.
           CONSTR (SUC 0) ((@v:(4 word). T), a) (\n:num. (BOTTOM : (4 word # bsid) recspace))) a))

definition RM_reg
  |- RM_reg = _<RM_reg>

definition RM_mem
  |- RM_mem = _<RM_mem>

definition read_sib_displacement
  |- read_sib_displacement
     = (\_1:(2 word) _2:(4 word) _3:(byte list).
         COND (_2 = (word 5 : 4 word) /\ _1 = (word 0 : 2 word))
           (>>= (read_int32 _3) (GABS (\f:(int32 # byte list ->
                                            ((int64 # gpr option) # byte list) option).
             !w:int32 l:(byte list).
               GEQ (f (w, l)) (SOME (((word_sx w : int64), (NONE : gpr option)), l)))))
           (>>= (read_displacement _1 _3) (GABS (\f:(int64 # byte list ->
                                                      ((int64 # gpr option) # byte list) option).
             !w:int64 l:(byte list). GEQ (f (w, l)) (SOME ((w, SOME (Gpr _2 Full_64)), l))))))

definition read_SIB
  |- read_SIB
     = (specification "read_SIB" read_SIB:((4 word) option -> 2 word -> byte list ->
           (bsid # byte list) option).
         (!rex:((4 word) option) md:(2 word).
           read_SIB rex md (NIL : byte list) = (NONE : (bsid # byte list) option))
         /\ (!rex:((4 word) option) md:(2 word) b:byte l:(byte list).
              read_SIB rex md (CONS b l)
              = _BITMATCH b (_SEQPATTERN
                  (\"BM%PVAR%14":num "BM%PVAR%15":((bsid # byte list) option).
                    ?ss:(2 word) ix:(3 word) bs:(3 word).
                      _UNGUARDED_PATTERN
                        (pat_set (CONSPAT (CONSPAT (CONSPAT NILPAT ss) ix) bs) "BM%PVAR%14")
                        ((let bs:(4 word) = rex_reg (rex_B rex) bs in
                        let ix:(4 word) = rex_reg (rex_X rex) ix in
                        LET
                          (GABS (\f:(2 word # gpr option -> (bsid # byte list) option).
                            !s:(2 word) i:(gpr option).
                              GEQ (f (s, i)) (LET_END
                                (>>= (read_sib_displacement md bs l)
                                  (GABS (\f:((int64 # gpr option) # byte list ->
                                              (bsid # byte list) option).
                                    !d:int64 b:(gpr option) l:(byte list).
                                      GEQ (f ((d, b), l)) (SOME (Bsid b i s d, l))))))))
                          (COND (ix = (word 4 : 4 word)) ((word 0 : 2 word), (NONE : gpr option))
                            (ss, SOME (Gpr ix Full_64))))
                        = "BM%PVAR%15"))
                  (_ELSEPATTERN (ARB : (bsid # byte list) option)
                    : num -> (bsid # byte list) option -> bool))))

definition read_ModRM
  |- read_ModRM
     = (specification "read_ModRM" read_ModRM:((4 word) option -> byte list ->
           ((4 word # RM) # byte list) option).
         (!rex:((4 word) option).
           read_ModRM rex (NIL : byte list) = (NONE : ((4 word # RM) # byte list) option))
         /\ (!rex:((4 word) option) b:byte l:(byte list).
              read_ModRM rex (CONS b l)
              = _BITMATCH b (_SEQPATTERN
                  (\"BM%PVAR%16":num "BM%PVAR%17":(((4 word # RM) # byte list) option).
                    ?reg:(3 word).
                      _UNGUARDED_PATTERN
                        (pat_set
                          (CONSPAT (CONSPAT (CONSPAT NILPAT (word 0 : 2 word)) reg)
                            (word 5 : 3 word))
                          "BM%PVAR%16")
                        (>>= (read_int32 l) (GABS (\f:(int32 # byte list ->
                                                        ((4 word # RM) # byte list) option).
                          !i:int32 l:(byte list).
                            GEQ (f (i, l)) (SOME ((rex_reg (rex_R rex) reg
                            , RM_mem (Riprel (word_sx i : int64)))
                            , l))))
                        = "BM%PVAR%17"))
                  (_SEQPATTERN
                    (\"BM%PVAR%16":num "BM%PVAR%17":(((4 word # RM) # byte list) option).
                      ?reg:(3 word) rm:(3 word).
                        _UNGUARDED_PATTERN
                          (pat_set (CONSPAT (CONSPAT (CONSPAT NILPAT (word 3 : 2 word)) reg) rm)
                            "BM%PVAR%16")
                          (SOME ((rex_reg (rex_R rex) reg, RM_reg (rex_reg (rex_B rex) rm)), l)
                          = "BM%PVAR%17"))
                    (_SEQPATTERN
                      (\"BM%PVAR%16":num "BM%PVAR%17":(((4 word # RM) # byte list) option).
                        ?md:(2 word) reg:(3 word).
                          _UNGUARDED_PATTERN
                            (pat_set (CONSPAT (CONSPAT (CONSPAT NILPAT md) reg) (word 4 : 3 word))
                              "BM%PVAR%16")
                            (>>= (read_SIB rex md l)
                              (GABS (\f:(bsid # byte list -> ((4 word # RM) # byte list) option).
                                !sib:bsid l:(byte list).
                                  GEQ (f (sib, l)) (SOME
                                    ((rex_reg (rex_R rex) reg, RM_mem sib), l))))
                            = "BM%PVAR%17"))
                      (_SEQPATTERN
                        (\"BM%PVAR%16":num "BM%PVAR%17":(((4 word # RM) # byte list) option).
                          ?md:(2 word) reg:(3 word) rm:(3 word).
                            _UNGUARDED_PATTERN
                              (pat_set (CONSPAT (CONSPAT (CONSPAT NILPAT md) reg) rm) "BM%PVAR%16")
                              (>>= (read_displacement md l)
                                (GABS (\f:(int64 # byte list -> ((4 word # RM) # byte list) option).
                                  !disp:int64 l:(byte list).
                                    GEQ (f (disp, l))
                                      (SOME ((rex_reg (rex_R rex) reg
                                      , RM_mem (%% (Gpr (rex_reg (rex_B rex) rm) Full_64
                                        , val disp)))
                                      , l))))
                              = "BM%PVAR%17"))
                        (_ELSEPATTERN (ARB : ((4 word # RM) # byte list) option)
                          : num -> ((4 word # RM) # byte list) option -> bool)))))))

definition gpr_adjust
  |- gpr_adjust
     = (\_1:(4 word) _2:regsize.
         COND (_2 = Upper_8)
           (COND (val _1 < 4) (Gpr _1 Lower_8) (COND (val _1 < 8)
             (Gpr (word (val _1 - 4) : 4 word) Upper_8)
             (ARB : gpr)))
           (Gpr _1 _2))

definition operand_of_RM
  |- operand_of_RM
     = (specification "operand_of_RM" operand_of_RM:(regsize -> RM -> operand).
         (!sz:regsize reg:(4 word). operand_of_RM sz (RM_reg reg) = Register (gpr_adjust reg sz))
         /\ (!sz:regsize ea:bsid. operand_of_RM sz (RM_mem ea) = Memop (to_wordsize sz) ea))

definition mmreg
  |- mmreg = (\_1:(4 word) _2:simdregsize. Simdregister (Simdreg (word_zx _1 : 5 word) _2))

definition simd_of_RM
  |- simd_of_RM
     = (specification "simd_of_RM" simd_of_RM:(simdregsize -> RM -> operand).
         (!sz:simdregsize reg:(4 word).
           simd_of_RM sz (RM_reg reg) = Simdregister (Simdreg (word_zx reg : 5 word) sz))
         /\ (!sz:simdregsize ea:bsid. simd_of_RM sz (RM_mem ea) = Memop (simd_to_wordsize sz) ea))

definition is_memop
  |- is_memop
     = (specification "is_memop" is_memop:(RM -> bool).
         (!reg:(4 word). is_memop (RM_reg reg) = F) /\ (!ea:bsid. is_memop (RM_mem ea) = T))

definition read_ModRM_operand
  |- read_ModRM_operand
     = (\_1:((4 word) option) _2:regsize _3:(byte list).
         >>= (read_ModRM _1 _3) (GABS (\f:((4 word # RM) # byte list ->
                                            ((operand # operand) # byte list) option).
           !reg:(4 word) rm:RM l:(byte list).
             GEQ (f ((reg, rm), l)) (SOME ((Register (gpr_adjust reg _2), operand_of_RM _2 rm)
             , l)))))

definition read_opcode_ModRM
  |- read_opcode_ModRM
     = (\_1:((4 word) option) _2:(byte list).
         >>= (read_ModRM _1 _2) (GABS (\f:((4 word # RM) # byte list ->
                                            ((3 word # RM) # byte list) option).
           !rn:(4 word) rm:RM l:(byte list).
             GEQ (f ((rn, rm), l)) (SOME (((word_zx rn : 3 word), rm), l)))))

definition read_opcode_ModRM_operand
  |- read_opcode_ModRM_operand
     = (\_1:((4 word) option) _2:regsize _3:(byte list).
         >>= (read_opcode_ModRM _1 _3) (GABS (\f:((3 word # RM) # byte list ->
                                                   ((3 word # operand) # byte list) option).
           !opc:(3 word) rm:RM l:(byte list).
             GEQ (f ((opc, rm), l)) (SOME ((opc, operand_of_RM _2 rm), l)))))

