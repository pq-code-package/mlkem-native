         _3:((x86state, 'N word) component) _4:x86state.
         let x:('N word) = read _2 _4
         and ix:('N word) = read _3 _4 in
         let f8:(int128 -> byte -> byte) =
             \w:int128 i:byte.
               COND (bit 7 i) (word 0 : byte) (word_subword w
                 (8 * val (word_subword i (0, 4) : 4 word), 8)
