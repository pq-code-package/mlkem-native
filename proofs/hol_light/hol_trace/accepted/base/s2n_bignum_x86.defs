definition x86_VPBLENDVB
  |- (x86_VPBLENDVB : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> (x86state, 'N word) component -> x86state -> x86state ->
         bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:((x86state, 'N word) component) _5:x86state.
         let x:('N word) = read _2 _5
         and y:('N word) = read _3 _5
         and m:('N word) = read _4 _5 in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let x256:(256 word) = (word_zx x : 256 word) in
           let y256:(256 word) = (word_zx y : 256 word) in
           let m256:(256 word) = (word_zx m : 256 word) in
           let res:(256 word) =
               (word
                 (nsum (0..31) (\i:num.
                   val (COND (bit (8 * i + 7) m256) (word_subword y256 (8 * i, 8) : byte)
                     (word_subword x256 (8 * i, 8) : byte))
                   * 2 EXP (8 * i)))
                 : 256 word) in
           := _1 (word_zx res : 'N word) _5)
           (let x128:int128 = (word_zx x : int128) in
           let y128:int128 = (word_zx y : int128) in
           let m128:int128 = (word_zx m : int128) in
           let res:int128 =
               (word
                 (nsum (0..15) (\i:num.
                   val (COND (bit (8 * i + 7) m128) (word_subword y128 (8 * i, 8) : byte)
                     (word_subword x128 (8 * i, 8) : byte))
                   * 2 EXP (8 * i)))
                 : int128) in
           := _1 (word_zx res : 'N word) _5))

definition x86_VPABSD
  |- (x86_VPABSD : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _2 _3 in
         let f:(int32 -> int32) = \a:int32. COND (word_igt (word 0 : int32) a) (word_neg a) a in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) = usimd8 f (word_zx x : 256 word) in
           := _1 (word_zx res : 'N word) _3)
           (let res:int128 = usimd4 f (word_zx x : int128) in := _1 (word_zx res : 'N word) _3))

definition x86_VPACKUSWB
  |- (x86_VPACKUSWB : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:x86state.
         let x:('N word) = read _2 _4
         and y:('N word) = read _3 _4 in
         let sat:(int16 -> byte) = \w:int16. (word (MIN (COND (bit 15 w) 0 (val w)) 255) : byte) in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let x256:(256 word) = (word_zx x : 256 word) in
           let y256:(256 word) = (word_zx y : 256 word) in
           let res:(256 word) =
               (word
                 (nsum (0..7) (\i:num.
                   val (sat (word_subword x256 (16 * i, 16) : int16)) * 2 EXP (8 * i))
                 + nsum (0..7) (\i:num.
                     val (sat (word_subword y256 (16 * i, 16) : int16)) * 2 EXP (8 * (i + 8)))
                 + nsum (0..7) (\i:num.
                     val (sat (word_subword x256 (128 + 16 * i, 16) : int16))
                     * 2 EXP (8 * (i + 16)))
                 + nsum (0..7) (\i:num.
                     val (sat (word_subword y256 (128 + 16 * i, 16) : int16))
                     * 2 EXP (8 * (i + 24))))
                 : 256 word) in
           := _1 (word_zx res : 'N word) _4)
           (let x128:int128 = (word_zx x : int128) in
           let y128:int128 = (word_zx y : int128) in
           let res:int128 =
               (word
                 (nsum (0..7) (\i:num.
                   val (sat (word_subword x128 (16 * i, 16) : int16)) * 2 EXP (8 * i))
                 + nsum (0..7) (\i:num.
                     val (sat (word_subword y128 (16 * i, 16) : int16)) * 2 EXP (8 * (i + 8))))
                 : int128) in
           := _1 (word_zx res : 'N word) _4))

definition x86_VPMADDUBSW
  |- (x86_VPMADDUBSW : (x86state, 'N word) component -> (x86state, 'N word) component ->
         (x86state, 'N word) component -> x86state -> x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component)
         _3:((x86state, 'N word) component) _4:x86state.
         let x:('N word) = read _2 _4
         and y:('N word) = read _3 _4 in
         let f:(int16 -> int16 -> int16) =
             \x:int16 y:int16.
               let prod1:int32 =
                   word_mul (word_zx (word_subword x (0, 8) : byte) : int32)
                     (word_sx (word_subword y (0, 8) : byte) : int32) in
               let prod2:int32 =
                   word_mul (word_zx (word_subword x (8, 8) : byte) : int32)
                     (word_sx (word_subword y (8, 8) : byte) : int32) in
               let tot:int32 = word_add prod1 prod2 in
               COND (bit 31 tot = bit 15 tot) (word_subword tot (0, 16) : int16)
                 (COND (bit 31 tot) (word 32768 : int16) (word 32767 : int16)) in
         COND (dimindex (UNIV : 'N -> bool) = 256)
           (let res:(256 word) = simd16 f (word_zx x : 256 word) (word_zx y : 256 word) in
           := _1 (word_zx res : 'N word) _4)
           (let res:int128 = simd8 f (word_zx x : int128) (word_zx y : int128) in
           := _1 (word_zx res : 'N word) _4))

