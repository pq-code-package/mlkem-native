                                                  (word1 L))
                                                p)
                                              "BM%PVAR%24")
                                            (>>= (read_VEXM m)
                                              (\m:VEXM.
                                                SOME
                                                  ((SOME (rex_reg w (word_not rxb))
                                                  , m, word_not v, L, read_VEXP p)
                                                  , l))
                                            = "BM%PVAR%25"))
                                      (_ELSEPATTERN
                                        (ARB : (((4 word) option # VEXM # 4 word # bool # bool #
                                                rep_pfx # seg_pfx) # byte list) option)
                                        : num ->
                                            (((4 word) option # VEXM # 4 word # bool # bool #
                                                    rep_pfx # seg_pfx) # byte list) option ->
                                            bool)))))
                            = "BM%PVAR%27"))
                      (_ELSEPATTERN
                        (ARB : (((4 word) option # VEXM # 4 word # bool # bool # rep_pfx #
                                seg_pfx) # byte list) option)
                        : num ->
                            (((4 word) option # VEXM # 4 word # bool # bool # rep_pfx # seg_pfx) #
                                byte list) option -> bool)))))))

