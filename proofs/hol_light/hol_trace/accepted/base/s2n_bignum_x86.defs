definition x86_movsb1
  |- x86_movsb1
     = (specification "x86_movsb1" x86_movsb1:(int64 -> int64 -> num -> x86state -> x86state).
         !a:int64 b:int64 n:num s:x86state.
           x86_movsb1 a b n s
           = write (memory :> bytes8 (word_add b (word n : int64)))
               (read (memory :> bytes8 (word_add a (word n : int64))) s)
               s)

definition x86_movsb
  |- x86_movsb
     = (specification "x86_movsb" x86_movsb:(bool -> int64 -> int64 -> num -> x86state -> x86state).
         (!df:bool a:int64 b:int64. x86_movsb df a b 0 = (I : x86state -> x86state))
         /\ (!df:bool a:int64 b:int64 n:num.
              x86_movsb df a b (SUC n)
              = COND df (x86_movsb df a b n o x86_movsb1 a b n)
                  (x86_movsb1 a b n o x86_movsb df a b n)))

definition x86_stringcopy
  |- x86_stringcopy
     = (specification "x86_stringcopy" f:(bool -> int64 -> int64 -> num -> num -> num -> num).
         (!df:bool a:int64 b:int64 n:num abuf:num bbuf:num. f df a b n abuf bbuf < 2 EXP (8 * n))
         /\ (!df:bool a:int64 b:int64 n:num s:x86state.
              n < 2 EXP 64
              ==> read (memory :> bytes (b, n)) (x86_movsb df a b n s)
                  = f df a b n (read (memory :> bytes (a, n)) s) (read (memory :> bytes (b, n)) s)))

definition x86_ADC
  |- (x86_ADC : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _1 _3
         and y:('N word) = read _2 _3
         and c:num = bitval (read CF _3) in
         let z:('N word) = word_add (word_add x y) (word c : 'N word) in
         (,,) (:= _1 z)
           (:= ZF (val z = 0)
           ,, := SF (ival z < &0)
           ,, := PF (word_evenparity (word_zx z : byte))
           ,, := CF (~ (val x + val y + c = val z))
           ,, := OF (~ (ival x + ival y + int_of_num c = ival z))
           ,, := AF (~ (val (word_zx x : 4 word) + val (word_zx y : 4 word) + c
              = val (word_zx z : 4 word))))
           _3)

definition x86_ADCX
  |- (x86_ADCX : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _1 _3
         and y:('N word) = read _2 _3
         and c:num = bitval (read CF _3) in
         let z:('N word) = word_add (word_add x y) (word c : 'N word) in
         (,,) (:= _1 z) (:= CF (~ (val x + val y + c = val z))) _3)

definition x86_ADD
  |- (x86_ADD : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _1 _3
         and y:('N word) = read _2 _3 in
         let z:('N word) = word_add x y in
         (,,) (:= _1 z)
           (:= ZF (val z = 0)
           ,, := SF (ival z < &0)
           ,, := PF (word_evenparity (word_zx z : byte))
           ,, := CF (~ (val x + val y = val z))
           ,, := OF (~ (ival x + ival y = ival z))
           ,, := AF (~ (val (word_zx x : 4 word) + val (word_zx y : 4 word)
              = val (word_zx z : 4 word))))
           _3)

definition x86_ADOX
  |- (x86_ADOX : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _1 _3
         and y:('N word) = read _2 _3
         and c:num = bitval (read OF _3) in
         let z:('N word) = word_add (word_add x y) (word c : 'N word) in
         (,,) (:= _1 z) (:= OF (~ (val x + val y + c = val z))) _3)

definition x86_AESENC
  |- (x86_AESENC : ('?1, int128) component -> ('?1, int128) component -> '?1 -> '?1 -> bool)
     = (\_1:(('?1, int128) component) _2:(('?1, int128) component) _3:'?1.
         let state:int128 = read _1 _3
         and roundkey:int128 = read _2 _3 in
         let new_state:int128 = aesenc state roundkey in := _1 new_state _3)

definition x86_AESENCLAST
  |- (x86_AESENCLAST : ('?1, int128) component -> ('?1, int128) component -> '?1 -> '?1 -> bool)
     = (\_1:(('?1, int128) component) _2:(('?1, int128) component) _3:'?1.
         let state:int128 = read _1 _3
         and roundkey:int128 = read _2 _3 in
         let new_state:int128 = aesenclast state roundkey in := _1 new_state _3)

definition x86_AESDEC
  |- (x86_AESDEC : ('?1, int128) component -> ('?1, int128) component -> '?1 -> '?1 -> bool)
     = (\_1:(('?1, int128) component) _2:(('?1, int128) component) _3:'?1.
         let state:int128 = read _1 _3
         and roundkey:int128 = read _2 _3 in
         let new_state:int128 = aesdec state roundkey in := _1 new_state _3)

definition x86_AESDECLAST
  |- (x86_AESDECLAST : ('?1, int128) component -> ('?1, int128) component -> '?1 -> '?1 -> bool)
     = (\_1:(('?1, int128) component) _2:(('?1, int128) component) _3:'?1.
         let state:int128 = read _1 _3
         and roundkey:int128 = read _2 _3 in
         let new_state:int128 = aesdeclast state roundkey in := _1 new_state _3)

definition x86_AESKEYGENASSIST
  |- (x86_AESKEYGENASSIST : ('?1, int128) component -> ('?1, int128) component ->
         ('?1, byte) component -> '?1 -> '?1 -> bool)
     = (\_1:(('?1, int128) component) _2:(('?1, int128) component) _3:(('?1, byte) component)
         _4:'?1.
         let x:int128 = read _2 _4 in
         let imm8:byte = read _3 _4 in let res:int128 = aeskeygenassist x imm8 in := _1 res _4)

definition x86_AND
  |- (x86_AND : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _1 _3
         and y:('N word) = read _2 _3 in
         let z:('N word) = word_and x y in
         (,,) (:= _1 z)
           (:= ZF (val z = 0)
           ,, := SF (ival z < &0)
           ,, := PF (word_evenparity (word_zx z : byte))
           ,, := CF F
           ,, := OF F
           ,, UNDEFINED_VALUES [AF])
           _3)

definition x86_BSF
  |- (x86_BSF : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _2 _3 in
         let z:('N word) = (word (word_ctz x) : 'N word) in
         (,,) (COND (x = (word 0 : 'N word)) (UNDEFINED_VALUES [_1]) (:= _1 z))
           (:= ZF (val x = 0) ,, UNDEFINED_VALUES [CF; OF; SF; PF; AF])
           _3)

definition x86_BSR
  |- (x86_BSR : (x86state, 'N word) component -> (x86state, 'N word) component -> x86state ->
         x86state -> bool)
     = (\_1:((x86state, 'N word) component) _2:((x86state, 'N word) component) _3:x86state.
         let x:('N word) = read _2 _3 in
         let z:('N word) = (word (dimindex (UNIV : 'N -> bool) - 1 - word_clz x) : 'N word) in
         (,,) (COND (x = (word 0 : 'N word)) (UNDEFINED_VALUES [_1]) (:= _1 z))
           (:= ZF (val x = 0) ,, UNDEFINED_VALUES [CF; OF; SF; PF; AF])
           _3)

