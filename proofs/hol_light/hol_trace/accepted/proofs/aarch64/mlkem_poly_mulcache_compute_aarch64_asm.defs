# mlkem_poly_mulcache_compute_aarch64_asm
#
# The definitions that the main theorems use beyond the shared files
# in accepted/base and accepted/spec. Written by `hol-trace outline`
# or `hol-trace compare --accept`. check-binary compares the byte list
# with functions in binaries, through proofs/hol_light/bind.yml.
# The notation is explained in proofs/hol_light/hol_trace/accepted/README.md.

definition have_mulcache_zetas
  |- have_mulcache_zetas
     = (specification "have_mulcache_zetas" have_mulcache_zetas:(int64 -> int64 -> armstate ->
           bool).
         !zetas:int64 zetas_twisted:int64 s:armstate.
           have_mulcache_zetas zetas zetas_twisted s
           = ((!i:num.
               i < 128
               ==> read (memory :> bytes16 (word_add zetas (word (2 * i) : int64))) s
                   = (iword (EL i mulcache_zetas) : int16))
             /\ (!i:num.
                  i < 128
                  ==> read (memory :> bytes16 (word_add zetas_twisted (word (2 * i) : int64))) s
                      = (iword (EL i mulcache_zetas_twisted) : int16))))

