# mlkem_poly_tobytes_aarch64_asm
#
# The main theorems. Written by `hol-trace outline` or `hol-trace
# compare --accept`. This is what the proof claims.

theorem mlkem_poly_tobytes_aarch64_asm MLKEM_POLY_TOBYTES_SUBROUTINE_CORRECT
  |- !r:int64 a:int64 l:(int16 list) pc:num returnaddress:int64.
       ALL (nonoverlapping (r, 384)) [(word pc : int64), LENGTH mlkem_poly_tobytes_mc; a, 512]
       ==> ensures arm
             (\s:armstate.
               aligned_bytes_loaded s (word pc : int64) mlkem_poly_tobytes_mc
               /\ read PC s = (word pc : int64)
               /\ read X30 s = returnaddress
               /\ C_ARGUMENTS [r; a] s
               /\ LENGTH l = 256
               /\ read (memory :> bytes (a, 512)) s = num_of_wordlist l)
             (\s:armstate.
               read PC s = returnaddress
               /\ read (memory :> bytes (r, 384)) s
                  = num_of_wordlist (MAP (word_zx : int16 -> 12 word) l))
             (MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI ,, MAYCHANGE [memory :> bytes (r, 384)])

theorem mlkem_poly_tobytes_aarch64_asm MLKEM_POLY_TOBYTES_SUBROUTINE_SAFE
  |- ?f_events:(int64 -> int64 -> num -> int64 -> (64 address_uarch_event) list).
       !e:((64 address_uarch_event) list) r:int64 a:int64 pc:num returnaddress:int64.
         ALL (nonoverlapping (r, 384)) [(word pc : int64), LENGTH mlkem_poly_tobytes_mc; a, 512]
         ==> ensures arm
               (\s:armstate.
                 aligned_bytes_loaded s (word pc : int64) mlkem_poly_tobytes_mc
                 /\ read PC s = (word pc : int64)
                 /\ read X30 s = returnaddress
                 /\ C_ARGUMENTS [r; a] s
                 /\ read events s = e)
               (\s:armstate.
                 read PC s = returnaddress
                 /\ (?e2:((64 address_uarch_event) list).
                      read events s = APPEND e2 e
                      /\ e2 = f_events a r pc returnaddress
                      /\ memaccess_inbounds e2 [a, 512; r, 384] [r, 384]))
               (\s:armstate s':armstate. T)
