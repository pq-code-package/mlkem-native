# mlkem_polyvec_basemul_acc_montgomery_cached_k3_aarch64_asm
#
# The definitions that the main theorems use beyond the shared files
# in accepted/base and accepted/spec. Written by `hol-trace outline`
# or `hol-trace compare --accept`. check-binary compares the byte list
# with functions in binaries, through proofs/hol_light/bind.yml.
# The notation is explained in proofs/hol_light/hol_trace/accepted/README.md.

definition basemul3_even
  |- basemul3_even
     = (specification "basemul3_even" basemul3_even:((num -> int) -> (num -> int) -> (num -> int) ->
           (num -> int) -> (num -> int) -> (num -> int) -> (num -> int) -> (num -> int) ->
           (num -> int) -> num -> int).
         !x0:(num -> int) y0:(num -> int) y0t:(num -> int) x1:(num -> int) y1:(num -> int)
          y1t:(num -> int) x2:(num -> int) y2:(num -> int) y2t:(num -> int).
           basemul3_even x0 y0 y0t x1 y1 y1t x2 y2 y2t
           = (\i:num.
               pmul_acc3 (x0 (2 * i)) (x0 (2 * i + 1)) (y0 (2 * i)) (y0t i) (x1 (2 * i))
                 (x1 (2 * i + 1))
                 (y1 (2 * i))
                 (y1t i)
                 (x2 (2 * i))
                 (x2 (2 * i + 1))
                 (y2 (2 * i))
                 (y2t i)))

definition basemul3_odd
  |- basemul3_odd
     = (specification "basemul3_odd" basemul3_odd:((num -> int) -> (num -> int) -> (num -> int) ->
           (num -> int) -> (num -> int) -> (num -> int) -> num -> int).
         !x0:(num -> int) y0:(num -> int) x1:(num -> int) y1:(num -> int) x2:(num -> int)
          y2:(num -> int).
           basemul3_odd x0 y0 x1 y1 x2 y2
           = (\i:num.
               pmul_acc3 (x0 (2 * i)) (x0 (2 * i + 1)) (y0 (2 * i + 1)) (y0 (2 * i)) (x1 (2 * i))
                 (x1 (2 * i + 1))
                 (y1 (2 * i + 1))
                 (y1 (2 * i))
                 (x2 (2 * i))
                 (x2 (2 * i + 1))
                 (y2 (2 * i + 1))
                 (y2 (2 * i))))

definition pmul_acc3
  |- pmul_acc3
     = (specification "pmul_acc3" pmul_acc3:(int -> int -> int -> int -> int -> int -> int -> int ->
           int -> int -> int -> int -> int).
         !x00:int x01:int y00:int y01:int x10:int x11:int y10:int y11:int x20:int x21:int y20:int
          y21:int.
           pmul_acc3 x00 x01 y00 y01 x10 x11 y10 y11 x20 x21 y20 y21
           = (int_of_num (inverse_mod 3329 65536)
             * pmull_acc3 x00 x01 y00 y01 x10 x11 y10 y11 x20 x21 y20 y21)
             rem &3329)

definition pmull
  |- pmull
     = (specification "pmull" pmull:(int -> int -> int -> int -> int).
         !x0:int x1:int y0:int y1:int. pmull x0 x1 y0 y1 = x1 * y1 + x0 * y0)

definition pmull_acc3
  |- pmull_acc3
     = (specification "pmull_acc3" pmull_acc3:(int -> int -> int -> int -> int -> int -> int ->
           int -> int -> int -> int -> int -> int).
         !x00:int x01:int y00:int y01:int x10:int x11:int y10:int y11:int x20:int x21:int y20:int
          y21:int.
           pmull_acc3 x00 x01 y00 y01 x10 x11 y10 y11 x20 x21 y20 y21
           = pmull x20 x21 y20 y21 + pmull x10 x11 y10 y11 + pmull x00 x01 y00 y01)

