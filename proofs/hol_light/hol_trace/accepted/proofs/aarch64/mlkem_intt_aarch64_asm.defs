# aarch64/mlkem_intt_aarch64_asm
#
# The definitions that the main theorems use beyond the generated
# layers. Written by `hol-trace conform --accept`; review changes like
# source code. check-bind compares the byte lists named in
# mlkem_intt_aarch64_asm.bind with sections of object files.

definition intt_constants
  |- (= intt_constants
       (@
         (\intt_constants:((num # num # num # num # num # num # num # num # num # num # num # num # num # num) -> (word #64) -> (word #64) -> armstate -> bool).
           (!_1:(num # num # num # num # num # num # num # num # num # num # num # num # num # num) z_12345:(word #64) z_67:(word #64) s:armstate.
             (= (intt_constants _1 z_12345 z_67 s)
               (/\
                 (!i:num.
                   (==> (< i #80)
                     (=
                       (read
                         (":>" memory (bytes16 (word_add z_12345 (word:(num -> (word #64)) (* #2 i)))))
                         s)
                       (iword:(int -> (word #16)) (EL i intt_zetas_layer12345)))))
                 (!i:num.
                   (==> (< i #384)
                     (=
                       (read
                         (":>" memory (bytes16 (word_add z_67 (word:(num -> (word #64)) (* #2 i))))) s)
                       (iword:(int -> (word #16)) (EL i intt_zetas_layer67)))))))))
         (, #105 #110 #116 #116 #95 #99 #111 #110 #115 #116 #97 #110 #116 #115)))

