# keccak_f1600_x4_v8a_v84a_scalar_hybrid_aarch64_asm
#
# The main theorems. Written by `hol-trace outline` or `hol-trace
# compare --accept`. This is what the proof claims.

theorem keccak_f1600_x4_v8a_v84a_scalar_hybrid_aarch64_asm KECCAK_F1600_X4_V8A_V84A_SCALAR_HYBRID_SUBROUTINE_CORRECT
  |- !a:int64 rc:int64 A1:(int64 list) A2:(int64 list) A3:(int64 list) A4:(int64 list) pc:num
      stackpointer:int64 returnaddress:int64.
       aligned 16 stackpointer
       /\ nonoverlapping (a, 800) (word_sub stackpointer (word 224 : int64), 224)
       /\ ALLPAIRS (nonoverlapping : int64 # num -> int64 # num -> bool)
            [a, 800; word_sub stackpointer (word 224 : int64), 224]
            [(word pc : int64), LENGTH keccak_f1600_x4_v8a_v84a_scalar_mc; rc, 192]
       ==> ensures arm
             (\s:armstate.
               aligned_bytes_loaded s (word pc : int64) keccak_f1600_x4_v8a_v84a_scalar_mc
               /\ read PC s = (word pc : int64)
               /\ read SP s = stackpointer
               /\ read X30 s = returnaddress
               /\ C_ARGUMENTS [a; rc] s
               /\ (wordlist_from_memory (a, 25) s : int64 list) = A1
               /\ (wordlist_from_memory (word_add a (word 200 : int64), 25) s : int64 list) = A2
               /\ (wordlist_from_memory (word_add a (word 400 : int64), 25) s : int64 list) = A3
               /\ (wordlist_from_memory (word_add a (word 600 : int64), 25) s : int64 list) = A4
               /\ (wordlist_from_memory (rc, 24) s : int64 list) = round_constants)
             (\s:armstate.
               read PC s = returnaddress
               /\ (wordlist_from_memory (a, 25) s : int64 list) = keccak 24 A1
               /\ (wordlist_from_memory (word_add a (word 200 : int64), 25) s : int64 list)
                  = keccak 24 A2
               /\ (wordlist_from_memory (word_add a (word 400 : int64), 25) s : int64 list)
                  = keccak 24 A3
               /\ (wordlist_from_memory (word_add a (word 600 : int64), 25) s : int64 list)
                  = keccak 24 A4)
             (MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
             ,, MAYCHANGE [memory :> bytes (a, 800);
                           memory :> bytes (word_sub stackpointer (word 224 : int64), 224)])

theorem keccak_f1600_x4_v8a_v84a_scalar_hybrid_aarch64_asm KECCAK_F1600_X4_V8A_V84A_SCALAR_HYBRID_SUBROUTINE_SAFE
  |- ?f_events:(int64 -> int64 -> num -> int64 -> int64 -> (64 address_uarch_event) list).
       !e:((64 address_uarch_event) list) a:int64 rc:int64 pc:num stackpointer:int64
        returnaddress:int64.
         aligned 16 stackpointer
         /\ nonoverlapping (a, 800) (word_sub stackpointer (word 224 : int64), 224)
         /\ ALLPAIRS (nonoverlapping : int64 # num -> int64 # num -> bool)
              [a, 800; word_sub stackpointer (word 224 : int64), 224]
              [(word pc : int64), LENGTH keccak_f1600_x4_v8a_v84a_scalar_mc; rc, 192]
         ==> ensures arm
               (\s:armstate.
                 aligned_bytes_loaded s (word pc : int64) keccak_f1600_x4_v8a_v84a_scalar_mc
                 /\ read PC s = (word pc : int64)
                 /\ read SP s = stackpointer
                 /\ read X30 s = returnaddress
                 /\ C_ARGUMENTS [a; rc] s
                 /\ read events s = e)
               (\s:armstate.
                 read PC s = returnaddress
                 /\ (?e2:((64 address_uarch_event) list).
                      read events s = APPEND e2 e
                      /\ e2
                         = f_events rc a pc (word_sub stackpointer (word 224 : int64)) returnaddress
                      /\ memaccess_inbounds e2
                           [a, 800; rc, 192; word_sub stackpointer (word 224 : int64), 224]
                           [a, 800; word_sub stackpointer (word 224 : int64), 224]))
               (\s:armstate s':armstate. T)
