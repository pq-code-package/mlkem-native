definition ntt_constants
  |- ntt_constants
     = (specification "ntt_constants" ntt_constants:(int64 -> int64 -> armstate -> bool).
         !z_12345:int64 z_67:int64 s:armstate.
           ntt_constants z_12345 z_67 s
           = ((!i:num.
               i < 80
               ==> read (memory :> bytes16 (word_add z_12345 (word (2 * i) : int64))) s
                   = (iword (EL i ntt_zetas_layer12345) : int16))
             /\ (!i:num.
                  i < 384
                  ==> read (memory :> bytes16 (word_add z_67 (word (2 * i) : int64))) s
                      = (iword (EL i ntt_zetas_layer67) : int16))))
