definition pmul_acc4
  |- (= pmul_acc4
       (@
         (\pmul_acc4:((num # num # num # num # num # num # num # num # num) -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int).
           (!_1:(num # num # num # num # num # num # num # num # num) x00:int x01:int y00:int y01:int x10:int x11:int y10:int y11:int x20:int x21:int y20:int y21:int x30:int x31:int y30:int y31:int.
             (= (pmul_acc4 _1 x00 x01 y00 y01 x10 x11 y10 y11 x20 x21 y20 y21 x30 x31 y30 y31)
               (rem
                 (int_mul (int_of_num (inverse_mod #3329 #65536))
                   (pmull_acc4 x00 x01 y00 y01 x10 x11 y10 y11 x20 x21 y20 y21 x30 x31 y30 y31))
                 &3329))))
         (, #112 #109 #117 #108 #95 #97 #99 #99 #52)))

definition pmull
  |- (= pmull
       (@
         (\pmull:((num # num # num # num # num) -> int -> int -> int -> int -> int).
           (!_1:(num # num # num # num # num) x0:int x1:int y0:int y1:int.
             (= (pmull _1 x0 x1 y0 y1) (int_add (int_mul x1 y1) (int_mul x0 y0)))))
         (, #112 #109 #117 #108 #108)))

definition pmull_acc4
  |- (= pmull_acc4
       (@
         (\pmull_acc4:((num # num # num # num # num # num # num # num # num # num) -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int -> int).
           (!_1:(num # num # num # num # num # num # num # num # num # num) x00:int x01:int y00:int y01:int x10:int x11:int y10:int y11:int x20:int x21:int y20:int y21:int x30:int x31:int y30:int y31:int.
             (= (pmull_acc4 _1 x00 x01 y00 y01 x10 x11 y10 y11 x20 x21 y20 y21 x30 x31 y30 y31)
               (int_add (pmull x30 x31 y30 y31)
                 (int_add (pmull x20 x21 y20 y21)
                   (int_add (pmull x10 x11 y10 y11) (pmull x00 x01 y00 y01)))))))
         (, #112 #109 #117 #108 #108 #95 #97 #99 #99 #52)))

