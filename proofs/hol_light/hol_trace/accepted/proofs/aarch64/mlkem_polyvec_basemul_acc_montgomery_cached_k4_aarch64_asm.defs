definition basemul4_even
  |- (= basemul4_even
       (@
         (\basemul4_even:((num # num # num # num # num # num # num # num # num # num # num # num # num) -> (num -> int) -> (num -> int) -> (num -> int) -> (num -> int) -> (num -> int) -> (num -> int) -> (num -> int) -> (num -> int) -> (num -> int) -> (num -> int) -> (num -> int) -> (num -> int) -> num -> int).
           (!_1:(num # num # num # num # num # num # num # num # num # num # num # num # num) x0:(num -> int) y0:(num -> int) y0t:(num -> int) x1:(num -> int) y1:(num -> int) y1t:(num -> int) x2:(num -> int) y2:(num -> int) y2t:(num -> int) x3:(num -> int) y3:(num -> int) y3t:(num -> int).
             (= (basemul4_even _1 x0 y0 y0t x1 y1 y1t x2 y2 y2t x3 y3 y3t)
               (\i:num.
                 (pmul_acc4 (x0 (* #2 i)) (x0 (+ (* #2 i) #1)) (y0 (* #2 i)) (y0t i) (x1 (* #2 i))
                   (x1 (+ (* #2 i) #1)) (y1 (* #2 i)) (y1t i) (x2 (* #2 i)) (x2 (+ (* #2 i) #1))
                   (y2 (* #2 i)) (y2t i) (x3 (* #2 i)) (x3 (+ (* #2 i) #1)) (y3 (* #2 i)) (y3t i))))))
         (, #98 #97 #115 #101 #109 #117 #108 #52 #95 #101 #118 #101 #110)))

