# mlkem_ntt_aarch64_asm
#
# The main theorems. Written by `hol-trace outline` or `hol-trace
# compare --accept`. This is what the proof claims.

theorem mlkem_ntt_aarch64_asm MLKEM_NTT_SUBROUTINE_CORRECT
  |- !a:int64 z_12345:int64 z_67:int64 x:(num -> int16) pc:num stackpointer:int64
      returnaddress:int64.
       aligned 16 stackpointer
       /\ ALLPAIRS (nonoverlapping : int64 # num -> int64 # num -> bool)
            [a, 512; word_sub stackpointer (word 64 : int64), 64]
            [(word pc : int64), LENGTH mlkem_ntt_mc; z_12345, 160; z_67, 768]
       /\ nonoverlapping (a, 512) (word_sub stackpointer (word 64 : int64), 64)
       ==> ensures arm
             (\s:armstate.
               aligned_bytes_loaded s (word pc : int64) mlkem_ntt_mc
               /\ read PC s = (word pc : int64)
               /\ read SP s = stackpointer
               /\ read X30 s = returnaddress
               /\ C_ARGUMENTS [a; z_12345; z_67] s
               /\ ntt_constants z_12345 z_67 s
               /\ (!i:num.
                    i < 256
                    ==> read (memory :> bytes16 (word_add a (word (2 * i) : int64))) s = x i))
             (\s:armstate.
               read PC s = returnaddress
               /\ ((!i:num. i < 256 ==> abs (ival (x i)) <= &3328)
                  ==> (!i:num.
                        i < 256
                        ==> (let zi:int16 =
                                read (memory :> bytes16 (word_add a (word (2 * i) : int64))) s in
                            (ival zi == forward_ntt ((ival : int16 -> int) o x) i) (mod &3329)
                            /\ abs (ival zi) <= &17389))))
             (MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
             ,, MAYCHANGE [memory :> bytes (a, 512);
                           memory :> bytes (word_sub stackpointer (word 64 : int64), 64)])

theorem mlkem_ntt_aarch64_asm MLKEM_NTT_SUBROUTINE_SAFE
  |- ?f_events:(int64 -> int64 -> int64 -> num -> int64 -> int64 -> (64 address_uarch_event) list).
       !e:((64 address_uarch_event) list) a:int64 z_12345:int64 z_67:int64 pc:num stackpointer:int64
        returnaddress:int64.
         aligned 16 stackpointer
         /\ ALLPAIRS (nonoverlapping : int64 # num -> int64 # num -> bool)
              [a, 512; word_sub stackpointer (word 64 : int64), 64]
              [(word pc : int64), LENGTH mlkem_ntt_mc; z_12345, 160; z_67, 768]
         /\ nonoverlapping (a, 512) (word_sub stackpointer (word 64 : int64), 64)
         ==> ensures arm
               (\s:armstate.
                 aligned_bytes_loaded s (word pc : int64) mlkem_ntt_mc
                 /\ read PC s = (word pc : int64)
                 /\ read SP s = stackpointer
                 /\ read X30 s = returnaddress
                 /\ C_ARGUMENTS [a; z_12345; z_67] s
                 /\ read events s = e)
               (\s:armstate.
                 read PC s = returnaddress
                 /\ (?e2:((64 address_uarch_event) list).
                      read events s = APPEND e2 e
                      /\ e2
                         = f_events z_12345 z_67 a pc (word_sub stackpointer (word 64 : int64))
                             returnaddress
                      /\ memaccess_inbounds e2
                           [a, 512; z_12345, 160; z_67, 768;
                            word_sub stackpointer (word 64 : int64), 64]
                           [a, 512; word_sub stackpointer (word 64 : int64), 64]))
               (\s:armstate s':armstate. T)
