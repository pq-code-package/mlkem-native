# mlkem_poly_mulcache_compute_aarch64_asm
#
# The main theorems. Written by `hol-trace outline` or `hol-trace
# compare --accept`. This is what the proof claims.

theorem mlkem_poly_mulcache_compute_aarch64_asm MLKEM_POLY_MULCACHE_COMPUTE_SUBROUTINE_CORRECT
  |- !dst:int64 src:int64 zetas:int64 zetas_twisted:int64 x:(num -> int16) pc:num
      returnaddress:int64.
       ALL (nonoverlapping (dst, 256)) [(word pc : int64), LENGTH poly_mulcache_compute_mc;
                                        src, 512; zetas, 256; zetas_twisted, 256]
       ==> ensures arm
             (\s:armstate.
               aligned_bytes_loaded s (word pc : int64) poly_mulcache_compute_mc
               /\ read PC s = (word pc : int64)
               /\ read X30 s = returnaddress
               /\ C_ARGUMENTS [dst; src; zetas; zetas_twisted] s
               /\ (!i:num.
                    i < 256
                    ==> read (memory :> bytes16 (word_add src (word (2 * i) : int64))) s = x i)
               /\ have_mulcache_zetas zetas zetas_twisted s)
             (\s:armstate.
               read PC s = returnaddress
               /\ (!i:num.
                    i < 128
                    ==> (let z_i:int16 =
                            read (memory :> bytes16 (word_add dst (word (2 * i) : int64))) s in
                        (ival z_i == mulcache ((ival : int16 -> int) o x) i) (mod &3329)
                        /\ abs (ival z_i) <= &3328)))
             (MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI ,, MAYCHANGE [memory :> bytes (dst, 256)])

theorem mlkem_poly_mulcache_compute_aarch64_asm MLKEM_POLY_MULCACHE_COMPUTE_SUBROUTINE_SAFE
  |- ?f_events:(int64 -> int64 -> int64 -> int64 -> num -> int64 -> (64 address_uarch_event) list).
       !e:((64 address_uarch_event) list) dst:int64 src:int64 zetas:int64 zetas_twisted:int64 pc:num
        returnaddress:int64.
         ALL (nonoverlapping (dst, 256)) [(word pc : int64), LENGTH poly_mulcache_compute_mc;
                                          src, 512; zetas, 256; zetas_twisted, 256]
         ==> ensures arm
               (\s:armstate.
                 aligned_bytes_loaded s (word pc : int64) poly_mulcache_compute_mc
                 /\ read PC s = (word pc : int64)
                 /\ read X30 s = returnaddress
                 /\ C_ARGUMENTS [dst; src; zetas; zetas_twisted] s
                 /\ read events s = e)
               (\s:armstate.
                 read PC s = returnaddress
                 /\ (?e2:((64 address_uarch_event) list).
                      read events s = APPEND e2 e
                      /\ e2 = f_events src zetas zetas_twisted dst pc returnaddress
                      /\ memaccess_inbounds e2 [src, 512; zetas, 256; zetas_twisted, 256; dst, 256]
                           [dst, 256]))
               (\s:armstate s':armstate. T)
