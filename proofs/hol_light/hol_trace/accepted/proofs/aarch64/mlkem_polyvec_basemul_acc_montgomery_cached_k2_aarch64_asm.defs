# mlkem_polyvec_basemul_acc_montgomery_cached_k2_aarch64_asm
#
# The definitions that the main theorems use beyond the shared files
# in accepted/base and accepted/spec. Written by `hol-trace outline`
# or `hol-trace compare --accept`. check-binary compares the byte list
# with functions in binaries, through proofs/hol_light/bind.yml.
# The notation is explained in proofs/hol_light/hol_trace/accepted/README.md.

definition basemul2_even
  |- basemul2_even
     = (specification "basemul2_even" basemul2_even:((num -> int) -> (num -> int) -> (num -> int) ->
           (num -> int) -> (num -> int) -> (num -> int) -> num -> int).
         !x0:(num -> int) y0:(num -> int) y0t:(num -> int) x1:(num -> int) y1:(num -> int)
          y1t:(num -> int).
           basemul2_even x0 y0 y0t x1 y1 y1t
           = (\i:num.
               pmul_acc2 (x0 (2 * i)) (x0 (2 * i + 1)) (y0 (2 * i)) (y0t i) (x1 (2 * i))
                 (x1 (2 * i + 1))
                 (y1 (2 * i))
                 (y1t i)))

definition basemul2_odd
  |- basemul2_odd
     = (specification "basemul2_odd" basemul2_odd:((num -> int) -> (num -> int) -> (num -> int) ->
           (num -> int) -> num -> int).
         !x0:(num -> int) y0:(num -> int) x1:(num -> int) y1:(num -> int).
           basemul2_odd x0 y0 x1 y1
           = (\i:num.
               pmul_acc2 (x0 (2 * i)) (x0 (2 * i + 1)) (y0 (2 * i + 1)) (y0 (2 * i)) (x1 (2 * i))
                 (x1 (2 * i + 1))
                 (y1 (2 * i + 1))
                 (y1 (2 * i))))

definition pmul_acc2
  |- pmul_acc2
     = (specification "pmul_acc2" pmul_acc2:(int -> int -> int -> int -> int -> int -> int -> int ->
           int).
         !x00:int x01:int y00:int y01:int x10:int x11:int y10:int y11:int.
           pmul_acc2 x00 x01 y00 y01 x10 x11 y10 y11
           = (int_of_num (inverse_mod 3329 65536) * pmull_acc2 x00 x01 y00 y01 x10 x11 y10 y11)
             rem &3329)

definition pmull
  |- pmull
     = (specification "pmull" pmull:(int -> int -> int -> int -> int).
         !x0:int x1:int y0:int y1:int. pmull x0 x1 y0 y1 = x1 * y1 + x0 * y0)

definition pmull_acc2
  |- pmull_acc2
     = (specification "pmull_acc2" pmull_acc2:(int -> int -> int -> int -> int -> int -> int ->
           int -> int).
         !x00:int x01:int y00:int y01:int x10:int x11:int y10:int y11:int.
           pmull_acc2 x00 x01 y00 y01 x10 x11 y10 y11
           = pmull x10 x11 y10 y11 + pmull x00 x01 y00 y01)

