                    i < 16
                    ==> (!j:num.
                          j < 8
                          ==> read
                                (memory
                                :> bytes16 (word_add src2 (word (64 * j + 32 + 2 * i) : int64)))
                                s
                              = d0 i j))
               /\ (!i:num.
                    i < 16
                    ==> (!j:num.
                          j < 8
                          ==> read
                                (memory :> bytes16 (word_add src2t (word (32 * j + 2 * i) : int64)))
                                s
                              = dz0 i j))
               /\ (!i:num.
                    i < 16
                    ==> (!j:num.
                          j < 8
                          ==> read
                                (memory
                                :> bytes16 (word_add src1 (word (512 + 64 * j + 2 * i) : int64)))
                                s
                              = a1 i j))
               /\ (!i:num.
                    i < 16
                    ==> (!j:num.
                          j < 8
