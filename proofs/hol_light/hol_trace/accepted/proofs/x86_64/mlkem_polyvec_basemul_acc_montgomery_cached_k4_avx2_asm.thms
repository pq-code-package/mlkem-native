                                       (ival (d0 i j'))
                                       (ival (dz0 i j'))
                                       (ival (a1 i j'))
                                       (ival (b1 i j'))
                                       (ival (c1 i j'))
                                       (ival (d1 i j'))
                                       (ival (dz1 i j'))
                                       (ival (a2 i j'))
                                       (ival (b2 i j'))
                                       (ival (c2 i j'))
                                       (ival (d2 i j'))
                                       (ival (dz2 i j'))
                                       (ival (a3 i j'))
                                       (ival (b3 i j'))
                                       (ival (c3 i j'))
                                       (ival (d3 i j'))
                                       (ival (dz3 i j'))) (mod &3329))))
               /\ (!i:num.
                    i < 16
                    ==> (!j:num.
                          j < 8
                          ==> abs (ival (a0 i j)) <= &2 pow 12
                              /\ abs (ival (b0 i j)) <= &2 pow 12
                              /\ abs (ival (a1 i j)) <= &2 pow 12
                              /\ abs (ival (b1 i j)) <= &2 pow 12
                              /\ abs (ival (a2 i j)) <= &2 pow 12
                              /\ abs (ival (b2 i j)) <= &2 pow 12
                              /\ abs (ival (a3 i j)) <= &2 pow 12
                              /\ abs (ival (b3 i j)) <= &2 pow 12
                          ==> (ival (read
                                (memory
                                :> bytes16 (word_add dst (word (64 * j + 32 + 2 * i) : int64)))
                                s)
                              == pmulaccred1_k4 (ival (a0 i j)) (ival (b0 i j)) (ival (c0 i j))
