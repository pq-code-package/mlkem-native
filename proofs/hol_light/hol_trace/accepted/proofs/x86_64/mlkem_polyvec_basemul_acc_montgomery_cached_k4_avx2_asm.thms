                                       (ival (dz0 i j'))
                                       (ival (a1 i j'))
                                       (ival (b1 i j'))
                                       (ival (c1 i j'))
                                       (ival (d1 i j'))
                                       (ival (dz1 i j'))
                                       (ival (a2 i j'))
                                       (ival (b2 i j'))
                                       (ival (c2 i j'))
                                       (ival (d2 i j'))
                                       (ival (dz2 i j'))
                                       (ival (a3 i j'))
                                       (ival (b3 i j'))
                                       (ival (c3 i j'))
                                       (ival (d3 i j'))
