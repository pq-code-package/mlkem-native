theorem x86_64/mlkem_polyvec_basemul_acc_montgomery_cached_k4_avx2_asm MLKEM_POLYVEC_BASEMUL_ACC_MONTGOMERY_CACHED_K4_SUBROUTINE_SAFE
  |- (?f_events:((word #64) -> (word #64) -> (word #64) -> (word #64) -> num -> (word #64) -> (word #64) -> (list (address_uarch_event #64))).
       (!e:(list (address_uarch_event #64)) src1:(word #64) src2:(word #64) src2t:(word #64) dst:(word #64) pc:num stackpointer:(word #64) returnaddress:(word #64).
