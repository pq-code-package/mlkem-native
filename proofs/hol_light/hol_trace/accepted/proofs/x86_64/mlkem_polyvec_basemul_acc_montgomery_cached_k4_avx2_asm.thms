                          ==> abs (ival (a0 i j)) <= &2 pow 12
                              /\ abs (ival (b0 i j)) <= &2 pow 12
                              /\ abs (ival (a1 i j)) <= &2 pow 12
                              /\ abs (ival (b1 i j)) <= &2 pow 12
                              /\ abs (ival (a2 i j)) <= &2 pow 12
                              /\ abs (ival (b2 i j)) <= &2 pow 12
                              /\ abs (ival (a3 i j)) <= &2 pow 12
                              /\ abs (ival (b3 i j)) <= &2 pow 12
                          ==> (ival (read
                                (memory
                                :> bytes16 (word_add dst (word (64 * j + 32 + 2 * i) : int64)))
                                s)
                              == pmulaccred1_k4 (ival (a0 i j)) (ival (b0 i j)) (ival (c0 i j))
                                   (ival (d0 i j))
                                   (ival (dz0 i j))
                                   (ival (a1 i j))
                                   (ival (b1 i j))
                                   (ival (c1 i j))
                                   (ival (d1 i j))
                                   (ival (dz1 i j))
                                   (ival (a2 i j))
                                   (ival (b2 i j))
                                   (ival (c2 i j))
                                   (ival (d2 i j))
                                   (ival (dz2 i j))
                                   (ival (a3 i j))
                                   (ival (b3 i j))
                                   (ival (c3 i j))
                                   (ival (d3 i j))
                                   (ival (dz3 i j))) (mod &3329))))
             (MAYCHANGE [RSP]
             ,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
             ,, MAYCHANGE [memory :> bytes (dst, 512)])

theorem mlkem_polyvec_basemul_acc_montgomery_cached_k4_avx2_asm MLKEM_POLYVEC_BASEMUL_ACC_MONTGOMERY_CACHED_K4_SUBROUTINE_SAFE
  |- ?f_events:(int64 -> int64 -> int64 -> int64 -> num -> int64 -> int64 ->
          (64 address_uarch_event) list).
       !e:((64 address_uarch_event) list) src1:int64 src2:int64 src2t:int64 dst:int64 pc:num
        stackpointer:int64 returnaddress:int64.
         aligned 32 src1
         /\ aligned 32 src2
         /\ aligned 32 src2t
         /\ aligned 32 dst
         /\ ALL (nonoverlapping (dst, 512)) [src1, 2048; src2, 2048; src2t, 1024]
         /\ nonoverlapping (dst, 512) ((word pc : int64), LENGTH mlkem_basemul_k4_mc)
         /\ nonoverlapping (stackpointer, 8) (dst, 512)
         ==> ensures x86
               (\s:x86state.
                 bytes_loaded s (word pc : int64) mlkem_basemul_k4_mc
                 /\ read RIP s = (word pc : int64)
                 /\ read RSP s = stackpointer
                 /\ read (memory :> bytes64 stackpointer) s = returnaddress
                 /\ C_ARGUMENTS [dst; src1; src2; src2t] s
                 /\ read events s = e)
               (\s:x86state.
                 read RIP s = returnaddress
                 /\ read RSP s = word_add stackpointer (word 8 : int64)
                 /\ (?e2:((64 address_uarch_event) list).
                      read events s = APPEND e2 e
                      /\ e2 = f_events src1 src2 src2t dst pc stackpointer returnaddress
                      /\ memaccess_inbounds e2
                           [src1, 2048; src2, 2048; src2t, 1024; dst, 512; stackpointer, 8]
                           [dst, 512; stackpointer, 8]))
               (\s:x86state s':x86state. T)
