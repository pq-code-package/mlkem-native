theorem mlkem_polyvec_basemul_acc_montgomery_cached_k4_avx2_asm MLKEM_POLYVEC_BASEMUL_ACC_MONTGOMERY_CACHED_K4_NOIBT_SUBROUTINE_CORRECT
  |- !src1:int64 src2:int64 src2t:int64 dst:int64 a0:(num -> num -> int16) b0:(num -> num -> int16)
      c0:(num -> num -> int16) d0:(num -> num -> int16) dz0:(num -> num -> int16)
      a1:(num -> num -> int16) b1:(num -> num -> int16) c1:(num -> num -> int16)
      d1:(num -> num -> int16) dz1:(num -> num -> int16) a2:(num -> num -> int16)
      b2:(num -> num -> int16) c2:(num -> num -> int16) d2:(num -> num -> int16)
      dz2:(num -> num -> int16) a3:(num -> num -> int16) b3:(num -> num -> int16)
      c3:(num -> num -> int16) d3:(num -> num -> int16) dz3:(num -> num -> int16) pc:num
      stackpointer:int64 returnaddress:int64.
       aligned 32 src1
       /\ aligned 32 src2
       /\ aligned 32 src2t
       /\ aligned 32 dst
       /\ ALL (nonoverlapping (dst, 512)) [src1, 2048; src2, 2048; src2t, 1024]
       /\ nonoverlapping (dst, 512) ((word pc : int64), LENGTH mlkem_basemul_k4_tmc)
       /\ nonoverlapping (dst, 512) (stackpointer, 8)
       ==> ensures x86
             (\s:x86state.
               bytes_loaded s (word pc : int64) mlkem_basemul_k4_tmc
               /\ read RIP s = (word pc : int64)
               /\ read RSP s = stackpointer
               /\ read (memory :> bytes64 stackpointer) s = returnaddress
               /\ C_ARGUMENTS [dst; src1; src2; src2t] s
               /\ (!i:num.
                    i < 16
                    ==> (!j:num.
                          j < 8
                          ==> read
                                (memory :> bytes16 (word_add src1 (word (64 * j + 2 * i) : int64)))
                                s
                              = a0 i j))
               /\ (!i:num.
                    i < 16
                    ==> (!j:num.
                          j < 8
                          ==> read
                                (memory
                                :> bytes16 (word_add src1 (word (64 * j + 32 + 2 * i) : int64)))
                                s
                              = b0 i j))
               /\ (!i:num.
                    i < 16
                    ==> (!j:num.
                          j < 8
                          ==> read
                                (memory :> bytes16 (word_add src2 (word (64 * j + 2 * i) : int64)))
                                s
                              = c0 i j))
