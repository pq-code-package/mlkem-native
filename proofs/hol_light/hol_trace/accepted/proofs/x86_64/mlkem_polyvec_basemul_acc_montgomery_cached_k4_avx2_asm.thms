                              /\ abs (ival (b1 i j')) <= &2 pow 12
                              /\ abs (ival (a2 i j')) <= &2 pow 12
                              /\ abs (ival (b2 i j')) <= &2 pow 12
                              /\ abs (ival (a3 i j')) <= &2 pow 12
                              /\ abs (ival (b3 i j')) <= &2 pow 12
