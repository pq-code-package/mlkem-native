definition mlkem_tobytes_tmc
  |- mlkem_tobytes_tmc = TRIM_LIST (4, 0) mlkem_tobytes_mc

definition permute_list
  |- (permute_list : '?1 list -> '?1 list)
     = (\_1:('?1 list). list_of_seq (\i:num. EL (avx_order i) _1) 256)
