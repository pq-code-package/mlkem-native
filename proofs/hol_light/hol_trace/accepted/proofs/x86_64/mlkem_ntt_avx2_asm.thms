# mlkem_ntt_avx2_asm
#
# The main theorems. Written by `hol-trace outline` or `hol-trace
# compare --accept`. This is what the proof claims.

theorem mlkem_ntt_avx2_asm MLKEM_NTT_NOIBT_SUBROUTINE_CORRECT
  |- !a:int64 zetas:int64 zetas_list:(int16 list) x:(num -> int16) pc:num stackpointer:int64
      returnaddress:int64.
       aligned 32 a
       /\ aligned 32 zetas
       /\ nonoverlapping ((word pc : int64), LENGTH mlkem_ntt_tmc) (a, 512)
       /\ nonoverlapping ((word pc : int64), LENGTH mlkem_ntt_tmc) (zetas, LENGTH qdata_full * 2)
       /\ nonoverlapping (a, 512) (zetas, LENGTH qdata_full * 2)
       /\ nonoverlapping (a, 512) (stackpointer, 8)
       /\ nonoverlapping (zetas, LENGTH qdata_full * 2) (stackpointer, 8)
       ==> ensures x86
             (\s:x86state.
               bytes_loaded s (word pc : int64) mlkem_ntt_tmc
               /\ read RIP s = (word pc : int64)
               /\ read RSP s = stackpointer
               /\ read (memory :> bytes64 stackpointer) s = returnaddress
               /\ C_ARGUMENTS [a; zetas] s
               /\ (wordlist_from_memory (zetas, 624) s : int16 list)
                  = MAP (iword : int -> int16) qdata_full
               /\ (!i:num. i < 256 ==> abs (ival (x i)) <= &3328)
               /\ (!i:num.
                    i < 256
                    ==> read (memory :> bytes16 (word_add a (word (2 * i) : int64))) s = x i))
             (\s:x86state.
               read RIP s = returnaddress
               /\ read RSP s = word_add stackpointer (word 8 : int64)
               /\ (!i:num.
                    i < 256
                    ==> (let zi:int16 =
                            read (memory :> bytes16 (word_add a (word (2 * i) : int64))) s in
                        (ival zi == avx2_forward_ntt ((ival : int16 -> int) o x) i) (mod &3329)
                        /\ abs (ival zi) <= &16187)))
             (MAYCHANGE [RSP]
             ,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
             ,, MAYCHANGE [memory :> bytes (a, 512)])

theorem mlkem_ntt_avx2_asm MLKEM_NTT_NOIBT_SUBROUTINE_SAFE
  |- ?f_events:(int64 -> int64 -> num -> int64 -> int64 -> (64 address_uarch_event) list).
       !e:((64 address_uarch_event) list) a:int64 zetas:int64 pc:num stackpointer:int64
        returnaddress:int64.
         aligned 32 a
         /\ aligned 32 zetas
         /\ nonoverlapping ((word pc : int64), LENGTH mlkem_ntt_tmc) (a, 512)
         /\ nonoverlapping ((word pc : int64), LENGTH mlkem_ntt_tmc) (zetas, LENGTH qdata_full * 2)
         /\ nonoverlapping (a, 512) (zetas, LENGTH qdata_full * 2)
         /\ nonoverlapping (stackpointer, 8) (a, 512)
         ==> ensures x86
               (\s:x86state.
                 bytes_loaded s (word pc : int64) mlkem_ntt_tmc
                 /\ read RIP s = (word pc : int64)
                 /\ read RSP s = stackpointer
                 /\ read (memory :> bytes64 stackpointer) s = returnaddress
                 /\ C_ARGUMENTS [a; zetas] s
                 /\ read events s = e)
               (\s:x86state.
                 read RIP s = returnaddress
                 /\ read RSP s = word_add stackpointer (word 8 : int64)
                 /\ (?e2:((64 address_uarch_event) list).
                      read events s = APPEND e2 e
                      /\ e2 = f_events zetas a pc stackpointer returnaddress
                      /\ memaccess_inbounds e2
                           [a, 512; zetas, LENGTH qdata_full * 2; stackpointer, 8]
                           [a, 512; stackpointer, 8]))
               (\s:x86state s':x86state. T)

