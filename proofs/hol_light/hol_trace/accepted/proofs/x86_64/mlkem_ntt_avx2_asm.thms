# x86_64/mlkem_ntt_avx2_asm
#
# The main theorems. Written by `hol-trace conform --accept`; review
# changes like source code: this is what the proof claims.

theorem x86_64/mlkem_ntt_avx2_asm MLKEM_NTT_NOIBT_SUBROUTINE_CORRECT
  |- (!a:(word #64) zetas:(word #64) zetas_list:(list (word #16)) x:(num -> (word #16)) pc:num stackpointer:(word #64) returnaddress:(word #64).
       (==>
         (/\ (aligned #32 a) (aligned #32 zetas)
           (nonoverlapping (, (word:(num -> (word #64)) pc) (LENGTH mlkem_ntt_tmc)) (, a #512))
           (nonoverlapping (, (word:(num -> (word #64)) pc) (LENGTH mlkem_ntt_tmc))
             (, zetas (* (LENGTH qdata_full) #2)))
           (nonoverlapping (, a #512) (, zetas (* (LENGTH qdata_full) #2)))
           (nonoverlapping (, a #512) (, stackpointer #8))
           (nonoverlapping (, zetas (* (LENGTH qdata_full) #2)) (, stackpointer #8)))
         (ensures x86
           (\s:x86state.
             (/\ (bytes_loaded s (word:(num -> (word #64)) pc) mlkem_ntt_tmc)
               (= (read RIP s) (word:(num -> (word #64)) pc)) (= (read RSP s) stackpointer)
               (= (read (":>" memory (bytes64 stackpointer)) s) returnaddress)
               (C_ARGUMENTS [a; zetas] s)
               (=
                 (wordlist_from_memory:(((word #64) # num) -> x86state -> (list (word #16)))
                   (, zetas #624) s)
                 (MAP iword:(int -> (word #16)) qdata_full))
               (!i:num. (==> (< i #256) (int_le (int_abs (ival (x i))) &3328)))
               (!i:num.
                 (==> (< i #256)
                   (=
                     (read (":>" memory (bytes16 (word_add a (word:(num -> (word #64)) (* #2 i))))) s)
                     (x i))))))
           (\s:x86state.
             (/\ (= (read RIP s) returnaddress)
               (= (read RSP s) (word_add stackpointer (word:(num -> (word #64)) #8)))
               (!i:num.
                 (==> (< i #256)
                   (LET
                     (\zi:(word #16).
                       (LET_END
                         (/\
                           (== (ival zi) (avx2_forward_ntt (o ival:((word #16) -> int) x) i)
                             (int_mod &3329))
                           (int_le (int_abs (ival zi)) &16187))))
                     (read (":>" memory (bytes16 (word_add a (word:(num -> (word #64)) (* #2 i))))) s))))))
           (,, (MAYCHANGE [RSP])
             (,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
               (MAYCHANGE [(":>" memory (bytes (, a #512)))]))))))

theorem x86_64/mlkem_ntt_avx2_asm MLKEM_NTT_NOIBT_SUBROUTINE_SAFE
  |- (?f_events:((word #64) -> (word #64) -> num -> (word #64) -> (word #64) -> (list (address_uarch_event #64))).
       (!e:(list (address_uarch_event #64)) a:(word #64) zetas:(word #64) pc:num stackpointer:(word #64) returnaddress:(word #64).
         (==>
           (/\ (aligned #32 a) (aligned #32 zetas)
             (nonoverlapping (, (word:(num -> (word #64)) pc) (LENGTH mlkem_ntt_tmc)) (, a #512))
             (nonoverlapping (, (word:(num -> (word #64)) pc) (LENGTH mlkem_ntt_tmc))
               (, zetas (* (LENGTH qdata_full) #2)))
             (nonoverlapping (, a #512) (, zetas (* (LENGTH qdata_full) #2)))
             (nonoverlapping (, stackpointer #8) (, a #512)))
           (ensures x86
             (\s:x86state.
               (/\ (bytes_loaded s (word:(num -> (word #64)) pc) mlkem_ntt_tmc)
                 (= (read RIP s) (word:(num -> (word #64)) pc)) (= (read RSP s) stackpointer)
                 (= (read (":>" memory (bytes64 stackpointer)) s) returnaddress)
                 (C_ARGUMENTS [a; zetas] s) (= (read events s) e)))
             (\s:x86state.
               (/\ (= (read RIP s) returnaddress)
                 (= (read RSP s) (word_add stackpointer (word:(num -> (word #64)) #8)))
                 (?e2:(list (address_uarch_event #64)).
                   (/\ (= (read events s) (APPEND e2 e))
                     (= e2 (f_events zetas a pc stackpointer returnaddress))
                     (memaccess_inbounds e2
                       [(, a #512); (, zetas (* (LENGTH qdata_full) #2)); (, stackpointer #8)]
                       [(, a #512); (, stackpointer #8)])))))
             (\s:x86state s':x86state. T)))))

