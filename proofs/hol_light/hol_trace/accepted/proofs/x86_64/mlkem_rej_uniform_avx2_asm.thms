#
# mlkem_rej_uniform_avx2_asm
#
# The main theorems. Written by `hol-trace outline` or `hol-trace
# compare --accept`. This is what the proof claims.

theorem mlkem_rej_uniform_avx2_asm MLKEM_REJ_UNIFORM_NOIBT_SUBROUTINE_CORRECT
  |- !res:int64 buf:int64 buflen:int64 table:int64 inlist:((12 word) list) pc:num stackpointer:int64
      returnaddress:int64.
       num_divides 12 (val buflen)
       /\ 8 * val buflen = 12 * LENGTH inlist
       /\ ALL (nonoverlapping (word_sub stackpointer (word 528 : int64), 528))
            [(word pc : int64), LENGTH mlkem_rej_uniform_tmc; buf, val buflen; table, 4096]
       /\ ALL (nonoverlapping (res, 512)) [(word pc : int64), LENGTH mlkem_rej_uniform_tmc;
                                           word_sub stackpointer (word 528 : int64), 536]
       ==> ensures x86
             (\s:x86state.
               bytes_loaded s (word pc : int64) mlkem_rej_uniform_tmc
               /\ read RIP s = (word pc : int64)
               /\ read RSP s = stackpointer
               /\ read (memory :> bytes64 stackpointer) s = returnaddress
               /\ C_ARGUMENTS [res; buf; buflen; table] s
               /\ read DF s = F
               /\ (wordlist_from_memory (table, 4096) s : byte list) = mlkem_rej_uniform_table
               /\ (wordlist_from_memory (buf, LENGTH inlist) s : (12 word) list) = inlist)
             (\s:x86state.
               read RIP s = returnaddress
               /\ read RSP s = word_add stackpointer (word 8 : int64)
               /\ (let inlist':(int16 list) = MAP (word_zx : 12 word -> int16) inlist in
                  let outlist:(int16 list) =
                      SUB_LIST (0, 256) (FILTER (\x:int16. val x < 3329) inlist') in
                  let outlen:num = LENGTH outlist in
                  C_RETURN s = (word outlen : int64)
                  /\ (wordlist_from_memory (res, outlen) s : int16 list) = outlist))
             (MAYCHANGE [RSP]
             ,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
             ,, MAYCHANGE [memory :> bytes (res, 512);
                           memory :> bytes (word_sub stackpointer (word 528 : int64), 528)])

theorem mlkem_rej_uniform_avx2_asm MLKEM_REJ_UNIFORM_NOIBT_SUBROUTINE_MEMSAFE
  |- !res:int64 buf:int64 buflen:int64 table:int64 inlist:((12 word) list)
      e:((64 address_uarch_event) list) pc:num stackpointer:int64 returnaddress:int64.
       num_divides 12 (val buflen)
       /\ 8 * val buflen = 12 * LENGTH inlist
       /\ ALL (nonoverlapping (word_sub stackpointer (word 528 : int64), 528))
            [(word pc : int64), LENGTH mlkem_rej_uniform_tmc; buf, val buflen; table, 4096]
       /\ ALL (nonoverlapping (res, 512)) [(word pc : int64), LENGTH mlkem_rej_uniform_tmc;
                                           word_sub stackpointer (word 528 : int64), 536]
       ==> ensures x86
             (\s:x86state.
               bytes_loaded s (word pc : int64) mlkem_rej_uniform_tmc
               /\ read RIP s = (word pc : int64)
               /\ read RSP s = stackpointer
               /\ read (memory :> bytes64 stackpointer) s = returnaddress
               /\ C_ARGUMENTS [res; buf; buflen; table] s
               /\ read DF s = F
               /\ (wordlist_from_memory (table, 4096) s : byte list) = mlkem_rej_uniform_table
               /\ (wordlist_from_memory (buf, LENGTH inlist) s : (12 word) list) = inlist
               /\ read events s = e)
             (\s:x86state.
               read RIP s = returnaddress
               /\ read RSP s = word_add stackpointer (word 8 : int64)
               /\ (?e2:((64 address_uarch_event) list).
                    read events s = APPEND e2 e
                    /\ memaccess_inbounds e2
                         [buf, val buflen; table, 4096;
                          word_sub stackpointer (word 528 : int64), 536]
                         [word_sub stackpointer (word 528 : int64), 528; res, 512]))
             (MAYCHANGE [RSP]
             ,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
             ,, MAYCHANGE [memory :> bytes (res, 512);
                           memory :> bytes (word_sub stackpointer (word 528 : int64), 528)])

