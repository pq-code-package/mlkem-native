# mlkem_poly_decompress_d11_avx2_asm
#
# The main theorems. Written by `hol-trace outline` or `hol-trace
# compare --accept`. This is what the proof claims.

theorem mlkem_poly_decompress_d11_avx2_asm MLKEM_POLY_DECOMPRESS_D11_NOIBT_SUBROUTINE_CORRECT
  |- !r:int64 a:int64 data:int64 inlist:((11 word) list) pc:num stackpointer:int64
      returnaddress:int64.
       LENGTH inlist = 256
       /\ aligned 32 r
       /\ aligned 32 data
       /\ ALL (nonoverlapping (r, 512)) [(word pc : int64), LENGTH mlkem_poly_decompress_d11_tmc;
                                         a, 352; data, 128; stackpointer, 8]
       ==> ensures x86
             (\s:x86state.
               bytes_loaded s (word pc : int64) mlkem_poly_decompress_d11_tmc
               /\ read RIP s = (word pc : int64)
               /\ read RSP s = stackpointer
               /\ read (memory :> bytes64 stackpointer) s = returnaddress
               /\ C_ARGUMENTS [r; a; data] s
               /\ read (memory :> bytes (data, 128)) s
                  = num_of_wordlist (MAP (iword : int -> byte) decompress_d11_data)
               /\ read (memory :> bytes (a, 352)) s = num_of_wordlist inlist)
             (\s:x86state.
               read RIP s = returnaddress
               /\ read RSP s = word_add stackpointer (word 8 : int64)
               /\ read (memory :> bytes (r, 512)) s = num_of_wordlist (MAP decompress_d11 inlist)
               /\ (!i:num.
                    i < 256
                    ==> &0 <= ival (EL i (MAP decompress_d11 inlist))
                        /\ ival (EL i (MAP decompress_d11 inlist)) < &3329))
             (MAYCHANGE [RSP]
             ,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
             ,, MAYCHANGE [memory :> bytes (r, 512)])

theorem mlkem_poly_decompress_d11_avx2_asm MLKEM_POLY_DECOMPRESS_D11_NOIBT_SUBROUTINE_SAFE
  |- ?f_events:(int64 -> int64 -> int64 -> num -> int64 -> int64 -> (64 address_uarch_event) list).
       !e:((64 address_uarch_event) list) r:int64 a:int64 data:int64 inlist:((11 word) list) pc:num
        stackpointer:int64 returnaddress:int64.
         LENGTH inlist = 256
         /\ aligned 32 r
         /\ aligned 32 data
         /\ ALL (nonoverlapping (r, 512)) [(word pc : int64), LENGTH mlkem_poly_decompress_d11_tmc;
                                           a, 352; data, 128; stackpointer, 8]
         ==> ensures x86
               (\s:x86state.
                 bytes_loaded s (word pc : int64) mlkem_poly_decompress_d11_tmc
                 /\ read RIP s = (word pc : int64)
                 /\ read RSP s = stackpointer
                 /\ read (memory :> bytes64 stackpointer) s = returnaddress
                 /\ C_ARGUMENTS [r; a; data] s
                 /\ read events s = e)
               (\s:x86state.
                 read RIP s = returnaddress
                 /\ read RSP s = word_add stackpointer (word 8 : int64)
                 /\ (?e2:((64 address_uarch_event) list).
                      read events s = APPEND e2 e
                      /\ e2 = f_events a data r pc stackpointer returnaddress
                      /\ memaccess_inbounds e2 [a, 352; data, 128; r, 512; stackpointer, 8]
                           [r, 512; stackpointer, 8]))
               (\s:x86state s':x86state. T)

