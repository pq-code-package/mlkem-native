theorem x86_64/mlkem_nttfrombytes_avx2_asm MLKEM_NTTFROMBYTES_SUBROUTINE_SAFE
  |- (?f_events:((word #64) -> (word #64) -> num -> (word #64) -> (word #64) -> (list (address_uarch_event #64))).
       (!e:(list (address_uarch_event #64)) r:(word #64) a:(word #64) pc:num stackpointer:(word #64) returnaddress:(word #64).
         (==>
           (/\ (aligned #32 r)
             (nonoverlapping (, (word:(num -> (word #64)) pc) (LENGTH mlkem_frombytes_mc)) (, a #384))
             (nonoverlapping (, (word:(num -> (word #64)) pc) (LENGTH mlkem_frombytes_mc)) (, r #512))
             (nonoverlapping (, a #384) (, r #512)) (nonoverlapping (, stackpointer #8) (, a #384))
             (nonoverlapping (, stackpointer #8) (, r #512)))
           (ensures x86
             (\s:x86state.
               (/\ (bytes_loaded s (word:(num -> (word #64)) pc) mlkem_frombytes_mc)
                 (= (read RIP s) (word:(num -> (word #64)) pc)) (= (read RSP s) stackpointer)
                 (= (read (":>" memory (bytes64 stackpointer)) s) returnaddress)
                 (C_ARGUMENTS [r; a] s) (= (read events s) e)))
             (\s:x86state.
               (/\ (= (read RIP s) returnaddress)
                 (= (read RSP s) (word_add stackpointer (word:(num -> (word #64)) #8)))
                 (?e2:(list (address_uarch_event #64)).
                   (/\ (= (read events s) (APPEND e2 e))
                     (= e2 (f_events a r pc stackpointer returnaddress))
                     (memaccess_inbounds e2 [(, a #384); (, r #512); (, stackpointer #8)]
                       [(, r #512); (, stackpointer #8)])))))
             (\s:x86state s':x86state. T)))))
