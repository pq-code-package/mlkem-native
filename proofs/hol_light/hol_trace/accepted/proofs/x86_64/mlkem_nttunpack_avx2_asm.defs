# x86_64/mlkem_nttunpack_avx2_asm
#
# The definitions that the main theorems use beyond the generated
# layers. Written by `hol-trace conform --accept`; review changes like
# source code. check-bind compares the byte lists named in
# mlkem_nttunpack_avx2_asm.bind with sections of object files.

definition avx_unorder
  |- (= avx_unorder
       (\_1:num.
         (LET
           (\half:num.
             (LET_END
               (LET
                 (\offset:num.
                   (LET_END (+ (* half #128) (+ (* #8 (MOD offset #16)) (DIV offset #16)))))
                 (MOD _1 #128))))
           (DIV _1 #128))))

