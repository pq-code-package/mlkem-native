definition mlkem_unpack_tmc
  |- (= mlkem_unpack_tmc (TRIM_LIST (, #4 #0) mlkem_unpack_mc))

definition unpermute_list
  |- (= unpermute_list:((list '?1) -> (list '?1))
       (\_1:(list '?1). (list_of_seq (\i:num. (EL (avx_unorder i) _1)) #256)))
