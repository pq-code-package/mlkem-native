definition mlkem_basemul_k3_tmc
  |- mlkem_basemul_k3_tmc = TRIM_LIST (4, 0) mlkem_basemul_k3_mc

definition pmul0
  |- pmul0
     = (specification "pmul0" pmul0:(int -> int -> int -> int -> int).
         !a:int b:int c:int dz:int. pmul0 a b c dz = b * dz + a * c)

definition pmul0_odd
  |- pmul0_odd
     = (specification "pmul0_odd" pmul0_odd:(int -> int -> int -> int -> int).
         !a:int b:int c:int dz:int. pmul0_odd a b c dz = a * c - b * dz)

definition pmul1
  |- pmul1
     = (specification "pmul1" pmul1:(int -> int -> int -> int -> int).
         !a:int b:int c:int d:int. pmul1 a b c d = b * c + a * d)

definition pmulacc0_k3
  |- pmulacc0_k3
     = (specification "pmulacc0_k3" pmulacc0_k3:(int -> int -> int -> int -> int -> int -> int ->
           int -> int -> int -> int -> int -> int -> int -> int -> int).
         !a0:int b0:int c0:int d0:int dz0:int a1:int b1:int c1:int d1:int dz1:int a2:int b2:int
          c2:int d2:int dz2:int.
           pmulacc0_k3 a0 b0 c0 d0 dz0 a1 b1 c1 d1 dz1 a2 b2 c2 d2 dz2
           = pmul0 a0 b0 c0 dz0 + pmul0 a1 b1 c1 dz1 + pmul0 a2 b2 c2 dz2)

definition pmulacc0_odd_k3
  |- pmulacc0_odd_k3
     = (specification "pmulacc0_odd_k3" pmulacc0_odd_k3:(int -> int -> int -> int -> int -> int ->
           int -> int -> int -> int -> int -> int -> int -> int -> int -> int).
         !a0:int b0:int c0:int d0:int dz0:int a1:int b1:int c1:int d1:int dz1:int a2:int b2:int
          c2:int d2:int dz2:int.
           pmulacc0_odd_k3 a0 b0 c0 d0 dz0 a1 b1 c1 d1 dz1 a2 b2 c2 d2 dz2
           = pmul0_odd a0 b0 c0 dz0 + pmul0_odd a1 b1 c1 dz1 + pmul0_odd a2 b2 c2 dz2)

definition pmulacc1_k3
  |- pmulacc1_k3
     = (specification "pmulacc1_k3" pmulacc1_k3:(int -> int -> int -> int -> int -> int -> int ->
           int -> int -> int -> int -> int -> int -> int -> int -> int).
         !a0:int b0:int c0:int d0:int dz0:int a1:int b1:int c1:int d1:int dz1:int a2:int b2:int
          c2:int d2:int dz2:int.
           pmulacc1_k3 a0 b0 c0 d0 dz0 a1 b1 c1 d1 dz1 a2 b2 c2 d2 dz2
           = pmul1 a0 b0 c0 d0 + pmul1 a1 b1 c1 d1 + pmul1 a2 b2 c2 d2)

definition pmulaccred0_k3
  |- pmulaccred0_k3
     = (specification "pmulaccred0_k3" pmulaccred0_k3:(int -> int -> int -> int -> int -> int ->
           int -> int -> int -> int -> int -> int -> int -> int -> int -> int).
         !a0:int b0:int c0:int d0:int dz0:int a1:int b1:int c1:int d1:int dz1:int a2:int b2:int
          c2:int d2:int dz2:int.
           pmulaccred0_k3 a0 b0 c0 d0 dz0 a1 b1 c1 d1 dz1 a2 b2 c2 d2 dz2
