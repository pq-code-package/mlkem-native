  |- (?f_events:((word #64) -> num -> (word #64) -> (word #64) -> (list (address_uarch_event #64))).
       (!e:(list (address_uarch_event #64)) a:(word #64) pc:num stackpointer:(word #64) returnaddress:(word #64).
         (==>
           (/\ (aligned #32 a)
             (nonoverlapping (, (word:(num -> (word #64)) pc) (LENGTH mlkem_unpack_mc)) (, a #512))
             (nonoverlapping (, stackpointer #8) (, a #512)))
           (ensures x86
