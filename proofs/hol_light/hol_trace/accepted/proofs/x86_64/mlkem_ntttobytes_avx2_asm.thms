# x86_64/mlkem_ntttobytes_avx2_asm
#
# The main theorems. Written by `hol-trace conform --accept`; review
# changes like source code: this is what the proof claims.

theorem x86_64/mlkem_ntttobytes_avx2_asm MLKEM_NTTTOBYTES_NOIBT_SUBROUTINE_CORRECT
  |- (!r:(word #64) a:(word #64) l:(list (word #16)) pc:num.
       (==>
         (/\ (aligned #32 a)
           (nonoverlapping (, (word:(num -> (word #64)) pc) (LENGTH mlkem_tobytes_tmc)) (, a #512))
           (nonoverlapping (, (word:(num -> (word #64)) pc) (LENGTH mlkem_tobytes_tmc)) (, r #384))
           (nonoverlapping (, a #512) (, r #384))
           (nonoverlapping (, {stackpointer:(word #64)} #8) (, r #384)))
         (ensures x86
           (\s:x86state.
             (/\ (bytes_loaded s (word:(num -> (word #64)) pc) mlkem_tobytes_tmc)
               (= (read RIP s) (word:(num -> (word #64)) pc))
               (= (read RSP s) {stackpointer:(word #64)})
               (= (read (":>" memory (bytes64 {stackpointer:(word #64)})) s)
                 {returnaddress:(word #64)})
               (C_ARGUMENTS [r; a] s)
               (= (read (":>" memory (bytes (, a #512))) s) (num_of_wordlist l))))
           (\s:x86state.
             (/\ (= (read RIP s) {returnaddress:(word #64)})
               (= (read RSP s) (word_add {stackpointer:(word #64)} (word:(num -> (word #64)) #8)))
               (==> (= (LENGTH l) #256) (!i:num. (==> (< i (LENGTH l)) (< (val (EL i l)) #3329)))
                 (= (read (":>" memory (bytes (, r #384))) s)
                   (num_of_wordlist (MAP word_zx:((word #16) -> (word #12)) (permute_list l)))))))
           (,, (MAYCHANGE [RSP])
             (,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
               (MAYCHANGE [(":>" memory (bytes (, r #384)))]))))))

theorem x86_64/mlkem_ntttobytes_avx2_asm MLKEM_NTTTOBYTES_NOIBT_SUBROUTINE_SAFE
  |- (?f_events:((word #64) -> (word #64) -> num -> (word #64) -> (word #64) -> (list (address_uarch_event #64))).
       (!e:(list (address_uarch_event #64)) r:(word #64) a:(word #64) pc:num stackpointer:(word #64) returnaddress:(word #64).
         (==>
           (/\ (aligned #32 a)
             (nonoverlapping (, (word:(num -> (word #64)) pc) (LENGTH mlkem_tobytes_tmc)) (, a #512))
             (nonoverlapping (, (word:(num -> (word #64)) pc) (LENGTH mlkem_tobytes_tmc)) (, r #384))
             (nonoverlapping (, a #512) (, r #384)) (nonoverlapping (, stackpointer #8) (, a #512))
             (nonoverlapping (, stackpointer #8) (, r #384)))
           (ensures x86
             (\s:x86state.
               (/\ (bytes_loaded s (word:(num -> (word #64)) pc) mlkem_tobytes_tmc)
                 (= (read RIP s) (word:(num -> (word #64)) pc)) (= (read RSP s) stackpointer)
                 (= (read (":>" memory (bytes64 stackpointer)) s) returnaddress)
                 (C_ARGUMENTS [r; a] s) (= (read events s) e)))
             (\s:x86state.
               (/\ (= (read RIP s) returnaddress)
                 (= (read RSP s) (word_add stackpointer (word:(num -> (word #64)) #8)))
                 (?e2:(list (address_uarch_event #64)).
                   (/\ (= (read events s) (APPEND e2 e))
                     (= e2 (f_events a r pc stackpointer returnaddress))
                     (memaccess_inbounds e2 [(, a #512); (, r #384); (, stackpointer #8)]
                       [(, r #384); (, stackpointer #8)])))))
             (\s:x86state s':x86state. T)))))

