# mlkem_poly_mulcache_compute_avx2_asm.bind with sections of object files.

definition avx2_mulcache
  |- (= avx2_mulcache
       (@
         (\avx2_mulcache:((num # num # num # num # num # num # num # num # num # num # num # num # num) -> (num -> int) -> num -> int).
           (!_1:(num # num # num # num # num # num # num # num # num # num # num # num # num) f:(num -> int) k:num.
             (= (avx2_mulcache _1 f k)
               (LET
                 (\r:num.
                   (LET_END
                     (LET
                       (\q:num.
                         (LET_END
                           (LET
                             (\s:num.
                               (LET_END
                                 (LET
                                   (\t:num.
                                     (LET_END
                                       (rem
                                         (int_mul (f s) (int_pow &17 (+ (* #2 (bitreverse7 t)) #1)))
                                         &3329)))
                                   (+ (* #64 r) (+ (* #2 (DIV q #32)) (* #4 (MOD q #16)))))))
                             (+ (* r #128) (+ (* #32 (DIV q #16)) (+ (MOD q #16) #16))))))
                       (MOD k #64))))
                 (DIV k #64)))))
         (, #97 #118 #120 #50 #95 #109 #117 #108 #99 #97 #99 #104 #101)))

