definition mlkem_basemul_k2_tmc
  |- mlkem_basemul_k2_tmc = TRIM_LIST (4, 0) mlkem_basemul_k2_mc

definition pmul0
  |- pmul0
     = (specification "pmul0" pmul0:(int -> int -> int -> int -> int).
         !a:int b:int c:int dz:int. pmul0 a b c dz = b * dz + a * c)

definition pmul0_odd
  |- pmul0_odd
     = (specification "pmul0_odd" pmul0_odd:(int -> int -> int -> int -> int).
         !a:int b:int c:int dz:int. pmul0_odd a b c dz = a * c - b * dz)

definition pmul1
  |- pmul1
     = (specification "pmul1" pmul1:(int -> int -> int -> int -> int).
         !a:int b:int c:int d:int. pmul1 a b c d = b * c + a * d)

definition pmulacc0
  |- pmulacc0
     = (specification "pmulacc0" pmulacc0:(int -> int -> int -> int -> int -> int -> int -> int ->
           int -> int -> int).
         !a0:int b0:int c0:int d0:int dz0:int a1:int b1:int c1:int d1:int dz1:int.
           pmulacc0 a0 b0 c0 d0 dz0 a1 b1 c1 d1 dz1 = pmul0 a0 b0 c0 dz0 + pmul0 a1 b1 c1 dz1)

definition pmulacc0_odd
  |- pmulacc0_odd
     = (specification "pmulacc0_odd" pmulacc0_odd:(int -> int -> int -> int -> int -> int -> int ->
           int -> int -> int -> int).
         !a0:int b0:int c0:int d0:int dz0:int a1:int b1:int c1:int d1:int dz1:int.
           pmulacc0_odd a0 b0 c0 d0 dz0 a1 b1 c1 d1 dz1
           = pmul0_odd a0 b0 c0 dz0 + pmul0_odd a1 b1 c1 dz1)

definition pmulacc1
  |- pmulacc1
     = (specification "pmulacc1" pmulacc1:(int -> int -> int -> int -> int -> int -> int -> int ->
           int -> int -> int).
         !a0:int b0:int c0:int d0:int dz0:int a1:int b1:int c1:int d1:int dz1:int.
           pmulacc1 a0 b0 c0 d0 dz0 a1 b1 c1 d1 dz1 = pmul1 a0 b0 c0 d0 + pmul1 a1 b1 c1 d1)

definition pmulaccred0
  |- pmulaccred0
     = (specification "pmulaccred0" pmulaccred0:(int -> int -> int -> int -> int -> int -> int ->
           int -> int -> int -> int).
         !a0:int b0:int c0:int d0:int dz0:int a1:int b1:int c1:int d1:int dz1:int.
           pmulaccred0 a0 b0 c0 d0 dz0 a1 b1 c1 d1 dz1
           = (int_of_num (inverse_mod 3329 65536) * pmulacc0 a0 b0 c0 d0 dz0 a1 b1 c1 d1 dz1)
             rem &3329)

definition pmulaccred0_odd
  |- pmulaccred0_odd
     = (specification "pmulaccred0_odd" pmulaccred0_odd:(int -> int -> int -> int -> int -> int ->
           int -> int -> int -> int -> int).
         !a0:int b0:int c0:int d0:int dz0:int a1:int b1:int c1:int d1:int dz1:int.
           pmulaccred0_odd a0 b0 c0 d0 dz0 a1 b1 c1 d1 dz1
           = (int_of_num (inverse_mod 3329 65536) * pmulacc0_odd a0 b0 c0 d0 dz0 a1 b1 c1 d1 dz1)
             rem &3329)

definition pmulaccred1
  |- pmulaccred1
     = (specification "pmulaccred1" pmulaccred1:(int -> int -> int -> int -> int -> int -> int ->
           int -> int -> int -> int).
         !a0:int b0:int c0:int d0:int dz0:int a1:int b1:int c1:int d1:int dz1:int.
           pmulaccred1 a0 b0 c0 d0 dz0 a1 b1 c1 d1 dz1
           = (int_of_num (inverse_mod 3329 65536) * pmulacc1 a0 b0 c0 d0 dz0 a1 b1 c1 d1 dz1)
             rem &3329)
