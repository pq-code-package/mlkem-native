definition mlkem_frombytes_tmc
  |- mlkem_frombytes_tmc = TRIM_LIST (4, 0) mlkem_frombytes_mc

definition unpermute_list
  |- (unpermute_list : '?1 list -> '?1 list)
     = (\_1:('?1 list). list_of_seq (\i:num. EL (avx_unorder i) _1) 256)
