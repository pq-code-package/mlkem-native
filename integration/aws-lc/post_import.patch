+  file(GLOB MLKEM_NATIVE_AARCH64_ASM_SOURCES CONFIGURE_DEPENDS
+    "${MLKEM_NATIVE_DIR}/mlkem/native/aarch64/src/*.S")
 
   list(APPEND BCM_ASM_SOURCES ${MLKEM_NATIVE_AARCH64_ASM_SOURCES})
 
