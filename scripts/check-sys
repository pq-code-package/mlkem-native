#!/usr/bin/env bash
# Copyright (c) The mlkem-native project authors
# SPDX-License-Identifier: Apache-2.0 OR ISC OR MIT

set -euo pipefail

usage() {
  echo "Usage: $0 --expected PATH [--make-arg ARG]..." >&2
  exit 1
}

expected=
make_args=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --expected)
      [ "$#" -ge 2 ] || usage
      expected="$2"
      shift 2
      ;;
    --make-arg)
      [ "$#" -ge 2 ] || usage
      make_args+=("$2")
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

[ -n "$expected" ] || usage

actual="$(mktemp "${TMPDIR:-/tmp}/mlkem-check-sys.XXXXXX")"

cleanup() {
  rm -f "$actual"
}

trap cleanup EXIT HUP INT TERM

make "${make_args[@]}" show-sys | grep '^MLK_' >"$actual"
diff -u "$expected" "$actual"
