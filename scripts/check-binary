#!/usr/bin/env python3
# Copyright (c) The mlkem-native project authors
# SPDX-License-Identifier: Apache-2.0 OR ISC OR MIT

"""Check that the assembly functions in binaries are the machine code
that the HOL Light proofs verify.

For every assembly function with a HOL Light proof, look for a function
symbol of the same name in the given files, with or without a namespace
prefix. If there is one, compare the SHA-256 of its code with the hash
of the proof's byte list in its accepted FUNC.defs, as recorded in
proofs/hol_light/bind.yml. scripts/autogen generates bind.yml from the
.defs, with `hol-trace bind`; check-binary reads nothing else, so a copy
of it and of bind.yml suffices to check a build anywhere. The exit status
is 1 if any check fails.

The files are read with ${CROSS_PREFIX}readelf, GNU's or LLVM's, or
with readelf if there is no such tool, so any ELF file that readelf
reads can be checked, including archives. A file that readelf cannot
read fails.

Options:
  --show-all   also list, in gray, the functions without a proof
  --force-all  require a proof for every function, and at least one
               function in every FILE
  --quiet      print only failures
  --require-match
               fail if no function in the FILEs has a proof
  --bind FILE  read the hashes from FILE instead of this checkout's
               proofs/hol_light/bind.yml

Usage:
  check-binary [--show-all] [--force-all] [--quiet] [--require-match]
               [--bind FILE] FILE ...
"""

import hashlib
import os
import re
import shutil
import subprocess
import sys

import yaml

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
HOL_LIGHT = os.path.join(ROOT, "proofs", "hol_light")
BIND_YML = os.path.join(HOL_LIGHT, "bind.yml")


class Failed(Exception):
    pass


# ----- bind.yml: the expected hashes.


def read_bind(path):
    with open(path, encoding="utf-8") as f:
        return yaml.safe_load(f)


# ----- readelf: the function symbols of an ELF file, or of each member
# of an archive, and the bytes of each function.

SECTION = re.compile(
    r"^\s*\[\s*(\d+)\]\s+(\S+)\s+\S+\s+([0-9a-f]+)\s+[0-9a-f]+\s+([0-9a-f]+)"
    r"\s+[0-9a-f]+\s+(\S*)\s+\d+\s+(\d+)\s+\d+\s*$"
)  # [Nr] Name Type Address Off Size ES Flg Lk Inf Al
SYMBOL = re.compile(
    r"^\s*\d+:\s+([0-9a-f]+)\s+(\S+)\s+(\w+)\s+(\w+)\s+\w+(?:\s+\[[^\]]*\])?"
    r"\s+(\S+)\s+(\S+)\s*$"
)  # Num: Value Size Type Bind Vis Ndx Name
RELOCATIONS = re.compile(r"^Relocation section '(\S+)' at offset")
DUMP = re.compile(r"^Hex dump of section '(\S+)':")
DUMP_LINE = re.compile(r"^\s*0x([0-9a-f]+)\s+(.*)$")


def readelf(path, *args):
    """The output of `${CROSS_PREFIX}readelf -W ARGS path`, as
    [(label, text)]: one for path or, for an archive, one per member,
    which readelf introduces with a line `File: NAME`."""
    tool = os.environ.get("CROSS_PREFIX", "") + "readelf"
    if shutil.which(tool) is None:
        tool = "readelf"  # it reads ELF files of any architecture
    try:
        p = subprocess.run([tool, "-W", *args, path], capture_output=True, text=True)
    except FileNotFoundError:
        raise Failed(f"{tool} not found")
    if p.returncode != 0:
        raise Failed((p.stderr.strip().splitlines() or [f"{tool} failed on {path}"])[0])
    parts = re.split(r"^File: (.*)\n", p.stdout, flags=re.M)
    if len(parts) == 1:
        return [(path, p.stdout)]
    return [(parts[i], parts[i + 1]) for i in range(1, len(parts), 2)]


def parse_headers(text):
    """(relocatable, sections, symbols, relocations) of one file, from
    `readelf -h -S -s -r`: sections maps an index to (name, address,
    size, executable); symbols are (name, section, value, size,
    is_function) of the defined symbols in .symtab, where a function is
    global, or local of type FUNC, in an executable section; and
    relocations are (target section, offset) pairs."""
    relocatable = re.search(r"^\s*Type:\s+REL\b", text, flags=re.M) is not None
    sections, targets = {}, {}
    for m in map(SECTION.match, text.split("\n")):
        if m:
            idx, name, addr, size, flags, info = m.groups()
            sections[int(idx)] = (name, int(addr, 16), int(size, 16), "X" in flags)
            targets[name] = int(info)
    symbols, relocations, table, target = [], [], None, None
    for line in text.split("\n"):
        if line.startswith("Symbol table "):
            table = line.split("'")[1]
            continue
        m = RELOCATIONS.match(line)
        if m:
            target = targets[m.group(1)]
            continue
        if not line.strip():
            table = target = None
            continue
        m = SYMBOL.match(line)
        if m and table == ".symtab":
            value, size, kind, binding, ndx, name = m.groups()
            if ndx.isdigit() and int(ndx) in sections:
                is_function = (
                    sections[int(ndx)][3]
                    and kind in ("NOTYPE", "FUNC")
                    and (binding != "LOCAL" or kind == "FUNC")
                )
                symbols.append(
                    (name, int(ndx), int(value, 16), int(size, 0), is_function)
                )
            continue
        m = re.match(r"^([0-9a-f]+)\s+[0-9a-f]+\s+\S", line)
        if m and target is not None:
            relocations.append((target, int(m.group(1), 16)))
    return relocatable, sections, symbols, relocations


def parse_dumps(text, sections):
    """{section name: bytes} from `readelf -x NAME ...`. A line shows
    an address and up to 16 bytes in hex, then the same bytes as text;
    the section's size says how many of them there are."""
    sizes = {name: (addr, size) for name, addr, size, _ in sections.values()}
    dumps, name = {}, None
    for line in text.split("\n"):
        m = DUMP.match(line)
        if m:
            name = m.group(1)
            dumps[name] = bytearray()
            continue
        m = DUMP_LINE.match(line)
        if m and name in sizes:
            addr, size = sizes[name]
            count = min(16, addr + size - int(m.group(1), 16)) * 2
            digits = ""
            for word in m.group(2).split():
                if len(digits) >= count:
                    break
                digits += word
            dumps[name] += bytes.fromhex(digits[:count])
    return {n: bytes(b) for n, b in dumps.items()}


def functions(path):
    """[(label, [(symbol, bytes, problem, is_function)])] for path or
    each member of it. A function's bytes run from its symbol for its
    size or, without a size, to the next function symbol or the end of
    its section. problem says why its bytes cannot be checked: a
    relocation applies to them, its section's name is not unique, or it
    is not a function."""
    headers = readelf(path, "-h", "-S", "-s", "-r")
    parsed = [(label, parse_headers(text)) for label, text in headers]
    code = sorted(
        {sec[n][0] for _, (_, sec, syms, _) in parsed for _, n, _, _, f in syms if f}
    )
    if code:
        dumps = readelf(path, *[a for n in code for a in ("-x", n)])
    else:
        dumps = [(label, "") for label, _ in headers]
    if len(dumps) != len(parsed):
        raise Failed(f"{path}: readelf listed the members differently")
    out = []
    for (label, (relocatable, sections, symbols, relocations)), (_, text) in zip(
        parsed, dumps
    ):
        contents = parse_dumps(text, sections)
        names = [sec[0] for sec in sections.values()]
        funcs = []
        for symbol, ndx, value, size, is_function in symbols:
            name, addr, sec_size, _ = sections[ndx]
            if not is_function:
                funcs.append((symbol, b"", "not a function", False))
                continue
            if not size:
                later = [v for _, n, v, _, f in symbols if f and n == ndx and v > value]
                end = sec_size if relocatable else addr + sec_size
                size = min(later, default=end) - value
            # In an object file, a symbol's value is an offset into its
            # section; in a linked file, an address, as are the offsets of
            # its relocations, which the loader applies.
            start = value if relocatable else value - addr
            data = contents.get(name, b"")[start : start + size]
            problem = None
            if any(
                start <= off < start + size
                if relocatable
                else value <= off < value + size
                for t, off in relocations
                if not relocatable or t == ndx
            ):
                problem = "relocations apply"
            elif names.count(name) != 1:
                problem = f"its section {name} is not the only one of that name"
            elif start < 0 or len(data) != size:
                problem = "it extends beyond its section"
            funcs.append((symbol, data, problem, True))
        out.append((label, funcs))
    return out


# ----- check: compare each function found with bind.yml and report.


def entry_for(symbol, bind):
    """The bind.yml entry that a symbol matches; the longest name wins."""
    names = [n for n in bind if symbol == n or symbol.endswith("_" + n)]
    return max(names, key=len) if names else None


def paint(text, color):
    if sys.stdout.isatty() or os.environ.get("GITHUB_ACTIONS"):
        return f"\033[{color}m{text}\033[0m"
    return text


GREEN, RED, GRAY = "32", "31", "90"


def check(bind, paths, show_all, force_all, quiet, require_match):
    failures, matched = 0, 0

    def report(line, color):
        if color == RED and os.environ.get("GITHUB_ACTIONS"):
            print(f"::error title=check-binary::{line}")  # an annotation
        elif color == RED or not quiet:
            print(paint(line, color))

    for path in paths:
        for label, funcs in functions(path):
            if force_all and not any(f for _, _, _, f in funcs):
                report(f"✗ {label}: no function symbols", RED)
                failures += 1
            for symbol, code, problem, is_function in funcs:
                name = entry_for(symbol, bind)
                where = f"{label}: {symbol}"
                if name is None:
                    if is_function and force_all:
                        report(f"✗ {where}: no proof", RED)
                        failures += 1
                    elif is_function and show_all:
                        report(f"  {where}: no proof", GRAY)
                    continue
                matched += 1
                proof = f"{bind[name]['arch']}/{bind[name]['function']}"
                if problem:
                    report(f"✗ {where}: {problem} ({proof})", RED)
                    failures += 1
                    continue
                digest = hashlib.sha256(code).hexdigest()
                consts = [c for c, h in bind[name]["sha256"].items() if h == digest]
                if consts:
                    report(
                        f"✓ {where}: {len(code)} bytes = {consts[0]} ({proof})", GREEN
                    )
                else:
                    expected = " or ".join(bind[name]["sha256"])
                    report(
                        f"✗ {where}: {len(code)} bytes, sha256 {digest}, not {expected} ({proof})",
                        RED,
                    )
                    failures += 1
    if not matched:
        if require_match:
            report("✗ no function in these files has a proof", RED)
            failures += 1
        elif not quiet:
            print("check-binary: no function in these files has a proof")
    if failures:
        print(
            f"check-binary: {failures} check(s) failed: these files do not contain the "
            "code that the HOL Light proofs are about (see the reassembly risk in "
            "SOUNDNESS.md)"
        )
    return 1 if failures else 0


def main(args):
    options = ("--show-all", "--force-all", "--quiet", "--require-match")
    bind, paths, flags = BIND_YML, [], set()
    rest = list(args)
    while rest:
        a = rest.pop(0)
        if a == "--bind" and rest:
            bind = rest.pop(0)
        elif a in options:
            flags.add(a)
        elif a.startswith("-"):
            sys.exit(__doc__.strip())
        else:
            paths.append(a)
    if not paths:
        sys.exit(__doc__.strip())
    try:
        return check(read_bind(bind), paths, *(f in flags for f in options))
    except (Failed, OSError) as e:
        print(f"check-binary: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
